  (
    Kaz,
    Long,
    [11093743, 1681369],
    "Сіз бұл жерде қалай өмір сүріп жатырсыз? Бұнда өмір сүру шарттары өте шамалы ғой! Шоколадтың «ракқа қарсы» күшті әсері бар деген болжам да бар және ағзаның қартаюын тежейтін қасиеті бар.",
  ),
  (
    Kaz,
    Long,
    [1636225, 1681376],
    "Уолт Дисней мультфильмдері мен көркем фильмдері қалың көрерменге қазақ тілінде жол тартады. Қазіргі әлем барлық плюстерімен және минустерімен төтенше деңгейде өзара байланысты болып отыр.",
  ),
  (
    Kaz,
    Long,
    [1560462, 1520144, 10130688, 1565331, 2748401],
    "Мен испанша сөйлемеймін. Мен Шымкентте тұрамын. Том сенімді емес екенін айтты. Ол машина жүргізуді үйренді. Сирия басшысының сөзіне қарағанда, Сириядағы химиялық қару арсеналдарын толығымен жою шамамен 1 млрд. долларды құрайды.",
  ),
  (
    Kaz,
    Long,
    [1564126, 1358747, 1573794, 2427163, 9871195, 10875737],
    "Бос уақытта не істейсіз? Өкінішке орай, бұл шындық. Аман-сау тұрғанда кет! Бұл іс менің ырқымда емес. Ол өте алыс жерде тұрады. Ол дәріханада жұмыс істейді.",
  ),
  (
    Kaz,
    Long,
    [2748474, 1560468, 4061511, 7889069],
    "Байқоңырда «Союз ТМА-10» ғарыш кемесінің халықаралық экипажы стартқа дайындалуда. Мен қазақша сөйлей алмаймын. Жaңa жылыңыз құтты болсын. Бүгін Томның туылған күні.",
  ),
  (
    Kaz,
    Long,
    [2812649, 13915262, 8781158, 13534913],
    "Тілдерге деген ұмтылыспен оның Шығыстың классикалық әдебиетіне қызығушылығы оянды. Біз тым аз су ішеміз. Ол супермаркетке бара ма? Ол өрмекшіден қорқады.",
  ),
  (
    Kaz,
    Long,
    [10195753, 9959929, 1723906],
    "Боран біздің барлық іздерімізді жауып кетеді, сондықтан бұл туралы алаңдамаңыз. Мен шахмат ойнауға онша шебер емеспін. Атырауда облыстың ең сұлу бойжеткені таңдалды.",
  ),
  (
    Kaz,
    Long,
    [10130722, 10858037, 11087248, 9868767],
    "Менің достарымды ұнатқаныңызға қуаныштымын. Шаштаразда шашымды қидырдым. Адамдар сияқты, иттердің көру қабілеті үлкейген сайын нашарлайды. Томды террористер ұрлап әкетті.",
  ),
  (
    Kaz,
    Long,
    [9869487, 9869108, 1548633, 2137404, 1569226],
    "Менің достарым көп емес. Олар өз бөлмелерін жинады. Қиын шақта көмектескен сыныптастарыма рақмет! Әр құстың өз ұясы өзіне қымбат. Мені тәтті тіліңмен алдай алмайсың.",
  ),
  (
    Kaz,
    Long,
    [10195652, 1563794, 8310573, 9871664, 1520214],
    "Сіз оны неге жалғыз қалдырдыңыз? Құрғақ жерде сақтау керек. Біздің YouTube-каналымызға жазылыңыз. Сізге сенбегенім үшін мені кешіріңіз. Ол спортпен шұғылданады.",
  ),
  (
    Kaz,
    Long,
    [9869495, 8544715, 9871797, 2812482],
    "Сіз көп ұзамай оралу шартымен ғана кете аласыз. Jetkilikti ýaqyty bolmaǵandyqtan túski as ishpeı ketip qaldy. Мен оларға жазба жазайын деп жатырмын. Кінәлі адам тоғыз ірі қара төледі.",
  ),
  (
    Kaz,
    Long,
    [1565324, 2768803, 9871638, 1549857, 9868897],
    "Кіріңіз, ал танысайық! Балалар өміріміздің гүлдері. Том маған сен туралы бәрін айтып берді. Бiрiншiден мен бұл сөздердiң мағынасы туралы айтайын. Мен көптеген қателіктер жібердім.",
  ),
  (
    Kaz,
    Long,
    [2748232, 1565783, 9959956, 2844361],
    "ҚР Премьер-Министрі Серік Ахметов жұмыс сапарымен Францияға аттанды. \"Кіруге рұқсат па?\" \"Иә, кіріңізші.\" Біз өз балаларымызды жақсы көреміз. Елтаңба («герб») термині немістің «erbe» (мұра) деген сөзінен шыққан.",
  ),
  (
    Kaz,
    Long,
    [8814925, 4685855, 1560587, 7889587],
    "Ол он жыл бұрын үйленген. Қарыз қатынас бұзады. Препараттың үлкен бөлігі метаболит түрінде несеппен шығарылады. Оның Токио қаласына кеткеніне сенімдімін.",
  ),
  (
    Kaz,
    Long,
    [12428976, 9868879, 13775243, 1517447, 2683433],
    "Мен оларды ешқашан ұмытпаймын. Том маған бәрін айтқан жоқ. Менен сұрағыңыз келетін нәрсе бар ма? Менде бір аға және екі сіңлі бар. Ауру өлсіздігін сезді.",
  ),
  (
    Kaz,
    Long,
    [1518356, 2864645, 9868766, 2802556],
    "Бiзге жазуға ұмытпаңыз. Соғыс кезінде сен қайда болдың? Сен тіпті жартысын білмейсін! Мен де тарихшымын, оған қоса Қазақстан тарихшылары ұлттық конгресінің төрағасымын.",
  ),
  (
    Kaz,
    Long,
    [9959939, 12195762, 8781153, 9868980, 9868878, 14044312],
    "Өтінемін, тезірек келіңіз. Өз көзіме сене алмадым. Саған хат жазбақпын. Кейт Брайанның әңгімесін естігенде таң қалды. Сізде жасыл кітап бар. Аллаһ барлық мүліктің, ғаламның және Жердің иесі.",
  ),
  (
    Kaz,
    Long,
    [9869090, 1586037, 9963028],
    "Бәрімізде ауру жұқтырған. Қазақстанда жұмыс істейтін инвесторлардың 85 пайызы оны ТМД-дағы ең тартымды ел деп есептейді. Саған не істеуге тура келіп тұр?",
  ),
  (
    Kaz,
    Long,
    [2734499, 9868837, 2871975],
    "Дамушы нарықтардың Еуразиялық форумы табысты өтті. Біз дұрыс емес жолда жүрміз. Өз бағдарламасын айна-қатесіз орындаған жерлесіміз 88,19 ұпай жинап, қарсыластарынан оқ бойы озып шықты.",
  ),
  (
    Kaz,
    Long,
    [12175743, 2802364, 2683560],
    "Англияда қандай валюта қолданылады? Жарысқа алты команда, оның ішінде ресейлік Қорған қаласының өкілдері де қатысты. Адамның қадiр-қасиетiне қол сұғылмайды.",
  ),
  (
    Kaz,
    Long,
    [9871478, 11055880, 2728136, 3126740],
    "Сізбен жұмыс жасау өте қуанышты болды. Зиридің бүкіл үйі бос еді. Ол бірдеңе іздеген болып күбжеңдеп жүр. Жеткізуші жеткізілетін тауардың жоғары сапасына кепілдік береді.",
  ),
  (
    Kaz,
    Long,
    [1565584, 11087204, 1699126],
    "Байытылған тамақ өнімдері - бұл дәрумендер, минералдық заттар, микроэлементтер қосылған тағам өнімдері. Сіз бұл қыздарды білесіз бе? «Славян базары» байқауында Македония әншісі жеңімпаз атанды.",
  ),
  (
    Kaz,
    Long,
    [2743007, 9868967, 2743043, 9871567, 1523036, 9871719],
    "Жазғы күндердің кeші ұзақ бoлады. Екеуміз де шындықты айтып отырмыз. Бұл жерде ыза жақын. Том саңырау болып көрінді. Бие көп болса, құлын көп. Том кетіп қалды деп ойладым.",
  ),
  (
    Kaz,
    Long,
    [2871943, 9871225, 13540030, 4444010],
    "Соңғысының бағдарламасына командалық шахмат жарысы енгізілді. Сіз ақымақ сияқты әрекет етесіз. Сендер шай қалайсыңдар ма? Мен киноға барғым келiп тұр.",
  ),
  (
    Kaz,
    Long,
    [3551571, 9960001, 9869026, 9868957, 1569501, 1527264],
    "Сіз үшін не істей аламын ? Оның одан кешірім сұрау ниеті жоқ. Том тез тамақтанады. Сізді адамдар көре алады. Ол кітапханаға кітап өткізді. Ол бар қымызды қотарып ішіп қойды.",
  ),
  (
    Kaz,
    Long,
    [9869175, 5262160, 9869030, 1529655, 1578880],
    "Ол сабақта ұйықтап кетті. Тырыссаң, қолыңнан келеді. Ол мұны бүгін жасай алатындығын айтты. Біреудің ыңқылдағанын естігім келмейді. Түркияда Қазақстан Қарулы күштерінің 20 жылдығы аталып өтілді.",
  ),
  (
    Kaz,
    Long,
    [9868956, 1518659, 2812429, 9868758, 9868872],
    "Мен үйленгеннен шаршадым. Біз алмалар жеп тұрамыз. Далаға шахмат қайдан келді? Кальвадос - сидрді айдау арқылы жасалған арақ. Бұл туралы ойлау менің жүрегімді ауыртады.",
  ),
  (
    Kaz,
    Long,
    [9868712, 1578892, 1549868, 2742873],
    "Мэри мәңгі жас болғысы келеді. Қадыров Шешенстан Үкіметін отставкаға жіберді. Шынымды айтсам, парталастарымыз жоқ екен. Бұл менің біздің азаматтарымыз қалай өмір сүріп жатқанын көру үшін аймаққа кезекті тексеру сапарым.",
  ),
  (
    Kaz,
    Long,
    [9869028, 9871080, 12428977, 9869066, 2903205],
    "Том өзімен бірге қолшатыр алып келді. Құс киіз үйдің үстінен ұшып өтті. Фильм басталып жатыр. «Кім бұл?» - «Бұл Том.» Бүгінде барлық өңірлер бір-бірімен ажырағысыз байланыста жұмыс істейді.",
  ),
  (
    Kaz,
    Long,
    [9868948, 1358788, 2748389],
    "Берлинде күндіз де, түнде де кез-келген уақытта көшеде адамдарды көруге болады. Бұл контекстіге байланысты. Анасына қатысты баланы тәрбиелеу бойынша міндеттерін орындамау бойынша әкімшілік іс қозғалды.",
  ),
]

///|
let rows_arb : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Arb, Short, [12355111], "إنهن في البستان."),
  (Arb, Short, [3581850], "لا أريد البكاء أمامهُ."),
  (Arb, Short, [607986], "ذاك هو العائق."),
  (Arb, Short, [11679745], "زاروا بوسطن."),
  (Arb, Short, [6991540], "أشعر بأمر مريب."),
  (Arb, Short, [11946339], "أطفئ الهاتف."),
  (Arb, Short, [5548214], "اذهب إلى النوم"),
  (Arb, Short, [11864049], "ذهبن للنوم."),
  (Arb, Short, [4923382], "سنفتقد توم."),
  (Arb, Short, [5131893], "لدينا مشكلة."),
  (Arb, Short, [13906444], "كنتُ يومًا صغيرةً."),
  (Arb, Short, [5120097], "هذا الكلب يركض بسرعة."),
  (Arb, Short, [7121234], "كان سامي يتكلّم مع ليلى."),
  (
    Arb,
    Short,
    [6130833],
    "لا تزال ليلى تعيش في القاهرة.",
  ),
  (Arb, Short, [11580419], "هل أكلت ساندويشك؟"),
  (Arb, Short, [12083928], "هو يعرف كيف يقلي البيض."),
  (Arb, Short, [10685734], "يعلّق معطفه وراء الباب."),
  (Arb, Short, [11752230], "لا تدعني أسقط."),
  (Arb, Short, [431154], "الجميع يحبها."),
  (Arb, Short, [11612939], "فقد زيري سترته."),
  (Arb, Short, [11283330], "هم يجمعون الطائرات"),
  (Arb, Short, [13174760], "كيف الحال؟"),
  (Arb, Short, [6989704], "أنا مدعوّ لرحلة الشّركة."),
  (Arb, Short, [12172992], "لقد أنقذ قراره حياته."),
  (Arb, Short, [4456002], "إنّما الأعمال بالنيّات."),
  (Arb, Short, [11622922], "أكل ياني البيتزا."),
  (Arb, Short, [11613443], "قام زيري بتصويري."),
  (Arb, Short, [7623456], "لقد تجاهلوك."),
  (Arb, Short, [12339029], "هل عندكم سترة؟"),
  (Arb, Short, [7198425], "سامي غاضب."),
  (
    Arb,
    Medium,
    [11977897],
    "منطقة القبائل هي المكان الذي ولد فيه والدي.",
  ),
  (
    Arb,
    Medium,
    [1584901],
    "أعتقد أنه من المهم قول الحقيقة.",
  ),
  (
    Arb,
    Medium,
    [9225283],
    "مساهماته في المشروع لا جدال عليها.",
  ),
  (
    Arb,
    Medium,
    [507686],
    "نقبل الدفع بأي نوع من بطاقات الإئتمان المعروفة.",
  ),
  (
    Arb,
    Medium,
    [1595155],
    "بيت السيد جونسون بالقرب من بيتي.",
  ),
  (
    Arb,
    Medium,
    [11748063],
    "سياسة إدارة ترامب في الشرق الأوسط كارثية.",
  ),
  (
    Arb,
    Medium,
    [507352],
    "أمضيت ساعتين و أنا أحفظ هذه الجملة.",
  ),
  (
    Arb,
    Medium,
    [7120919],
    "من المفروض أن يكون سامي في القسم.",
  ),
  (
    Arb,
    Medium,
    [11664095],
    "تحكم المسامير الملولبة في اتجاه عقارب الساعة.",
  ),
  (
    Arb,
    Medium,
    [10741967],
    "\"الفلسطينيون غير متحضرين\"، حسب ما قاله السيد جونسون.",
  ),
  (
    Arb,
    Medium,
    [2603296],
    "يأتي كل يوم لزيارة صديقه المريض.",
  ),
  (
    Arb,
    Medium,
    [7983938],
    "لم يسبق لسامي و أن رأى ليلى في حياته.",
  ),
  (
    Arb,
    Medium,
    [2901106],
    "سوف أعلمك كيفية صيد السمك الاحد المقبل.",
  ),
  (
    Arb,
    Medium,
    [824111],
    "نصحني الطبيب بأن أترك الشراب المُسْكِر، ما أصابني بالتوتر وقلة الصبر.",
  ),
  (
    Arb,
    Medium,
    [4122466],
    "يجب على السياح ان ياخذو بالحسبان احترام الثقافات المحلية عندما يسافرون .",
  ),
  (
    Arb,
    Medium,
    [8158740],
    "يقع منزل سامي في الشارع الرئيسي.",
  ),
  (
    Arb,
    Medium,
    [6462536],
    "لِكُلِّ قَاعِدَةٍ إِسْتِثْنَاءٌ.",
  ),
  (
    Arb,
    Medium,
    [476152],
    "ألا يجدر بك أن تتجاهل أخطاءه و تسامحه.",
  ),
  (
    Arb,
    Medium,
    [1878404],
    "أنتِ لا يمكنكِ أن تأكليها فقط لأنها مغذية.",
  ),
  (
    Arb,
    Medium,
    [7121051],
    "كان سامي يريد حقّا أن يثير إعجاب ليلى.",
  ),
  (
    Arb,
    Medium,
    [3760513],
    "لماذا توقفت عن الكتابة في مدونتك؟ كنت أطالعها دائما بسرور عارم!",
  ),
  (
    Arb,
    Medium,
    [2948785],
    "ما هو السبب الحقيقي لعدم رغبتك بعمل هذا؟",
  ),
  (
    Arb,
    Medium,
    [6445199],
    "تُوفِّيَ سامي في حادث مرور مأساوي.",
  ),
  (
    Arb,
    Medium,
    [8338382],
    "كان سامي يجتنب المجيء إلى المدينة.",
  ),
  (
    Arb,
    Medium,
    [374797],
    "لم يشعل النار مع أن الجو كان بارداً.",
  ),
  (
    Arb,
    Medium,
    [371913],
    "لم يكن بإمكانهم فعل شيء إلا الوقوف والمشاهدة.",
  ),
  (
    Arb,
    Medium,
    [12897247],
    "ذهبت إلى المدرسة مباشرةً بعد الفطور.",
  ),
  (
    Arb,
    Medium,
    [5961014],
    "هل ترجمت اللغة الأخرى الى اللغة البرتغالية؟",
  ),
  (
    Arb,
    Medium,
    [650163],
    "ما هي أكثر جملة محببة إلى قلبك؟",
  ),
  (
    Arb,
    Medium,
    [7681567],
    "عليك أن تحصل على كفايتك من النوم.",
  ),
  (
    Arb,
    Long,
    [6472754, 475148, 507434, 6393985, 1566611, 7981753, 5118817],
    "استقرّ سامي في تلك الوظيفة. كوكب الأرض كوكبٌ جميل. ماذا فعلت بتلك الكاميرا؟ ماذا ستصنع لو لم يأت؟ اعرض لنا باختصار حالتك علمت أنّك لن تنساها. طلبت منه فتح النافذة.",
  ),
  (
    Arb,
    Long,
    [7756148, 6994369, 11985956, 11665453, 3054126, 10914941, 4534088],
    "هل أنت مهتم باللغة الأمازيغية؟ أُدخل سامي إلى العيادة. أين تعلمت الألمانية؟ انطفأت الشاشة مرة أخرى. القمر موجودٌ خلف السحاب. من يسيّر هذا الفندق؟ إنّ الدّبّ يأكل تفّاحة.",
  ),
  (
    Arb,
    Long,
    [11763110, 794508, 12014994, 11500259, 3225965, 1883094, 11643631],
    "حصل زيري على الوظيفة. كان الطقس جيدا حتى اليوم. كنت أريد أن أعاركها. يعرف أسماء السيارات. لقد فقدت عقلها من الخوف. هى ولدت في العام 1960. عومل ياني مثل الكلب.",
  ),
  (
    Arb,
    Long,
    [1408617, 10903551, 6980786, 11734613, 1578010, 665679],
    "بتلاتٌ تتطاير في الريح. لما ترتدي ريمة ذلك اللباس؟ أذهب إلى مطعم كلّ يومين. لقد أصلحته، أليس كذلك؟ هلا شغلت التلفاز من فضلك؟ اشتهرت كاليفورنيا بفواكهها.",
  ),
  (
    Arb,
    Long,
    [4982194, 5118992, 7976214, 11984356, 1372669, 4974069, 11487433],
    "أنت سوف تخرج عنها. هل تسمعني؟ هذا ما قاله توم لماري. سامي يعرف أين هو عاقبه. لماذا فعلت ذلك لييدير؟ ماذا تنصحني أن أفعل؟ هذه النافذة ضد الرصاص. ذلك التيس صعد فوق المنزل.",
  ),
  (
    Arb,
    Long,
    [6557465, 470288, 11977308, 11237049, 13936544],
    "عليَّ أن أتخذ القرار حالًا. درس كل يوم لمدة ساعة ونصف. سأل إدموندو عن مكان تواجد ريمة. \"براد بيت! هل هذا حقا أنت؟\" \"نعم، و من أنت؟\" من سنن يوم عيد الأضحى:",
  ),
  (
    Arb,
    Long,
    [11676406, 7016266, 11763165, 11581683, 1995023],
    "الزر في وضعية الإطفاء. لا تزال ليلى تعمل من أجل استرجاع صحّتها. صعد زيري فوق الصخرة. هل تحبن الجبن الأزرق؟ نحن نبحث عن بعض الناس البارعين في الكمبيوتر للعمل معنا.",
  ),
  (
    Arb,
    Long,
    [10856559, 2691346, 11201514, 13281001, 3668940, 7303068],
    "لم أعُدْ أعمل معهم بعد الآن أُرِيدُ أَنْ أَرَى الْغُرْفَةَ. رمى يانّي التّفاز عبر النّافذة. على قدر بساطك مدّ رجليك. أريد أن أذهب إلى المدينة. لم يكن سامي مسيحيّا قطّ.",
  ),
  (
    Arb,
    Long,
    [9627175, 6989680, 4887597, 1581593, 11080698, 1479361],
    "هو وَعد أن يمضي فترة خمس سنوات كرئيس. دعى سامي ليلى للعشاء. سوف نبق دائما صديقين. نهارك سعيد، هل تغديت؟ كان ياني يسير في الشارع و يبحث عن حافلته. ارید الذهاب الی المنزل.",
  ),
  (
    Arb,
    Long,
    [6561327, 12831743, 6893698, 6076740, 6980753, 383699],
    "يريد توم الحديث عن ما حدث. سامي أعتذر عمَّا فعل. نريد حقا ان نساعد توم. \"هل لديك أطفال؟\" \"نعم، اثنان.\" كان سامي يحبّ الحياة كفنّان موسيقي. أعمل منذ السادسة صباحاً.",
  ),
  (
    Arb,
    Long,
    [10322306, 4103886, 1904228, 11581418, 7981581],
    "في الأخير، اتصل ياني بالشرطة. زوجتي خائفة من قيادة سيارة جديدة. أنا لم أفعل أى شىء غير قانوني. تخلى الناس عن هذه العادة منذ وقت طويل. لا تنس الاتصال بأمّك.",
  ),
  (
    Arb,
    Long,
    [10240335, 5865850, 8822214, 5120117],
    "دخل زيري إلى الداخل. كانت ليلى ممرّضة مسجّلة تعمل في مركز معروف لمعالجة السّرطان. موسى عليه السلام كان رسولا من عند الله. توم فائق الجمال وهو يعلم ذلك.",
  ),
  (
    Arb,
    Long,
    [11896890, 5495261, 4105289, 12632936, 372092, 11993345],
    "أراد سامي الزواج بعد تخرّجه. آمل أن يسير كل شيء على ما يرام انا احفظ النشيد الوطني. لقد افهموها لكم من يوم كنتم أطفالا. تزداد الحوادث سنةً بعد سنة. ماذا سأكتب العام القادم؟",
  ),
  (
    Arb,
    Long,
    [11745703, 372030, 5833949, 7981864, 832708],
    "ستغيرنها، أليس كذلك؟ زادت الفرقة الموسيقية عدد الحفلات في جولتها. لم تسر الأمور على ما يرام، أليس كذلك؟ إن لم تذكّرني، فسأنسى. تُكس هو طائر من أنتاركتيكا.",
  ),
  (
    Arb,
    Long,
    [12809528, 5876460, 11897594, 5125037, 12172552],
    "الصينيون قادمون؟ متى؟ روى فاضل للشرطة ما حدث. سامي هو الوحيد في العائلة الذي لا يتكلم الفرنسية. لا يمكنك الحصول علي الملكية من زوجته الراحلة. فلاديمير يقدم بقاشيش هامة.",
  ),
  (
    Arb,
    Long,
    [6982290, 11626914, 371313, 1920213, 6980707, 2659126],
    "كان سامي يتخاصم مع ليلى. صاح ذلك الدينصور و كأنه صفارة إنذار. على الأصدقاء مساعدة بعضهم البعض. إنها مسالة حياة أو موت. نحن ذاهبون إلى المسجد. ينام القط على المائدة.",
  ),
  (
    Arb,
    Long,
    [458521, 7841648, 4982166, 11974696, 372804, 448314],
    "هذا الحذاء كبير عليّ. ثيزيري هي مواطنة جزائرية. ماذا فعلت عندما رجعت إلى منزلك أمس؟ أرني ذلك الفستان القبائلي. هناك سوق كبيرة للقهوة. وقع الرجل العجوز على الأرض.",
  ),
  (
    Arb,
    Long,
    [7804034, 11644913, 672493, 618329, 2603445, 11251282],
    "أسكن في غرداية بالجزائر. كان روبرت يبدو قبيحا. عَبّرتْ عن حزنها بالدموع الصامتة. هل تعرف كم عمر السيدة نكانو؟ يظن توم أن على ماري الاعتذار من جون. إن قابلت ياني مجددا، فسأطردك من المنزل.",
  ),
  (
    Arb,
    Long,
    [394087, 11855127, 3052118, 1013735, 11986988, 4119391],
    "أهم شيء ، إهتم بنظامك الغذائي. كتبنا جملة على السبورة. أتمنتى فقط لو أستطعتُ تكلّمَ الفرنسيّةِ. هذا الرجل يأكل الخبز. من وضعنا في هذا العالم؟ المتاجر المحلية تقوم بمتاجرة جيدة مع السياح .",
  ),
  (
    Arb,
    Long,
    [10951047, 12411183, 1593834, 11990799, 11644094],
    "لقد فقدت القليل من الوزن. أغلبية الناس الذين يقطنون في هذه المنطقة هم من أصول أمازيغية. يُستخرج الحمض النووي من عينة من الدم. لن يفهم زيري هذا أبدا. دان يريد أن تعود ليندة.",
  ),
  (
    Arb,
    Long,
    [6058965, 1568741, 11990561, 11235164, 11993755, 11975167, 6712816],
    "أريد أن نكون صديقتين. أحتاج لشراء بعض الطوابع. لقد كتبت كتابا عن الصين. زيري لا يعلم من يراقبه. سيغسل منشفاته مجددا. بإمكانه القفز أعلى مني. اشترى سامي هذا بمئة و ستّين دولارا.",
  ),
  (
    Arb,
    Long,
    [11502472, 11772523, 6984369, 6994344, 13236511, 7677856, 6998121],
    "هل تجيدين اليابانية؟ نحن نتحدث عن الدراجات. هل سبق لك و أن زرت ألبانيا؟ أحضر سامي ليلى إلى العيادة. هيا نذهب إلى السينما. لن يناسبني هذا الفستان. أنتما تسبّبان لي الإحراج.",
  ),
  (
    Arb,
    Long,
    [11989602, 7238170, 1406859, 11695753, 5547432],
    "هل تريد إشعال النار؟ كان بإمكان سامي أن يحمي ليلى. وأخيراً قرر أن يتزوج. كان جامس جالسا أمام التّلفاز كالعادة. يستوجب بذل جهود أكبر؛ إذا ما أردنا إنجاز هذا الأمر.",
  ),
  (
    Arb,
    Long,
    [2000912, 11250111, 375764, 7972743, 12172950],
    "أنا أعلم أنكَ ليس معجباً بي. بال زيري في وجه أمه حين كانت تغير له حفاظته. كان عطشاناً جداً فطلب القليل من الماء. لم لا نقوم بهذا سويّا. زيري أيضا رقيق المشاعر.",
  ),
  (
    Arb,
    Long,
    [11654494, 11636186, 11250030, 6572733, 11621960, 7744391],
    "قرر زيري ذكر تلك القصة. تصب مياه الجدول من الحوض. تحتاج الجزائر للمزيد من الماء. كان صالون حلاقة سامي نجاحا فوريّا. اليوم هو الثالث من شهر رمضان. متى اشترى توم هذا القميص؟",
  ),
  (
    Arb,
    Long,
    [1573036, 11707948, 417648, 4107196, 7990769],
    "ضربة قوية على العين. ذهب توم لاصطياد السمك. ليس من الضروري أن تتكلم بصوت عالٍ. لقد قمنا من مقاعدنا عندما عزف النشيد الوطني. حكم بالمؤبّد في إندونيسيا يعني سجن مؤبّد.",
  ),
  (
    Arb,
    Long,
    [9090814, 11716681, 7669535],
    "إِنِّي لَأُعْطِي الرَّجُلَ وَغَيْرُهُ أَحَبُّ إِلَيَّ مِنْهُ خَشْيَةَ أَنْ يَكُبَّهُ اللَّهُ فِي النَّارِ. سيحصد المرأ ما زرعه. هل تملكِينَ لوحة المفاتيح الأمازيغية على هاتِفِكِ؟",
  ),
  (
    Arb,
    Long,
    [11442983, 1417768, 7484616, 383061, 1924084],
    "جرت العادة أن تعتبر المرآة المكسورة نذير شؤم يجب عليك أن تعوض عن الوقت الضائع. كنت أرغب في البقاء في السرير طوال اليوم. هل أنهيت واجبك بهذه السرعة؟ هل يمكنك أن تعطي تقريراً كاملاً حول ما حدث؟",
  ),
  (
    Arb,
    Long,
    [11849297, 7215568, 12172610, 7027087, 1890763, 11668942],
    "ذهب يانّي إلى دار دعارة محلّي. أرسل سامي رسالة بيجر لليلى. تملك العقارب كماشات كبيرة. ألحّ سامي على الأمر. هل يجب أن تذهبي إلى مكتب البريد؟ زار زيري فلسطين مؤخرا.",
  ),
  (
    Arb,
    Long,
    [3054766, 455530, 11616118, 3664474, 1468599, 9307519],
    "يا لها من مدينة جميلة! كان هناك الكثير من الناس في الحديقة. أصبح زيري رائد فضاء. يجب أن تفخر جدا بابنتك. هي ترتدي خاتماً قيماً. لِمَ لَمْ تُخبِرني أنَّ توم سَيَكونُ هُنا؟",
  ),
]

