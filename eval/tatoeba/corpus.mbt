let rows_ukr : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Ukr, Short, [8393430], "Чому Том переодягнувся?"),
  (
    Ukr,
    Short,
    [7744081],
    "Моя бабця розвмовляє повільно.",
  ),
  (Ukr, Short, [6674355], "Том хотів подати скаргу."),
  (Ukr, Short, [7255360], "Я вас не поважаю."),
  (Ukr, Short, [651733], "Нема чого сміятися!"),
  (Ukr, Short, [10135605], "Коли він розпочинає?"),
  (Ukr, Short, [9710715], "Том не адвокат."),
  (Ukr, Short, [6743280], "Том це зробив не для нас."),
  (Ukr, Short, [6674173], "Цю книжку написав ти?"),
  (Ukr, Short, [6440765], "Хочете приєднатися до них?"),
  (Ukr, Short, [11551937], "Час обмежений."),
  (Ukr, Short, [6114264], "Том приїхав півгодини тому."),
  (Ukr, Short, [9672698], "У мене є брунатний кіт."),
  (
    Ukr,
    Short,
    [6770949],
    "Як ти можеш бути такою сліпою?",
  ),
  (Ukr, Short, [6279830], "Ніхто не допоміг би мені."),
  (Ukr, Short, [7153153], "Це було недешево, еге ж?"),
  (Ukr, Short, [5862959], "Я можу поїхати з Томом."),
  (Ukr, Short, [6976797], "Він послизнувся на кризі."),
  (Ukr, Short, [6578101], "Том християнин."),
  (Ukr, Short, [472421], "Чи є помилки у цій вправі?"),
  (Ukr, Short, [6138203], "Хтось має запальничку?"),
  (
    Ukr,
    Short,
    [501132],
    "Ти повинен слухатися батьків.",
  ),
  (Ukr, Short, [6723230], "Ти не мусиш туди заходити."),
  (Ukr, Short, [6779804], "Том має дуже мало грошей."),
  (Ukr, Short, [7836878], "Хіба в тебе немає телефону?"),
  (Ukr, Short, [5966304], "Мені не потрібна дружина."),
  (
    Ukr,
    Short,
    [6217920],
    "Права жінок — це права людини.",
  ),
  (
    Ukr,
    Short,
    [10651979],
    "У їхньому будинку є телефон?",
  ),
  (Ukr, Short, [8182708], "Гарна краватка."),
  (Ukr, Short, [7714157], "Я випив би ще чашку кави."),
  (
    Ukr,
    Medium,
    [6306317],
    "Це найгарніша пісню, яку я коли-небудь чула.",
  ),
  (
    Ukr,
    Medium,
    [6398560],
    "Гадаєш, Том насправді переможе?",
  ),
  (
    Ukr,
    Medium,
    [1570869],
    "Принесiть менi, будь-ласка, склянку води.",
  ),
  (
    Ukr,
    Medium,
    [7050655],
    "Ти впевнена, що нам дозволено це робити?",
  ),
  (
    Ukr,
    Medium,
    [6939890],
    "Я хотіла би, щоб ви всі розійшлися по домівках.",
  ),
  (
    Ukr,
    Medium,
    [516883],
    "Багато людей втратили свої домівки під час землетрусу.",
  ),
  (
    Ukr,
    Medium,
    [6690210],
    "Вчора вдень я грав із Томом у теніс.",
  ),
  (
    Ukr,
    Medium,
    [472498],
    "Скільки мов ти знаєш, стільки разів ти людина.",
