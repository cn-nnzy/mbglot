  (
    Vie,
    Medium,
    [4255249],
    "Chúng ta theo dõi tin tức khá thường xuyên.",
  ),
  (
    Vie,
    Long,
    [13896801, 11303204],
    "Axit sunfuric là chất lỏng, sánh, không màu, không bay hơi, tan vô hạn trong nước, và toả nhiệt nhiều. Tin tức có thể được tìm thấy trên tất cả các phương tiện truyền thông.",
  ),
  (
    Vie,
    Long,
    [10233324, 13232212, 8954569, 1542940],
    "Bạn hứa với mình là không cười rồi mà. Tôi thích nghe nhạc. Tôi không thể trả lời câu hỏi này. Tôi sẽ không tha thứ cho bạn trừ khi bạn thành thật xin lỗi.",
  ),
  (
    Vie,
    Long,
    [9081273, 3324712, 13640346, 3313546, 13870232],
    "Chị gái của mẹ tôi là bác tôi. Tôi muốn mua máy ảnh kỹ thuật số. Con người thường mắc sai lầm. Chụp CT chính là chụp cắt lớp. Cô ấy theo Ki-tô giáo, đó là lí do vì sao cô ấy đọc Kinh Thánh và đi lễ mỗi Chủ Nhật.",
  ),
  (
    Vie,
    Long,
    [1552424, 13893857, 3534133, 5160058, 10669859],
    "Nó không bì được với tôi. Gió thổi từ hướng Tây. Cuối cùng thì bạn muốn làm gì với nó? Bạn có thể nhận ra anh ta không? Tom uống thuốc vitamin và khoáng chất mỗi ngày",
  ),
  (
    Vie,
    Long,
    [11318294, 9075762, 8961894, 10540481],
    "Chúng ta cần một kế hoạch. Bà ta có khả năng dự đoán trước tương lai. Tại sao trừ chính tôi ra, ai cũng nghĩ là tôi có thể làm được điều này? Tôi định gặp Tom ở Boston vào đầu tuần sau.",
  ),
  (
    Vie,
    Long,
    [13510776, 872508, 9056976, 11363955],
    "Có ai có câu hỏi gì không? Mọi thứ đã xảy ra, như tôi đã mong. Làm ơn hãy dịch cái này sang tiếng Anh. Tôi hy vọng bạn đã không bị đau lưng trong lúc nâng cái thùng này.",
  ),
  (
    Vie,
    Long,
    [3669889, 1552392, 11357054, 13467914, 9704827],
    "Mày phải ngừng hút thuốc. Mày biết những ngôn ngữ nào? Có những vết đen trên quần tây trắng của tôi. Cô ấy đã ở London cách đây hai năm. Bạn sẽ ở khách sạn nào?",
  ),
  (
    Vie,
    Long,
    [4275061, 10271462, 2652544],
    "Việt Nam là một nước ở khu vực Đông Nam Á. Anh ấy thậm chí không thể nói sự khác biệt giữa một con vịt và một con hưu cao cổ. Cô ấy mới bắt đầu chơi piano.",
  ),
  (
    Vie,
    Long,
    [8938135, 13666135, 3709277],
    "Tác phẩm của ông ấy có thể được tóm lại trong ba từ. Tôi hầu như không ăn thịt. Nói tóm lại, bộ phim này từ kịch bản đến cách trình chiếu đều thành công.",
  ),
  (
    Vie,
    Long,
    [9000584, 2080935, 9009948, 1808205],
    "Anh ấy không muốn bạn biết. Thắp đèn lên đi. Tôi chẳng nhìn thấy gì cả ! Tom đã nói rằng anh ấy nghe thấy tiếng súng. Chúng tớ nghĩ rằng thông điệp đó là thật.",
  ),
  (
    Vie,
    Long,
    [9722355, 14028391, 10233388, 12557906],
    "Anh ấy đang đọc một cuốn sách trong phòng mình. Trái Đất đang tắm mưa sao băng. Cô ấy là một người có sức hút, nhưng cô ấy nói nhiều quá. Khi bạn không thể làm điều mà bạn muốn , bạn hãy làm điều mà bạn có thể làm",
  ),
  (
    Vie,
    Long,
    [10703668, 13508534, 8945662, 9441254],
    "Đừng đứng sát lề đường. Họ không vui trong chính ngôi nhà của họ. Người lớn dành bao nhiên thời gian để xem TV mỗi ngày? Sấm chớp là dấu hiệu cho thấy rằng một cơn bão sắp tới.",
  ),
  (
    Vie,
    Long,
    [3534139, 13270362, 9071172, 8956658, 10276508],
    "Bạn nói không giống Tom. Wǒ xǐhuān xuéxí zhōngwén Tôi không học được gì từ cô giáo đó cả. Tom và Mary đều đến từ Australia. Cô ấy nghe điều này từ anh ấy.",
  ),
  (
    Vie,
    Long,
    [11270828, 624242, 3309481, 8961608, 3468380],
    "Bạn làm tôi mệt quá. Anh ấy không chấp nhận đề nghị của tôi. Chúng ta phải rất cẩn thận. Chúng tôi tận dụng thời tiết đẹp để chơi te-nít. Tôi không muốn đi bằng máy bay, nếu tôi có thể.",
  ),
  (
    Vie,
    Long,
    [9023418, 9431868, 3839330, 3667556],
    "Bạn có thật sự nghĩ là Tom chưa kết hôn không? Tất cả chúng mày đều là đồ nhát cáy. Tom phàn nàn rằng món súp không đủ nóng. Tôi sẽ không thắt ca vát đâu.",
  ),
  (
    Vie,
    Long,
    [3140261, 1566046, 13342805, 9082094],
    "Đây là những áo quần mà Mary đã tự làm. Tom đã tìm thấy một con heo rừng. Chó và sói khác nhau ở đâu? Tôi nghĩ Tom đã từng làm điều đó ít nhất một lần.",
  ),
  (
    Vie,
    Long,
    [13271006, 10282108, 8964469],
    "Tôi thích tên của mình. Tôi muốn ở lại đây và nói chuyện, nhưng tôi phải đi đến buổi hòa nhạc con gái tôi biểu diễn. Bạn đã bao giờ thử làm điều đó chưa?",
  ),
  (
    Vie,
    Long,
    [10265359, 12007210, 14028600, 13666140, 1699107],
    "Thượng Đế đã tạo ra trời đất. Bạn nợ anh ta cái gì? Tôi đã phạm phải một số sai lầm. Anh ấy tránh xa người khác. Các vì sao đang lấp lánh trên bầu trời.",
  ),
  (
    Vie,
    Long,
    [12562913, 13493172, 11289513, 3470063, 13587366],
    "Tôi không còn cảm hứng nữa Hoá thạch ở khắp nơi. Anh ấy đã nói đồng ý với câu hỏi của tôi. Tom đã đạt được một thỏa thuận. Mary không muốn tôi làm bạn với Tom.",
  ),
  (
    Vie,
    Long,
    [11260617, 9010842, 9007606, 4169243],
    "Nguồn cung cấp thực phẩm sẽ không kéo dài được qua mùa đông. Anh ấy đã ngồi cạnh tôi. Tom là một người cha tuyệt vời. Dio vin mortigu kaj la Tero vin ekstermu!",
  ),
  (
    Vie,
    Long,
    [11353489, 8978358, 1567312, 12052655],
    "Tay tôi bị lạnh vào mùa đông nên tôi thích đeo găng tay. Không biết là có cách nào hay không nhỉ. Tụi tao tuy nghèo nhưng rất vui sướng. Tôi nghĩ tôi sẽ ở lại lâu hơn một chút.",
  ),
  (
    Vie,
    Long,
    [2652542, 14028712, 575105, 9003270, 3526258, 11295354],
    "Thu nhập hàng năm của tôi hơn 5 triệu yen. Bạn muốn uống cà phê hay trà? Đó là một con búp bê. Tôi nghĩ là Tom đã nói dối Mary. Cái hòm này quá nặng. Anh ấy đã đội một chiếc mũ lưỡi trai trên đầu.",
  ),
  (
    Vie,
    Long,
    [1510648, 9734359, 620869],
    "Samsung cũng từng khẳng định sẽ trình làng thiết bị với màn hình linh hoạt trong năm 2012. Mỹ đang tìm cách dẫn độ Julian Assange. Hôm nay tôi chả có việc gì đáng làm.",
  ),
  (
    Vie,
    Long,
    [13980671, 13896432, 893091, 3484836, 12534000],
    "Có con chuột dưới bàn. Chúng ta thái thức ăn lên thớt. Quý khách có mua gì thêm nữa không ạ? Tôi biết rất nhiều về thuyền. tôi sẽ mất mãi mãi để giải thích mọi thứ",
  ),
  (
    Vie,
    Long,
    [5144925, 4255221, 934906, 11276027, 9010697],
    "Đừng gọi cảnh sát, anh bạn. Tôi chỉ thấy hơi chóng mặt một tí. Sao mà yếu đuối dữ vậy, cố gắng lên. Bò và gà có hữu ích gì đối với chúng ta? Bạn cần phải chuẩn bị cho tình huống xấu nhất.",
  ),
  (
    Vie,
    Long,
    [13598285, 520189, 1550450, 8938535],
    "Anh ấy rất thích ô tô. Thời ký huy hoàng của người La Mã đã qua rồi. Bạn sẽ kịp xe lửa nếu đi ngay. Cuối cùng thì một tiểu thuyết mới đã được phát hành.",
  ),
  (
    Vie,
    Long,
    [11338270, 10235811, 8945561, 8959909],
    "Tập thể dục tốt cho các cơ bắp và xương của bạn. Tôi đã xem một trận tennis trên ti vi. Bạn có biết cô ấy đang ở đâu không? Tôi có thể không hạnh phúc, nhưng tôi không định tự tử.",
  ),
  (
    Vie,
    Long,
    [1542463, 11571805, 13340669, 1549486],
    "Thành phố Hồ Chí Minh là thành phố lớn nhất Việt Nam. Ông ấy nói tiếng Trung trôi chảy. Chào buổi sáng, công chúa. Thái độ cuả ông đối với cô rất lịch sự, cùng với óc hài hước dễ ưa.",
  ),
  (
    Vie,
    Long,
    [11584763, 11037907, 12054944, 8796120, 9014818],
    "Tom chưa đi được đâu. Tôi đã đợi bạn từ 9 giờ sáng. Đừng lên xe với người lạ. Cái này là mũ của Tom hả? Anh ấy đã hắng giọng trước khi bắt đầu bài giảng.",
  ),
  (
    Vie,
    Long,
    [9075869, 1716329, 13666263],
    "Konstantin Ernst là tổng đạo diễn buổi lễ khai mạc Olympic Mùa đông 2014 tại Sochi. Một người phụ nữ đang ghi chép lại một cái gì đó. Tom đã mua một tờ báo.",
  ),
]

