let rows_srp : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (
    Srp,
    Short,
    [13582515],
    "Још увек имаш довољно времена.",
  ),
  (Srp, Short, [8862311], "Немој да ме повредиш!"),
  (Srp, Short, [6897461], "Идеш ли са нама?"),
  (Srp, Short, [6147449], "Детективи и даље истражују."),
  (Srp, Short, [4449671], "Dođi ovamo unutra."),
  (Srp, Short, [8853560], "Окрени овде."),
  (Srp, Short, [3395299], "Kakvo fantastično jutro!"),
  (Srp, Short, [8844526], "Тому су потекле бале."),
  (Srp, Short, [13954122], "Чуо сам те."),
  (Srp, Short, [12402208], "Често мењам шифре."),
  (Srp, Short, [8890376], "Уништено је."),
  (Srp, Short, [6905791], "Утрнула ми је лева нога."),
  (Srp, Short, [8891276], "Неко се умеша."),
  (Srp, Short, [3389564], "Ne vršimo promenu valuta."),
  (Srp, Short, [13637950], "Сицилија је острво."),
  (Srp, Short, [1384478], "Ово сам купио те седмице."),
  (Srp, Short, [4261757], "Nabavićemo vam jednu."),
  (Srp, Short, [4261930], "Jesi li ovo rekla Tomu?"),
  (Srp, Short, [4324638], "Da li su svi oni jaki?"),
  (Srp, Short, [8869065], "Требало би да певаш с нама."),
  (Srp, Short, [8844185], "Потрчала сам."),
  (Srp, Short, [5651572], "On bi nas sve pobio!"),
  (Srp, Short, [4976013], "Mogu li vam pomoći, gospodine?"),
  (Srp, Short, [942389], "Na tvom mestu bih uradio isto."),
  (Srp, Short, [6983444], "Ne zahvaljuj mi."),
  (Srp, Short, [3334747], "Ne tako brzo!"),
  (Srp, Short, [8896716], "Том је пао на тесту за вожњу."),
  (Srp, Short, [11055713], "Окренула ми је леђа."),
  (Srp, Short, [3248305], "Kada ćemo jesti?"),
  (Srp, Short, [12395608], "Колико кошта векна хлеба?"),
  (
    Srp,
    Medium,
    [8906432],
    "Вероватно ће падати киша цео дан.",
  ),
  (
    Srp,
    Medium,
    [8867651],
    "Урадила бих то поново кад би ми тражио.",
  ),
  (Srp, Medium, [3535659], "Izvadi baterije iz detektora dima."),
  (
    Srp,
    Medium,
    [398510],
    "Нисам разумео ништа на данашњем семинару.",
  ),
  (Srp, Medium, [3331593], "Da li si siguran da je tačno to što govoriš?"),
  (
    Srp,
    Medium,
    [8876873],
    "И даље ниси урадио ништа што је требало да урадиш.",
  ),
  (Srp, Medium, [3286430], "Zamisli samo da možemo da letimo kao ptice."),
  (
    Srp,
    Medium,
    [1074727],
    "Ова електронска порука је поверљива и односи се само на адресанта.",
  ),
  (Srp, Medium, [1436576], "Soba s kupatilom za jednu osobu, molim vas."),
  (Srp, Medium, [4248484], "Vežbaj više, inače ćeš biti debeo."),
  (Srp, Medium, [4942634], "Ne mogu da verujem da ste me lagali."),
  (
    Srp,
    Medium,
    [8820212],
    "Бићу много пажљивија у будућности.",
  ),
  (Srp, Medium, [3365941], "Prihvatamo sve značajnije kreditne kartice."),
  (Srp, Medium, [4246735], "Hoćeš da mi se pridružiš, lepi?"),
  (
    Srp,
    Medium,
    [8820217],
    "Писаћу о томе шта сам урадио прошле зиме.",
  ),
  (
    Srp,
    Medium,
    [4781934],
    "Sigurna sam da Tom nije nameravao da ti povredi osećanja.",
  ),
  (Srp, Medium, [799903], "Da li si se dobro odmorio na raspustu?"),
  (
    Srp,
    Medium,
    [4243340],
    "Merin entuzijazam za kurs je opao kada se njen omiljeni predavač odselio.",
  ),
  (
    Srp,
    Medium,
    [13576689],
    "Јеси ти онај који је ишао са Томом у Аустралију?",
  ),
  (
    Srp,
    Medium,
    [8873078],
    "Да ли Том зна где је Мери отишла?",
  ),
  (
    Srp,
    Medium,
    [3534993],
    "Šta je, po tebi, najčešći uzrok problema u odnosima.",
  ),
  (
    Srp,
    Medium,
    [1183320],
    "Ми смо извезли месо у Аргентину.",
  ),
  (
    Srp,
    Medium,
    [8840553],
    "Часоци почињу следећег понедељка.",
  ),
  (
    Srp,
    Medium,
    [5714279],
    "Ovo je mali korak za čoveka, ali veliki skok za čovečanstvo.",
  ),
  (
    Srp,
    Medium,
    [3434930],
    "Sreo sam mog prijatelja koga nisam video tri godine.",
  ),
  (
    Srp,
    Medium,
    [1057456],
    "Ја сам потпуно заборавио његово име.",
  ),
  (Srp, Medium, [3522692], "Džon i Marija uvek šetaju držeći se za ruke."),
  (
    Srp,
    Medium,
    [3269648],
    "Tajna kreativnosti je znati kako sakriti svoje izvore.",
  ),
  (Srp, Medium, [3297946], "Ovo su koraci koji vode pravo u propast."),
  (
    Srp,
    Medium,
    [1117644],
    "Линколн је поздравио свога старог политичког противника.",
  ),
  (
    Srp,
    Long,
    [10049519, 1776383],
    "Када су Џону обе девојке рекле, да гаје осећања према њему, он није знао, са којом девојком би требало да буде. Највеће уживање које познајем је да се учини неко добро дело у тајности, па тек после буде случајно откривено.",
  ),
  (
    Srp,
    Long,
    [8823890, 4247113, 4976046, 3425268, 5034694, 3470361],
    "Нисам могла да говорим. Tom je bio veoma ljubazan. Nismo čuli ništa od Toma. Ne bi trebao da ovde čekaš. Nikad se nisam pokajala. Želim da dobijem psa.",
  ),
  (
    Srp,
    Long,
    [3410386, 5624087, 5034764, 3266193],
    "Pažljivo pročitajte uputstva. Koliko ti je potrebno mesečno? Mislio sam na svoju porodicu. Oni su se svađali oko toga koji je jezik jednostavniji između Nemačkog i Francuskog.",
  ),
  (
    Srp,
    Long,
    [8835667, 4238388, 12394385, 3438898, 3440922, 13576698],
    "Престаните да се тучете! Kakav koš Majkla Džordana! Овај смрад је неподношљив. Rado bih plesao sa tobom. Ona je nastavila da plače. Стојим испод дрвета.",
  ),
  (
    Srp,
    Long,
    [3429795, 4274669, 3429942, 6905662, 8894856, 13589292],
    "On nije uradio ništa pogrešno. Mogao bih da izgubim penziju. Aerodrom je odmah pored. Где ти је пријатељица? Том се приближи вратима. Ти си се променио, не он.",
  ),
  (
    Srp,
    Long,
    [5308559, 4992713, 8870684, 12404808, 4274705, 5003565, 4258309],
    "Vreme je da ideš u krevet. Da li imate primerak? Хоћу да поправим то. Прочитајте главу три. Nikad nisam kampovao. Glasnije, molim vas. Nisi rekao ništa loše.",
  ),
  (
    Srp,
    Long,
    [4975959, 8876495, 4250628, 8895085, 3311595],
    "U tvojim sam rukama. Шта радиш ових дана? Znam bolji način da se to uradi. То сам очекивао од Тома. On je čiodom zakačio obaveštenje na obaveštajnu tablu.",
  ),
  (
    Srp,
    Long,
    [3438771, 1076261, 1045816, 1312258, 6557669],
    "Ne treba da ostaješ. Те пацијенте хируршко лечење никако неће задовољити. Види се да ја прелазим улицу. Престао сам да пушим пре две године. Мој отац је рекао не.",
  ),
  (
    Srp,
    Long,
    [3477609, 11060180],
    "Poslepodne su specijalne jedinice izvršili prepad na gasno postrojene u Alžiru. Пре него што почнете да користите овај уређај, морате да га прегледате и проверите да ли постоји неко оштећење.",
  ),
  (
    Srp,
    Long,
    [885033, 8902104, 6964070, 3305661, 8852325],
    "Ovi biseri nisu veštački već pravi. Очекивала сам повишицу. Nije baš toliko loše. Moći ćete da vozite automobil posle nekoliko dana. Престаните да мумлате.",
  ),
  (
    Srp,
    Long,
    [12413177, 3424547, 5028985, 8892271],
    "Ради то још мало, молим те. Nisam bio sasvim siguran u to. Tom nije uspeo da nagovori Meri da spremi tortu za Džonovu rođendansku žurku. Сећаш ли се имена своје баке? - Не, увек сам је звао само баком.",
  ),
  (
    Srp,
    Long,
    [3424519, 5588876, 1046884, 13770749, 2153164],
    "Kada možeš da dođeš? Disciplina je najvažniji deo uspeha. Ова инстант супа је подељена на порције. Путовање је трајало четрнаест месеци. Ово је моја мајка. Она се зове Беатриса.",
  ),
  (
    Srp,
    Long,
    [5043518, 1086198, 547427, 3410513, 8849283],
    "Tom izgleda kao bankar. Јеси ли ти Кинез или Јапанац? Трипут мери, једном сеци. Mislim da znaš zašto sam te bio zvao. Овај намештај припада мојој мајци.",
  ),
  (
    Srp,
    Long,
    [3470357, 4258171, 3390876, 1054992],
    "Kada je sve bilo gotovo, sedimo neko vreme ćuteći dok slušamo učitelja. Parkiran sam pozadi. Tom je raskinuo sa svojom devojkom. Човечанство ради да живи, уместо живи да ради.",
  ),
  (
    Srp,
    Long,
    [8894854, 1042346, 4449743, 3485412, 3484072],
    "Том се приближио вратима. Сам у великом граду, осетио сам чежњу за кућом. Kako bih mogla da mrzim Toma? To je glupo pitanje! Pre deset godina je gorelo poslednji put.",
  ),
  (
    Srp,
    Long,
    [3430112, 3304906, 2925890, 8840758, 8842713],
    "Znaš li kako se koristi ova mašina? Nisi govorio istinu. Emili i Melani su Engleskinje. Помислила сам како је звучало много чудно. Склони се да прођем, молим те.",
  ),
  (
    Srp,
    Long,
    [3351479, 1042387, 665263, 3311596],
    "Ona je počela pre deset minuta. Ви можете да останете толико дуго колико хоћете. Znati samog sebe je jako teško. Na granicu su mi tražili da pokažem pasoš.",
  ),
  (
    Srp,
    Long,
    [4250530, 4790660, 13759458, 8865423, 8886711],
    "Tom je mogao da objasni to. Da li si oprala sudove? Том не изгледа старо. Ламе се дуго времена користе у истраживању антитела. Том је пробао да се убије тако што је слупао ауто о зид.",
  ),
  (
    Srp,
    Long,
    [4258284, 1113399, 1052532, 8820284, 8907922, 8852562],
    "Bio sam na recepciji. Трговац је дао рабат на цену. Ми ћемо направити изузетак у вашем случају. Том већ зна ко ће то да ради. Поставио сам ти питање. Узмите још једну шољу.",
  ),
  (
    Srp,
    Long,
    [12398786, 8893496, 3438897, 897079, 8880243],
    "Желим да ти урадиш то сутра уместо мене. Јеси ли ти угасио ТВ? Da li znaš gde ja živim? Da li se mogu osloniti na to da ćeš doći na vreme? Стварно хоћу да изађем с тобом.",
  ),
  (
    Srp,
    Long,
    [3418781, 4250189, 3243423, 1200569],
    "Ti bi trebao biti u školi. Lekove uglavnom ne treba mešati sa alkoholom. Ne volim da kuvam kada je napolju vruće. Зимски спорт, у коме многи људи уживају, јесте клизање.",
  ),
  (
    Srp,
    Long,
    [1046526, 13587100, 4996927, 3243165, 4251220],
    "Ја хоћу да изађем из те тесне собе што је могуће пре. Заборавио сам шифру! Svi su se nasmešili. Ne možeš dobiti dobru ocenu bez mnogo rada. Jesi li video Toma kako je otišao?",
  ),
  (
    Srp,
    Long,
    [1075133, 6872259, 4364603, 1609989],
    "Изволите, покажите ми вашу рањену руку. Бескрајни плави круг. У њему звезда. Rekla sam ti da će da radi. Морам да нагласим чињеницу да је наш тим слабији од америчког.",
  ),
  (
    Srp,
    Long,
    [8877182, 1280740, 6964041, 3535245, 4250569],
    "Том је одлучио да је дошло време да крене. Молим те, поправи моју играчку. Тако се прави важан. Ne brini, nije tako strašno kao što izgleda. Znala sam da nećeš moći da uradiš to.",
  ),
  (
    Srp,
    Long,
    [10689088, 4781392, 3369738, 8849453, 3317312],
    "Скоро сви су отишли. Tom je ponovo slomio nešto. On je imao solidan alibi. Зашто су ствари некад тако тешке? Možeš da misliš koliko je on bio iznenađen kada me je video na tom mestu.",
  ),
  (
    Srp,
    Long,
    [8865358, 8906388, 12738882, 3306678],
    "Ланац треба ставити у керозин и оставити да се натопи. Том жели да иде на журку. Mislim da bi ti trebalo da biraš. Japan i Južna Koreja su zemlje susedi.",
  ),
  (
    Srp,
    Long,
    [3470712, 3341495, 3434946, 5035475],
    "U iskušenju sam da se sakrijem na prvi nagoveštaj konflikta. Latinski je jezik budućnosti! Očekuje se da oblakoder potone u močvari. Imam nekoliko prijatelja iz Kanade.",
  ),
  (
    Srp,
    Long,
    [3357512, 1271569, 3795212, 4981330, 4250226],
    "Da li si zaista tako zauzet? Молим вас, не понављајте ту песму! Када ће кренути курс италијанског језика? Da li mogu da vam pogledam kartu? Nisu mogli da pobegnu.",
  ),
  (
    Srp,
    Long,
    [1048601, 12400431, 5043488, 5294773, 3414403, 13629836],
    "Они су га сматрали глупаном. Мораш да је послушаш. Tom je upucan i ubijen. Gde je studentkinja? Slavili su ga kao heroja. Да ли знаш нешто о породици?",
  ),
  (
    Srp,
    Long,
    [3296181, 8869766, 13589320, 3391996, 11055779],
    "Ova amajlija me štiti od toga da pravim omaške u govoru. Требало би да једем. Свакога лета, ја се вратим на село. Da li je ovo rečnik koji tražiš? Неће стићи на састанак на време.",
  ),
]

///|
let rows_ckb : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
