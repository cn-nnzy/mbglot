  ),
  (
    Tam,
    Medium,
    [13012275],
    "எனக்கு ஒரு குவளை பால் தாருங்கள் .",
  ),
  (
    Tam,
    Long,
    [12410472, 11511697, 4164694],
    "ஆப்பிரிக்க கண்டத்தில் கிளிமஞ்சாரோவிற்கு அடுத்தபடியாக கென்யா மலையில் இரண்டாவது மிக உயரமான மலைமுகடு உள்ளது. ரேடியோ ஆன் பண்ணுங்களேன். நான் இப்பொழுது போக வேண்டும்",
  ),
  (
    Tam,
    Long,
    [12410488, 4158747, 10720920, 4268459, 3425899],
    "அவரது மரணம் தற்செயலானது. நான் ஒரு வழி காட்டப் படுகிறேன் உனக்கு என்ன நிறம் பிடிக்கும்? உங்களுக்கு சைக்கிள் ஓட்டத் தெரியுமா? நாள் முழுதும் டோம் எங்கிருந்தான்?",
  ),
  (
    Tam,
    Long,
    [4163961, 7156600, 10720914, 10720837, 3425798],
    "இந்த ஊரின் ஒவ்வொரு அங்குலமும் எனக்குத் தெரியும் அவர்களில்லாமல் நான் என்ன செய்வேன்? எனக்கு மஞ்சள் பிடிக்கும். அவளுக்கு பத்து வயது. இப்பசுக்கள் சலிப்படைந்து காணப்படுகின்றன.",
  ),
  (
    Tam,
    Long,
    [3174739, 3425779, 4157471, 4271105],
    "ஒரு விசித்திரமான ஒன்று இன்று காலை எனக்கு நடந்தது. நீ எவ்வகையான விளையாட்டை ஆடுகிறாய்? அவன் ஓட ஆரம்பித்தான் தானம் தவமிரண்டும் தங்கா வியனுலகம் வானம் வழங்கா தெனின்",
  ),
  (
    Tam,
    Long,
    [12410470, 11511689],
    "ஆப்பிரிக்க கண்டத்தில் கிளிமஞ்சாரோவிற்கு அடுத்தபடியாக கென்யா மலையில் இரண்டாவது மிக உயரமான சிகரம் உள்ளது. அல்ஜீரியாவோட இந்த பகுதியில் மக்களக்கு வெளியாட்கள பாத்து பழக்கம் இல்ல.",
  ),
  (
    Tam,
    Long,
    [4240357, 3425886, 3174717, 13012283],
    "இங்கே அமருங்கள்,தயவு செயது காத்திருங்கள் டோம் மருத்துவமனையில் மூன்று நாட்களாக இருக்கிறான். என்ன நடந்தது என்பதை தெரிந்து கொள்ள விரும்பினேன். அவர்கள் அவர்களை பார்க்கவில்லை .",
  ),
  (
    Tam,
    Long,
    [3425861, 11036737, 11037831, 13012235],
    "ஆகவே நான் என்ன செய்ய வேண்டும்? உங்களுக்கு பாடல்கள் பிடிக்குமா? அவளின் பார்வையில் அவன் வெறுப்பையும் அலட்சியத்தையும் கண்டான். உங்கள் பாசம் அமிழ்தம் போன்றுள்ளது .",
  ),
  (
    Tam,
    Long,
    [13886630, 4267963, 3425822, 4270207],
    "என் முன்னால் அந்த கத்தியை அசைக்காதே. அவன் இப்பொழுதுதான் வந்தான் டோம் இறுதியாக நாம் அவனிடம் கேட்டதைச் செய்து முடித்தான். பொறிவாயில் ஐந்தவித்தான் பொய்தீர் ஒழுக்க நெறிநின்றார் நீடுவாழ் வார்",
  ),
  (
    Tam,
    Long,
    [4267935, 4271963, 4268043, 4155236],
    "இது எப்பொழுது ஆரம்பிக்கிறது? மக்கள் அந்த வார்த்தையைப் பயன் படுத்துவதாக எனக்குத் தெரியவில்லை தங்களுடைய தந்தையார் எப்படி இருக்கிறார்கள்? நான் வேலை பளுவினால் சோர்வாகயிருக்கிறேன்",
  ),
  (
    Tam,
    Long,
    [4271948, 4267959, 4268467],
    "நம்பிக்கையில்லாமல் நட்பு இருக்க முடியாது நீ எப்பொழுது ஜப்பான் வந்தாய்? உங்களுடைய வேலையாட்கள் மகிழ்ச்சியாக இருக்க வேண்டுமென்றால் நீங்கள் கணிசமான சம்பளம் தர வேண்டும்",
  ),
  (
    Tam,
    Long,
    [10720870, 4157612, 4267857, 10722119],
    "அவருக்கு ஆங்கிலம் பிடிக்காது. உன்னைப் பார்ப்பதில் நான் மகிழ்ச்சி அடைகிறேன் அவள் அவனைக் கடித்தாள் எனக்கு ஒரு தங்கை இல்லை, எனக்கு இரண்டு தங்கைகள் இருக்கிறார்கள்.",
  ),
  (
    Tam,
    Long,
    [4268035, 3425869, 13895051],
    "நான் நிறைய சாப்பிட்டேன் டோம் மேரியைத் தன் இல்லத்துக்கு விருந்துக்காக அழைத்தான். “என் மகனை சந்தித்தால், அவனை வீட்டிற்கு திரும்ப சொல்லு” என்று உன் அப்பா கூறினார்.",
  ),
  (
    Tam,
    Long,
    [3425885, 3425903, 4163964, 10720875, 4271955],
    "டோம் ஏற்கனவே இறந்து போயிருக்கலாம். டோம் அழாமல் இருக்க முயன்றான். அவள் எதற்கும் பயப்படுவதில்லை அப்போது அவனுக்கு மூன்று வயது. அவள் முகம் அழுகையால் நனைந்திருந்தது",
  ),
  (
    Tam,
    Long,
    [7157230, 13012225, 4163971, 4268054],
    "டாமிடம் நான் இதை பகிர்ந்துகொண்டு இருக்கவில்லை. டாம் செய்வான், இல்லையெனில் வேறு யாராவது செய்வார்கள் அவன் அபாயத்தை அறிந்திருக்க வில்லை அவன் இன்னும் இருக்கிறான்",
  ),
  (
    Tam,
    Long,
    [4165476, 8792531, 4268478, 4271984],
    "இந்த சீடி அவளுக்குச் சொந்தமானது என் ஒருவனால் மட்டுமே அதை செய்ய முடியாது என்று நினைக்கிறேன் என டாம் கூறினார் செய்தி வேகமாக பரவியது அவன் தூக்கக் கலக்கத்தில் இல்லை",
  ),
  (
    Tam,
    Long,
    [10720864, 4272100, 4155270, 3425710],
    "எப்படி உங்களுக்கு நன்றி சொல்வது என்று தெரியவில்லை. இன்று மாலை ஆறு மணிக்கு அவனை நான் சந்திக்கிறேன். அவனுக்கு நீச்சல் மீது பற்று உண்டு நான் உன்னை எழுப்பியபோது நீ எதைப் பற்றி கனவு கண்டுகொண்டிருந்தாய்?",
  ),
  (
    Tam,
    Long,
    [3425764, 4155449, 4157490, 4159914, 4158733],
    "உன்னால் ஏன் முடியாது? அவன் எனக்குப் பதிலாக சேன்றான் எப்படி பனியில் சறுக்கி விளையாடுவது என்பது எனக்கு தெரியும் நீ வழி காட்டிக் கொண்டு இருக்கிறாய் நான் ஒரு வழி காட்டிக் கொண்டு இருக்கிறேன்",
  ),
  (
    Tam,
    Long,
    [4157506, 4271998, 4268473, 4163960, 4154915],
    "அவள் போகத் தீர்மானித்தாள் அவள் உன்னை வெறுக்கிற மாதிரி தெரிகிறது நான் கீழ் தளத்தில் வசிக்கிறேன் ஒரு நாயின் படத்தை வரைந்தான் நான் ஒரு விதமான மகிழ்ச்சியிலிருக்கிறேன்",
  ),
  (
    Tam,
    Long,
    [4154984, 10720854, 10720900, 10720879, 7157122],
    "என் மகனைப் பற்றி பெருமைப் படுகிறேன் அதற்கு இப்போது உதவி தேவை. ரொம்ப நேரம் விளையாடாதே. நான் உங்களுக்கு என்ன செய்யணும்? டாம் மதியம் முழுவதும் அழுதுகொண்டேயிருக்கிறான்.",
  ),
  (
    Tam,
    Long,
    [4158741, 7241253, 4155048, 3179657],
    "நான் ஒரு வழி காட்டப் பட்டுக் கொண்டு இருக்கிறேன் ஒரு சதுரத்திற்கு நான்கு சமமான பக்கங்கள் உள்ளன இது ஒரு கேக்கின் துண்டு \"நீங்கள் எங்கே வசிக்கிறீர்கள்?\" \"நான் டோக்கியோவில் வசிக்கும்.\"",
  ),
  (
    Tam,
    Long,
    [10722133, 4271066, 4267948, 4272009],
    "இதை உங்கள் பையில் வையுங்கள். சிறப்பொடு பூசனை செல்லாது வானம் வறக்குமேல் வானோர்க்கும் ஈண்டு அவனைக் கொஞ்சம் பணம் கேட்டாள் இருட்டாக இருக்கும் பொழுது நான் வெளியே போக விரும்புவதில்லை.",
  ),
  (
    Tam,
    Long,
    [7157288, 13012242, 4268044, 7156638],
    "கடல் மட்டம் உயர்வதற்கு தட்பவெப்ப மாற்றம் காரணமாக இருக்கிறது. அது எனக்கு சுவாரஸ்யமாகத் தெரிகிறது! ஆறு மணிக்கு முன்பு வீட் டிற்கு வா அவன் அவளிடம் ஏதோ சொன்னான் மற்றும் அவள் சிரித்தாள்.",
  ),
  (
    Tam,
    Long,
    [4157515, 4165483, 10722099, 3174777, 4157619],
    "அவன் வருவது நிச்சயம் என்னுடைய கணக்கிற்கு மாற்று நான் அவளிடம் இதை பற்றி சொல்லலாமா? நான் என்று படம் விரும்புகிறேன். நான் தூங்குவதற்கு முயற்சி செய்து கொண்டிருக்கிறேன்",
  ),
  (
    Tam,
    Long,
    [4157853, 4155174, 4267976, 10720835, 4240351, 10720868],
    "நீ வர வேண்டுமென விரும்புகிறேன் அவனுக்கு நிறைய பணம் கிடைத்தது அவன் சீக்கிரம் திரும்பி வந்தான் அவனுக்கு பத்து வயது. டாமும் நானும் நண்பர்கள் உங்களுக்கு எத்தனை குழந்தைகள்?",
  ),
  (
    Tam,
    Long,
    [8792543, 3626677, 7157330, 4271954],
    "அவர்கள் எதனால் என் உதவி தேவைப்பட்டது என்று கூறினார்கள். நான் கழிவறைக்குச் செல்ல வேண்டும். எப்படி பதில் சொல்வது என்பதில் நான் உறுதியாக இல்லை. நட்பை விட அன்புதான் முக்கியமானதா?",
  ),
  (
    Tam,
    Long,
    [4240373, 11037820, 12410494, 3425832, 4268464],
    "உடனே வந்து என்னைப் பார்க்கவும் மது அருந்தும் வயதல்ல உங்களது ஏன் அந்தத் தவறைச் செய்தாய்? அவ்வேளையில் அது என்ன என்று நான் அறிந்திருக்கவில்லை. நான் எதிர் காலத்தில் ஒரு விமானியாக விரும்புகிறேன்",
  ),
  (
    Tam,
    Long,
    [3174779, 10722088, 13902923, 10722055, 11511707],
    "பாப் மிகவும் மகிழ்ச்சியாக இருந்தது. இன்று இரவு மழை பெய்யும் என்று நினைக்கிறேன். அப்படி சொல்வதன் அர்த்தம் என்ன? அவள் குழந்தையை முத்தமிட்டாள். மேஜ மேலேந்து கால எடு.",
  ),
  (
    Tam,
    Long,
    [3425800, 7157292, 4157493, 4159917],
    "மேரி எனக்குப் பிடித்தமான எழுத்தாளர்களில் ஒருவர். நாங்கள் உன்னைத் பின்பற்றுவோம் (அ) தொடர்வோம். என்ன செய்வது என்பது எனக்குத் தெரியும் நீ வழி காட்டப் பட்டுக் கொண்டு இருக்கிறாய்",
  ),
  (
    Tam,
    Long,
    [3425771, 11511708, 4270632],
    "நீ எவ்வகையான விளையாட்டை ஆடுகிறாய், டோம்? உன்ன மாதிரி ஆட்கள் தான் பாஸ்டனுக்கு கெட்ட பேர் வாங்கி தர்றது. வானின் றுலகம் வழங்கி வருதலால் தானமிழ்தம் என்றுணரற் பாற்று",
  ),
  (
    Tam,
    Long,
    [7157148, 4155152, 3425761],
    "டாம் மேரியுடன் தொடர்பிலிருந்துருக்கிறான் அல்லது டாம் மேரியுடன் தொடர்பிலிருக்கிறான். ஜேப்படிகாரர்களிடம் ஜாக்கிரதையாக இருக்கவும் அது நடக்கும் என்று எனக்குத் தெரியும்.",
  ),
]

///|
let rows_guj : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Guj, Short, [3936565], "મારું નામ રાહુલ છે."),
  (
    Guj,
    Short,
    [3242672],
    "મારું નામ હોપકિન્સ છે.",
  ),
  (Guj, Short, [3238168], "હું વ્યસ્ત છું."),
  (
    Guj,
    Short,
    [3238181],
    "શું તેણી અંગ્રેજી બોલી શકે છે?",
  ),
  (
    Guj,
    Short,
    [6171291],
    "મને તે લૂખો મળ્યો નથી.",
  ),
  (
    Guj,
    Short,
    [5688467],
    "પારકા ખંભે બંદુક ફોડે",
  ),
  (Guj, Short, [3268836], "સંગ્રહાલય ક્યાં છે?"),
  (Guj, Short, [6171309], "તે તારા આધારે નથી"),
  (
    Guj,
    Short,
    [5683528],
    "મે થોડા ફેરફાર કર્યા છે.",
  ),
  (Guj, Short, [3242683], "મારું નામ સાશા છે."),
  (
    Guj,
    Short,
    [3185636],
    "હું તને પ્રેમ કરુ છુ.",
  ),
  (Guj, Short, [3242671], "મારું નામ જેક છે."),
  (
    Guj,
    Short,
    [3774254],
    "સમુદ્ર માં ટાપુઓ છે.",
  ),
  (Guj, Short, [5683593], "તું તારુ કર"),
  (Guj, Short, [4546223], "કેટલા વાગ્યા છે?"),
  (
    Guj,
    Short,
    [6171300],
    "તે તેનો આધાર આમ પણ રાખતો નથી",
  ),
  (Guj, Short, [3185710], "હું માંસ ખાય છે."),
  (Guj, Short, [5721821], "તેઓ જગ્ડ્યા"),
  (Guj, Short, [5688454], "મારું કહ્યું કરે"),
  (Guj, Short, [3238163], "તે અમેરિકન છે."),
  (
    Guj,
    Short,
    [5683577],
    "તારા કિધે જગ નથી હાલતુ.",
  ),
  (
    Guj,
    Short,
    [6171281],
    "તમે સારા ભાઈ-બહેન છો.",
  ),
  (Guj, Short, [3268825], "પૅરિસ ક્યાં છે?"),
  (
    Guj,
    Short,
    [3238180],
    "શું તું અંગ્રેજી બોલી શકે છે?",
  ),
  (Guj, Short, [3570664], "ધરતી ઉપર આકાશ છે."),
  (
    Guj,
    Short,
    [5688479],
    "માલિક ને મસકા મારે છે.",
  ),
  (
    Guj,
    Short,
    [5683599],
    "આંધળુ અનુકરણ નહિ કરું.",
  ),
  (
    Guj,
    Short,
    [6171310],
