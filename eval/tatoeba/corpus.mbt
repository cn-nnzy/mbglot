  (Yor, Short, [11984421], "Kẹ̀kẹ́ mi ni."),
  (Yor, Short, [11207157], "Ìwọ ta ni?"),
  (Yor, Short, [11984183], "Ṣ'o fẹ́ jẹun adìẹ?"),
  (Yor, Short, [3143500], "Onísègùn ni yín."),
  (Yor, Short, [4535812], "Jack lorúkọ mi."),
  (Yor, Short, [3154998], "Ó yà mí l'ẹ́nu."),
  (Yor, Short, [11207172], "Ọmọ Èkó ni mí."),
  (Yor, Short, [11984170], "Mo mu tíì."),
  (Yor, Short, [11984227], "Mo fẹ́ ràwé."),
