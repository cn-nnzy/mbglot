  ),
  (
    Urd,
    Long,
    [1452196, 1535302, 10823878, 4223662, 1019485, 12486894],
    "وہ بازو باندھ کے سوچ رہا تھا۔ مجھے آج رات کال کرنا۔ سب جاندار آکسیجن پر محتاج ہیں۔ ٹام قیمتی وسائل کو ضائیع کر رہا ہے۔ او چشمان زیبائی دارد. وہ خودکشی کرنا چاہتا ہے۔",
  ),
  (
    Urd,
    Long,
    [10775489, 2840654, 6313829, 13415673],
    "آنا بارہ سال کی ہیں۔ راجندرہ پرساد بھارت کے پہلے صدر تھے. میں نے نوکری ڈھوڑھنے کی کوشش کی۔ آج ہمارا شمار کم ہے، مگر صحیح سیاسی حکمت عملی کے ساتھ، چند سال بعد ہماری تعداد بیسیوں ہزار جتنی ہو سکتی ہے۔",
  ),
  (
    Urd,
    Long,
    [1462358, 12032680, 1476654, 12032445],
    "اس پرندے کی نسل ختم ہونے کے قریب ہے۔ تمہیں پہلے کچھ کپڑے تو پہنے چاہیے۔ ڈاکٹر نے ہر ممکن کوشش کی مریض کو بچانے کے لیئے۔ ٹام اور میری اسکول کے یونیفارم پہن رہے ہیں۔",
