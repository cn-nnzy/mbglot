let rows_uzn : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Uzn, Short, [3212166], "Hayirli tong."),
  (Uzn, Short, [10474537], "Bu xonada issiq suv yo'q."),
  (Uzn, Short, [11070349], "Pul yeyolmaysan."),
  (Uzn, Short, [3764077], "Ko'zlarimning ichiga qara."),
  (Uzn, Short, [3834120], "Senga fillar yoqadi."),
  (Uzn, Short, [493646], "У об-хавога боғлиқ."),
  (Uzn, Short, [3982537], "Bu bizning fikrimiz edi."),
  (Uzn, Short, [13174340], "Qachon uchrashamiz?"),
  (Uzn, Short, [5953782], "Unda ishim bor."),
  (Uzn, Short, [2836653], "Kitoblaringizni oching."),
  (Uzn, Short, [12899848], "Bolalar yig‘lashadi."),
  (Uzn, Short, [3745332], "Уй қишлоқда."),
  (Uzn, Short, [11633397], "Bugun Tomning dam olish kuni."),
  (Uzn, Short, [427040], "Тафсилотларни билмайман."),
  (Uzn, Short, [13118055], "Ukrainaga shon-sharaf!"),
  (Uzn, Short, [3764315], "Menga kitob o'qish yoqadi."),
  (Uzn, Short, [3764120], "Ular Tomni topmadilar."),
  (Uzn, Short, [425153], "Биз кўпинча шахмат ўйнаймиз."),
  (Uzn, Short, [2768402], "Qayerga boryapsan?"),
  (Uzn, Short, [12897292], "Men senga pul yuborolmayman."),
  (Uzn, Short, [10852594], "Baliqni yaxshi ko‘raman."),
  (Uzn, Short, [10716008], "Bu Tomning uyining surati."),
  (Uzn, Short, [4134573], "Uni xalq shoiri deb aytadilar."),
  (Uzn, Short, [397613], "Менинг дўстларим ёш эмас."),
  (Uzn, Short, [8832332], "Bu soat qancha turadi?"),
  (Uzn, Short, [4420919], "Rasmingni ko'rmoqchiman."),
  (Uzn, Short, [3866787], "Sizning uyingiz bormi?"),
  (Uzn, Short, [12896769], "Men o‘ynayapman."),
  (Uzn, Short, [12180541], "Menga kalitlarim kerak."),
  (Uzn, Short, [8821408], "Ertagacha!"),
  (Uzn, Medium, [8824232], "Ertaga erta turish kerak. Endi uxlasangchi?"),
  (Uzn, Medium, [7206788], "O'ylisanki buni qilish arziydimi?"),
  (Uzn, Medium, [7206836], "Bu suv butilkasini to'ldirip qo'ying, iltimos!"),
  (Uzn, Medium, [8824226], "Janob Santa axir aslida otangku, to'g'rimi?"),
  (Uzn, Medium, [8821362], "Tom jahli chiqayotganini ko'rgan joying bormi?"),
  (Uzn, Medium, [10473987], "Har kimning o'zi yoqtirgan narsasi bor."),
  (Uzn, Medium, [8824259], "Nega bunchalik ingliz tilidan zo'rsan?"),
  (
    Uzn,
    Medium,
    [4136116],
    "Kattalar bilan mashg'ulot Elmurodga alohida zavq berar edi.",
  ),
  (Uzn, Medium, [8821103], "Kechirasiz, qoshiqni berib yubora olasizmi?"),
  (Uzn, Medium, [8832154], "Nega bunchalik ovqat qilishda ustasan?"),
  (Uzn, Medium, [13778760], "Tokio qaysi mamlakatning poytaxti?"),
  (Uzn, Medium, [13778757], "U men haqimda bir soʻz ham aytmadi."),
  (Uzn, Medium, [13154723], "Bu kitobni bolalar ham o‘qiy oladi."),
  (Uzn, Medium, [4134359], "Men do'stimga bu voqea haqida aytdim."),
  (Uzn, Medium, [10474578], "Uygonganimda soat oltidan o'tgan edi."),
  (Uzn, Medium, [13539983], "Matematikadan hech narsa tushunmaydi."),
  (Uzn, Medium, [3763993], "Olmalarni va apelsinlarni qiyoslayapsan."),
  (Uzn, Medium, [8824044], "Bunaqa yengil kiyimda uxlasang, shamollaysan."),
  (
    Uzn,
    Medium,
    [10852590],
    "Tom hayotining ko‘p qismini Bostonda o‘tkazdi.",
  ),
  (Uzn, Medium, [8832323], "Ertaga nechida kutib olishga borsam bo'ladi?"),
  (Uzn, Medium, [3764087], "Mening onam kartoshkani archdi."),
  (Uzn, Medium, [4134688], "Bu topshiriqni albatta bajaramiz."),
  (Uzn, Medium, [12905917], "Nega itlarni shunchalik yomon ko‘rasan?"),
  (Uzn, Medium, [9646581], "6 soatda bir marta tana haroratimni oʻlchadim."),
  (Uzn, Medium, [11596132], "Qiladigan bir narsa bo‘lmasligi juda zerikarli."),
  (Uzn, Medium, [3764299], "U hozir restoranda o'zbek palovi yeyapti."),
  (
    Uzn,
    Medium,
    [9642948],
    "Болаларнинг тана ҳарорати ўсмирларникидан юқори.",
  ),
  (Uzn, Medium, [7206772], "Tom bilan suhbatlashishni xohlayman."),
  (
    Uzn,
    Medium,
    [3098155],
    "Klassik musiqa tinglash bilan o'qish bir-birini to'ldiradi.",
  ),
  (Uzn, Medium, [2664988], "Chaqaloqning tagligini o'zgartirdim."),
  (
    Uzn,
    Long,
    [8821397, 3817362, 14036442, 10236721, 510217, 3633459],
    "Yana bir bor qilib ko'rchi. Samarqandga bormoqchiman. Hikoya qanday davom etmoqda? Assalomu alaykum, do'stlar! Онам отға койияптими? Мактабга боргим келмаяпти.",
  ),
  (
    Uzn,
    Long,
    [12474870, 3971668, 10473951, 11065573, 3746878, 3720623],
    "U senga nega yordam bermadi? O'sha vaqtda uylangan edim. Bu yerga kelsam bo'ladimi? Men go‘sht yemayman. Кутубхонада талабалар бор. Мен сени ҳар доим севдим.",
  ),
  (
    Uzn,
    Long,
    [12474876, 3766220, 4420924, 465510, 3835476, 2929074, 3834117],
    "Ozgina qo'rqayapman. Uning ko'zlari qora edi. Dorini sotib oldingizmi? Гиламда ухлаш жуда яхши! Qancha mushugingiz bor? Mushuklar unga hujum qildi. Bir stakan kola olmoqchi edim.",
  ),
  (
    Uzn,
    Long,
    [4127482, 12905766, 8812565, 8832134],
    "O'tgan hafta harorat noldan yuqori edi. Ta’lim uchun bo‘lsa ham seni chet elga yuborolmayman. Biz ham qozoq tilini o'rganaylik! Nima demoqchiligimni unutib qo'ydim.",
  ),
  (
    Uzn,
    Long,
    [2836674, 3835564, 10874182, 12173872, 3764155, 8453329, 12794144],
    "Chaqaloq gapira olmaydi. Men Ashxobodga boraman. Germaniyaga qachon borasan? Bugun ob-havo qanday? It mushukni ko'rmayapti. Oqibatsiz inson ekansiz! Ularning hamkorligi bilan vazifa muvaffaqiyatli bajarildi.",
  ),
  (
    Uzn,
    Long,
    [8824188, 2768820, 10474001, 8824233, 10473710],
    "Musiqasiz hayotni hayolimga sig'dira olmayman. U qo'shiq aytishga boshladi. Pasportni qayerga ko'rsatish kerak? Bu velosiped kimniki? Sudya Tomni uch yillik qamoq jazosiga hukm qildi.",
  ),
  (
    Uzn,
    Long,
    [8832192, 10854398, 7206748, 4134317, 4420922],
    "O'tgan yilgi rojdestvoda nima qilganding? Kechani qayerda o‘tkazding? U o'z Xudosiga qattiq iymoni bor Yuring, havoda aylanamiz. Shifokor senga nima aytib berdi?",
  ),
  (
    Uzn,
    Long,
    [11282688, 3764117, 11909482],
    "Kutubxona qoidalariga ko‘ra baland ovozda gapirish taqiqlanadi. Italiya bir yarimorol. Men mushuklarni yaxshi ko‘raman, mushuklar ham meni yaxshi ko‘radilar.",
  ),
  (
    Uzn,
    Long,
    [3763791, 11282104, 425338, 10715999, 12020360, 813318],
    "Qancha pul istaysan? Bu savolingizga javobmi? Бу жумла аниқ йозилган эмас. Erkin va baxtli bo'lishni xohlayman. Faqat birinchi tarjimani o‘qidim. Kelilar gullar haqida gapalshamiz .",
  ),
  (
    Uzn,
    Long,
    [11537605, 2836654, 10874183, 14036822, 11905569, 2830947],
    "Bu kitobni ikki yil oldin o‘qigan edim. Kitoblaringizni berkiting. Germaniyaga qachon borasiz? U siz haqingizda soʻradi. Savolga javob berdi. Olmani kim o'g'irladi?",
  ),
  (
    Uzn,
    Long,
    [5397075, 13725544, 528762, 521360, 8097840],
    "Men Toshkentda yashayman. Kitob oʻqishni yoqtirmayman. Саломатлик бойликдан муҳим. Тафтс дунёнинг энг хавфли университети. Badaviylar choʻlda yashaydi.",
  ),
  (
    Uzn,
    Long,
    [9642917, 9641392, 3817394, 14034790, 12899845],
    "Oilam hech nimadan shubhalanmadi. Oʻquvchining kitobi qayerda? Men faqat frantsuzcha gapiraman. Bugun faqat bozorga bordim. Bu barcha mayda-chuydadan qutulolasanmi?",
  ),
  (
    Uzn,
    Long,
    [3720638, 3763796, 2664974, 3817376, 8824241, 426016],
    "Менга Вероникани қучоқлаш ёқади. Kim bilan gaplashmoqchisiz? Men kecha maktabga bordim. U Tomning onasi edi. Nima uchun menga bunchalik mehribonsan? Улар яхши муҳитда яшайдилар.",
  ),
  (
    Uzn,
    Long,
    [4134695, 3836877, 3763781, 8824193, 4134439],
    "To'yingga albatta boraman. Bolalar hayotimizning gullari. Menda hamma faktlar yo'q. Uylanmoqchi (/Erga tegmoqchi) emasmanku-ya, farzand xohlayman. Bola \"r\"ni ayta olmaydi.",
  ),
  (
    Uzn,
    Long,
    [3865728, 13725533, 4127634, 425127, 4866629, 3161375],
    "Bir kitob yozmoqchiman. Endi kimga ishonishni bilmayman. Siz buni qanday bajardingiz? Мумкин бўлса, келинглар. O'tgan kecha menga telefon qildingmi? Ingliz tilida javob bering!",
  ),
  (
    Uzn,
    Long,
    [3764111, 12897213, 13540141, 12321198],
    "U onasining o'limidan xabardor emas. Petri kitobni nima bilan yozmoqda? U koʻzlarini ochmoqchi emas. Boshliq, hammasi ketdi! Gips olib tashlandi! Mijoz ketmoqda!",
  ),
  (
    Uzn,
    Long,
    [3764072, 4136106, 3817368, 11163461],
    "Bu yerda hech nima yo'q. Anvar xususiy haeti, ayniqsa Ra'noga aloqasidan hech kimga og'iz ochmas edi. U Buxoroga bormoqchi. Ular menga nimadir topishganini aytishdi.",
  ),
  (
    Uzn,
    Long,
    [4136078, 8821095, 10474881, 426425, 12899877, 4136073],
    "Kalishim almashib qolibdi. Bu rostdan ham spagettimi? Soat oltidan o'tgan edi. Душманнинг душмани дўст. O‘lishimni xohlaysanmi? O'qituvchimiz almashdi.",
  ),
  (
    Uzn,
    Long,
    [3764092, 8824212, 2661324, 2929064, 8821378, 12897886],
    "Bu surat kim tomonidan bo'yalgan? Quloqchining (Naushniging) bormi? Men kitobni o'qiyman. Bu so'z juda ta'sirli. Hozir soat nechi, bilasanmi? Go‘sht yeyishni yaxshi ko‘raman.",
  ),
  (
    Uzn,
    Long,
    [7206840, 2929057, 9646607, 12194916, 8821377],
    "Men Pragvada tug'ulganman. Bu kitobni allaqachon oʻqiganman. Kecha yer qimirladi. Men buni imzolashni xohlamayman. O'zim ham nima deganimga tushunmay qoldim.",
  ),
  (
    Uzn,
    Long,
    [3745333, 398186, 2836661, 3764143, 10473703],
    "Биз туркманча гапиряпмиз. Қийинчиликдаги дўст ҳақиқий дўстдир. Ba'zan kinoteatrga boraman. Odam maktubni yozmayapti. Bungacha men taksi haydovchisi bo'lib ishlaganman.",
  ),
  (
    Uzn,
    Long,
    [12146204, 8832141, 4136149, 545996],
    "Nima ichishni xohlaysiz? Nega bunchalik fransuzchada ustasan? Mening kelinimga ayt:kurak, bolta, arra, jami asboblarni yig'sin. «Михаил» эркак исми, лекин «Мишел» аёл исми.",
  ),
  (
    Uzn,
    Long,
    [14036453, 11165377, 11906413, 8832236, 8832322, 3817365],
    "Tilingizni yaxshi koʻraman. Agar yomg‘ir yog‘sa, piknik bekor qilinadi. Tillarni yaxshi ko‘raman. Ertaga qayerda uchrashamiz? Bu nonni yesam maylimi? Samarqandga bormoqchi emasman.",
  ),
  (
    Uzn,
    Long,
    [397204, 3764568, 8824219, 4125796, 12526042],
    "Сиз хотинни қаерда кўрдингиз? Mening amakim Toshkentda yashaydi. Tomning oyisini hech ko'rganmisan? Biz kemaga soat o'nda o'tirdik. Ertangi yig‘ilishga kelmayman.",
  ),
  (
    Uzn,
    Long,
    [4136719, 13991549, 8821401, 10474528, 12073352, 4136723],
    "Aql yoshda emas, boshda. Xitoycha oʻrganish qiyin emas. Yiqilib tushmagin-a. Xonamda issiq suv yo'q. Bugun maktabda nimani o‘rgandingiz? Ko'pdan ko'p chiqar.",
  ),
  (
    Uzn,
    Long,
    [13539872, 3776250, 8781540, 10473720, 12794129, 10474555],
    "U matematikadan hech narsa tushunmaydi. Hech kim javob bermadi. U qo'ylarini oziqlantiryapti. Nimalarni ko'ryapsan? Kimdir o‘zini o‘ldirdi. Narxini tushurolasizmi?",
  ),
  (
    Uzn,
    Long,
    [13679909, 12194917, 10846303, 13858675, 13572535],
    "Men bu kitobni sotib olmayman. Men uni imzolashni xohlamayman. Sen roman yozishing kerak. Ingliz tilida hamma joyda gaplashiladi Ijtimoiy tarmoqlardan foydalanishni toʻxtatdim.",
  ),
  (
    Uzn,
    Long,
    [7206762, 866403, 12474879, 4136144, 10474479, 3746888],
    "Turkcha gaplashdingizmi? Chet elda ko'p do'stlarim bor. Siz va Tom bu yerda xavfsiz bo'lasizlar. Anor faqat janubda o'sadi. O'zimga oro bermoqchiman. Мен бормоқчи эмасман.",
  ),
  (
    Uzn,
    Long,
    [3507475, 10473686, 10474518, 559027, 3764295, 473748],
    "Sen o'qituvchi emasmiding? Men sotuvchi bo'lib ishlayman. Qayerga bormoqchisiz? Сув кўрмай этик ечма. Men u qayerda ishlashini bilmoqchi emasman. Соғлиқ ва лаззат учун!",
  ),
  (
    Uzn,
    Long,
    [3865736, 8824087, 10473938, 3817385, 11904898],
    "Men oldin uni ko'rgan edim. O'zingni majburlamagin-a. Qayerda o'tirishni xohlaysiz? Matematikani yomon ko'raman. Ma’lumotlar bazamizda bunday yozuv yo‘q.",
  ),
]

///|
let rows_zlm : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Zlm, Short, [8223072], "Dia meninggalkan keluarganya."),
  (Zlm, Short, [9947276], "Kenapa awak semua ketawa?"),
  (Zlm, Short, [10943079], "Tangan awak sejuk macam ais."),
  (Zlm, Short, [10789946], "Tom pun tolong Mary jugak."),
  (Zlm, Short, [10137045], "Sudu ini untuk teh."),
  (Zlm, Short, [11066967], "Hujan turun sehingga pagi."),
  (Zlm, Short, [6569616], "Lancarkan pakaian kamu."),
  (Zlm, Short, [6314622], "Si Tom akan rasa kesal tu."),
  (Zlm, Short, [11518705], "Kau dah kenapa?"),
  (Zlm, Short, [3936323], "Maafkan saya."),
  (Zlm, Short, [10688591], "Tom membeli coklat untuk Mary."),
  (Zlm, Short, [10156347], "ايت تق عاديلله!"),
  (Zlm, Short, [10302177], "كاو تق ڤايه بوات ڤون."),
  (Zlm, Short, [9186334], "Kita akan melakukannya."),
  (Zlm, Short, [1216870], "Awak percaya kepada Tuhan?"),
  (Zlm, Short, [5239315], "Bilakah awak akan pulang?"),
  (Zlm, Short, [5899518], "Saya malas."),
  (Zlm, Short, [9127743], "Saya ada soalan untuk awak."),
  (Zlm, Short, [10723478], "Lain kalilah kot."),
  (Zlm, Short, [10724972], "Tom rasa Mary akan minat."),
  (Zlm, Short, [10784348], "Aku kena tolak offer Tom."),
  (Zlm, Short, [11187918], "Aku bagi setepek je kat dia."),
  (Zlm, Short, [4572474], "Itu je aku dah cakap dah."),
  (Zlm, Short, [9933911], "Saya suka masakan Jamaica."),
  (Zlm, Short, [10844019], "Saya juga telah menerimanya."),
  (Zlm, Short, [2607217], "Aku cinta sekolah ini."),
  (Zlm, Short, [4558402], "Teruskan saja."),
  (Zlm, Short, [11470304], "Siapa yang membuka tingkap?"),
  (Zlm, Short, [9541484], "Itu tak adillah!"),
  (Zlm, Short, [11084641], "Saya kawan Tom."),
  (
    Zlm,
    Medium,
    [4579224],
    "Kami akan tiba kira-kira satu jam sebelum Tom sampai di sana.",
  ),
  (Zlm, Medium, [992021], "Saya telah digigit nyamuk di seluruh tangan saya."),
  (Zlm, Medium, [10167100], "Si kembar itu akan dihukum kerana penipuan."),
  (Zlm, Medium, [10724978], "Saya telah terlepas satu lagi peluang."),
  (
    Zlm,
    Medium,
    [1230473],
    "Negara itu adalah lima kali lebih besar daripada Jepun.",
  ),
  (Zlm, Medium, [9709013], "Tom keluar dari bilik air dan pakai baju."),
  (Zlm, Medium, [10973382], "Adakah anda mengambil gula bersama kopi?"),
  (
    Zlm,
    Medium,
    [13859195],
    "Saya berada di pekan sewaktu berlaku angin kencang itu.",
  ),
  (
    Zlm,
    Medium,
    [2391743],
    "Kenapa karangan awak ada terlalu banyak kesalahan tatabahasa?",
  ),
  (
    Zlm,
    Medium,
    [9695714],
    "Dia berpendapat bahawa lagu itu terlalu lapuk untuk dinyanyikan pada masa kini.",
  ),
  (
    Zlm,
    Medium,
    [5126005],
    "Sebelum ini saya terlihat orang itu, melainkan saya tersilap pun.",
  ),
  (Zlm, Medium, [11518733], "Kenapalah aku tak ambik cuti hari tu."),
  (Zlm, Medium, [10120905], "Saya akan membelikan untuk awak esok."),
  (
    Zlm,
    Medium,
    [10723499],
    "Saya merasakan saya tidak berminat untuk melakukannya.",
  ),
  (Zlm, Medium, [11020621], "Dia kelihatan seolah-olah dia akan sakit."),
  (Zlm, Medium, [10156631], "Kami sedang menyemak peti surat kami."),
  (Zlm, Medium, [971815], "Dia seperti katak di bawah tempurung."),
  (
    Zlm,
    Medium,
    [10586427],
    "Untuk mengusahakan ingatan anda adalah perlu untuk maju.",
  ),
  (Zlm, Medium, [10724939], "Aku tak sangka dia pandai menyanyi."),
  (Zlm, Medium, [10690008], "Aku tak pedulik sapa yang start dulu."),
  (
    Zlm,
    Medium,
    [9709054],
    "Saya tidak pernah menyangka ia akan berakhir seperti ini.",
  ),
  (Zlm, Medium, [9708934], "Tarikh tutup nak hantar benda tu dah habis."),
  (Zlm, Medium, [8670965], "Tom bercakap dengan paderi selama dua jam."),
  (Zlm, Medium, [960836], "Saya menafikan kesemua tuduhan-tuduhan itu."),
  (Zlm, Medium, [10723511], "Kami tidak berbuat apa-apa pun."),
  (
    Zlm,
    Medium,
    [10100152],
    "Kita akan berpesta apabila tiba hari perkahwinan kamu.",
  ),
  (Zlm, Medium, [5145810], "Saya dimaklumkan kepada dia kedatangannya."),
  (Zlm, Medium, [5894493], "Kesihatan badan saya saja penting bagi saya."),
  (Zlm, Medium, [4839683], "Tom semakin baik sedikit demi sedikit."),
  (
    Zlm,
    Medium,
    [8749364],
    "Awak selalu mengatakan bahawa awak ingin menjadi seorang saintis. Kenapa tidak?",
  ),
  (
    Zlm,
    Long,
    [961948, 8890241, 11368215],
    "Antara 1820 dan 1973, Amerika Syarikat telah menerima lebih daripada 46 juta pendatang. Dia tinggal di sebuah pangsapuri. Bila dah basuh baru rasa selesa sikit nak pakai.",
  ),
  (
    Zlm,
    Long,
    [9709173, 10787014, 9136513],
    "Saya sentiasa menuruti arahannya. Aku pun terkejut macam Tom jugak. Dalam kamus seperti ini mesti ada sekurang-kurangnya dua ayat dengan \"peti sejuk\".",
  ),
  (
    Zlm,
    Long,
    [9724628, 5894511, 2912814, 8247109, 11074654],
    "Kalau Mary tau mesti dia marah. Denda kematian ini seharusnya dihapuskan. Adakah kamu tahu tentang Singapura? Saya tidak akan membohongi padanya. Saya mempunyai hak untuk menyatakan pendapat saya!",
  ),
  (
    Zlm,
    Long,
    [2391775, 9700496, 10657756, 960939],
    "Tangga ini diperbuat daripada kayu jati. Saya harap Tom tidak terbeban dengan perkara itu. Saya menghargai hasil kerja awak. Kita mesti mementingkan untuk menjaga warisan-warisan kebangsaan kita.",
  ),
  (
    Zlm,
    Long,
    [10171674, 984789, 13840331, 10656053],
    "Sangat menyenangkan untuk membungkus gelembung pop. Kami telah tiba di sini dengan selamat semalam. Anak-anak Pauline semuanya peramah. Patutnya Tom datang petang ni, tapi tak nampak langsung batang hidung dia.",
  ),
  (
    Zlm,
    Long,
    [961121, 1825704],
    "Saya telah kehilangan jam saya, jadi sekarang saya perlu membeli satu yang lain. Atlanta, Georgia mempunyai salah satu daripada lapangan terbang tersibuk di dunia.",
  ),
  (
    Zlm,
    Long,
    [7776163, 9724724, 10304171],
    "Di sepanjang jalan itu dia berjalan sambil melihat jam di tangan. Mary boleh mendengar suara Tom, namun dia tidak boleh melihatnya. Cemburu tidak sama dengan perasaan dengki. Jangan mengelirukan kedua-duanya. Ada perbezaannya.",
  ),
  (
    Zlm,
    Long,
    [8749355, 10841163, 11368210],
    "Saya tidak pasti berapa saiz yang dia memakai. Lugansk dan Donetsk mengisytiharkan kemerdekaan daripada Ukraine. Rasa macam ada ulat merayap kat kulit.",
  ),
  (
    Zlm,
    Long,
    [5200262, 10656086, 9193245, 11187907],
    "Emak menggoreng ikan untuk makan malam. Saya tidak pernah melihat gajah sebenar. Dia sedang menaiki kapal kecil di atas air. Tak la, saja letak gambar tu buat kenangan.",
  ),
  (
    Zlm,
    Long,
    [5680818, 1403402],
    "Sebentar lagi, di teater yang megah, semua lampu akan terpadam dan pentas akan ditinggalkan hanya untuk hantu-hantu Pulau itu adalah panas sepanjang tahun.",
  ),
  (
    Zlm,
    Long,
    [1267502, 10677754, 10784311, 5894476],
    "Saya ke perpustakaan untuk membaca buku. Ramai gak orang Amerika suka sushi. Tom nak belajar bahasa Perancis dengan Mary. Saya mempunyai idea yang menentang dia punya idea.",
  ),
  (
    Zlm,
    Long,
    [10761991, 10903313, 10690050, 10678798],
    "Dia telah meninggalkan beberapa buku kepada saya. Saya paling tidak suka matematik. Adakah awak ingin menjadi terkenal? Saya tidak tahu bagaimana saya sampai ke rumah.",
  ),
  (
    Zlm,
    Long,
    [5118509, 9031108, 9117317, 10726200],
    "Awak tau tak macamana nak gunakan kamera ni? Berapakah bilangan bandar di Montana? Bandar itu adalah pusat industri keluli. Benda tu takkan tahan lebih dari tiga minit.",
  ),
  (
    Zlm,
    Long,
    [10260923, 10784361, 10655114, 13859247],
    "Adakah anda menikmati menyanyikan lagu-lagu Krismas? Kitorang rasa bagus idea tu. Tom gantung kot dia kat penyangkut baju. Saya santai kat sini lah wei.",
  ),
  (
    Zlm,
    Long,
    [9689106, 9177555, 8653023, 10727803],
    "Tom mesti gembira kalau kau buat camtu. Tom tidak mengenali Mary atau John. Saya fikir awak panik. Ia tiada kaitan sama ada awak menyukainya ataupun tidak.",
  ),
  (
    Zlm,
    Long,
    [10301845, 10729766, 9128984, 10778280],
    "Sudah sehari pun awak belum bermula! Tak lama lagi dah masuk musim hujan. Dia menterjemahkan buku dari bahasa Jepun ke bahasa Inggeris. Tom memiliki ramai kawan di Australia.",
  ),
  (
    Zlm,
    Long,
    [8281109, 9709005, 9779302, 10729114],
    "Saya ingin tahu si Tom buat apa disini. Tom berpendapat bahawa Mary seorang yang hebat. Kamu tengokkah apa yang berlaku semalam? Tom tidak tahu yang beliau tidak mempunyai wang yang mencukupi.",
  ),
  (
    Zlm,
    Long,
    [10761186, 10301861, 5001998, 8223078, 10139200],
    "Adakah kita patut berkata sesuatu? Lajunya kerita kamu. Dia telah pergi ke Switzerland. Adakah anda pernah membakar kot anda dengan sebatang rokok? Pastikan anda membaca ini jika anda ingin mempelajari bahasa Kadazan.",
  ),
  (
    Zlm,
    Long,
    [10690015, 10666274, 9695770, 8281102],
    "Saya tidak peduli siapa yang memulakannya. Tom cakap dia tak kisah pasal cuaca panas tu. Mary pernah buat camtu kan? Saya menghairankan mengapa si Tom memandangi saya.",
  ),
  (
    Zlm,
    Long,
    [10688608, 8943288, 11373292],
    "Tom tak tau apa nak belikan Mary untuk birthday dia. Setiausaha anda berkata untuk masuk. Tak bagi cuti pun satu hal, ni dah bagi cuti pun satu hal jugak.",
  ),
  (
    Zlm,
    Long,
    [9620997, 10730588, 8600389, 11029268],
    "Banyak kerja saya ini. Pernahkah kamu berucap dalam bahasa Perancis sebelum ini? Pakcik saya membawa saya untuk menaiki di kawasan luar bandar. Tom tu bukan pembantu aku.",
  ),
  (
    Zlm,
    Long,
    [5931162, 6404433, 10657769],
    "Kita dilahirkan ke dunia ini atas sebab-sebab. Saya berhasrat untuk mengambil kedudukan saya sebagai pihak ketiga. Masalahnya ialah kita tidak memiliki makanan yang mencukupi.",
  ),
  (
    Zlm,
    Long,
    [9700610, 3936697, 11969086, 1923820],
    "Tom yang sepatutnya melakukan perkara itu untuk kita. Saya akan cuba cari mereka. Jangan lupa beritahu Tom itu. Bahasa Melayu sudah terbukti berperanan sebagai bahasa ilmu sejak dahulu lagi.",
  ),
  (
    Zlm,
    Long,
    [10656042, 11368274, 8239273, 2391752, 9739214],
    "Aku belum sedia nak buat benda tu. Kau nak bohong kemain. Percutian musim panas bermula Isnin depan. Matahari mula memancarkan sinarnya. Tom sudah tahu membaca.",
  ),
  (
    Zlm,
    Long,
    [10175898, 2391769, 10139314, 9708965],
    "Lepas sekolah buat apa? Abang Long sedang bermain di halaman rumah. Tom memakai topi berbulu lebar. Kedua-dua Tom dan Mary berjanji yang mereka akan sempat sampai ke parti itu.",
  ),
  (
    Zlm,
    Long,
    [10784313, 10789969, 661230, 7776226],
    "Aku suruh Tom pakai tie. Kau rasa Tom memang akan balik rumah hari Isnin ke? Dia merupakan rakan sekelas saya. Dia telah mengaku bahawa dia telah bersilap.",
  ),
  (
    Zlm,
    Long,
    [10873488, 11082846],
    "Jika anda memenangi sepuluh juta dolar dalam loteri, apakah yang akan anda lakukan dengan wang itu? Saya sentiasa menaiki basikal untuk pergi ke sekolah.",
  ),
  (
    Zlm,
    Long,
    [11029263, 10730606, 10655096, 962282, 10156184],
    "Birthday dia, dia nak jam. Tom berkata bahawa Mary tidak pernah ditangkap. Tom meninggalkan Mary bersama John. Bapa saya mencintai ibu saya. كاو ڤاتوت باليق سكارڠ.",
  ),
  (
    Zlm,
    Long,
    [10729113, 10126117, 10887757, 11376581, 10503302],
    "Itulah sebab kami berpindah dari Boston. ماس دڤن الڬيريا چره. Filem ini sesuai untuk kanak-kanak. Sedar tak sedar dah bulan Disember. ايوه، ماري كيت مولاكن ڤرستروان كيت!",
  ),
  (
    Zlm,
    Long,
    [9714133, 7776224, 9689172],
    "Sepatutnya dia telah kembali selepas makan tengahari. Saya tidak fikir bahawa Tom berasa malu. Algeria sedang menarik banyak syarikat-syarikat dari China.",
  ),
]

///|
let rows_ibo : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Ibo, Short, [6789594], "Mu na ndi be Tomu ahubeghi."),
  (Ibo, Short, [6789583], "I wepuru ahihia ahu?"),
  (Ibo, Short, [6789597], "Ikwukwara Ihe meru?"),
  (Ibo, Short, [13282319], "Ee! Kedu aha gị?"),
  (Ibo, Short, [6789584], "Gwagodi Tomu ka-obata n'ime?"),
  (Ibo, Short, [6789592], "Enwerem ike iju gi ajuju ozo?"),
  (Ibo, Short, [6789595], "Akam ahubeghi ndi be Tomu."),
  (Ibo, Short, [10473298], "A chọbụrụ m ịchete."),
  (Ibo, Short, [8853390], "Ka emesịa!"),
  (Ibo, Short, [6789587], "Tomu na Mari akpara Ihe ahu?"),
  (Ibo, Short, [11497845], "Ị̀ na-asụ Bekee?"),
  (Ibo, Short, [3610765], "Ana m ele anya ya."),
  (Ibo, Short, [6789607], "Obu n'imaburo maka ihea?"),
  (Ibo, Short, [5327630], "Mbe enweghị ezé."),
  (Ibo, Short, [13288582], "Gịnị ka njakịrị a pụtara?"),
  (Ibo, Short, [13282303], "Welie olu gị."),
  (Ibo, Short, [6789586], "I na-akwado Iga ebe ahu?"),
  (Ibo, Short, [13282294], "Kedu onye nọ ebe ahụ?"),
  (
    Ibo,
    Medium,
    [13282300],
    "Ihe kasị enye nsogbu bụ nrụrụ aka nke ndị kasị mma.",
  ),
  (Ibo, Medium, [6789585], "I nwere Ike Igwa Tomu ka-obata n'ime?"),
  (Ibo, Medium, [6789605], "Mu na Tomu enwere Ike ikwu maka ihea?"),
  (Ibo, Medium, [6789602], "I tinyere ihe na-asa efere ka obido."),
  (
    Ibo,
    Medium,
    [13282301],
    "O nwere mmetụta dịpụrụ adịpụ site na nke e bu n'obi.",
  ),
  (Ibo, Medium, [6789601], "Amam na Tomu choro ka mu na ya kwo."),
  (Ibo, Medium, [6789596], "Amam na Tomu na-aruru Meri Oru."),
  (Ibo, Medium, [6789599], "Amam na Tomu choro ka mu na ya kpa."),
  (
    Ibo,
    Medium,
    [13282307],
    "N'ihi ya, ọ ga-amụta ihe niile na anyị nwere ike izute obere oge.",
  ),
  (Ibo, Medium, [13282316], "Sami ahụbeghị Layla ruo mgbe ebighị ebi."),
  (Ibo, Medium, [13282317], "Biko nyefee m mkpịsị akwụkwọ ahụ."),
  (Ibo, Medium, [6789598], "Amam na Tomu choro igwa m okwu."),
  (Ibo, Medium, [13282314], "Anyị ghọrọ enyi mgbe m nọ na Taiwan."),
  (Ibo, Medium, [6789591], "Ihuru mgbe Tomu bara n'me ugbo ala ahu?"),
  (
    Ibo,
    Medium,
    [13293476],
    "Idem ama enyek enye tutu enye efehe ọkpọn̄ ukot.",
  ),
  (Ibo, Medium, [10799965], "Amara ihe nke ukwu na agaghịm eme ihe dị otua"),
  (Ibo, Medium, [6789589], "Enwere m ike ibiri gi diksonari a?"),
]

///|
let rows_ceb : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Ceb, Short, [4674588], "Pahulama ra kog kutchilyo."),
  (Ceb, Short, [14037092], "Murag buotan nga tawo si Ken."),
  (Ceb, Short, [4687864], "Susmarusep!"),
  (Ceb, Short, [10939501], "Bakakon gyud ni si Tom o!"),
  (Ceb, Short, [5701988], "Hapit na ang tingtugnaw."),
  (Ceb, Short, [4630442], "Lolo nimo!"),
  (Ceb, Short, [5423603], "Nagbantay ko sa mga tawo."),
  (Ceb, Short, [4737080], "Unsa nang taknaa?"),
  (Ceb, Short, [4630456], "Gikapoy ko."),
  (Ceb, Short, [4685141], "Ayaw og saba ni Joana ha."),
  (Ceb, Short, [6195495], "Giunsa ba nimo pagsakay dinhi?"),
  (Ceb, Short, [4674691], "Mogahi ang lawas inigkamatay."),
  (Ceb, Short, [4722354], "Anus-a gud na nimo humana?"),
  (Ceb, Short, [4680788], "Modagan na."),
  (Ceb, Short, [4633372], "Hapit intawon namo."),
  (Ceb, Short, [14008374], "Walay imbestigasyon."),
  (Ceb, Short, [14007405], "Inig hawa nimo, niabot sila."),
  (Ceb, Short, [4701597], "Inadlaw maligo ko."),
  (Ceb, Short, [4702351], "Daw bi pakit-a ko sa imoha."),
  (Ceb, Short, [4697760], "Taga Davao ko."),
  (Ceb, Short, [4701248], "Basa pa ang habol."),
  (Ceb, Short, [4708458], "Gisikop siya."),
  (Ceb, Short, [4680782], "Modagan ri."),
  (Ceb, Short, [4680823], "Modagan tong tawo."),
  (Ceb, Short, [4815838], "Ambot lang."),
  (Ceb, Short, [4690606], "Unsa, moadto ba ta ug dili?"),
  (Ceb, Short, [4633343], "Hunong diha palihog."),
  (Ceb, Short, [6135235], "Nag-uban sila magbakasyon."),
  (Ceb, Short, [4735639], "Kinsay gawasan nimo sa bir?"),
  (Ceb, Short, [4877890], "Nagkahushos ang iyang sayal."),
  (Ceb, Medium, [4705994], "Nahurot jud og kaguba ang balay ni Tom."),
  (Ceb, Medium, [4674702], "Nakatilawan mo na ba ning putahe-a?"),
  (Ceb, Medium, [8873486], "Asa nimo napalit nang sanina-a?"),
  (Ceb, Medium, [11315183], "Nibyahe dayon among eroplano eksakto alas sais."),
  (Ceb, Medium, [14060221], "Gasarado ang tindahan sa Domingo."),
  (
    Ceb,
    Medium,
    [14060219],
    "Salikway ang ilahang gina-ingon sa ilang gina-bati.",
  ),
  (
    Ceb,
    Medium,
    [4643703],
    "Buot ni Tom masayran ni Mary nga wala siyay kaitok niini.",
  ),
  (Ceb, Medium, [4687667], "Sa kaadlawon moadto ko sa dagat."),
  (
    Ceb,
    Medium,
    [4683583],
    "Kun moabot sila, hatagi sila ug pagkaon pero dili kuarta!",
  ),
  (Ceb, Medium, [14010612], "Paunsa nato ni mahuman hangtod Lunes?"),
  (
    Ceb,
    Medium,
    [4690595],
    "Dili ni ingon sa pag-unsa nimo, pero tinuod giyud na.",
  ),
  (Ceb, Medium, [14052008], "Dili siya kabalo mag-Ininglish, diba?"),
  (Ceb, Medium, [6830002], "Kahilakon siya pagkadungog niya sa balita."),
  (Ceb, Medium, [4638750], "Pagkaanindot sa akong gitahing kurtina."),
  (Ceb, Medium, [4726896], "Nahurot jud kaguba ang kang Tom nga balay."),
  (
    Ceb,
    Medium,
    [14061597],
    "Dili na yata ta kinahanglan mo-adto sa miting sa Lunes.",
  ),
  (
    Ceb,
    Medium,
    [10939541],
    "Gihatag nako ang akong phone number sa akong amigo.",
  ),
  (Ceb, Medium, [4738486], "Naglaway ang hubog nga matulog."),
  (Ceb, Medium, [4625889], "Sagad sa Kano, dagkong sakyanay ganahan."),
  (
    Ceb,
    Medium,
    [4680786],
    "Usahay naghunahuna ko, naay tawo nga stupido mora'g ngitngit sa tungang-gabii.",
  ),
  (Ceb, Medium, [14021093], "Malay nako unsay ginakaon ni Tom."),
  (Ceb, Medium, [14034327], "Dili ganahan ang tanan sa siyudad kanako."),
  (Ceb, Medium, [4695992], "Nagpanombag ko sa bungbong sa kapungot."),
  (Ceb, Medium, [4669895], "Motulo ka tuig nang nagtuon si Tom og French."),
  (Ceb, Medium, [4733267], "Duna koy higala nga nagpuyo sa Boston."),
  (Ceb, Medium, [14060210], "Inig uli nako, natulog na sila Tom ug Mary."),
  (Ceb, Medium, [4629823], "Kinahanglan may buhaton si Tom."),
  (Ceb, Medium, [11344847], "Gidaro ni Domeng ang iyang basakan."),
  (Ceb, Medium, [14010625], "Kaestorya ko lang sa mga doktor ni Tom."),
  (
    Ceb,
    Medium,
    [6461411],
    "Natukmod ko niya dili tungod sa pagdumot kundili sa kakuyaw.",
  ),
  (
    Ceb,
    Long,
    [4688187, 5081299, 14061618, 4677370],
    "Thilo Sarrazin man ang tagsulat sa librong nakapalagot sa mga politiko sa Alemanya. Laay kaayo ning wa tay buhat. Nagtindog ang tanan. Mogamit ko nimog singko pesos.",
  ),
  (
    Ceb,
    Long,
    [8637470, 4701954, 5195097, 14030253, 4696028, 4669350],
    "Wala ko kahibalo ngano. Napuno ba mog trabaho? Kamoy bida karong semanaha. Wala nigamay ang pantalon. Inyo ba diay nang otangon? Ayaw pagpakabuang diha!",
  ),
  (
    Ceb,
    Long,
    [6195500, 4703737, 4776586, 4680826],
    "Mahimsog sa panglawas sa tawo. Giunsa nimo pagkahagbong sa lim-aw? May mitukmod nako. Gipaburosan si Rosi pagpayaya sa kastilyo. Modagan ning mga tawo.",
  ),
  (
    Ceb,
    Long,
    [10939515, 4715152, 5638588],
    "Nagpadala ko gahapon og sulat sa akong mama. Binuang ang pagpakamatay tungod sa kahadlok sa mga migrante. Dili gihapon niini ginasolusyunan ang problema.",
  ),
  (
    Ceb,
    Long,
    [4767321, 4702356, 5423652, 4737457],
    "Uy Rosi, nakalimot ka og butonis sa imong blusa. Pakit-a ra ko sa imong pasaporte. Magtiwas ko sa akong trabaho aron mahuman dayon. Kinsa na man naghimo kanang kahon?",
  ),
  (
    Ceb,
    Long,
    [14019519, 10939580],
    "Ang quantum communication gitan-aw ingon nga usa ka bag-ong teknolohiya alang sa pagpanalipod sa impormasyon. Mag-search sa diay ka bag-o ka mangutana sa uban?",
  ),
  (
    Ceb,
    Long,
    [14022592, 4701976, 8637465, 4638754],
    "Hapit ko natuk-an inig nadunggan nako ang pito. Kinsa man to si Mona Lisa? Si Tom nag-ingon nga gikapoy kaayo si Mary. Nabasa ang akong hinalay kay miulan ug kalit.",
  ),
  (
    Ceb,
    Long,
    [4702353, 11315079, 4841160, 4702533],
    "Kon buot ka, hala layas karon dayon! Kasagaran sa mga tao mutuo sa tanang isulti sa pamantalaan. Natapun-ogan sa mga buluhaton. Dinhay mga tawo gahapon sa among balay.",
  ),
  (
    Ceb,
    Long,
    [4699847, 4669303, 4740926, 4735619, 4733450],
    "Paliti ko duha ka kaha sa bir! Namuga ang mga prisu kay natulog ang bantay. Talagsa makahilak ko, kun magbasa ug libro. Hinginum ang palainum. Nagtimbang si Orlando og mga usa ka gatos og kaupatan ka kilo.",
  ),
  (
    Ceb,
    Long,
    [4720148, 4737089, 4702347],
    "Sa kataposan sa hapon, si Maria nakakita nga ang sapa nga nagdagan duol sa ilang lugar. Hinginom si Pedro, apan utokan siya ug buotan. Dili ko mokaon og karne.",
  ),
  (
    Ceb,
    Long,
    [4669342, 5423621, 4719661, 8663735, 11344905],
    "Kalipay nga bantuk sa dughan. Kun makita niya ang trak igawas niya ang basura. Unsang matamga ni sa bino? Iyang gihatag tanan iyahang kwarta. Nakamata ko sa tungang gabii kay nagsigeg paghot ang iro.",
  ),
  (
    Ceb,
    Long,
    [4737377, 4687496, 10939535, 4734165, 4699863],
    "Ang iro ni Tom mihasmag kanako. Kusogkusoga ra pagsulti. Porbaha gud og gunit. Humok kaayo. Ang buhatan ni Rosi sa pampaman. Nakahibalo ko, kana ang sinugdanan sa kataposan.",
  ),
  (
    Ceb,
    Long,
    [14021102, 4669357, 4629826, 14010631],
    "Kaila nako si Tom sa tibuok niyang kinabuhi. Ayaw kog binuangi, ha! Nakahukom si Tom nga magpaabot. \"Ngano hadlok kaayo si Tom sa imo?\" \"Wala ko kabalo.\"",
  ),
  (
    Ceb,
    Long,
    [4699800, 4703718, 4702370, 14030247, 4629866],
    "Hinaut pa nga Diyos nagapanalangin kaninyo! Gihilantan karong hapon ang pasyente. Wala sila kabalo nga Hapon ko. Gusto kog bag-ong iro. Nadato si Tom nga iya rang paningkamot.",
  ),
  (
    Ceb,
    Long,
    [4737100, 4630182, 14010615, 11368611, 4738985],
    "Makahilak kong mahinumdom sa baryo ko sa bukid. \"Salamat.\" \"Walay sapayan.\" Ngano dali man kaayo ka? Kinahanglan nako mag-tuon ug Hinapon. Bisag diin sila miadto ang ilang regalo sa mga nasod, katalagman ug pag-antos.",
  ),
  (
    Ceb,
    Long,
    [4702506, 14060211, 11346707, 4735621, 14037089],
    "Dili moari ang amahan ug inahan mo no? Unsay orasa ka niadto sa sine? Kasabot ko sa mga lagda. Gisultihan ko ni Pedro nga palahubog siya. Wala niya gipaila iyahang kaugalingon kang Duterte.",
  ),
  (
    Ceb,
    Long,
    [4776406, 4669307, 4728013, 14026110],
    "Dili matuohan ang amaw sa pipila politiko. Ibantay ko ug taksi! Dihay mga punoan og seregwelas tapad sa tubod didto sa kastilyo. Nanghinaut kami nga molungtad ang kagawasan ug kalinaw.",
  ),
  (
    Ceb,
    Long,
    [10939581, 4719652, 6102809, 4692933, 4668669],
    "Nagsindi si Tom og posporo. Puno pa karon sa trabaho si Tom, unya pa ka niya matagad. Gikawatan ko niya'g kwarta. Nia siya dinhi sa eskwelahan. Gipakababoy lang ko nimo.",
  ),
  (
    Ceb,
    Long,
    [8658870, 4703765, 11340865, 4680815, 4703727],
    "Nagsuwat si Tom sa iyang ngalan sa blakbord. Unsang orasa diay ka sagad mogikan sa iinyoha? Wa koy kinahanglan karon. Modagan nang tawhana. Nangatagak ang kadahonan.",
  ),
  (
    Ceb,
    Long,
    [4703745, 4687521, 10939403, 4675251],
    "Kinahanglan jud mauli sa balay karong gabhiona sa dili pa kaayo ngitngit. Ayaw pagpaspas ug sulti. Unsa'y buot pasabot nimo? Kon lemosito ang anaa, himoa kining lemonada.",
  ),
  (
    Ceb,
    Long,
    [4703858, 11316436, 4733445],
    "Gisukna ko siya kon napuno ba siyag trabahoon. Ang pugon sa balay murag palyado karong adlawa. Nabughat ang babaye, kay nagkaun siya'g karne sa kabaw.",
  ),
  (
    Ceb,
    Long,
    [4702378, 11461973, 4797494, 14008412, 14018773],
    "Plamuot jud ni si Mr. Bean. Maglisod ko pagbuhat niana. Kanang bataa mosiyagit dayon kon dili tagaan sa gusto. Unsa nang nagasaba-saba? Wala nay mabuhat ang doktor sa ospital kang Tom, mao na mouli lang siya.",
  ),
  (
    Ceb,
    Long,
    [4701921, 4702358, 4650846, 4956103, 5172700],
    "Misulod si Tom sa kwarto. Nasayod si Tom kinsay uyab ni Maria. Dili kinaiyanhon ang makaluksaw nga ulan. Ingna ko kun si Rosi motawag. Imong giluwas ang bata sa balay nga nasunog.",
  ),
  (
    Ceb,
    Long,
    [4740019, 4680465, 4703710, 4956825, 14037084],
    "Atong buhaton karon ang ugma Molad-uk lang siyag kapi dayong adtos trabaho. Hain ang akong antyohos? Nanganak si Rosi sa miaging semana Walay nagtawag kaniya.",
  ),
  (
    Ceb,
    Long,
    [4690085, 4772670, 4700168, 4733250, 4662409],
    "Unsa pay but-on nimo? Nakitan ka nako nga naghilak sa ulan. Og masad-an ka, ipapriso ka. Ganahan si Tom sa pagkaun ng Bombay. Ikapilang presidente sa Pilipinas si PNoy?",
  ),
  (
    Ceb,
    Long,
    [4710263, 4680696, 4633369, 10939565],
    "Naam-am ko pag-ingon sa magtutudlo nga tapulan kaayo ko. Tamdon ko ang tanan imong pagmando. Ibaligya intawon na ngari nako. Nag-absent ko sa eskwelahan kay nagsakit ko.",
  ),
  (
    Ceb,
    Long,
    [4668695, 4674525, 4702363, 4705895, 11344986],
    "Nagbayang sa ulan ang mga bata. Gabii na kaayo siyang mibalik sa balay. Dili baya ngil-ad mangihing magpungko. Nagrambol ang magtiayon. Lami ang pamahaw nga naay sikwate ug buwad.",
  ),
  (
    Ceb,
    Long,
    [4702361, 4715138, 4690485, 11360635, 4680800],
    "Nakita ko ang akong inahan nga mitipig sa torta. Migilok ang akong ilong. Bisitahan ko sa akong uyab matag adlaw. Mao ba nay giingon nimo niya? Modagan to si Joseph.",
  ),
  (
    Ceb,
    Long,
    [14025490, 6195493, 4733271, 11368551],
    "Ibutang/I-post na imong hulagway/pikchur sa bungbong. I-unsa man nimo ang kwarta? Tigulang kaayo si Tom. Wala koy labot kung unsa man ang gikaon ni Tom.",
  ),
  (
    Ceb,
    Long,
    [3626659, 4680476, 4629759, 14010614, 4650855],
    "Kinahanglan ko moadto sa kasilyas. Sa usa ka lag-ab mahurot nako ang usa ka baso. Kuli ra nang mahitabo. Ayaw itabok ning dalana samtang gaulan pa. Milibotlibot ang kweti sa bulan.",
  ),
]

///|
let rows_tgl : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Tgl, Short, [11468611], "Iunat mo ang mga binti mo."),
  (Tgl, Short, [11806913], "Delikado ang mga taong iyon."),
  (Tgl, Short, [11555367], "Ayaw mo ba silang makita?"),
  (Tgl, Short, [11895649], "Tingnan mo ang mga bulsa mo!"),
  (Tgl, Short, [11725672], "Napaiyak ako niyan."),
  (Tgl, Short, [11675161], "Nakakain ko ang karne."),
  (Tgl, Short, [11533146], "Baka umulan sa hapon."),
  (Tgl, Short, [8719265], "Paano ka napunta dito?"),
  (Tgl, Short, [11731623], "Protektahan mo ang sarili mo."),
  (Tgl, Short, [11394701], "Nag-eespiya ka ba sa akin?"),
  (Tgl, Short, [11895582], "Kumakain po ba kayo ng karne?"),
  (Tgl, Short, [11708540], "Dilaw ang panyo niya."),
  (Tgl, Short, [11659862], "Mahilig talaga ako sa bawang."),
  (Tgl, Short, [4560115], "Matangkad si Mary."),
  (Tgl, Short, [11403864], "Hinihintay namin si Tom."),
  (Tgl, Short, [11601351], "Napakamapagkumbaba po ni Tom."),
  (Tgl, Short, [11606341], "Natengga ang proyekto."),
  (Tgl, Short, [11716127], "Magbabawas ako ng timbang."),
  (Tgl, Short, [1357445], "Bumaba ka at maghinaw."),
  (Tgl, Short, [4650504], "Masarap ang saging."),
  (Tgl, Short, [11731275], "Hindi po Tom ang pangalan ko."),
  (Tgl, Short, [11564168], "Nanigarilyo si Tom."),
  (Tgl, Short, [11573110], "Papunta sila sa ospital."),
  (Tgl, Short, [1361255], "Pakiulit ba niyan?"),
  (Tgl, Short, [5361122], "Kay Tony ang aklat na ito."),
  (Tgl, Short, [11447315], "May isa akong hiling."),
  (Tgl, Short, [2280998], "Namula siya sa kahihiyan."),
  (Tgl, Short, [11643084], "Maingat po ako."),
  (Tgl, Short, [8656267], "Mukhang pagod na pagod si Tom."),
  (Tgl, Short, [12173703], "Umabante ang kotse."),
  (Tgl, Medium, [11655244], "Napakaasim ng lasa ng suhang ito."),
  (Tgl, Medium, [11788890], "Ang lambot po nitong karne ng baka."),
  (Tgl, Medium, [11577579], "Dumapo ang ibon sa likod ng unikorniyo."),
  (Tgl, Medium, [11487323], "Ano ba ang sinabi ko sa iyong gawin mo?"),
  (Tgl, Medium, [11894056], "Dapat po ba nating palitan ang bandera?"),
  (Tgl, Medium, [11446623], "May mga espesyal na abilidad si Tom."),
  (Tgl, Medium, [11403411], "Huwag kang makipag-usap sa klase!"),
  (
    Tgl,
    Medium,
    [11708936],
    "Nangako ang kapulisan na aasikasuhin nila ang isyu.",
  ),
  (Tgl, Medium, [1614247], "Puwede ba tayong magsalita nang pribado?"),
  (Tgl, Medium, [11610746], "Kulang-kulang ang isinukli sa akin ng tindera."),
  (Tgl, Medium, [11448979], "Ayaw sa akin ng lahat dahil pangit ako."),
  (Tgl, Medium, [11453708], "Walang silbi ang pagsisikap mo."),
  (Tgl, Medium, [11273083], "Hindi nila tayo paniniwalaan kahit kailan."),
  (
    Tgl,
    Medium,
    [1619099],
    "Hindi niya masusundan ang mga yapak ng kanyang inapo.",
  ),
  (Tgl, Medium, [11597267], "Pareho po kaming nawalan ng balanse."),
  (Tgl, Medium, [11789435], "Gusto ko pang palamigin ang alak."),
  (
    Tgl,
    Medium,
    [3630111],
    "Nag-aaral si Jingjing ng eksobiyolohiya sa Unibersidad ng Sistemang Solar.",
  ),
  (Tgl, Medium, [11789649], "Ginagawa ko iyan mula sa simula."),
  (Tgl, Medium, [11858362], "Sobrang baba po ng tingin ko sa sarili ko."),
  (Tgl, Medium, [2280960], "Nag-taxi siya papunta sa museo."),
  (Tgl, Medium, [11811547], "Mayroon lang akong mga personal na gamit."),
  (Tgl, Medium, [1364096], "Pinakalalim na lawa ito sa Hapon."),
  (Tgl, Medium, [11532169], "Punong-puno ng luha ang mga mata niya."),
  (Tgl, Medium, [11809043], "Marunong din akong sumakay ng kabayo."),
  (Tgl, Medium, [11476857], "Siya ang bagong may-ari ng otel."),
  (
    Tgl,
    Medium,
    [13648025],
    "Binigay ni Mary sa akin ang kaniyang lumang kotse.",
  ),
  (Tgl, Medium, [11705565], "Pinaghatian po nating dalawa ang pera."),
  (Tgl, Medium, [5077251], "Nagluluto ng sisig at nilaga si Leo."),
  (Tgl, Medium, [11812111], "Masyado pong maanghang ang sabaw na ito."),
  (Tgl, Medium, [11270241], "May dalawang diksiyonaryo ng Pranses si Tom."),
  (
    Tgl,
    Long,
    [2783672, 11893939],
    "Ang sinabi mo ay nagpaalala sa akin ng isang kakaibang karanasan nang maraming taon ang nakalipas. Wala po akong kapitbahay na may apelyidong Maldonado.",
  ),
  (
    Tgl,
    Long,
    [12988876, 11643213, 11690236, 11548913],
    "Tumalon si Marie sa ilog mula sa bintana. Hindi ko payong ito. Iba ang may-ari nito. Nabili ko ang plumang ito sa Paris. Ang hirap namang sagutin ng tanong mo.",
  ),
  (
    Tgl,
    Long,
    [11805702, 8973841, 1361274, 11780067],
    "Wala akong oras para makipagkita sa iyo. Maraming laruan si Silvestre sa bahay niya. \"Parehong ideya,\" sabi ng kapitbahay. Puwede na kayong pumasok ngayon.",
  ),
  (
    Tgl,
    Long,
    [11659817, 11782524, 11516720, 11574825],
    "Kailangan ko lang pong magpahinga. Hindi ko po maalala kung sinong nagsabi niyan. Nahulog ang bata sa palaruan ng eskuwelahan. Ipakita ninyo sa akin ang inyo!",
  ),
  (
    Tgl,
    Long,
    [11731451, 11756261, 11417300, 11655118],
    "Malinis po ba ang kuwarto niyo? Hindi po naiiba ang sitwasyon ni Tom. Hinahanap ko ang mga kaibigan ko. Nagtatapos ang kuwento sa pagmamakaawa ni Tom.",
  ),
  (
    Tgl,
    Long,
    [11805982, 8653995, 11774561, 8636023],
    "Hindi ko po kayang ipaliwanag ang hindi ko naiintindihan. Bakit hindi ka pumasok? Ipinagbabaon si Tom ng nanay niya ng pagkain araw-araw. Paano ito maiiwasan?",
  ),
  (
    Tgl,
    Long,
    [2772565, 11453682, 3797489, 3856368],
    "Kalilipat lamang nila rito noong isang araw. Hindi siya marunong magbasa o magsulat. Wala namang kuwenta ang pag-aaral ng kanilang wika. Ano ba ang \"balimbing\" sa Ingles?",
  ),
  (
    Tgl,
    Long,
    [11755882, 1663290, 11869480, 11463338, 2747354],
    "Babalik po ako. Pangako ko po! Mas na mas na nagustuhan ko itong larawan. Kinaladkad ako ng dyip. Nakikinig siya habang nakapangalumbaba. Kailangan mong panatilihing maayos ang iyong silid-tulugan.",
  ),
  (
    Tgl,
    Long,
    [11394865, 3211649, 11501183, 11557577, 11527433],
    "Wala tayong masyadong bisita ngayong tag-init. Gusto naming bumoto. Nasa matinding panganib tayong lahat. Hinahanap niya ang sasakyan niya. Hindi mukhang kabado ang testigo nang tumestigo siya sa paglilitis.",
  ),
  (
    Tgl,
    Long,
    [11585005, 11640623, 11680302, 11893752, 11606233],
    "Masakit ang hinlalaki ng kanang paa ko. Ang hirap niyong paniwalaan. Kung walang wika, wala pong pag-iisip. Hindi po mailarawan ang kanyang ganda. Ano ba ang nakita ko? Si Mona Lisa po at ang Toreng Eiffel.",
  ),
  (
    Tgl,
    Long,
    [11394834, 11655107, 11460523, 11571483, 11683410],
    "Kumain tayo ng sorbetes sa labas. Binabawalan kitang umalis ng bahay. Ang pag-aaliw ay ang sanhi ng sakit. Ilang taon ka na bang nagbebenta ng kotse? Kapalaran namin ito.",
  ),
  (
    Tgl,
    Long,
    [4002584, 11756247, 11569982, 11659404],
    "Nag-ispageti si Ana sa restawran sa siyudad. Sa tingin ni Tom, nakatipid po siya nang malaki. Magsusulat ako tungkol diyan. Mahahaba po ang mga kuko ni Ziri at may mga laman-laman pa po ni Rima sa ilalim.",
  ),
  (
    Tgl,
    Long,
    [11586034, 11805669, 11780218, 11446392],
    "Naglagay tayo ng mga patibong para manghuli ng mga kuneho. Maaari ko po bang makita ang librong iyon? Saan po ba iyan ginagamit? Ang mga libro ay para sa mga taong gustong mapunta sa ibang lugar.",
  ),
  (
    Tgl,
    Long,
    [11751701, 11501177, 11481991, 11782698],
    "Alam ko ang tunog na ito. Inililibing ng mga Muslim ang kanilang mga patay sa libingan. Nakalimutan kong magsuot ng sinturon. Hindi ko nabasa ang text ninyo.",
  ),
  (
    Tgl,
    Long,
    [11858550, 13649568, 11902305, 2909264],
    "Bawal kang pumasok sa lugar na ito. Hindi pa rin puwede si Tom bumisita kay Mary. Gumagamit ng alambre para maghatid ng kuryente. Imbitado ako sa kanyang kasal.",
  ),
  (
    Tgl,
    Long,
    [2944816, 11394863, 11420855, 11725939],
    "Gustong lumabas ang aso ni Tom. Wala kaming masyadong bisita ngayong tag-init. Nakasara ang pinto mula sa loob. Kaya kong sabihin sa iyo kung saan mahahanap si Tom.",
  ),
  (
    Tgl,
    Long,
    [6390074, 11460745, 11811920, 2832062],
    "Nilalagyan ni Nestor ng sili ang nilulutong sopas. Hindi naman ganoon kataka-taka ang mga resulta. Puwede po ba akong magbayad gamit ang credit card? Higit na maikli ang kanyang hintuturo kaysa palasingsingan.",
  ),
  (
    Tgl,
    Long,
    [11743348, 11330303, 13752275, 11403258, 2104252],
    "Gagawa ba kayo ng estante? Mas malayo ang paaralan kaysa sa istasyon. Nabalitaan ko ang gantimpala sa inyo. May malaki kang utang sa akin. Magaling siyang maggitara.",
  ),
  (
    Tgl,
    Long,
    [11447821, 11773790, 13876945, 1850451, 11818583, 12988946],
    "May basag ang platong ito. Bumagsak po ako sa iksamen. Magkaiba ang mga bilang na ito. Sabi kong umalis siya sa silid. Gawin niyo nang dahan-dahan. Ayaw ni Yanni magkalat.",
  ),
  (
    Tgl,
    Long,
    [11447929, 11611010, 2941193, 11646334],
    "Mabilis tumubo ang balbas ko. Natutuwa ang mga bata kapag may karne ang ulam. Sino ang may gusto, pwedeng kumuha. Muntik na pong mahulog si Tom sa palanguyan.",
  ),
  (
    Tgl,
    Long,
    [11807451, 11330508, 11811394, 11586242],
    "Nag-aaway na naman sina ma at pa. Ikaw ba ang nangangalabit sa akin? Puwedeng magbago nang mabilis ang mga bagay. Hindi mo dapat tinatrato nang ganoon ang tauhan mo.",
  ),
  (
    Tgl,
    Long,
    [11806611, 11761989, 11395898, 11871712, 11571160],
    "Pinabayaan ni Tom ang kanyang mag-anak. Kailangan natin ng isa pang upuan. Hindi ganyan ang kulay ng watawat ng Pilipinas. Tumaas ang iskor ng lahat. Wala itong pinapatunayan.",
  ),
  (
    Tgl,
    Long,
    [11519032, 1340692, 11571328, 11876125],
    "Ang isang kadena ay kasinglakas lang ng pinakamahina nitong kawing. Sinabayan ko siya sa paglalakad. \"Okey ka lang ba?\" \"Oo, okey lang ang lahat.\" Maaari itong pakinabangan.",
  ),
  (
    Tgl,
    Long,
    [11299438, 11655638, 8638162, 11414795],
    "Sinabi sa akin ni Tom na nakahanda siya. Paano po kayo nasangkot? Asin ang inilagay ni Tom sa kape niya imbis na asukal. Hindi totoong marunong kang umawit.",
  ),
  (
    Tgl,
    Long,
    [11731391, 11523191, 7139448, 13758244, 5214101],
    "Ilang oras pa ang natitira? Baka may inililihim si Tom. Ang aking tiyuhin ay napakamayaman. Sinisiguro ko sa iyo na mayroon kaming pakialam. Maaaring umulan ngayong gabi.",
  ),
  (
    Tgl,
    Long,
    [11464149, 11887917, 1817564, 11788948],
    "Huwag ninyo silang sasaktan. Huhugasan mo ba ang mga plato? Ito'y daang pataas ng burol. Mahirap sabihin kung ano ang tunay na paniniwala ng isang politiko.",
  ),
  (
    Tgl,
    Long,
    [11680295, 11614745, 11714300],
    "Ipinapahayag natin ang mga saloobin natin sa pamamagitan ng mga salita. Ang sakit sa ulo ni Tom! Hindi niya ba ako puwedeng lubayan? Nasaan po ba ang sasakyan?",
  ),
  (
    Tgl,
    Long,
    [11612274, 11861581, 11378653],
    "Kapag nagpapalit ng gulong, kailangan ding palitan ang kabila sa parehong ehe. Hindi po pamangkin ni Mary si Tom. Pakiusapan ninyo si Tom na tumawag sa akin.",
  ),
  (
    Tgl,
    Long,
    [11546012, 11714048, 11484254],
    "Ano ang ginawa mo sa mga taong ito? Puwede kang maghintay sa akin dito. Parati ninyo pong iniisip ang ina ko. Alam po ninyong labis nang otsenta na siya.",
  ),
  (
    Tgl,
    Long,
    [11516886, 11797497, 11447869, 11522846, 11612296],
    "Ikaw ba ang nanalo sa karera? Nilabhan ko ang kamiseta ko. May narinig tayong putukan. Hindi ba natin iyan puwedeng pag-usapan nang mahinahon? Hindi ko po gusto ang keso.",
  ),
]

///|
let rows_hun : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Hun, Short, [7887863], "Túl pőrén öltöztél."),
  (Hun, Short, [7883675], "Köszönet az ízletes ételért."),
  (Hun, Short, [13909586], "Én mást szeretnék csinálni."),
  (Hun, Short, [13560252], "Nincs ehhez erőm."),
  (Hun, Short, [7745306], "Azt hittem, sosem hívsz."),
  (Hun, Short, [7881089], "Ez a dzseki jól áll."),
  (Hun, Short, [12097987], "Bedőlt a tőzsde."),
  (Hun, Short, [4288189], "Teszek rá!"),
  (Hun, Short, [2159990], "Vonattal mentem Kobéba."),
  (Hun, Short, [12132655], "Utálja a franciát."),
  (Hun, Short, [7060346], "Ki vitte el a számítógépemet?"),
  (Hun, Short, [6991779], "Szörnyen mérges voltam."),
  (Hun, Short, [10556162], "Miben segíthetek önnek?"),
  (Hun, Short, [5450234], "Visszaél a hatalmával."),
  (Hun, Short, [7167263], "Segítségre szorulsz."),
  (Hun, Short, [13063048], "Miért gondolod, hogy ez igaz?"),
  (Hun, Short, [5420456], "Csak egyszer élünk!"),
  (Hun, Short, [3866583], "Te aztán érted a dolgodat."),
  (Hun, Short, [8217607], "Egyedül vagy itt?"),
  (Hun, Short, [8276968], "A hűség kifizetődő."),
  (Hun, Short, [8393662], "Milyen állatokat tartasz?"),
  (Hun, Short, [4224555], "Ez nem fer."),
  (Hun, Short, [7847863], "Szeretem a piros rózsákat."),
  (Hun, Short, [11965658], "Kevesebbet érdemelnek ők."),
  (Hun, Short, [4725484], "Te is német vagy?"),
  (Hun, Short, [10978646], "Új kormány állt fel."),
  (Hun, Short, [10662734], "Nem megy neki a csapatmunka."),
  (Hun, Short, [7314773], "Lakat van az ajtón."),
  (Hun, Short, [4214469], "Nem értenek azok hozzá."),
  (Hun, Short, [8556223], "Ezek az ollók jól vágnak."),
  (
    Hun,
    Medium,
    [5667144],
    "Miről lehet órákon keresztül beszélni a telefonba?",
  ),
  (Hun, Medium, [4409505], "Apám figyelmeztetett az ilyen helyzetekre."),
  (Hun, Medium, [9991935], "Szeret beszélni a jelenlétünkben."),
  (Hun, Medium, [10220049], "Talán észre sem veszed a hozzám hasonlóakat?"),
  (Hun, Medium, [7330972], "Tudom, hogy meg tudom csinálni."),
  (
    Hun,
    Medium,
    [13276190],
    "Barátokat találni könnyű; megtartani nehéz őket.",
  ),
  (Hun, Medium, [10781550], "Van egy ablakhoz közeli asztaluk?"),
  (Hun, Medium, [4681583], "Na ezért vagy még mindig egyedül."),
  (
    Hun,
    Medium,
    [3114806],
    "Kölcsönöztem pénzt Marinak, hogy kifizesse a havi bérletet.",
  ),
  (
    Hun,
    Medium,
    [4183998],
    "Kivették a manduláit, mert túl gyakran gyulladtak be.",
  ),
  (
    Hun,
    Medium,
    [4984587],
    "Ugyanabban a pillanatban eszembe jutott a holnapi munka.",
  ),
  (Hun, Medium, [4843799], "Tom igazán nagyszerűen teljesít."),
  (
    Hun,
    Medium,
    [13942443],
    "A grófné elrejtett a szoknyája alá, amikor megjött a gróf.",
  ),
  (
    Hun,
    Medium,
    [4473734],
    "A szabados viselkedése néha udvariatlanságnak tűnik.",
  ),
  (Hun, Medium, [10586526], "Kibírod egyedül a most hétvégét?"),
  (Hun, Medium, [8383281], "Rosszul esett és lehorzsolta a könyökét."),
  (
    Hun,
    Medium,
    [5580117],
    "Amitől a legjobban félek, az az, hogy úgy halok majd meg, hogy nem éltem igazán.",
  ),
  (Hun, Medium, [4464024], "Mondja el pontosan, mit tett étkezés után!"),
  (Hun, Medium, [13784171], "Teljesen figyelmen kívül hagyott engem."),
  (
    Hun,
    Medium,
    [3848125],
    "Arra biztatlak, hogy írj neki egy köszönőlevelet.",
  ),
  (Hun, Medium, [5680561], "Karácsonyra vegyünk Tomnak valami hasznosat."),
  (
    Hun,
    Medium,
    [11724443],
    "Ez az oldal jó koncepció, de szar megvalósítás.",
  ),
  (
    Hun,
    Medium,
    [7889550],
    "Most nem tudom abbahagyni: benne van a kezemben az írás!",
  ),
  (Hun, Medium, [4406652], "A mondat végére pontot kell tenni."),
  (
    Hun,
    Medium,
    [13741501],
    "— Jó ez a mondat is? — Az én érzésem szerint nem.",
  ),
  (
    Hun,
    Medium,
    [5596471],
    "Akkor, ha én nem csinálom, nem lesz megcsinálva.",
  ),
  (Hun, Medium, [14030782], "Persze hogy fontos ez, de most van fontosabb."),
  (
    Hun,
    Medium,
    [5445831],
    "Istenem, add, hogy még egyszer láthassam Máriát mosolyogni!",
  ),
  (Hun, Medium, [10963951], "Mit tenne ő ebben a helyzetben?"),
  (Hun, Medium, [6860458], "Az ugye megvan, hogy ez provokáció?"),
  (
    Hun,
    Long,
    [5055379, 12708372],
    "Amit Tomi mondott, annak ellenére hogy ő egy hazudozó, annyira logikus, hogy csakis igaz lehet. Az új főnökasszony elég türelmetlen embernek tűnik. De mit tudok én róla? Hiszen csak néhány napja ismerem.",
  ),
  (
    Hun,
    Long,
    [819508, 7204454, 10474799],
    "Az esti szürkület előtt megérkezett a csorda a faluba. Tomi öreg járgánya végül kilehelte a lelkét. Sok külföldi jön azért Japánba, hogy japánt tanuljon.",
  ),
  (
    Hun,
    Long,
    [4429273, 12442385, 657837, 7881739],
    "Valami nem stimmel a motorral. Nem szeretem az automata kasszákat, sem a bankkártyás fizetést. Az építés magas összegbe került. Magatoknak kellene feltenni a kérdést, hogy miért.",
  ),
  (
    Hun,
    Long,
    [9990359, 8368981, 8516764, 5352767, 12302971, 8011106],
    "Mi lehetett ez vajon? A madarak jól látnak. Valóban szerettem őt. Vonattal utaztam Kiotóig. Tom ignorálja a valóságot. Ez egy olyan régi dal, hogy mindenki ismeri.",
  ),
  (
    Hun,
    Long,
    [8546585, 10086165],
    "Az a fura érzésem támadt, hogy mi már találkoztunk valamikor. A szúrós külső ellenére volt benne egy bizonyos gyengédség, ami őt olyan megnyerővé tette.",
  ),
  (
    Hun,
    Long,
    [6839893, 13822115, 3269236, 4672501, 12594127],
    "Én tudom, hogy igazad van. Trump csalással lett elnök: átbaszta a választóit. Nem olyan takarékos, mint egy dízeles. Hol van a svéd követség? Megint lehajtva hagytad a vécéülőkét!",
  ),
  (
    Hun,
    Long,
    [6561986, 11016928],
    "Én beírtam a határidőnaplómba, kérem, jegyezze fel ön is az időpontot a biztonság kedvéért. Egyesek attól tartanak, hogy a repülőgép a levegőben darabokra hullott, és a roncsokat talán soha nem találják meg.",
  ),
  (
    Hun,
    Long,
    [8910519, 5377759, 8500690, 10703431],
    "A vallása miatt kellett meghalnia. Ugyan, ugyan! Tudom, hogy úgysem fogod megtenni. Az iskola reggel 8:30-kor kezdődik. Csak kevesen képesek megérteni az elméleteit.",
  ),
  (
    Hun,
    Long,
    [10264809, 10524111, 8203165, 637911, 13813373],
    "Mit akarsz Tomival csinálni? A szobám a sertéstelepre néz. Mondtam neki, hogy itt jártál. Nem tudom, ki írta ezt a levelet. Hol van a sütim?” „Bocsi, mindet megettem.”",
  ),
  (
    Hun,
    Long,
    [4375166, 11243682, 10372260, 4420200, 2465634],
    "Az emléket a szívedből nem lehet elvenni. Becsuktad rendesen az ablakot? Ezek nem valami fennkölt gondolatok. Szeretnék együttműködni. Tejet öntött a teájába és megkeverte.",
  ),
  (
    Hun,
    Long,
    [8644960, 13698580, 592114, 4102506],
    "A rosszullét kerülgetett, amikor megláttam. Senkinek sem meséltünk arról, mi történt azon az éjjelen. A Fudzsi hegy gyönyörű naplementekor. Láttál már ilyen nagy lányt cuclizni?",
  ),
  (
    Hun,
    Long,
    [8553100, 4696104, 9432721, 9730304, 7008544],
    "A magyar géniuszok között számtalan zsidó volt. Péter egy évig nem játszhatott a csapatban. Van elfoglaltságom ma estére. Ismerősök vagytok facén? Vannak, akik örömet okoznak, bárhová is mennek; mások, amikor elmennek.",
  ),
  (
    Hun,
    Long,
    [5659497, 8343637, 10564643, 9730518, 652613, 4466354],
    "Semmit nem tudtam hozzászólni a témához. A vonat félórás késésben van. Azt akarom, hogy fizessenek. Tom rossz vonatra szállt. Nagyon gyakran síelek. Nem éri meg a fáradságot.",
  ),
  (
    Hun,
    Long,
    [5333170, 4125752, 6739305, 4659953, 3963685, 4836268],
    "A tenisz a kedvenc sportom. Semmit nem adtam neki. Itt van rád szükségem. Egyikünk sem védekezett. Gombóc van a torkomban. Egy szót se mondj senkinek erről!",
  ),
  (
    Hun,
    Long,
    [12713450, 11044608, 3865112],
    "Ma mosok annak ellenére, hogy borús az ég, mert holnap nem érek rá. Arash zenéin keresztül ismerkedem a perzsa és arab nyelvekkel. Sokkal gyakrabban kéne misére menned.",
  ),
  (
    Hun,
    Long,
    [8199228, 1196967, 7265563, 7861730, 9708355, 11461127],
    "Tudod, hogy ki az apja? Az állomásig elment. Nem ajánlom, hogy megpróbáljon kijátszani! Ez a másik oldalra való. Két kutya vigyáz a házra. Szerintem nem jó ötlet.",
  ),
  (
    Hun,
    Long,
    [3892098, 5171296, 13092216, 13980875],
    "Fred mindig hazugságokat beszél. A bátyámmal osztozom egy lakáson. Segítesz megírni egy hivatalos levelet? Azon tűnődöm, az almák miert akkorák lettek, mint a diók.",
  ),
  (
    Hun,
    Long,
    [10141798, 10635909, 4440278, 3952516],
    "Füstmérgezésben halt meg. A nyár nagy részében Londonban voltam. Tom a kutyáját figyelte, és a kutyája viszonozta a figyelmet. Muszáj volt hazudnom a rendőröknek.",
  ),
  (
    Hun,
    Long,
    [2344164, 12647941, 10903261, 6169214],
    "Oszakába megyek busszal. A gyerekeknek elegük van a szabályaidból. Soros embere katonai kötvényekkel nyerészkedik Ukrajnában. Tominál tíz éves korában agydaganatot diagnosztizáltak.",
  ),
  (
    Hun,
    Long,
    [7349466, 4073562, 4889445],
    "- Mit fogunk mondani Tomnak? - Ne aggódj. Majd kitalálok valamit. Nem hagyom, hogy erőszakoskodjon velem! Tereljük a vitát egy nyugodt mederbe és keressünk egy közös megoldást.",
  ),
  (
    Hun,
    Long,
    [7965018, 10656485, 4771300, 8342000],
    "Nem sok hiányzik ahhoz, hogy megismerjük az igazságot. Felelősnek érzem magamat a történtek miatt. Nagyobb baj is történt már kettőnkkel. Úgy érzem, hogy minden az én hibám.",
  ),
  (
    Hun,
    Long,
    [5246729, 4627297, 4408721, 695020],
    "Két fiam van. Az egyik Nara, a másik Tsu. Na, most végre kimondtam, ami a szívemet nyomta. A bánatos menekültek arcán halovány mosoly látszódott. A tiszta törülközők a fiókban vannak.",
  ),
  (
    Hun,
    Long,
    [692643, 12388685, 8408339, 4168424, 10689951],
    "Ne feledd el magaddal hozni a fényképezőgépet. Játsszatok tovább nélkülem. Szerintem nyerni fogunk. Ezt nem bocsátják meg nekem a gyerekek. Lehetetlennek tartom.",
  ),
  (
    Hun,
    Long,
    [4727966, 3841828, 9780642, 665461, 12485862],
    "Most akarsz bosszút állni rajtam? Judit már abbahagyta a profi éneklést. Bánom, hogy ezt tettem veled. El akarom olvasni a könyvet. Büdös volt a szobában.",
  ),
  (
    Hun,
    Long,
    [6878317, 10666862, 7556763, 5776885, 3940580],
    "Tom nem fogja meginni. Miért nem csörgettél meg korábban? A padlót beterítik az üvegcserepek. Ezek a könyvek nehezek. Biztos,hogy nekem is vannak idegesítő dolgaim,de még nem említette eddig senki.",
  ),
  (
    Hun,
    Long,
    [4759765, 10602321, 4208428, 9188606, 11971932],
    "Nagyon későn keltem fel. Évek óta nem láttam már. Nem kértem nagy dolgot tőled, ugye? Nálunk is megrekedtek a reformok. Bársonyka csak egy kicsit szereti a bársonyt.",
  ),
  (
    Hun,
    Long,
    [7849270, 13122218, 13318699],
    "Egyáltalán nem értettem őt. A modern, felvilágosult ember már nem jár el templomba – a modern, felvilágosult ember nézi a televíziót. Megbénultam a hidegtől.",
  ),
  (
    Hun,
    Long,
    [13186630, 9099162, 9915914, 2435132],
    "Ilyet nem mondott még nekem senki. Nem baj, ha ideülök melléd? Megmondtam, nem, hogy lesz rá gondom, mihelyst időm engedi!? Kalózok cirkáltak a tengeren.",
  ),
  (
    Hun,
    Long,
    [10606066, 13623593, 12126957],
    "Tomban tombolt a lelkesedés. — Melyik iskolában tanul a fiatok? — Az túlzás, hogy tanul, inkább csak bejár, ha egyáltalán úgy van. Én elveszett ember vagyok egy nagyvárosban.",
  ),
  (
    Hun,
    Long,
    [10493580, 11913823, 3754339, 4789031],
    "Elhagyom mindig az ékezeteket. Okostelefon. Tom az iskolába tart épp. Nem vagyok képes ezt szótár nélkül megcsinálni. A bátyám segítsége nélkül vízbe fulladtam volna.",
  ),
]

///|
let rows_azj : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Azj, Short, [10852250], "Pomidor yeməyi sevmirəm."),
  (Azj, Short, [4464810], "O məndən bir az gödəkboyludur."),
  (Azj, Short, [13639354], "Adətən çimərliyə gedirəm."),
  (Azj, Short, [13335929], "Boynuna al."),
  (Azj, Short, [13644026], "Adriano İslama nifrət edirdi."),
  (Azj, Short, [4090262], "Bu kimin lüğətidir?"),
  (Azj, Short, [13635537], "O, kefsiz görünür."),
  (Azj, Short, [4191138], "Xidmətdən razısınızmı?"),
  (Azj, Short, [13374912], "Cavab ver."),
  (Azj, Short, [9201029], "Təşəkkür edirəm."),
  (Azj, Short, [2696456], "O, müğənnidir."),
  (Azj, Short, [3303301], "Vacib deyildi."),
  (Azj, Short, [2932591], "Ağıllı idim."),
  (Azj, Short, [13389367], "Axı niyə soxmursan içinə?!"),
  (Azj, Short, [13572506], "Hal-hazırda ac deyiləm."),
  (Azj, Short, [4419551], "Səndən xoşum gəlir."),
  (Azj, Short, [13371714], "Onlara əl vurmayın."),
  (Azj, Short, [4036536], "Yox, bunu mən yazmamışam."),
  (Azj, Short, [13603598], "Nyutonun neçə qanunu var?"),
  (Azj, Short, [13332269], "Yalnız bir dəfə yaşayırsınız."),
  (Azj, Short, [7463551], "Ermənistanda çoxlu turist var?"),
  (Azj, Short, [4321367], "Mən bu axşam ona zəng vuracam."),
  (Azj, Short, [13330138], "Google pulsuzdur."),
  (Azj, Short, [2920518], "Mən polis deyiləm."),
  (Azj, Short, [3988892], "Səndə sonuncu versiya var?"),
  (Azj, Short, [4411446], "Mən qarpız xoşlayıram."),
  (Azj, Short, [13394037], "Tom səni eşidə bilir."),
  (Azj, Short, [13603603], "Film gözlədiyim kimi deyildi."),
  (Azj, Short, [3814521], "Mən qazılmışam."),
  (Azj, Short, [4411417], "Bu ispanaqdır?"),
  (Azj, Medium, [13332003], "Tom və Meri tam olaraq istədiklərini aldılar."),
  (
    Azj,
    Medium,
    [13618785],
    "Bunu etməyimin tələb olunub-olunmamağımı soruşdum.",
  ),
  (Azj, Medium, [13389392], "Osturağın qabağında sıçmaq lazımdır."),
  (
    Azj,
    Medium,
    [5156276],
    "Bu gecə kimin gələcəyini mənə deyə bilərsinizmi?",
  ),
  (Azj, Medium, [4411185], "Çiməndə süngərdən istifadə edirsən?"),
  (
    Azj,
    Medium,
    [8809134],
    "Düşünürəm ki, tarakanlardan qurtulmağın tək yolu budur.",
  ),
  (
    Azj,
    Medium,
    [13638544],
    "Gələn çərşənbə, yəni Sentyabrın 10-u sənlə görüşəcəm.",
  ),
  (Azj, Medium, [2768826], "Bu, piylənmə haqqında kitabdır."),
  (
    Azj,
    Medium,
    [13334212],
    "Tom əsasən özü-özünü öyrədən gitara ifaçısıdır.",
  ),
  (Azj, Medium, [13330121], "Pythonda proqramlaya bilirsinizmi?"),
  (Azj, Medium, [13640641], "Onunla təklikdə danışmaq istəyirəm."),
  (Azj, Medium, [4314659], "Bilmirəm niyə ondan xoşun gəlmir."),
  (
    Azj,
    Medium,
    [8821838],
    "Tom mənə dedi ki, o dağ dırmanışına getmək istəyir.",
  ),
  (
    Azj,
    Medium,
    [5366754],
    "Mənə maraqlıdır, o gəmi hara istiqamətlənir.",
  ),
  (Azj, Medium, [13368231], "Bu mağazada heç vaxt olmamışam."),
  (Azj, Medium, [13641132], "Həqiqətən də onlarla danışmaq istəyirəm."),
  (Azj, Medium, [13329607], "Hələ də kifayət qədər vaxtınız var."),
  (
    Azj,
    Medium,
    [13638570],
    "Gələn dəfə gələndə ona bu barədə danışaram.",
  ),
  (
    Azj,
    Medium,
    [4417039],
    "Şimali Dakotada böyük neft yataqları tapılmışdı.",
  ),
  (
    Azj,
    Medium,
    [3988937],
    "Tom artıq fransız dilini öyrənməyə başlayıb.",
  ),
  (Azj, Medium, [2852651], "Hava limanına çatan kimi ofisimizə zəng vurdu."),
  (Azj, Medium, [3995041], "Mənə bir saata sənə zəng vuracam."),
  (
    Azj,
    Medium,
    [13329621],
    "Yaponiya şimaldan cənuba çox uzun bir ölkədir.",
  ),
  (Azj, Medium, [13423174], "Tom başa düşür ki, nə səhv getdi."),
  (Azj, Medium, [13312115], "Bu axşam burada olmaqdan qürur duyuram."),
  (
    Azj,
    Medium,
    [13372026],
    "Ölkənin ən inkişaf etmiş üç post-sənaye aqlomerasiyasından biridir.",
  ),
  (
    Azj,
    Medium,
    [4090367],
    "Sarayevo Bosniya və Herseqovinanın paytaxtıdır.",
  ),
  (Azj, Medium, [4339137], "Xahiş edirəm mənə de, sənin problemin nədir?"),
  (Azj, Medium, [13638846], "Saat 2:30-da orda olacam, yaxşı?"),
  (Azj, Medium, [13641333], "Hitler niyə SSRİ-ni işğal etdi?"),
  (
    Azj,
    Long,
    [13640654, 2872302, 13377767, 13618933, 3307060, 8805751],
    "Sənə dedim ki, onunla danışma. Tətilimi Bakıda keçirəcəm. Nensi, sizə məktub var. Tom sol ayağı ilə topa vurdu. Hamı sizinlə razıdır. Və Jacob oğullarına səsləndi və dedi: başıma toplanın, sizə son günlərdə başınıza gələcəklər haqqında bildirəcəyəm.",
  ),
  (
    Azj,
    Long,
    [13331894, 13335041, 13330790, 3303506, 13363498, 4106907, 5375612],
    "Tom kömək edə bilər? Tom mənə danışmağa qoymadı. Ağcaqanadlar hərəşatdırlar. Tezliklə sənə yazacam. Bu, gözəl bir güldür. Sən harda yaşayırsan? Məktəb birisi gün başlayır.",
  ),
  (
    Azj,
    Long,
    [4522520, 13644127, 13343484, 13919767, 13329098, 3988976],
    "O, yayda üzməyi xoşlayır. Onun əmisi qızı müsəlman oldu. Bu, sizin telefonunuzdu? Anama oxşamağa başlayırsan. Gitarada ifa etmək asandır. Sən suala cavab verməlisən.",
  ),
  (
    Azj,
    Long,
    [4099893, 4409458, 13644181, 4337026, 13518451, 4314772],
    "Bu Avstraliyada çəkilib. Tom bura hər gün gəlir. Gərəksiz risklərə getmə. Mən bu fabrikdə işləmişəm. Elə indicə etmək istəyirəm. Onun iyirmi uşağı var.",
  ),
  (
    Azj,
    Long,
    [13372546, 4339194, 4116306, 4100945, 3991006, 13334279],
    "Buna kim cavabdehdir? Mən əlimdən gələni edəcəm. Mən təəccüblənmişdim. Pedofiliya cinayətdir. Mən fransız dili müəllimiyəm. Səhvlərinizi qəbul etməlisiz.",
  ),
  (
    Azj,
    Long,
    [13343298, 4109223, 13312304, 13638665, 13358618],
    "Sizdə müdriklik var. Onlar ikisi də fransızca danışırlar. Tom üçün yeni bir avtomobil aldım. Sənə bir xəbərim var. III Şuşa Qlobal Media Forumunun iştirakçıları ilə görüş keçirilib.",
  ),
  (
    Azj,
    Long,
    [4512491, 7463528, 13638592, 13312103, 13313341],
    "Mən ətrafa baxdım amma heç kimi görmədim. Sami mənim yaşımda idi. Axşam yeməyindən əvvəl dua edək. Tom hələ də yuxulu görünür. Tom həmişə işindən şikayətlənir.",
  ),
  (
    Azj,
    Long,
    [13331357, 5366726, 13342576, 3986696, 13620771, 3307089],
    "Bunlara ayaqqabı deyilir. Sən nə üçün Yaponiyaya gəldin? Məni vurmaqdan əl çəkin. O xəstə olduğu üçün gələ bilmir. Həqiqət daim qalib gəlir. Tenis raketkamı klubdda qoydum.",
  ),
  (
    Azj,
    Long,
    [13632584, 2693083, 10875889, 4343065, 13333309, 2423291],
    "Məncə Tom və Meri çox aqresivdirlər. Bu kitab Yannis tərəfindən yazılıb. Mən kitab oxumağı xoşlayıram. Biz heç bir şey görmədik. Lallar nicat tapmaz. Pişiklər siçan tutar.",
  ),
  (
    Azj,
    Long,
    [13348098, 4339220, 13334291, 3303351],
    "Bir daha heç vaxt aşiq olmayacam. Biz birbirimizə lazımıq. Şəxsi biznes və korrupsioner siyasətçilərin milyardlarla dolları mənimsədiyi güman edilir. Ümüd edirəm bir iş taparsan.",
  ),
  (
    Azj,
    Long,
    [13640595, 13632424, 13332065],
    "Öncə sizlə danışmaq istəyirəm. Əslində bunu edən Tom deyildi. İndi bu qayğıdan artıq azad olmuşuq və buna görə Sizə bir daha minnətdarlığımızı bildiririk.",
  ),
  (
    Azj,
    Long,
    [13378274, 3303263, 13330806, 13333170, 4314800, 8780443],
    "Bir monarxın altı oğlu var idi. Yay Tətilini harda keçirdin? Zəhmət olmasa, gülləri sula. Onun iki dənə evi var. Mənim çemodanım haradadır? Mən balaca olanda çox yaramazlıq edirdim.",
  ),
  (
    Azj,
    Long,
    [14053389, 13362204, 13332303, 13888008, 2771544],
    "Nensi sevinclə gülümsədi. Sevdiklərin haqqında düşün. Diqqətinizi cəmləyin! Nənəm səksən yaşındadır. Hipotenuzun kvadratı digər iki tərəfin kvadratlarının cəminə bərabərdir.",
  ),
  (
    Azj,
    Long,
    [13386009, 3303517, 4407518, 13369793, 13329605, 12205157],
    "Sənə kim dedi ki, Tomu öldür? Dərhal çəkmələrimi geyindim. Mən deməli olduğumu demişəm. O, sözlərimi təhrif elədi. Boz səmanı sevmirəm. Onun tərcüməyi-halı on dilə tərcümə olunub.",
  ),
  (
    Azj,
    Long,
    [4174301, 13364288, 13329980, 13330219, 4076457],
    "Den Lindanın otağını görmək istədi. Mən belə bir şey etməmişəm. Sabah məktəbə getməyəcəm. Meri dedi ki, o, bunu etməli idi. Mən gələcəkdə həkim olmaq istəyirəm.",
  ),
  (
    Azj,
    Long,
    [13374412, 13641135, 13632416, 2853278, 11206475],
    "Mən kiçik olanda çox nadinc idim. Həqiqətən də onlarla danışmalıyam. Tomla heç də danışmaq istəmirdim. Mən də sizinlə tanışlığıma çox şadam. Ailəm şəhərdə yaşayır.",
  ),
  (
    Azj,
    Long,
    [13329585, 13632466, 4409760, 10054380],
    "Sizin üçün gitara ifa edəcəm. Tualetinizdən istifadə edə bilərəm? Badımcanları yu və uclarını kəs. Cümləniz əlavə edilmədi, çünki aşağıdakılar artıq mövcuddur.",
  ),
  (
    Azj,
    Long,
    [13345041, 4191110, 13617717],
    "Əgər əsas metodunuz əlçatan deyilsə, biz aşağıda sadalanan telefon nömrələrinə ehtiyat nişanları göndərə bilərik. Onlar Toma kömək etdilər. Enter düyməsinə basma!",
  ),
  (
    Azj,
    Long,
    [13632380, 4123539, 4409591, 8854107, 5343476, 4407327],
    "Nepaldan xoşum gəlir. Laboratoriyaya qayıt! Mənə artıq heç kim lazım deyil. Bu Tom üçün daha pis ola bilərdi. Haradadır sizin uşaqlar? Mənim oxuduğum kitab hanı?",
  ),
  (
    Azj,
    Long,
    [13632426, 13313088, 13620723, 3303875, 4414769],
    "Tom həbs olunan yeganə adam idi. Tatoeba-da gizli reklam xoş qarşılanmır. Toma etibar edə bilərik. Bu gün yəqin ki yağış yağacaq. Deyirlər ki, o, xəstədir.",
  ),
  (
    Azj,
    Long,
    [5156259, 13348101, 3986504, 13328588, 13376341, 13312292],
    "Bir gün başa düşəcəksiniz. Onu olduğu yerə qaytar. Bütün vəkillər yalançıdırlar. Gün eynəyim dünən çimərlikdə oğurlanıb. Gəlin avtobusa minək. Bizim yalnız bir qaydamız var, amma buna ciddi əməl edilməlidir.",
  ),
  (
    Azj,
    Long,
    [13639683, 4407590, 4076477, 13345070, 3990095],
    "Sevimli Linux paylanman hansıdır? Den maşının içində qusdu. Mən bu gün heç nə tərcümə etmək istəmirəm. Zəhmət olmasa, bir dəqiqə gözləyin. Hər ailədə biri var.",
  ),
  (
    Azj,
    Long,
    [13384409, 3303871, 3990298, 13720396, 13374978],
    "Mən həqiqətən əhvalımda deyiləm. Tapşırığını etdin mı? Reykyavik İslandiyanın paytaxtıdır. Xahiş edirəm, səhər yeməyinə bir şey yemək istəyirdik. Sizin qayğınıza qalacam.",
  ),
  (
    Azj,
    Long,
    [13631329, 4417118, 3986523, 3453052],
    "Xahiş edirəm sadəcə olaraq etdiyim hər şeyi edin. Almaniya Niderlandla həmsərhəddir. İtalyanlar heç vaxt qəhvə içmirlər. Bank quldurları maska taxırdılar.",
  ),
  (
    Azj,
    Long,
    [13313065, 13641139, 4279505, 13342638, 11906581],
    "Tom etdiklərin üçün çox minnətdardır. Sadəcə sizlə danışmaq istəyirdim. Mən onlardan heç nə istəmirəm. Yəqin ki, bunu bilirsiniz. O Tomu qəzəbləndirmək istədi.",
  ),
  (
    Azj,
    Long,
    [4340464, 13328399, 3995013, 12905767, 13331843],
    "Gəl çarpayının altına baxaq. Boşluqlarla necə mübarizə aparılmalı? Siz burada qalmalısınız. Təhsil üçün olsa da, səni xaricə göndərə bilmərəm. Yaponiyanı tərk etməyimdən on il keçdi.",
  ),
  (
    Azj,
    Long,
    [4099773, 13376098, 13640596, 13344351, 13313070, 13350294],
    "Onun tünd qəhvəyi saçları var idi. Onun qırmızı gülləri var. Öncə onunla danışmaq istəyirəm. Get, Tomla söhbət elə. Rusiya bayrağının üç rəngi var. Yoxsulluq hər yerdədi.",
  ),
  (
    Azj,
    Long,
    [4407332, 13888094, 4321296, 13313662],
    "Mən buradan təxminən bir mil uzaqlıqda yaşayıram. Mən bunu bir daha heç vaxt etməyəcəyəm. Mən sizin istədiyinizi edə bilmərəm. Tomun evini görmüsünüz?",
  ),
  (
    Azj,
    Long,
    [2676395, 4411139, 5415709, 13332860, 8780157, 3303739],
    "Yalnız səni eşidirəm. Piter çox cavan görünür. O oğlan tamamilə dəlidir. Bu donuz əti rezin kimidir. Tom sorğu-sual üçün içəri gətirildi. Həyatını şirkətinə həsr etdi.",
  ),
  (
    Azj,
    Long,
    [13822521, 13644289, 8854098, 13331599],
    "Bu dəhşətli bir fikirdir. O, Əlcəzairə qaçaqmalçılıq yolu ilə almaz keçirməyə cəhd etdi. Bunun mənə heç bir adiyyatı yoxdur. Tom sənə bunu etməkdə yardım edə bilər.",
  ),
]

///|
let rows_ces : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Ces, Short, [11005843], "Tom si zaslouží lepší bydlení."),
  (Ces, Short, [3465025], "Stromy už shodily listí."),
  (Ces, Short, [10033567], "Jsi lékař."),
  (Ces, Short, [13470396], "Tyto dívky jsou sestry."),
  (Ces, Short, [6455864], "Proč jsi nepolíbil Toma?"),
  (Ces, Short, [458599], "Viděl jsem ho před třemi lety."),
  (Ces, Short, [8739475], "Můj otec zemřel na rakovinu."),
  (Ces, Short, [4414678], "Už nikomu toto číslo nedávej."),
  (Ces, Short, [4227282], "Mám černé oko."),
  (Ces, Short, [10024433], "V kolik hodin jste přijeli?"),
  (Ces, Short, [9579616], "Ubrus je v kredenci."),
  (Ces, Short, [8977174], "Nemůžeš k tomu Toma nutit."),
  (Ces, Short, [3457606], "Nejsem zvyklý vstávat brzy."),
  (Ces, Short, [4414745], "Oni nesnášejí hmyz."),
  (Ces, Short, [12131396], "Stydí se lhát."),
  (Ces, Short, [9076471], "Nerad jím maso."),
  (Ces, Short, [8843083], "Ještě je možné se tam dostat?"),
  (Ces, Short, [8119705], "Snáším lépe zimu, nežli vedro."),
  (Ces, Short, [7223540], "Pamatuju si Toma."),
  (Ces, Short, [8353006], "Na vrcholu hory byl vysílač."),
  (Ces, Short, [3502076], "Musíš se zbavit zlozvyků."),
  (Ces, Short, [8173694], "Chystal se na párty."),
  (Ces, Short, [8715399], "Příměří netrvalo dlouho."),
  (Ces, Short, [7347481], "Jsi opravdu nudná."),
  (Ces, Short, [10782040], "Tuto restauraci vlastní Tom."),
  (Ces, Short, [7759321], "Jak se píše vaše jméno?"),
  (Ces, Short, [7238060], "Tom to možná zvládl."),
  (Ces, Short, [9206368], "Hodně tě obdivuji."),
  (Ces, Short, [10169759], "Na střeše sedí bílá hrdlička."),
  (Ces, Short, [4717149], "Bohužel pršelo."),
  (Ces, Medium, [2243948], "Všimla jste si, že opustil dům?"),
  (Ces, Medium, [4283907], "V Německu je oblíben černý chléb."),
  (Ces, Medium, [13193219], "To se pravděpodobně nikdy nestane."),
  (
    Ces,
    Medium,
    [1133240],
    "Jakých koncovek nabývá to sloveso v přítomném čase?",
  ),
  (Ces, Medium, [8334899], "To je něco, co bych raději nedělal."),
  (Ces, Medium, [3535666], "Zdráhám se Toma požádat o pomoc."),
  (Ces, Medium, [8003649], "Tom řekl, že musím počkat až do pondělí."),
  (Ces, Medium, [10660619], "Tom by nikdy svoji rodinu neopustil."),
  (Ces, Medium, [1698084], "Dospěl jsem k závěru, že jsem byl podveden."),
  (Ces, Medium, [8401838], "K produkci elektřiny je zapotřebí více větru."),
  (Ces, Medium, [8471522], "Nevěděli jste, že Tom to plánuje udělat?"),
  (Ces, Medium, [10611748], "Moudrost je lepší než bohatství."),
  (Ces, Medium, [12150904], "Naši otcové spolu kdysi pracovali."),
  (
    Ces,
    Medium,
    [11923464],
    "Je mi jedno, co si lidé myslí o tom, jak se oblékám.",
  ),
  (Ces, Medium, [4867745], "Ona často navštěvuje tuto zemi."),
  (Ces, Medium, [8337721], "Víš, jakého druhu tento strom je?"),
  (Ces, Medium, [8172434], "Tento svět je ovládán zlovolnými silami."),
  (Ces, Medium, [10900938], "Učit se francouzsky není snadné."),
  (Ces, Medium, [11803762], "Rodiče ho poslali do Ameriky ke strýci."),
  (Ces, Medium, [7562759], "Pravděpodobně neschválí tvůj návrh."),
  (Ces, Medium, [10030356], "Podívej, co jsem našel pod pohovkou."),
  (
    Ces,
    Medium,
    [3042754],
    "Chci abys věděla, že si můžeme přestat dělat starosti.",
  ),
  (Ces, Medium, [10621772], "Na otázku jsi odpověděl jenom ty."),
  (Ces, Medium, [13413547], "Nepotřeboval jsem Tomův souhlas."),
  (
    Ces,
    Medium,
    [3708311],
    "Na této křižovatce dochází téměř denně k nehodám.",
  ),
  (Ces, Medium, [11188799], "Částka byla připsána na můj účet."),
  (Ces, Medium, [12437748], "Přinutí tě, aby ses plazil v prachu."),
  (Ces, Medium, [12945924], "V tomto oboru jsou daleko před námi."),
  (
    Ces,
    Medium,
    [12714310],
    "Mnozí říkají, že je to mrzí, ale nikdo nedělá nic, čím by pomohl.",
  ),
  (Ces, Medium, [7695624], "Dělám přesně to, co jsi mi řekl."),
  (
    Ces,
    Long,
    [7991597, 10121278, 1138629, 8954527, 13767337, 13793845],
    "V neděli je muzeum zavřené. Tom nikdy nebude dobrý otec. Zdá se, že nesouhlasí. Proč je ten nápad špatný? Tam je teď všechno jiné. Nepij, když řídíš auto!",
  ),
  (
    Ces,
    Long,
    [10780468, 6814687, 8524573, 5236121, 8266505, 12136598],
    "Tom potřebuje nový psací stůl. Ona nikoho z nás nezná. Nedali by Tomovi vízum. Nežijete v mé městské čtvrti. Prosil o svůj život. Jak dlouho tam Tom byl?",
  ),
  (
    Ces,
    Long,
    [9929154, 7425459, 13276549, 5099903],
    "Věřím ve slunce, i když nesvítí. Věřím v lásku, i když ji necítím. Věřím v Boha, i když mlčí. Zdávalo se mi o tobě. Chtěli Toma jen umlčet. Ve třídě je třicet pět žáků.",
  ),
  (
    Ces,
    Long,
    [4795576, 8939225, 4420435, 11844872, 1832950, 8423462, 9354686],
    "Napsal jsi tuhle knihu? Tom nebude učit francouzštinu. Co to může znamenat? Jak dobýváme uhlí ze země? Kdy se budete ženit? Neopakuj stejnou chybu. Toto je mylná informace.",
  ),
  (
    Ces,
    Long,
    [1802078, 9933061, 14029082, 12830548, 9049290, 8783711],
    "Zemřel před deseti lety. Nemusíte Tomovi brát práci. Ještě nemáme nic hotové. Zajímá tě akorát jen Tom. Kam teď jdete? Domů? Ty s námi nechceš jíst, že?",
  ),
  (
    Ces,
    Long,
    [12144074, 12913265, 12505634, 1639111, 8878279],
    "Při přecházení ulice držte dítě za ruku. Tom má nějaké příbuzné v Rusku. Tom některá jídla špatně tráví. Chce jet do Ameriky. Udělala spoustu chyb, takže ji podvedli.",
  ),
  (
    Ces,
    Long,
    [12379091, 12472360, 3985729, 4276131, 6462581, 8422101],
    "Jsem ve městě služebně. Tom nosí na hlavě modrý šátek. Tom říkal, že přijdeš. Povodně zničily úrodu. Tvoje podpora je také důležitá. Vím, že jsem nenahraditelný.",
  ),
  (
    Ces,
    Long,
    [3864417, 11755485, 13476351, 12890435, 12441567],
    "Ženám bylo poskytnuto hlasovací právo. Je to velká zodpovědnost. Tato cesta je delší než ta předchozí. Tom na schůzi prděl. V neděli do školy chodit nemusíš.",
  ),
  (
    Ces,
    Long,
    [8554330, 13513954, 8790087, 11514694],
    "Jestli Tom nebude brát předepsané léky, jeho zdravotní stav se může zhoršit. Tom pravděpodobně nepočká. Včera večer jsme měli nezvané hosty. Německá gramatika mi dělá problémy.",
  ),
  (
    Ces,
    Long,
    [9302116, 12684722, 8923236, 7237367, 12732777],
    "Doufám, že Tom bude potrestán. Má to hezkou patinu. Tom a Mary jsou s těmi výsledky vcelku spokojeni. Nechci být negativní, ale... Tohle džentlmeni nedělají.",
  ),
  (
    Ces,
    Long,
    [8487644, 4780462, 13122536],
    "Tom se bál, že možná nestihne vlak. Má sestra Mary a její přítelkyně nejsou doma, nýbrž na zahradě. Můžete zde sdílet a diskutovat vše, co se týká angličtiny.",
  ),
  (
    Ces,
    Long,
    [10462118, 8120242, 13197511, 7445751, 8734718, 6941894],
    "Plavat jsem se nikdy nenaučil. Většina psů má hnědé oči. Proč neustále mluvíte o Tomovi? Ihned jsem začal křičet. Jak bezpečná je tato městská část? Ještě jsem s Tomem neskončil.",
  ),
  (
    Ces,
    Long,
    [10072521, 1676265, 5507981, 12526898, 7325296],
    "Spal jsem tři hodiny. To je dle mého gusta a k mému potěšení. Tomova těžká práce se vyplatila. Tohle jezero není hluboké. Je mělké. Jsem si celkem jistý, že Tom říká pravdu.",
  ),
  (
    Ces,
    Long,
    [7760143, 8024282, 8572520, 7950368, 9568243, 10254769],
    "Odpočineme si na chvilku? Předal jsem mu tu zprávu. Naštěstí už jsem je znovu neviděl. Kudy se jde na pláž? Neptej se na nic, pokud to nechceš vědět. Je mi fuk, jestli Tom půjde do basy.",
  ),
  (
    Ces,
    Long,
    [4419811, 1657833, 10112487, 8807268],
    "Čím víc vysvětlujete, tím miň rozumím. Tom pokračoval ve studiu francouzštiny další tři roky. Zná tu někdo tohohle chlapa? Ztratil jsem nabíječku ke svému telefonu.",
  ),
  (
    Ces,
    Long,
    [8472341, 8600770, 5199030, 12491804, 13535761, 7716919],
    "Kde se narodila Mary? Tom nás přinutil stát. Ty se rád bavíš o architektuře, že? Kdo vydává tyto noviny? Tom zapnul televizi a posadil se na pohovku. Šest dní jsem nic nejedl.",
  ),
  (
    Ces,
    Long,
    [9481589, 11086350, 7751861, 10338489, 11898217],
    "Určitě si je toho nebezpečí vědom. Přiznal se, že poklad ukradl. Můj plán se od vašeho liší. Tom je pevně rozhodnutý. V horách se volně potulovaly kozy.",
  ),
  (
    Ces,
    Long,
    [8013704, 1823182, 12449414, 7970461, 8537526],
    "Tom hledal svoje ponožky. Chci vám poděkovat, že jste přeložili moje věty. Myslím, že Toma by to z míry nevyvedlo. Tom zmáčknul skrytý knoflík. Tom vykouří až dvacet cigaret denně, zatímco Mary nekouří vůbec.",
  ),
  (
    Ces,
    Long,
    [8341642, 7999319, 10825870, 11338649, 4412449],
    "Pokusili jsme se Toma podvést. Tom odjel minulé pondělí. V tomhle domě už nikdo nebydlí. Nosí boty s vysokým podpatkem. Jaké procento onemocnění je spojeno s nevhodnou stravou?",
  ),
  (
    Ces,
    Long,
    [12297265, 12451289, 3244047, 8213936],
    "Měl ses zeptat Toma. V poslední době jsem trochu přibral okolo pasu. Asi to bude pupík středního věku. Jak dlouho chceš zůstat v této zemi? Jakmile získáte dostatek moudrosti, jste moc staří na to, abyste toho využili.",
  ),
  (
    Ces,
    Long,
    [13991597, 10098887, 4735033, 8583115, 10239709, 13696341],
    "Všechno je to jen tvoje fantazie. Nechoďte přes silnici. Nebyla to moje vina. Tom se rozhodl nepřijít. Klíče jsou u mě na stole. Příští měsíc touto dobou už budeme bydlet v našem novém domě.",
  ),
  (
    Ces,
    Long,
    [9779830, 13792870, 12423603, 8328096, 3042769],
    "Odejdu, až se vrátí. Popadni tu druhou židli! Stejně bychom Toma měli navštívit. Je to stejná místnost, ve které jsme se naposledy setkali. Nečekám, že si budeš pamatovat.",
  ),
  (
    Ces,
    Long,
    [12555091, 12444468, 338229, 8807213, 13713136, 11799817],
    "Tito lidé jsou bezdomovci. Jsem připraven vzdát se moci. Jste v lepším stavu než já. Ještě mají Tom a Mary loďku? Tom dělá naší firmě ostudu. Děti zpívaly písničky.",
  ),
  (
    Ces,
    Long,
    [1607995, 10629407, 8126397, 7530805, 4409801, 12126462],
    "Děti se probudí, jestli budeš dělat rámus. Pondělí je špatný den. Zvětšil jsem ty fotky. Tom býval dobrým studentem. Nechce se mi jít do školy. Tom to nemohl strávit.",
  ),
  (
    Ces,
    Long,
    [7288854, 8358367, 8347440, 3972650, 2196536, 6842451],
    "Sami se snažil tu situaci pochopit. Tom souhlasí s mým nápadem. Stavíme dřevěný dům. Musí se to vidět, abys uvěřil. Ona je přebornicí v šermu. Tom sjel dolů po bazénové skluzavce.",
  ),
  (
    Ces,
    Long,
    [7947885, 13298393, 6950812, 9386776, 7972975],
    "Nechceš si se mnou zatančit? Pravda jednou vyjde najevo. Lístky se prodávají rychle a prostor je omezen. Tom začal hrát na klavír. Zazvonil jsem na zvonek a čekal jsem.",
  ),
  (
    Ces,
    Long,
    [10362144, 13370323, 10678092, 5217780, 8807277],
    "Slunce vždycky zachází na západě. Tom nechal pro své děti postavit dům. Něco si pro sebe mumlá. Hledal jsem Andyho. Nevíš, kde je? Tom stále něco rozbíjí.",
  ),
  (
    Ces,
    Long,
    [3674944, 10208353, 11278770, 9588994, 12237954, 3458112],
    "Pokrytectví se mi hnusí. Pošta má v neděli zavřeno. Tom potřeboval, abych mu něco přeložil. Moje zahrada je malá. Uvedu ti ještě jeden příklad. Kráva je užitečné zvíře.",
  ),
  (
    Ces,
    Long,
    [9968381, 8965357, 7300144, 8121888, 10514961, 12803078],
    "Tom dnes večer odjíždí do Budapešti. Tom není začátečník. Tohle je moje snoubenka. Proč chcete, abychom si to dali? Moje země se jmenuje Rusko. Tom používá služební auto k soukromým účelům.",
  ),
  (
    Ces,
    Long,
    [13710415, 8793402, 4724579, 10471234, 4479519, 9164204],
    "Tom byl ten, kdo dělal ten hluk. Kolik nákupních tašek máš? Jeho vlastí je Gruzie. Tom se rozvedl s mojí sestrou. Na, vem si můj klíč. Dnes jsem příliš líný na to, něco dělat.",
  ),
]

///|
let rows_run : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Run, Short, [8063954], "Nanje nzogukumbura."),
  (Run, Short, [8619607], "Afise inzu ku kiyaga."),
  (Run, Short, [7100079], "Ngirango ntaza."),
  (Run, Short, [8361723], "Urukundo ntirukeha."),
  (Run, Short, [7635089], "Nabarira vyose abavyeyi banje."),
  (Run, Short, [8456946], "Ndamufasha."),
  (Run, Short, [8083017], "Mpore kubera umuvyeyi wawe."),
  (Run, Short, [7217137], "Bitandukaniye hehe?"),
  (Run, Short, [8074036], "Ni igitabu gishasha."),
  (Run, Short, [7852140], "Ivyo birashavuza!"),
  (Run, Short, [7798282], "Reka ndabe."),
  (Run, Short, [7782419], "Kubera iki babikora?"),
  (Run, Short, [8063959], "Ndipfuza ko tuzongera."),
  (Run, Short, [7798271], "Kubera iki ataco uronka?"),
  (Run, Short, [7925722], "Nta batunzi baba ngaha."),
  (Run, Short, [7827732], "Uyu muhungu ni mwenebabo."),
  (Run, Short, [7832619], "Naje kwiga."),
  (Run, Short, [9095292], "Ntiwugurure umuryango!"),
  (Run, Short, [7695112], "Namye nipfuza umukobwa."),
  (Run, Short, [7901974], "Iyi kanzu ni jewe nayikoreye."),
  (Run, Short, [7036996], "Uyu ni dawe wanje."),
  (Run, Short, [7798344], "Sinshaka kubimenya."),
  (Run, Short, [8253736], "Ntashobora kumpagarika."),
  (Run, Short, [7694036], "Nabo baraza?"),
  (Run, Short, [8425857], "Nimubishireko umukono!"),
  (Run, Short, [7861316], "Urashobora gutera ururirimbo."),
  (Run, Short, [8626166], "Urashobora kwivuga uwo uri?"),
  (Run, Short, [8260873], "Kubera iki tuticara?"),
  (Run, Short, [7782427], "Ntimusubire!"),
  (Run, Short, [9778861], "Ndi umushakashatsi."),
  (Run, Medium, [8749338], "Ndiko ndakopiya impapuro ijana."),
  (Run, Medium, [8374855], "Ndazi izina ryawe ry'iritazirano."),
  (Run, Medium, [7958225], "\"Aya marori ni ayande?\" – \"Ni aya Data.\""),
  (Run, Medium, [7125422], "Mwashikiwe niki ejo ku mugoroba?"),
  (
    Run,
    Medium,
    [9787244],
    "Inama itangura Uno munsi ariko izohera mu ndwi iza.",
  ),
  (Run, Medium, [9462610], "Umusore adafise amahera biramugora."),
  (
    Run,
    Medium,
    [9127359],
    "Turahagaritse ibiganiro vyacu kubera inkuru ihambaye idushikiye.",
  ),
  (Run, Medium, [7698573], "Nagira ngo niwe ncuti itarutwa."),
  (Run, Medium, [8974651], "Wariye iki uyu munsi ku mutaga?"),
  (Run, Medium, [9371589], "Noeli ni umusi mukuru ukomeye cane."),
  (
    Run,
    Medium,
    [9462640],
    "Bimwe bimwe vyatumye ubuzima bworoha, ibindi vyatumye bugorana.",
  ),
  (Run, Medium, [9127394], "Twibaze ingaruka zari kuba iyo ibintu biyanzara."),
  (Run, Medium, [9131620], "Ejo habaye isanganya rihambaye."),
  (Run, Medium, [8374935], "Sinshobora kwihanganira kurindira ko ndakubona."),
  (Run, Medium, [8577635], "Nta gituma kihari co kugira ubwoba."),
  (
    Run,
    Medium,
    [8852732],
    "Umukobwa wanje yatakaje ibiceri hafi ya vyose yari yakoranije.",
  ),
  (Run, Medium, [8749265], "Hari hasigaye amata make gusa mw'icupa."),
  (Run, Medium, [8447132], "Ndashobora kubaza ikindi kibazo?"),
  (Run, Medium, [7872475], "Iyo aza kugira umwanya yari kugenda."),
  (Run, Medium, [8393874], "Yagarutse mu kwezi kw'umunani guheze."),
  (
    Run,
    Medium,
    [8396124],
    "Ni ubwa mbere kuri jewe nico gituma mfise agashitsi gato.",
  ),
  (Run, Medium, [9075061], "Aracateze amaboko abavyeyi biwe."),
  (Run, Medium, [8391066], "Mbere harakanye cane uyu munsi pe."),
  (
    Run,
    Medium,
    [9393406],
    "Abahinga bakeka ko ikirere coba gifise nk'imyaka imiriari cumi na zine.",
  ),
  (Run, Medium, [7921904], "Ushaka ko ndagusigira irangi ku nzara zawe?"),
  (Run, Medium, [9329383], "Ndagiye kuryama, ejo nzozinduka kare cane."),
  (Run, Medium, [8364251], "Ntidushobora kugenda ubu nyene."),
  (Run, Medium, [9789713], "Nshaka kubaho nk'umuganwa ariko ndakenye."),
  (
    Run,
    Medium,
    [7634388],
    "Iminsi yose aja ku kazi n'amaguru, kiretse iyo imvura igwa.",
  ),
  (Run, Medium, [8669608], "Nimufate asenseri ishika kw'igorofa rya gatanu!"),
  (
    Run,
    Long,
    [8290710, 7452302, 8425412, 8736457, 9329151, 7456600, 9131591],
    "Nshobora kutumako kimwe? Nta n'umwe azi imvo. Munyuma zawe, yaciye aza. Yatunzwe n'abaganga. Imbwa zirarira urugo neza. Ndashobora kwinjira? Sinkunda amareresi ababaje.",
  ),
  (
    Run,
    Long,
    [9131593, 9131566, 7036946, 7217054, 9789526, 7031670],
    "Umeze ute uyu munsi? Yatuzaniye amakuru ababaje. Rengane, ndakurikira. Mukeneye imfashanyo nyabaki? Impa iyo karanga muntu yanje. Ikintu cose gifise amaherezo.",
  ),
  (
    Run,
    Long,
    [8063825, 8313390, 7798266, 7452301, 8084114, 8313685, 8393865],
    "Ndi uwo afise umuduga. Turi abagenzi ba kera. Mbwira umugambi wawe. Nta n'umwe azi igituma. Nshaka ko uhimbarwa. Sinibaza ko ari vyo. Yama ari iruhande yanje.",
  ),
  (
    Run,
    Long,
    [7901964, 9171440, 7948225, 8010996, 8351725, 7798388, 7948335],
    "Ndafise ibikorwa vy'ishure. Umwana wanje ararwaye. Iki ciyumviro cari icande? Sindashaka kuba ngaha. Nahakuye abagenzi benshi. Ntidushaka kubimenya. Ndashobora kubibona kandi?",
  ),
  (
    Run,
    Long,
    [8074011, 7921896, 9130265, 8185160, 7925712, 8260620],
    "Mbirizwa kuvyiyumvira. Ntibikenewe ko mwinyegeza. Barunguruza bukebuke. Mfise imyaka cumi n'ibiri. Kubera iki abantu bavuga ivyo? Ubu ntidushobora guhagarika.",
  ),
  (
    Run,
    Long,
    [8974614, 8287343, 7827727, 8374850, 8224138, 8393862],
    "Nta mwanya munini mfise ubu. Afise imyaka icumi n'indwi. Umuryango wiwe urihe? Ni kare cane kugira tuvugane. Ndagusavye, ubizirikane. Abakobwa bandi bari he?",
  ),
  (
    Run,
    Long,
    [9789647, 8425905, 8667501, 8530436, 7611131, 8084228],
    "Uzonzanira iki niwagaruka ? Ni inyoni nziza cane. Urukoba rwanje rurumye. Iri barabara ntirirengana. Mbwirizwa guheraheza. Ishure ryawe riragushimisha?",
  ),
  (
    Run,
    Long,
    [8447121, 7836007, 9364109, 8253727, 8667483, 9329191],
    "Murakoze kandi ni agasaga! Nta mahera yari agifise. Ivyo biti ni birebire. Sinshobora kubiraba. Sinshaka ko abantu bambonana nawe. Ingenzi nyinshi ziraza muri iki gisagara.",
  ),
  (
    Run,
    Long,
    [8363887, 8669857, 8667424, 9117413, 8374939, 8609075],
    "Hari vyinshi vyo gukora. Sinigeze ndamwumva aririmba. Yambaye ikostim ishaje. Ivyo yavuze vyaradushavuje cane. Igishika co kukubona kigiye kunyica. Ndafise ubwoba bwo kugenda jenyene.",
  ),
  (
    Run,
    Long,
    [8222259, 7818464, 7775043, 9787141, 9329093, 8488511],
    "Mfise ibitabu vyinshi. Ndazi ingene bateye. Si ikintu co kwishimira. Aronka umushahara ukwezi guheze. Ibihugu biteye imbere birimwo amazu meza. Ndafise imbwa zitatu.",
  ),
  (
    Run,
    Long,
    [8609061, 7902050, 7698745, 7587827, 7022408],
    "Mwaramutse, ndashobora kuvugana n'umushingantahe Johnson? Bavuga ko atunze cane. Ivyirabura ni ivyanje. Uracababara ku kuguru kwawe kw'ibubamfu? Iyi mbugita irapfushe.",
  ),
  (
    Run,
    Long,
    [8001803, 8915830, 8063776, 9062428, 8613978],
    "Ndagutwara kw'ishure. Nzero ni ukwezi kwa mbere kw'ikalendari. Mfise kimwe mu muduga. Nasubiye kugishira mu kibanza caco. Rimwe, kabiri, gatatu, kane, gatanu, gatandatu, indwi, umunani, icenda, icumi.",
  ),
  (
    Run,
    Long,
    [7591785, 8287327, 7286568, 7125476, 8965463, 8749271],
    "Indoto yanje yabaye ukuri. Mfise inyonko ihambaye. Umuduga wanje urihe? Hari umuntu inyuma y'uruhome. Oya, urambabarira, ntitubikora ata gakingirizo. Nzogenda mu mwiyerekano.",
  ),
  (
    Run,
    Long,
    [8073982, 8001698, 8689046, 8689049],
    "Ndarondera musazanje. Kubera iki utari mw'isomero? Uheruka gutamba ubwa nyuma ryari? Bose bavuga ngo nabaye intwari, ariko naranguye igikorwa canje gusa.",
  ),
  (
    Run,
    Long,
    [8609112, 8491828, 7634409, 7902067, 7100108],
    "Turi mu nzira igana i muhira. Ijambo ryiwe ryari agahore. Muri ico gihe nararavye ya cenema wamye urata. Mubwirizwa kumperekeza. Ntashobora kuza kubera ko ararwaye.",
  ),
  (
    Run,
    Long,
    [7693933, 8852680, 8388106, 8253801, 7783048, 7858930],
    "Mpamagara hagati y'isaha imwe n'isaha zibiri. Nditwararitse umutekano wiwe. Twagenze inzira ndende. Tubwirizwa kuganira. Nibajije ko ndakuzi. Igituma c'urugendo rwanyu ni nyabaki?",
  ),
  (
    Run,
    Long,
    [8232351, 9127356, 8749342, 8852131, 8613979, 8923709],
    "Abantu benshi bagiye. Amahera avunjwa gute ubu? Nta bindi bibazo mfise. Nzokwabira ku wa mungu uza. Mw'ijoro inyabu zose zirasa. Musazanje yashatse kugenda wenyene.",
  ),
  (
    Run,
    Long,
    [7217173, 7858925, 9778915, 8425892, 8396207, 7852172],
    "Shira imeza yo gukora ku ruhome. Muritwararike umutwe wanyu. Urubanza rwagenze neza? Nsumira ijisho gusa. Ku wa gatatu haza ni sawa. Kubera iki ataho tutajana?",
  ),
  (
    Run,
    Long,
    [8350540, 8517018, 7350122, 7872473, 8626161, 8232036, 8488485],
    "Nshobora kuza iwawe? „Murakoze!“ – „Korerwa!“ Inzu yanje iri hafi y'urusengero. Iyi nyabu ni iyanje. Urashobora kwidondora? Ishuri rihera ryari? Uko wunguka niko ubitanga.",
  ),
  (
    Run,
    Long,
    [8388083, 9095267, 8313661, 9393365, 9789620, 8738396],
    "Ni vyose dushobora kubaza. Sintegereye neza itangazo. Nzogerageza vyose uko nshoboye. Nubatse mfise imyaka cumi n'icenda. Kanyenyeri yarezwe neza. Navyutse hakiri mw'ijoro.",
  ),
  (
    Run,
    Long,
    [9213121, 7100102, 9778724, 7782385],
    "Sogokuru yari yujuje imyaka mirongo umunani n'icenda. Urarwaye, ubwirizwa kuruhuka. 8. Umwigeme= Umuzenzwanzu=Umukamakare=Umukobwa Kubera iki utumviriza?",
  ),
  (
    Run,
    Long,
    [7872325, 7818492, 9364113, 8001618, 9075026, 8524513, 8073962],
    "Ndyama uko zandemye. Reka kunsomborotsa kubivuga! Ico gitabu kirashaje. Turi ngaha ku bwawe. Nobabara, ariko sinokwiyahura. Ndazi umuhungu wawe. Ubwirizwa kuntega amatwi.",
  ),
  (
    Run,
    Long,
    [8974617, 8669657, 7350127, 8001752],
    "Ndabasavye mwishure ikibazo canje. Yashoboye kugura umuduga mushasha n'ayo mahera. Inzu yanje iri hafi y'inyubakwa yo gusengeramwo. Ngaha nta n'umwe afise umuduga.",
  ),
  (
    Run,
    Long,
    [9393413, 9191857, 8388131, 8390969, 7858926, 9191831],
    "Akurusha imyaka icumi. Sinshaka ko umwana wacu yarukira ngaha. Wari kungirira co kimwe. Nzanira ikinyamakuru c'uyu munsi! Uzofata urugendo wenyene? Umwana yaciye arekura ukuboko kwa nyina.",
  ),
  (
    Run,
    Long,
    [9191849, 7635066, 8736846, 8390941, 7037064, 7694032],
    "Guma hamwe bishoboka! Sintegera ingene bimeze. Sinzi ingene umuntu ashikayo. Umuvyeyi wanje arakunda imuziki. Nta n'umwe yumviriza. Iri jambo riva mu kigereki.",
  ),
  (
    Run,
    Long,
    [7716778, 8388050, 9789796, 9371535, 8686855],
    "Amahera yanje ari hehe? Sinshobora kuvyemeza neza. Iteriteka ni umuhinga mu vy'imibano. Imbere ya Noeli abantu benshi barashariza amadirisha y'inzu. Nyizere ko nashaka kubafasha.",
  ),
  (
    Run,
    Long,
    [8010991, 8689034, 8364250, 7783027, 8350730, 8185166],
    "Ntimushaka kumenya igituma? Hari impanuka kujayo wenyene. Sinshobora kubakorera. Mvuga ico niyumvira. Uwa mungu uza sinzoba ndi i muhira. Hari umuntu yakubonye.",
  ),
  (
    Run,
    Long,
    [8063939, 7875054, 9786906, 8063777, 7921905],
    "Ndashaka kumenya iki ico arico. Iryo kanzu rikozwe mw'iharire. Igisara ca Bujumbura kibamwo abantu benshi. Ndafise kimwe mu muduga. Uracambara ikareso imwe?",
  ),
  (
    Run,
    Long,
    [7832602, 7291132, 8063946, 8063812, 8736836, 9786990],
    "Ni igihe co kuruhuka gatoya. Iki gitabu ni gishasha. Ndakunda iyo ubikora. Sinibaza ko ndakuzi. Ntiyaje kundaba ku wa mungu ahubwo ku wa mbere. Igihugu c'amavukiro canje ni Uburundi.",
  ),
  (
    Run,
    Long,
    [7980935, 8287214, 8085294, 8667444, 9787107],
    "Urategera ivyanditse ngaha? Yafashe akaruhuko indwi imwe. Ndabasavye muhagarare. Yangiriye ishari kubera uburoranirwe bwanje. Ku rubanza rwanje rw'ubugeni natumiye abagenzi banje bose.",
  ),
]

