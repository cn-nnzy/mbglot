  (Hrv, Short, [655402], "Vi ste njezine kćeri."),
  (Hrv, Short, [6158881], "Tom i Mary su bili prijatelji."),
  (Hrv, Short, [2213807], "Živio je jednostavnim životom."),
  (Hrv, Short, [2220505], "Mlađa samo od njega."),
  (Hrv, Short, [4701389], "Karton je jači od papira."),
  (Hrv, Short, [6082613], "Tko vidi moju knjigu?"),
  (Hrv, Short, [2220543], "Odbila je dati komentar."),
  (Hrv, Short, [5010753], "Soba je prazna."),
  (Hrv, Short, [11175311], "Rizik je prevelik."),
  (Hrv, Short, [2156894], "Maknite svoje ruke od mene!"),
  (Hrv, Short, [12413946], "Znam tvoju adresu."),
  (Hrv, Short, [3957410], "Želim ti nešto reći."),
  (Hrv, Short, [13642911], "Tom treba znati da smo ovdje."),
  (Hrv, Short, [1050921], "On kupuje odjeću."),
  (Hrv, Medium, [1053989], "Htio bih razgovarati s Tonijem."),
  (Hrv, Medium, [1054018], "Nije tako teško kao što se misli."),
  (Hrv, Medium, [1128255], "Kako si objasniti ovu činjenicu?"),
  (Hrv, Medium, [14012769], "Ona sjedi u kuhinji i pije čaj."),
  (Hrv, Medium, [934341], "Doslovce sam shvatio njezine riječi."),
  (
    Hrv,
    Medium,
    [1041600],
    "Često se spotaknem od nešto kao ništa ne vidim, poput šišmiša u mraku.",
  ),
  (Hrv, Medium, [2213782], "Koristi ga mudro i ne rasipaj ga."),
  (Hrv, Medium, [5741810], "Ljubav nije nikad nikoga ubila."),
  (Hrv, Medium, [1100907], "Ono što si učinio je za pohvalu."),
  (Hrv, Medium, [957891], "Provalio sam vrata jer sam izgubio ključ."),
  (Hrv, Medium, [6933649], "Bio sam preumoran da išta pojedem."),
  (Hrv, Medium, [6085296], "Možeš li pročitati onaj znak ispred nas?"),
  (
    Hrv,
    Medium,
    [2197364],
    "Grčki i latinski su korisni jezici, zato ih učim.",
  ),
  (Hrv, Medium, [1122636], "Ja se moram vratiti doma do sedam sati."),
  (Hrv, Medium, [6191062], "Anđeo se gospodnji u snu ukaže Josipu."),
  (Hrv, Medium, [1434479], "Oprostite, mislim da sam nazvao krivi broj."),
  (Hrv, Medium, [3249456], "Moramo izići na sljedećoj postaji."),
  (
    Hrv,
    Medium,
    [1048070],
    "Moja mati nije spavala posljednja tri dana, jer je bolesna.",
  ),
  (Hrv, Medium, [14018713], "Želim te pitati o novcu koji si pronašao."),
  (Hrv, Medium, [958096], "Još imam mnogo toga za učiniti."),
  (Hrv, Medium, [2294736], "Beba još uvijek ne može hodati."),
  (Hrv, Medium, [13324029], "Izgleda da niti ja niti on nismo normalni."),
  (Hrv, Medium, [4542145], "Otkad sam došao ovdje, prošle su dvije godine."),
  (Hrv, Medium, [1048042], "Nedostaje mi moja obitelj i moja domovina."),
  (Hrv, Medium, [1053854], "Ubijala je vrijeme hodajući po trgovinama."),
  (Hrv, Medium, [14059643], "Možete li mi, molim vas, reći što se događa?"),
  (Hrv, Medium, [13377300], "To jezero ima promjer od sto metara."),
  (Hrv, Medium, [14005033], "Ako već znaš, zašto još uvijek pitaš?"),
  (
    Hrv,
    Medium,
    [5020912],
    "Sutra ujutro počinjem rano, možda bih trebao otići spavati.",
  ),
  (Hrv, Medium, [12338547], "Moja baka je postala vrlo stara."),
  (
    Hrv,
    Long,
    [6077890, 5736763, 5730192],
    "Vidite šefe, mi smo bili pažljivi kad smo se rješavali dokaza. Mogu vas uvjeriti da smo ovo uspješno zatajili. Nisam mu nikad vidio lice. Tom je zaspao dok je čitao.",
  ),
  (
    Hrv,
    Long,
    [5751314, 945182, 1053855, 936659, 1051027, 4421891],
    "Tom nema braće ni sestara. On je današnji Bach. Pričuvaj mi torbicu na tren. Nikada nećeš biti sam. Odbila je moj prijedlog. Također je kupio rječnik.",
  ),
  (
    Hrv,
    Long,
    [944960, 742803, 8226967, 670314, 13791185, 2788648],
    "Stijena visi nad morem. Izaberi jednu osobu, molim te. Njihovo cvijeće slatko miriše. Amerika je jako velika. Pitala me je o mojoj majci. Lav je kralj džungle.",
  ),
  (
    Hrv,
    Long,
    [1432345, 10129378, 11355569, 5577822, 11170801, 12403556, 655470],
    "Dobro se osjećam, a ti? Majoneza se pravi od jaja. Počeo sam novu dijetu. Nismo mogli to napraviti. Ona želi biti heroj. Kako se zove tvoj konj? Žena mu je otvorila vrata.",
  ),
  (
    Hrv,
    Long,
    [949755, 933776, 1100780, 1101955],
    "Bilo je oko tisuću ljudi. Zaboravio sam ga pitati. Neki vjeruju da britanska kraljevska obitelj potječe direktno od obitelji kralja Davida. Moram se voziti autom u grad.",
  ),
  (
    Hrv,
    Long,
    [1059386, 2213854, 10826644, 699842, 1041618, 960603],
    "\"iPhone\" je izvanredni mobitel. Jesi li već uzeo svoj lijek? Uzimam satove ruskog jezika. Triput mjeri, jednom sijeci. Pravda je na mojoj strani. Ta torba nije dostupna ni u jednoj trgovini.",
  ),
  (
    Hrv,
    Long,
    [12167476, 2157050, 3457777, 5751317, 6082565, 6024240],
    "Mogu li platiti kreditnom karticom? On kaže da sam oprezan. Hvala na vašoj čokoladi. Tome, imamo problem. Gospodin satnik sada zapovijeda dosta tiho. Moj auto je u garaži.",
  ),
  (
    Hrv,
    Long,
    [1434449, 14065523, 5579765, 2197469, 5750022, 2156736],
    "Sada nemam puno vremena. Tom je proveo vrijeme s Mary. Kad sam se jutros probudio, padala je kiša. Ne pije mi se votku. On nije tip osobe koja krade. Istina, ludo sam ju volio.",
  ),
  (
    Hrv,
    Long,
    [13257061, 1050232, 1051051, 960596],
    "Molim te, prestani raditi ovakve stvari, vidiš da smeta ljudima. Danas ujutro sam susreo Tonia na putu do škole. Banka ne radi nedjeljom. Stalno će pričati, ako ga budeš slušao.",
  ),
  (
    Hrv,
    Long,
    [2157063, 1040889, 1048081, 13778268, 14001274],
    "Molim te, dođi pokupiti me. Uvijek je bio posvećen glazbi. Tko je naslikao ovu sliku? Šibenik se nalazi između Zadra i Splita. Želim znati ono što znaš.",
  ),
  (
    Hrv,
    Long,
    [658971, 6048193, 955710, 13323883],
    "Ta gospođa, odjevena u bijelo, je poznata glumica. Fokusiraj svoj fotoaparat na cvijet. Činjenice potvrđuju tu hipotezu. Mog prijatelja dosta muči ovo područje.",
  ),
  (
    Hrv,
    Long,
    [13994915, 5579750, 658997, 1477595, 13257001],
    "Proveo sam blagdane ukrašavajući kuću. E pa, djevojke, vrijeme je za polazak. Što se dogodilo da se tako smiješ? Tom je primljen u bolnicu. Pjesma nije baš po mom ukusu, ne slažem se s njenom porukom, ali nije ni grozna.",
  ),
  (
    Hrv,
    Long,
    [1053659, 1041516, 5585608, 469089],
    "Spenser neće nikome reći o spački koju će spraviti svojim prijateljima kada se vrati. Crveno nije više moderno. Sumnjam da bi Tom bio tako glup. Moje je, nije njegovo.",
  ),
  (
    Hrv,
    Long,
    [3957087, 4543079, 1050215, 5585378],
    "Možeš li preporučiti hotel u blizini zračne luke? Pitao me je kad namjeravam kupiti novi auto. Ovaj auto je bolji u usporedbi s onim. Tom je po njezinom naglasku znao da je Mary Irkinja.",
  ),
  (
    Hrv,
    Long,
    [1051041, 3179114, 3957099, 8754234, 957853, 5580549],
    "On je visok i ona također. Njegov brat je vrlo sposoban liječnik. Tom je prijatelj iz škole. Jesi li oprala ruke? Ne trebam novac sada. Jeste li završili zadaću?",
  ),
  (
    Hrv,
    Long,
    [5741814, 1100725, 1051123, 950058, 1434476, 2156861],
    "Želim vidjeti što imaš u kući. Ispravnost informacije je sumnjiva. Pokušat ću ponovno, hvala. Stajala je blizu svoga muža. Nazvali se krivi broj. Nosiš lijepu kravatu.",
  ),
  (
    Hrv,
    Long,
    [935197, 1047892, 1047910, 950839, 3836063],
    "Dr. Patterson: Da, bilo je užasno. Volim ga, ali je dosta često preosjetljiv. Vrijedno je pokušaja. Kut od 90 stupnjeva se zove pravi kut. Svidjela mi se moja šalica čaja.",
  ),
  (
    Hrv,
    Long,
    [5026722, 12659535, 13850976, 2213849, 6064087, 536978],
    "Tom mora biti ovdje. Što radiš na računalu? Lozinka je \"lozinka\". Jedeš li špagete motajući ih oko tvoje vilice? Ti si nas to naučio. Vrijeme je tako lijepo!",
  ),
  (
    Hrv,
    Long,
    [5359653, 12554370, 1119236, 1100898, 5356937, 2220541, 5036602],
    "Vrtlarenje je zabavno. Imam sve što mi treba. Ne, ići ću se kupati. Tvoj postupak je za pohvalu. Smijem li pričati s Tomom? Koga briga za činjenice? Jesi li ikad čula za nešto slično.",
  ),
  (
    Hrv,
    Long,
    [7097791, 5582850, 6158858, 2208815, 1051523, 933857],
    "Nacrtao sam jednu kartu. Želimo sobu za četiri noći. Prema njoj, on neće doći. Rezervirali smo mjesta za predstavu. Uzmi dva-tri dana slobodno. Kiriurg me je uvjerio da se podvrgem transplantaciji organa.",
  ),
  (
    Hrv,
    Long,
    [5585376, 14051460, 1100734, 14001692, 655500],
    "Upravo sam je dovršio. Bio sam ovdje kad si ušao. Sretni smo što smo dobili bitku. Tom je imao dovoljno novca da kupi ono što je trebao. Ne može doći jer je bolestan.",
  ),
  (
    Hrv,
    Long,
    [12003069, 1051013, 659007, 13276875, 3458415],
    "Riječi nema u rječniku. Otišao je na aerodrom kako bi sreo gospodina Westa. Bez vode je nemoguće živjeti. Nestalo mi je kruha. Jesi li ikada bio stvarno zaljubljen?",
  ),
  (
    Hrv,
    Long,
    [1040875, 3457717, 1059396, 2208967, 11175400],
    "Dao sam ti nekoliko knjiga. Uvijek sam spreman za ono što slijedi. Jako su se trudili riješiti problem. Njemački mi nije jača strana. Njegov mentalni razvoj bio je spor.",
  ),
  (
    Hrv,
    Long,
    [4700931, 13984177, 1041617, 2284744, 13170456],
    "Tom je odlučio prodati automobil. Nadam se da nas Tom ne gleda. Učinio sam ga gladnim. Teško je predvidjeti kakvo će vrijeme biti sutra. Drži se dalje od psa!",
  ),
  (
    Hrv,
    Long,
    [2208320, 5738911, 14051175, 960573, 1050213],
    "Tvoji napori te nisu nikamo doveli. Rekla sam da ću te čekati. Zna li ona da sam ovdje? Majko, žao mi je što ti uvijek dovodim probleme. 4. lipnja će se udati za gospodina Johnsona.",
  ),
  (
    Hrv,
    Long,
    [6048210, 6158582, 5741800, 6085290],
    "Postoji barem jedna prednost čelavosti - štediš puno na šamponu. Što želiš danas jesti? Koliko novca zarađuje mjesečno? Jesi li primila paket koji sam ti poslala?",
  ),
  (
    Hrv,
    Long,
    [12817778, 3967542, 670235, 8226954, 10894651],
    "Molim te pročitaj stranicu devedeset četiri. Naše oči ne mogu vidjeti infracrvene zrake. Nemoj zakasniti na vlak. Novac te nužno ne čini sretnim. Jeste li kupili potpuno nov auto?",
  ),
  (
    Hrv,
    Long,
    [1119244, 1100941, 2281591, 4542083, 1100992],
    "Prešao sam rijeku čamcem. Znanstvenici pomoću lasera proizveli kišu! On ima mnogo neprijatelja u svijetu politike. On nas ne može zaustaviti. Dva dana prije vjetar je puhao.",
  ),
  (
    Hrv,
    Long,
    [949761, 1396175, 5740870, 2125334],
    "Imate li vremena da mi pomognete? Hrvatska je zemlja koja se nalazi na jugoistoku Europe. Ona provodi praznike kod strica. Bilo je nemoguće za dječaka plivati preko te rijeke.",
  ),
  (
    Hrv,
    Long,
    [10363170, 6158580, 1477358, 5027724, 1418217],
    "Što se događa u ovoj zemlji? Morao sam dati malo novaca Tomu. Jučer sam pročitao jednu vrlo zanimljivu priču. Želiš li papra na tome? Nije svjestan da nema vremena za te stvari.",
  ),
]

///|
let rows_nld : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Nld, Short, [3270169], "Hebt u een tatoeage?"),
  (Nld, Short, [11321302], "Tom is in zijn kantoor."),
  (Nld, Short, [687089], "Een kat heeft negen levens."),
  (Nld, Short, [13129833], "Kun je me leren schaken?"),
  (Nld, Short, [8287169], "Layla was stapel op jongens."),
  (Nld, Short, [7868820], "Tom wachtte binnen."),
  (Nld, Short, [10773394], "Ik probeer iets te doen."),
  (Nld, Short, [8502942], "U bent creatief."),
  (Nld, Short, [11779542], "Er is nog best wat water over."),
  (Nld, Short, [466387], "Frans is haar moedertaal."),
  (Nld, Short, [1496340], "Hier is de rekening."),
  (Nld, Short, [7694676], "Het was dringend, zei ze."),
  (Nld, Short, [8438773], "Ik wacht op bus nummer 13."),
  (Nld, Short, [7556310], "Ik ben afgevallen."),
  (Nld, Short, [946192], "Hij is fier, muzikant te zijn."),
  (Nld, Short, [10735099], "Ik vind Tom niet knap."),
  (Nld, Short, [4511639], "Ik ben gewoon benieuwd."),
  (Nld, Short, [9740446], "Ik heb dat ook zo gedaan."),
  (Nld, Short, [12491958], "Haar neus bloedde hevig."),
  (Nld, Short, [7802095], "Ik kan geen duimbreed bewegen."),
  (Nld, Short, [8075019], "Is dat verstandig?"),
  (Nld, Short, [7481214], "Hij kwam uit een ander land."),
  (Nld, Short, [10626807], "Wie was er gisteren jarig?"),
  (Nld, Short, [9066644], "Ik ben geen toerist."),
  (Nld, Short, [3697675], "Ben je zeker dat hij het was?"),
  (Nld, Short, [11207685], "Het is over vijven."),
  (Nld, Short, [7814086], "Ik opende de fles."),
  (Nld, Short, [5117288], "Is je kleermaker arm?"),
  (Nld, Short, [7481313], "Vertel me iets over uw land."),
  (Nld, Short, [8386268], "Het is jouw beslissing."),
  (Nld, Medium, [8521981], "Hij probeerde haar te reanimeren."),
  (Nld, Medium, [718653], "Hebt ge een dokter geraadpleegd?"),
  (Nld, Medium, [9446150], "We hebben geen les op Goede Vrijdag."),
  (Nld, Medium, [6724555], "Breng me alstublieft de rekening!"),
  (
    Nld,
    Medium,
    [11330558],
    "Tom zei dat hij dacht dat Maria dat voor Jan wou doen.",
  ),
  (Nld, Medium, [12376798], "Er staan veel verse eieren op tafel."),
  (Nld, Medium, [10313965], "Iedereen op dit eiland kent Tom."),
  (Nld, Medium, [10040919], "Ik spreek maar een beetje Frans."),
  (
    Nld,
    Medium,
    [8352460],
    "Baseball is in verschillende Latijns-Amerikaanse landen een populaire sport.",
  ),
  (
    Nld,
    Medium,
    [7296877],
    "Soms glimlachen de mensen als ze zich niet goed voelen.",
  ),
  (
    Nld,
    Medium,
    [10734061],
    "Ik hoop dat je die appel hebt gewassen voordat je hem ging eten.",
  ),
  (Nld, Medium, [13650126], "Je ziet er oud uit voor je leeftijd."),
  (
    Nld,
    Medium,
    [10346121],
    "Een beetje meer bescheidenheid zou je geen kwaad doen!",
  ),
  (Nld, Medium, [10810863], "Als je klaar bent kan je naar huis."),
  (Nld, Medium, [11107142], "Vorige zomer zijn we naar Hokkaido gegaan."),
  (Nld, Medium, [7759418], "Maria is verslaafd aan heroïne."),
  (Nld, Medium, [4857160], "Dat is alleen maar een schatting."),
  (Nld, Medium, [12247576], "Ik weet wat haar geholpen heeft."),
  (
    Nld,
    Medium,
    [8316299],
    "Ik ben niet volwassen, ik zie er alleen maar zo uit.",
  ),
  (Nld, Medium, [5604107], "Het minst bezochte continent is zeker Antarctica."),
  (Nld, Medium, [4943658], "Alle wegen leiden naar het einde van de wereld."),
  (Nld, Medium, [10738116], "De laarzen zitten strak om de kuit."),
  (Nld, Medium, [4368075], "Er is geen roos zonder doornen."),
  (
    Nld,
    Medium,
    [10934773],
    "Dit op zich is al moeilijk uit te leggen aan andere mensen.",
  ),
  (
    Nld,
    Medium,
    [12340275],
    "Dat zal volgens mij niet zo makkelijk voor Tom zijn.",
  ),
  (Nld, Medium, [3124192], "Ik koop het zilver van iemand die een mijn bezit."),
  (Nld, Medium, [480977], "Pakistan is een islamitisch land."),
  (Nld, Medium, [4915172], "Tom draagt gewoonlijk zijden pyjama's."),
  (
    Nld,
    Medium,
    [13038621],
    "Ik geloof niet dat een andere taal het Engels zal vervangen als universele taal.",
  ),
  (Nld, Medium, [704261], "Ik zou beter niet uitgaan vanavond."),
  (
    Nld,
    Long,
    [775230, 13036449],
    "Ik heb drie fietsen: een sportfiets, een bergfiets, en een kleine opvouwbare fiets. Na elk kwaad komt altijd het goede. Er bestaat geen kwaad dat niet altijd het goede veroorzaakt.",
  ),
  (
    Nld,
    Long,
    [9939706, 10788980],
    "Zodra ik klaar ben met het schrijven van de brief, zal ik naar het postkantoor gaan. De leraren gaven nergens om. Ze hadden geen belangstelling voor ons. Ze wouden ons gewoon uit de weg hebben.",
  ),
  (
    Nld,
    Long,
    [8303203, 693055, 8652520, 5784931],
    "Ze heeft haar salade niet opgegeten. Als niemand de koekjes wil eten, zal ik ze nemen. Ben je een honden- of kattenmens? Zou u iets voor mij willen doen?",
  ),
  (
    Nld,
    Long,
    [1478437, 741391, 10740273, 8385379],
    "Je mag wie je maar wilt meenemen. Ik heb juist de brieven herlezen die ge mij gestuurd hebt. Sami bekeek zichzelf in de spiegel. Zouden ze niet in de gaten hebben dat hun betoog ingaat tegen hun eigen gevoelens?",
  ),
  (
    Nld,
    Long,
    [10824477, 7434468, 6106704, 12146825, 811643, 6384514],
    "Tom is nog niet op de hoogte. Appels zijn noodzakelijk. Waarom schrijf je met een potlood? Heb je nu en dan maagbrand? Morgen zien we wel verder. Meneer Green, er is telefoon voor u.",
  ),
  (
    Nld,
    Long,
    [7799455, 1554258, 13659144, 11831967],
    "De trein vertrekt om half vier. Hij leest graag romans op vakantie. Jij weet perfect waarover ik het heb. De medresse van Ulugbek was een van de beste kerkelijke universiteiten van de Islamitisch wereld in de 15de eeuw.",
  ),
  (
    Nld,
    Long,
    [7682453, 9483968, 9710927, 3145684],
    "De jager schoot een beer neer. Was jullie kantoor erbij betrokken? Ik wil naar Spanje gaan. Ik ben blij dat deze zaak op een vriendschappelijke manier is opgelost.",
  ),
  (
    Nld,
    Long,
    [7303415, 11608795, 717693, 1624295, 12394787],
    "Het is vandaag Moederdag. De appel valt niet ver van de stam. Wat hebt ge tijdens het weekend gedaan? Als het regent gaan we niet naar daar. Ik dacht dat we het tegen 2:30 konden halen.",
  ),
  (
    Nld,
    Long,
    [691027, 10996380, 9928279, 8001619],
    "Zij probeerden het vijandelijk front te doorbreken. Tom is een taalwetenschapper. Ik moet u vragen om in deze beker te plassen. Moslims geloven dat Mohammed Gods boodschapper is.",
  ),
  (
    Nld,
    Long,
    [13300074, 10339228, 3560100, 4943786],
    "Waar heb je de afstandsbediening verstopt? De film zal al begonnen zijn als we daar aankomen. Jij weet wat het is, toch? Ik wil niet over school praten.",
  ),
  (
    Nld,
    Long,
    [8434560, 7550412, 9525985, 764525, 924315],
    "Ik ben het niet gewend om rode wijn te drinken. Tom bezorgt pizza's. Hoe hebt u vorig jaar Kerstmis gevierd? Neem zoveel mee als ge nodig hebt. De sterren schitterden de hele tijd.",
  ),
  (
    Nld,
    Long,
    [5560806, 6549664, 6036664, 384459],
    "Bananen geven energie. Zegen me, vader, ik heb gezondigd of ik zal zondigen. Ze werkt al jaren bij de universiteit. De berg Fuji ziet er mooi uit bij zonsondergang.",
  ),
  (
    Nld,
    Long,
    [9705299, 10046484, 780604, 10204922, 10795220],
    "Hun doorlichtingsproces is zeer grondig. Hou uzelf in bedwang. De stuwdam die de rivier afdamt is heel breed. Hij komt morgenavond terug. Ben je je handtas verloren?",
  ),
  (
    Nld,
    Long,
    [4451903, 3356829, 9436449, 9818781, 3194048],
    "Dat moet je niet nu doen. Hij vertelde me: „Ik heb gisteren dat boek gelezen”. Tom at een mandarijn. Heb je de vaatwasser aangezet? U bent te gevoelig voor kritiek.",
  ),
  (
    Nld,
    Long,
    [7452175, 810480, 11905929, 7811955, 9727183, 12900979],
    "Je staat aan mijn kant, nu is alles goed. Ik hou niet van wetenschap. En Tony was de oudste. Ik heb je een e-mail gestuurd. Gelieve door te rijden! De weg naar eenvoud is geplaveid met helse moeilijkheden.",
  ),
  (
    Nld,
    Long,
    [4650491, 11907877, 11213402, 10637206, 1621023],
    "Ze heeft de sleutel tot mijn hart gevonden. Ik zei dat je op me moest wachten. Ik dacht niet over Tom. Zeg ze dat ik niet drink. Deze zomer belooft de warmste zomer van de afgelopen zesendertig jaar te worden.",
  ),
  (
    Nld,
    Long,
    [9292726, 714090, 9556195],
    "Tom en Maria konden nooit met elkaar overweg. Linealen zijn praktisch om rechte lijnen te trekken. Kinderen worden erop gewezen om de straat over te steken bij zebrapaden.",
  ),
  (
    Nld,
    Long,
    [9074186, 7142069, 8137302, 2810580, 9685514],
    "Het is een misverstand. Is Tom het daar niet mee eens? Je bent toch mijn vriend? Mijn moeder heeft een zware verkoudheid. Er zitten zes appels in de doos.",
  ),
  (
    Nld,
    Long,
    [12333073, 7992597, 13294077, 7801035, 13701885],
    "Mary zei dat ze verbaasd was. Aandacht alsjeblieft! In die tijd ging ik te voet naar school. Ik kan de druk niet aan. Misschien gebeurt dit alleen in Australië.",
  ),
  (
    Nld,
    Long,
    [3218726, 13034223, 5929946, 9462848, 6075066, 13659863],
    "Dit is een foto van mijn zus. Tom ging naar een après-skibar. Het kind is helemaal gezond geboren. Wie gaat het feest geven? Wij kunnen u helpen. Hij verpest je leven.",
  ),
  (
    Nld,
    Long,
    [10773414, 848025, 8305902, 1076157, 868927, 10039260],
    "Soms denk ik te veel na. Iedereen lacht in de foto. Bel alstublieft een ziekenwagen. Zoudt ge ooit naakt zwemmen? Wat doet de aarde draaien? We hebben nieuwe ideeën nodig.",
  ),
  (
    Nld,
    Long,
    [8099567, 8098622, 1058753],
    "Hoe waren jullie wittebroodsweken? Het lijdt geen twijfel dat hij de race zal winnen - hij is momenteel in topvorm! Hebt ge een briefje van vijf pond?",
  ),
  (
    Nld,
    Long,
    [14069919, 925334, 6323127, 8004189, 8565245],
    "Ik tipte de ober bij het afrekenen. Dat komt als geroepen. Ik heb daar zo goed als geen verstand van. Heb een gezegende Isra en Mi'raj . Tom begon zich ziek te voelen.",
  ),
  (
    Nld,
    Long,
    [6086709, 1510519, 405825, 8239561, 377905],
    "Het schip verdween achter de horizon. Hij verdient drie keer meer dan ik. Meneer Spencer werkt in een winkel. Dit probleem verbijstert me. Ik zal het nooit meer doen.",
  ),
  (
    Nld,
    Long,
    [4509282, 4722869, 10773033, 3144161, 7897975],
    "Ik denk niet dat Tom ons zal helpen. Tom vroeg me of ik zijn vader kende. Wat is je grootste project? Ik wil Kumiko ontmoeten. Tom en ik zijn vrienden.",
  ),
  (
    Nld,
    Long,
    [2339306, 741393, 7872256, 8346759, 7303994, 873261],
    "Ga niet zonder hoed uit. Ik wil ingenieur worden. Iedereen wil een langdurige vrede. Het was vanmiddag erg heet. Tom is altijd competitief geweest. Wanneer we het beste trachten te ontdekken in de anderen, halen we in zekere zin het beste van onszelf naar boven.",
  ),
  (
    Nld,
    Long,
    [7036744, 3985293, 7811519, 3837028, 8974993],
    "De begroting moet in evenwicht zijn. De volgende persoon a.u.b. Kunnen jullie onze software updaten? Ik wacht hier op haar. Er staan parkeermeters in deze straat.",
  ),
  (
    Nld,
    Long,
    [377435, 9633799, 7999034, 4514333, 13885747],
    "Dit probleem is ontstaan door een wederzijds misverstand. Ik ben niet jouw vrouw. De presentatie was een doorslaand succes. Vertel geen leugens! De Saksen uit de middeleeuwen hadden geen koning.",
  ),
  (
    Nld,
    Long,
    [1200871, 12343394, 8061060, 7613514, 8330819],
    "De intrest zal geleidelijk aan verhogen. Het antwoord van Tom verraste Mary. Ik drink net mijn koffie om wakker te worden. Dat is een mooie stropdas. Zijn schoenen zijn hier.",
  ),
  (
    Nld,
    Long,
    [6779864, 9485019, 5097964],
    "Wat is jouw favoriete gezegde? Tom en Maria zeiden dat ze dachten dat ik dat mogelijk vandaag moest doen. Het gerecht besliste dat Toms kinderen ieder tweede weekend met hem mogen doorbrengen.",
  ),
]

