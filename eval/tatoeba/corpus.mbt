    [11361244],
    "پێت وایە تیپەکەمان دەباتەوە؟",
  ),
  (Ckb, Short, [10358395], "تۆ نیگارکێشێکی باشیت."),
  (
    Ckb,
    Medium,
    [11001749],
    "بە ئەوانت نەگوت کە چیت لەو بابەتەدا نووسیوە.",
  ),
  (
    Ckb,
    Medium,
    [10932698],
    "دەمەوێت ئەم نیوەڕۆیە لە ئۆفیسەکەم بتبینم.",
  ),
  (
    Ckb,
    Medium,
    [10365835],
    "کەس تۆم ناناسێت ئەوەندەی من دەیناسم.",
  ),
  (
    Ckb,
    Medium,
    [10360115],
    "بەبێ هیچ هۆکارێک کۆبوونەوەکەی جێهێشت.",
  ),
  (
    Ckb,
    Medium,
    [10511979],
    "کوڕەکەتان لە ئەڵمانیا چی دەکات؟",
  ),
  (
    Ckb,
    Medium,
    [10351541],
    "ئەم بەیانییە خۆر دەدرەوشێتەوە، بەڵام زۆر ساردە.",
  ),
  (
    Ckb,
    Medium,
    [10618272],
    "تۆم گوتی ئەگەری زۆرە ماری بگری.",
  ),
  (
    Ckb,
    Medium,
    [10489740],
    "هیوادارم هەلێکم دەست بکەوێت بۆ پێدانەوەی ئەو چاکەیەی لەگەڵ منت کرد.",
  ),
  (
    Ckb,
    Medium,
    [10483338],
    "بەهار لەنێوان زستان و هاوین دێت.",
  ),
  (
    Ckb,
    Medium,
    [10851945],
    "هێشتا وەڵامی نامەکەمی نەداوەتەوە.",
  ),
  (
    Ckb,
    Medium,
    [10298972],
    "پێم وایە خەریکە هەڵەیەکی گەورە دەکەیت.",
  ),
  (
    Ckb,
    Medium,
    [10477145],
    "شتێک مەکڕن تەنها لەبەر ئەوەی داشکێنراوە.",
  ),
  (
    Ckb,
    Medium,
    [10930446],
    "بەکارهێنانی ئەم تەلەفۆنەم لێ قەدەغە کراوە.",
  ),
  (
    Ckb,
    Medium,
    [10513553],
    "مومکینە بەر لە تاریکبوون بگەینە ئەوێ؟",
  ),
  (
    Ckb,
    Medium,
    [9548251],
    "ئەو پارێز دەکات چونکە بڕێک کێشی زیادە.",
  ),
  (
    Ckb,
    Medium,
    [11276849],
    "ئێوە دەتوانن لەسەر حیسابی ئێمە شتێک هەڵبژێرن.",
  ),
  (
    Ckb,
    Medium,
    [10526785],
    "تۆم ئەوەندە قەڵەوە کە بەزەحمەت دەتوانێت بە پێ بڕوات.",
  ),
  (
    Ckb,
    Medium,
    [10297327],
    "باوکم ناهێڵێت ئۆتۆمۆبیل لێبخوڕم.",
  ),
  (
    Ckb,
    Medium,
    [10739860],
    "ئاردەکە تێکەڵ بە دوو هێلکە بکە.",
  ),
  (
    Ckb,
    Medium,
    [10893109],
    "بۆ ئەوەی شتێک چاک بکەیتەوە، دەبێت بزانیت چی تەواو نییە.",
  ),
  (
    Ckb,
    Medium,
    [11274622],
    "دەتانەوێت بە کام زمان ناوی گیانلەبەرەکان ببینن؟",
  ),
  (
    Ckb,
    Medium,
    [10898917],
    "پێت باشە سێوێک بخۆیت یان هەرمێیەک؟",
  ),
  (
    Ckb,
    Medium,
    [10236751],
    "تەنها دەمەوێت ببم بە کەسێکی ئاسایی",
  ),
  (
    Ckb,
    Medium,
    [10930943],
    "شتێک هەیە کە بتەوێت پێمی بڵێیت؟",
  ),
  (
    Ckb,
    Medium,
    [10351512],
    "کەس ناتوانێت ڕێگریم لێ بکات کە بچمە ئەوێ.",
  ),
  (
    Ckb,
    Medium,
    [10328331],
    "هەرچییەک دەکەیت، بە باشترین شێوە بیکە.",
  ),
  (
    Ckb,
    Medium,
    [10545865],
    "بەنیازم ئەمڕۆ پازدە کیلۆمەتر ڕابکەم!",
  ),
  (
    Ckb,
    Medium,
    [10113230],
    "داوای لێبوردنی لێ کرد بۆ درەنگکەوتنی.",
  ),
  (
    Ckb,
    Medium,
    [10126257],
    "دەتوانم بۆ چەند خولەکێک بتبینم؟",
  ),
  (
    Ckb,
    Medium,
    [10480540],
    "دەتەوێت ڕۆژێک لە ڕۆژان ببیتە باوان؟",
  ),
  (
    Ckb,
    Long,
    [10494314, 10854679, 10928578, 11373838, 10890664],
    "دوایین جار کەی چوویت بۆ مەیخانە؟ فریشتەی یەزدان هاتە خەوی یووسف. نامەوێت ئەو بزانێت لە کوێ دەژیم. چوومە کتێبخانە بۆ خوێندنەوەی کتێب. نامەوێت دایک و باوکم بزانن دوێنێ چیمان کرد.",
  ),
  (
    Ckb,
    Long,
    [10123441, 10882152, 10344685, 10507980, 10549360],
    "ئینشاڵڵا سبەی زوو دەچینە ئاکرێ. سامی لەم گەڕەکە پێویستە وریا بێت. پێویستە هەموو شتێک بە ڕێکوپێکی بکرێت. بەداخەوە، لە قسەکانت تێنەگەیشتم. نووسەری ئەو ڕۆمانەی کە دەیخوێنیتەوە کێیە؟",
  ),
  (
    Ckb,
    Long,
    [10500106, 10854477, 10905864, 10510234],
    "هەڵوێستی ئێوە چییە لەسەر سزای لەسێدارەدان؟ بۆیە، چێژ لە هەموو ڕۆژێک وەربگرن! لە کوردستان بە کوردی قسە دەکەن. خەونێکی بینیوە بەوەی بەڕووتی هاتووە بۆ ئۆفیس.",
  ),
  (
    Ckb,
    Long,
    [10925713, 11039924, 10501820, 10120528, 10645885, 10870320],
    "من خاوەنی ئەم موڵکەم. تۆم پرسیار لە مامۆستا دەکات. تۆم چەقۆیەک تیژ دەکات. نەیجیریا دانیشتووانێکی زۆری موسڵمانی هەیە. خەمبارم لەو بارەیەوە. تۆم ناتوانێت لەگەڵ فشار هەڵبکات.",
  ),
  (
    Ckb,
    Long,
    [10545818, 10550784, 9780141, 10122503, 10501872],
    "سامی نەیتوانی خۆی کۆنتڕۆڵ بکات. تۆم لە ڕووداوێکی هاتوچۆ نەمرد. ئەم ملپێچە لەلایەن مارییەوە چنراوە. ئەو پارەیەت بەدەست گەیشت کە بۆم ناردیت؟ دەمتوانی بە نهێنی بیهێڵمەوە، بەڵام بۆ ماوەیەکی زۆر نا.",
  ),
  (
    Ckb,
    Long,
    [10502961, 13661338, 10301258, 10932676, 10552407, 11276959],
    "گیانلەبەری دڵخوازت چییە؟ پێشبینی بینینت دەکەم خۆی وا پیشان دەدا کە خەوتووە. ناتوانم سندوقەکە بکەمەوە بەبێ ئەوەی بیشکێنم. تۆم ساڵێک لە ماری گەورەترە. سێ ساڵ لەمەوبەر درەختی میوەی جۆراوجۆرم لەسەر موڵکەکەم چاند.",
  ),
  (
    Ckb,
    Long,
    [10737695, 10124176, 10867642, 10311253],
    "زۆری نەبرد، چایەکە ئامادە بوو. کچەکەی سامی وەک کوڕێک خۆی پۆشی بوو. تۆم لە شوێنی وەستانی پاس چاوەڕێی ماری بوو کاتێک بینیم. سامی لەگەڵ پۆلیسەکان ژوورەکەی بەجێهێشت.",
  ),
  (
    Ckb,
    Long,
    [10295442, 10552494, 10494362, 10356800, 10476685],
    "تۆم ڕۆیشتە ژووری نووستنەکەی. بەدرێژایی ڕۆژ هیچم نەبووە بیخۆم. ئاو لە سەد پلەی سیلیزی دەکوڵێت. دەبێت بە هەموو ئیمکاناتێک بەر بە شەڕ بگرین. سامی لەیلای لە فەیسبووک دۆزییەوە.",
  ),
  (
    Ckb,
    Long,
    [10538751, 10552408, 9810492, 10104986, 10885994],
    "پەپوولەکانی ئەم جۆرەیە ئێستا قڕ بوون. دەتوانیت پیاوی نێو ئەم وێنەیە بناسیتەوە؟ من و تۆم لە پشتەوە دانیشتین. ئەم ساڵ وشکە ساڵییە. کچەکەی حەوت ساڵ لەمەوبەر دیار نەما.",
  ),
  (
    Ckb,
    Long,
    [10358342, 11458870, 9846387, 10521754, 10518199],
    "بۆچی پێت نەگوتم کە تۆم کچێکی هەیە؟ گرێبەستەکە بە قەڵەمدار واژۆ مەکەن. پەنجەرەکەم کراوە بوو. پێم وایە دەزانیت ئەوە بیرۆکەیەکی باش نییە. لە ئێستاوە پلانم داناوە.",
  ),
  (
    Ckb,
    Long,
    [10503612, 10521841, 10117333, 10293132],
    "بیرم کەوتەوە دەرگاکە قوفڵ بدەم، بەڵام لەبیرم چوو پەنجەرەکان قوفڵ بدەم. تێزەکەم لەسەر ئەمە نووسی. کام لاپەڕەت بۆ بخوێنمەوە؟ کامێرایەکم گۆڕییەوە بە گیتارێک.",
  ),
  (
    Ckb,
    Long,
    [10128455, 10365907, 9839570, 11015252, 10910684, 10489982],
    "کەس لە زەماوەندەکەتان گۆرانیی گوت؟ بۆنی چێشتلێنان برسیم دەکات. وابزانم ئێوە دەزانن باسی کێ دەکەم. نامەوێت هەڵامەتی تۆ بگرم. هیچ خواردنێک نەماوە. دەتەوێت بەردەوام بم؟",
  ),
  (
    Ckb,
    Long,
    [10609845, 10311479, 10496910, 9548238, 11045685],
    "تۆم گوتی من لە باوکم ناچم. دڵخۆشم بە بینینەوەتان. لەم بارەیەوە قسەت لەگەڵ دایک و باوکت کردووە؟ تۆم مامۆستاکەی بەدڵە. زۆرێک لەو کەسانەم بەدڵ نییە کە کاریان لەگەڵ دەکەم.",
  ),
  (
    Ckb,
    Long,
    [10882423, 11057391, 10351619, 10332121, 10488492],
    "پێم وانییە کە باوکت پەسەندی بکات. ئەو کابرایە نەیهێشت بە ئیسراحەت ئاوێ بخۆمۆ. تکایە سپلیتەکە دادەگیرسێنیت؟ ئێمە هەموو ڕۆژێک دار پارچە دەکەین. لەگەڵ هاوڕێکانی قسە دەکات.",
  ),
  (
    Ckb,
    Long,
    [11042772, 10474154, 10360206, 10477340, 10294326],
    "کەسێک دادەمەزرێنێت کە بە ئینگلیزی قسە بکات. هەندێک جار زیاتر لە کەسێک پێویستە بۆ کردنی ئەمە. پێشتر ئەم کتێبەم خوێندووەتەوە. کە جام پڕ بوو، لێی دەڕژێ. پێم وایە ڕەنگە تۆم کەمێک بێئارام بێت.",
  ),
  (
    Ckb,
    Long,
    [10344051, 10122346, 10488559, 10645161],
    "ڕاستە ئەو پیاوێکی خوێندەوارە، بەڵام خاوەنی عەقڵی سەلیم نییە. هەموو قوتابخانە حکوومییەکان داخران. زمانی فەڕەنسی فێر دەبم. ڕقی لە زوو هەستانە لە بەیانیان.",
  ),
  (
    Ckb,
    Long,
    [10552262, 10345972, 10559789, 9832289, 4485608],
    "ئەو دەزانێت من حەزم لێیەتی. ئەم قەڵەمە لەوە باشترە. هەندێک گیانلەبەر زایەند دەگۆڕن. قەت بە فڕۆکە گەشتم نەکردووە. بە تۆمم ووت کە دەتوانم هاوکاریت بکەم.",
  ),
  (
    Ckb,
    Long,
    [10549059, 10285099, 10847343, 10328937, 10358338],
    "توێژینەوەکانی دیکەش ئەنجامی هاوشێوە نیشان دەدەن. تۆم لێرە ئەوە ناکات. تۆم لە کەسانی وەک ئێوە ناترسێت. ئامادەکاریی گەشتەکەت تەواو کردووە؟ من دەزانم کە ئەوە بیرۆکەیەکی باش نییە.",
  ),
  (
    Ckb,
    Long,
    [9812854, 10288442, 10489811, 11276872, 10494072],
    "لە حەوزەکە مەلە دەکات. من دەتوانم بۆ تۆی بکەم. هاتە ئێرە پێش ئەوەی قوتابخانە تەواو بێت. خاوەنی ئەم کەشتییە کێیە؟ هەمووان لێرە دەزانن ئێمە گۆشتی بەراز ناخۆین.",
  ),
  (
    Ckb,
    Long,
    [10311474, 11276882, 10293295, 10526774],
    "تکایە گڵۆپەکە بکوژێنەوە کاتێک ژوورەکەت بەجێھێشت. لە حەڤدە ساڵی مێردی کرد. ناوی ڕاستەقینەی خۆمم بە پۆلیس نەدا. ئامۆژگاریتان دەکەم بە زووترین کات ئەوە بکەن.",
  ),
  (
    Ckb,
    Long,
    [10538819, 10332077, 10336459, 10336409],
    "تۆم زۆر حەزی لە پاڵکەوتنە لەسەر چیمەن لە ڕۆژێکی خۆرەتاو. دڵگرانین بە لەدەستدانی ئازیزەکەتان. ئەمە ئەو نەخۆشخانەیەیە کە تێیدا لەدایک بووم. تۆم داوای لێ کردم ئەوە نەکەم.",
  ),
  (
    Ckb,
    Long,
    [10911263, 10484611, 10504743, 10919399],
    "بوونە مرۆڤێکی باش لەم جیهانەدا ئاسان نییە. پێویست دەکات شتێک بێنم بۆ خوێندنەوە؟ تەنیا گەمژەیەک هەرگیز بیری ناگۆڕێت. گرنگ ئەوەیە کە خولیای تایبەت بە خۆت هەبێت.",
  ),
  (
    Ckb,
    Long,
    [10543020, 10311251, 9392996, 10550947],
    "هەرگیز متمانەم بە تۆم نەکردووە و گومانم هەیە هەرگیز بیکەم. سامی ژوورەکەی لەگەڵ پۆلیسەکان بەجێهێشت. په‌رتوکه‌که‌ له‌سه‌ر مێزه‌که‌یه‌. تۆم دەڵێت کە ناتوانێت چیتر گوێ بەو دەنگەدەنگە نەدات.",
  ),
  (
    Ckb,
    Long,
    [10558314, 10508466, 10477640, 10552373, 10347944],
    "پێت باشە دەمانچە قەدەغە بکرێت؟ هێشتا لە خەڵک تێناگەم. ئاخێوەرێکی ڕەسەن هەڵەکانمی ڕاست کردەوە. زۆر دڵخۆش بووین بە بینینی تۆم و ماری. ئەو خوێندکارانە خێرا تێدەگەن.",
  ),
  (
    Ckb,
    Long,
    [10897477, 10479696, 10542841, 10857873],
    "یەکەم هەنگاو بۆ چارەسەرکردنی کێشەیەک ئەوەیە دان بەوەدا بنرێت کە کێشەیەک هەیە. پشیلەیەک لەژێر مێزەکەوە هاتە دەر. دەتوانم ڕوونی بکەمەوە. گەشتکردن بۆ ژاپۆن چەند گرانە؟",
  ),
  (
    Ckb,
    Long,
    [10474137, 10122350, 10562245, 10518209, 10545723],
    "کاتێک گەیشتم، هەمووان ڕۆیشتبوون. سیاسەتوانەکە وەڵامی پرسیاری ڕۆژنامەنووسان دەداتەوە. ویکیپیدیا بەکاربھێنن. ڕێنمایییەکانم نەخوێندەوە. ژمارەیەکی زۆری جەزائیری هەن کە لە دەرەوەی وڵات کار دەکەن.",
  ),
  (
    Ckb,
    Long,
    [9841435, 9810445, 10892605, 10479934, 10308109],
    "لە قورئان چەندین موعجیزەی زانستی ھەن. تکایە چەند خولەکێکم پێ بدەن. تا ئێستا درۆتان لەگەڵ دایکتان کردووە؟ هەرگیز نەمانزانی چی ڕووی دا یان بۆچی. ئەوە گەورەترین دەستکەوتمان بوو.",
  ),
  (
    Ckb,
    Long,
    [10535426, 10509853, 10364479, 10324865, 10508025],
    "لەیلا سزای هەتاهەتایی بەسەر سەپێنرا. مانگ هەمیشە یەک دووری نییە لە زەوییەوە. ئەوە ڕێککەوتنەکەمان بوو. فێربوونی زمانێکی نوێ ئاسانترە کاتێک گەنجیت. لەگەڵ سکرتێرەکەی پەیوەندیی هەیە.",
  ),
  (
    Ckb,
    Long,
    [10620503, 9812792, 10521796, 10928579],
    "یۆنان وڵاتێکی پەرەسەندووە. تۆ زۆر زیاتر لە من پێڵاوت ھەیە. کورسییەکەی خۆی دا بە کەسێکی بەتەمەن. کۆمەڵگای بەنگلادیش هەوڵیان دا وێنەگرتنی فیلمەکە بوەستێنن.",
  ),
  (
    Ckb,
    Long,
    [10511931, 10882416, 10534863, 9798599, 10115148, 10332191],
    "دەبێت فەرشێکی نوێ بۆ ژوورەکە بکڕم. گرووپەکە بەردەوام بوو لە کارکردن. کێ دوورگەکەی کەشف کرد؟ ئەو ھەرگیز ئەو ڕۆژە لەبیر ناکات. باش ناهێیتە پێش چاو. بۆچی هەمیشە شەڕ دەکەن؟",
  ),
]

