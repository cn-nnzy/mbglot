let rows_koi : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Koi, Short, [5966380], "Ыджыт спасибо!"),
  (Koi, Short, [5966406], "Нем понда."),
  (Koi, Short, [5966480], "Тіян чужӧм меным тӧдса."),
  (Koi, Short, [5966375], "Звонитӧ телефонӧт."),
  (Koi, Short, [5865156], "Ме кывза Тіянӧс."),
  (Koi, Short, [5966281], "Кыдз здоровьеныт?"),
  (Koi, Short, [5966287], "Адззисьлытӧдз!"),
  (Koi, Short, [5966276], "Кыдз ни олат?"),
  (Koi, Short, [5966347], "Пантасям рытнас."),
  (Koi, Short, [5966453], "Баитӧ горӧнжыка."),
  (Koi, Short, [5966385], "На здоровье."),
  (Koi, Short, [5966465], "Бур лун тіянлӧ!"),
  (Koi, Short, [5865163], "Этӧ кывсӧ ме ог тӧд."),
  (Koi, Short, [5966354], "Пантасям ашын."),
  (Koi, Short, [5966260], "Олат-вылат."),
  (Koi, Short, [5966320], "Вовлӧ миянӧдз!"),
  (Koi, Short, [5966285], "Адззисьлытӧдз."),
  (Koi, Short, [5865157], "Кыным Тіянлӧ год?"),
  (Koi, Short, [5966503], "Дона я эта?"),
  (Koi, Short, [5966371], "Гижӧ меным."),
  (Koi, Short, [5865152], "Локтӧ нянь сёйны!"),
  (Koi, Short, [5865162], "Мый йылсь сія висьтасьӧ?"),
  (Koi, Short, [5966294], "Быдӧс бурсӧ!"),
  (Koi, Short, [5865159], "Ӧні кытӧн Ті олат?"),
  (Koi, Short, [5865158], "Кытӧн ті чужит?"),
  (Koi, Short, [5865165], "Тэ менӧ вежӧртін-эн?"),
  (Koi, Short, [5966511], "Кытӧн кассаыс?"),
  (
    Koi,
    Medium,
    [5865166],
    "Кыдз тэнат фамиллё, ним да айнимыт?",
  ),
  (
    Koi,
    Medium,
    [5865154],
    "Меным сьӧлӧм сьӧрті тӧдсасьӧмным.",
  ),
  (
    Koi,
    Medium,
    [5865160],
    "Сідз-ту вежӧртышта, а баитнытӧ ог куж.",
  ),
  (
    Koi,
    Medium,
    [5966417],
    "Позьӧ звонитны тіян телефон вывсянь?",
  ),
]

