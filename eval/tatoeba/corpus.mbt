  (
    Tha,
    Medium,
    [12742436],
    "เขาเป็นคนที่ไม่เหมาะกับงานนั้นมากที่สุด",
  ),
  (
    Tha,
    Long,
    [8817569, 12659901, 10239111, 10469196, 7879109, 8671235],
    "คุณรู้ไหมว่าเธอเป็นใคร? ทอมยังไม่บรรลุนิติภาวะ ผมขอนั่งตรงนี้สักครู่ได้ไหม คุณไม่ควรดื่มในขณะท้องว่าง คุณเป็นแม่ของทอมหรือเปล่า? ฉันอยู่ที่บ้านตอนนั้น",
  ),
  (
    Tha,
    Long,
    [10202324, 10713279, 12494815, 8671163, 10556531, 8703240],
    "การกินมากเกินไปไม่ดี อย่าลืมนำสเปรย์กันแมลงมาด้วย มีใครพูดภาษาญี่ปุ่นได้บ้าง สุนัขของใครเล่นกับทอม ผมไม่ได้ทำงานตอนกลางคืน ฉันต้องทำผิดพลาดไปแล้วแน่เลย",
  ),
  (
    Tha,
    Long,
    [12627088, 12632197, 8681605, 11114015, 11127327, 7878735, 11127325],
    "เมื่อวานฉันทำอาหารเย็น บอกชื่อร้านให้อีกรอบได้ไหม ดวงตาของเธอเป็นสีฟ้า คุณใส่ผ้าพันคอบ่อยไหม ฉันช่วยคุณไม่ได้จริงๆ ฉันยินดีที่จะช่วยคุณ คุณคือคนที่เราต้องการ",
  ),
  (
    Tha,
    Long,
    [8720118, 11480935, 12744866, 12561954, 10202128, 12579203],
    "คุณมีแผนจะทำอะไรพรุ่งนี้ไหม? เธอชอบเพื่อนของฉันไหม เขากับฉันเราต่างก็รักกัน ฉันสงสัยว่าทำไมเขาถึงไม่มา ทอมอยู่อีกฟากของแม่น้ำ ฉันไม่ชอบผู้หญิงขี้อิจฉา",
  ),
  (
    Tha,
    Long,
    [10351173, 10486725, 12659839, 8720363, 10176486, 8728779],
    "อุปกรณ์นี้ทำงานอย่างไร ทอมติดคุกตั้งแต่เดือนตุลาคม วันอาทิตย์หน้า ฉันจะไปสวนสัตว์ คุณมาถึงที่นี่อย่างรวดเร็ว ผมถามเขาว่าเขาจะไปไหน ฉันเหนื่อยและอยากไปนอน",
  ),
  (
    Tha,
    Long,
    [8994565, 8679071, 8717374, 12728302, 8669078, 8817544],
    "ฉันกำลังกินอาหารกลางวัน บ้านญี่ปุ่นมีขนาดเล็ก คุณอาบน้ำทุกวันหรือไม่? หล่อนไปที่ร้านเสริมสวย พวกเราคือประเทศที่รักสันติภาพ แม่ของฉันทำเสื้อกันหนาวให้ฉัน",
  ),
  (
    Tha,
    Long,
    [8695433, 10130338, 12581743, 12728255, 8673112, 10554112],
    "เราสามารถทำเช่นนั้นได้ แน่นอนเธอพูดภาษาอังกฤษได้ ฉันเจอน้าที่ยุโรปโดยบังเอิน ฉันอยากไปดูหนังด้วยกันกับเธอ นี่คือที่ที่พ่อฉันทำงาน ผมเคยต้องการสัตว์เลี้ยง",
  ),
  (
    Tha,
    Long,
    [8703171, 10736647, 6537618, 10692486, 1762950, 8722688, 8669484],
    "บ้านพวกนั้นมีอายุ 500 ปี ฉันคิดว่าทอมเป็นคนดี ถามผู้หญิงที่ไหนก็ได้ เราจะแก้ปัญหานี้อย่างไร ฉันชอบฝนตกในหน้าร้อน ทอมทำให้แมรี่ร้องไห้ ใครเล่าเรื่องให้คุณฟัง?",
  ),
  (
    Tha,
    Long,
    [12728318, 7766162, 8679126, 10567693, 8703063, 12627079],
    "เวลาขึ้นเครื่องกี่โมง ฉันเป็นคนทำขนมปัง ขนมอบ อย่าดื่มเบียร์มากนัก ที่นี่อากาศหนาวทั้งปี น้องชายของฉันสูงกว่าฉัน ฉันคิดว่ามันสมบูรณ์แบบ สุดท้ายก็ไม่เป็นท่า",
  ),
  (
    Tha,
    Long,
    [12529595, 12569882, 810201, 8675905, 8679117, 10200317],
    "พวกเราอยากซื้อโซฟา แต่ว่า เมื่อวานทีมของพวกเราชนะ พินัยกรรมถูกตัดสินเป็นโมฆะโดยศาล ชั้นเรียนจะเริ่มขึ้นอีกครั้งในไม่ช้า นั่นคือความผิดพลาดของฉัน คุณไม่ควรกินอาหารที่มีไขมัน",
  ),
  (
    Tha,
    Long,
    [12728298, 10116447, 10577182, 12572680, 7789815],
    "โปรดหลีกเลี่ยงการดื่มแอลกอฮอล์ทุกชนิด แผนของเราเปลี่ยนไปแล้ว ไม่มีใครอยู่ที่นั่นเหรอ ฝั่งตะวันออกของเมืองนี้เป็นป่าทั้งหมด ทอมให้มองเห็นทุกอย่างในแง่ลบเสมอ",
  ),
  (
    Tha,
    Long,
    [8673106, 12615578, 8695416, 12550090, 2185529],
    "ทอมทำงานตั้งแต่เก้าโมงเช้าถึงห้าโมงเย็น ทอมอยู่ที่นั่นตั้งแต่เมื่อไหร่ ทุกคนต้องการนั่งข้างเธอ เพื่อนบ้านของฉันคือเพื่อนของฉันเอง ในที่สุดฉันทำงานเส็รดแล้ว",
  ),
  (
    Tha,
    Long,
    [10623253, 12581744, 10365870, 12858387, 8669099, 8669213],
    "คำตอบสำหรับคำถามนี้ง่าย หล่อนเป็นพนักงานพิมพ์ดีด ผมไม่คิดว่าคุณจะชอบมัน ใครเขียนจดหมายนี้ถึงเธอ พี่สาวหรือน้องสาวทั้งสองสวย หนึ่ง, สอง, สาม, สี่, ห้า, หก, เจ็ด, แปด, เก้า, สิบ",
  ),
  (
    Tha,
    Long,
    [8718055, 12728195, 10986709, 7766174],
    "มีคนที่นี่พูดภาษาฝรั่งเศสได้ไหม? ทอมเป็นฝาแฝดกับแมรี่ ทำไมคุณไม่อยู่กับเราสักสองสามสัปดาห์ 1. ความหมายตรงตัว มันคือป้ายจราจร ป้ายบอกทาง 2. มันคือลางบอกเหตุ",
  ),
  (
    Tha,
    Long,
    [8669135, 810182, 12735485, 12589229],
    "สามีเก่าของฉันไม่อาศัยอยู่ในเมืองนี้อีกต่อไป ขอยืมใช้โทรศัพท์ของคุณได้ไหมครับ ถ้ามีคำถามขอให้ถามได้เลยไม่ต้องเกรงใจ จะเป็นไรไหมถ้าคุณไม่สูบบุหรี่ 1 อาทิตย์",
  ),
  (
    Tha,
    Long,
    [8675716, 10716581, 7920743, 8717329, 12564440, 10542958],
    "ฉันอดหัวเราะไม่ได้เมื่อได้ยินเรื่องนั้น ทอมมอบเน็กไทให้พ่อของเขา ทอมต้องการทำอย่างนั้นไม่ใช่เหรอ? คุณควรระวังสิ่งที่คุณพูด หมาตัวนี้เป็นของทอมเหรอ เราจะติดต่อกลับไปหาคุณ",
  ),
  (
    Tha,
    Long,
    [2848000, 12563961, 12569901, 8728815, 1187320],
    "ภูมิอากาศของประเทศญี่ปุ่นอ่อนกว่าประเทศอังกฤษ เขาก็เป็นมังสวิรัติเหมือนกัน พรุ่งนี้เธอจะมาใช่ไหม คุณเรียกแมลงชนิดนี้เป็นภาษาอังกฤษว่าอะไร รถของคุณแพงกว่ารถของผม",
  ),
  (
    Tha,
    Long,
    [11466421, 10300938, 10777048, 12503744],
    "ความสัมพันธ์ของมนุษย์เป็นเรื่องที่ซับซ้อนมาก นี่คือเว็บไซต์อย่างเป็นทางการ ทอมและแมรีนึกขึ้นได้ว่าพวกเขาไม่ได้อยู่แค่สองคน เขาไม่เป็นสองรองใครในวิชาคณิตศาสตร์",
  ),
  (
    Tha,
    Long,
    [10599657, 7784170, 4284488, 12659806, 12670135],
    "ความฝันของผมคือการเป็นนักดับเพลิง บอกฉันเกี่ยวกับ Tatoeba ฉันจะปล่อยสิ่งต่างๆไปอย่างที่มันเป็นเพื่อหลีกหนีปัญหา ตอนนี้ทอมกำลังมาที่นี่ หล่อนกำลังอาบน้ำอยู่",
  ),
  (
    Tha,
    Long,
    [12569808, 10220351, 12728281, 12589204, 7878982],
    "ลอนดอนเป็นเมืองหลวงของประเทศอังกฤษ อย่าทำอะไรที่เราจะเสียใจ หล่อนพูดภาษาญี่ปุ่นได้อย่างคล่องแคล่ว ฉันตั้งใจว่าจะซื้อมอเตอร์ไซต์ของตัวเอง คุณอยู่ที่นั่นหรือไม่?",
  ),
  (
    Tha,
    Long,
    [11115670, 10567566, 12632180, 11127483, 12589159, 2978357],
    "คุณจะสนุกกับการทำงานที่นี่ มีวิธีที่ง่ายกว่านั้นอีก ฉันเข้าใจว่านี่เป็นเรื่องที่เสี่ยง พวกเขาสมควรได้รับการศึกษา จริง ๆ แล้วมันมีความหมายว่าอะไร การถ่ายทอดความคิดออกมาเป็นคำพูดยากสำหรับฉัน",
  ),
  (
    Tha,
    Long,
    [10266418, 8669386, 12709863, 10455758, 4287134],
    "ทอมอยู่บนเที่ยวบินเดียวกับผม คุณทำอะไรกับกางเกงของฉัน? เรียนภาษาอิตาเลียนมาจากที่ไหน แมวสามตัวของทอมตายแล้ว ฉันทำได้แค่เพียงสงสัยว่าทุกคนเป็นเหมือนกันมั้ย",
  ),
  (
    Tha,
    Long,
    [10130473, 12691902, 12543166, 8719766, 12744607, 7784218],
    "คุณคิดว่าทอมจะมาสายไหม ฉันชอบดอกไม้มาก ๆ เลย ฉันอยากเป็นครูที่ดีมาก ๆ ทอมพูดภาษาฝรั่งเศสได้ไหม? คุณครูท่านนั้นดูแลนักเรียนของเขาได้เป็นอย่างดี คุณมีอะไรในตู้เย็นที่ฉันกินได้ไหม",
  ),
  (
    Tha,
    Long,
    [10130328, 12709834, 8669076, 8743260, 10241189, 11466436],
    "มีขวดเปล่าอยู่ในกล่อง ช้างเนี่ย ปีนต้นไหมใช่ไหม นั่นราคาเท่าไหร่ในดอลลาร์ ทอมมีความดันโลหิตสูง ผมรอมาหนึ่งเดือนแล้ว หลังจากนี้ฉันจะไปคืนหนังสือที่ห้องสมุด",
  ),
  (
    Tha,
    Long,
    [3036893, 10239082, 10597695, 7878798, 7878807, 8722707],
    "ทารกของฉันต้องการที่จะพูดคุย เราพยายามที่จะขายที่ดินของเรา ไม่มีใครคิดว่าคุณโง่ กรุณาโทรอีกครั้งในภายหลังได้ไหม? มองมาที่ฉันเมื่อฉันคุยกับคุณ! ฉันมีเวลาเหลือเฟือ แต่มีเงินไม่พอ",
  ),
  (
    Tha,
    Long,
    [12579087, 12849630, 12589498, 12670156, 3573407],
    "ฉันไม่มีอารมณ์ที่จะไปปาร์ตี้ ฉันไม่รู้ว่าจะเชิญใครดี คืนหนึ่งตอนที่ลาดตระเวนโรงเรียนมัธยมปลายฉันเจอผี พกร่มไปด้วยเผื่อว่าฝนตก นยังคงไม่เชื่อ ว่ามีเสือดาวหิมะที่อยู่ในสวนสัตว์ ฉันคิดว่าพวกมันคงเป็นสัตว์ที่ใกล้สูญพันธุ์",
  ),
  (
    Tha,
    Long,
    [12728370, 4287200, 7878958, 11470633, 7878528],
    "ชุดสูทนั้นมาจากที่ไหน เขาออกจากทีมเนื่องจากเขาไม่เข้าขากับผู้จัดการ นั่นคือสิ่งที่ทอมพูด คุณต้องการให้พยาบาลที่เป็นผู้หญิงตรวจให้ไหม ฉันอ่านหนังสือเล่มนี้เสร็จแล้ว",
  ),
  (
    Tha,
    Long,
    [12737756, 12858424, 10986750, 10277501, 12561960],
    "ขอโทษนะ วันนี้ฉันไม่มีอารมณ์ออกไปข้างนอก เธอเห็นตัวเองในกระจก คุณทำอะไรในเวลาว่างของคุณ คุณใช้เวลาเขียนหนังสือเล่มนี้นานเท่าไหร่ เขาทั้งรวยแถมยังหนุ่มแล้วก็หล่อด้วย",
  ),
  (
    Tha,
    Long,
    [4284512, 8717356, 11127472, 12627044, 12858379, 8669309],
    "แมรี่กำลังเก็บเบอร์รี่ในป่า ฉันต้องการมีส่วนร่วม พรุ่งนี้เราจะปั่นจักรยานไปทะเลสาบกัน ตุ๊กตานี้เธอทำเองเหรอ ทอมไปที่ทะเลสาบกับแมรี่ เขามาโตเกียวปีละครั้ง",
  ),
  (
    Tha,
    Long,
    [12589439, 12579263, 10736553, 4284525, 12627097],
    "เรียนภาษาต่างประเทศไม่สามารถทำได้ภายใน 2 อาทิตย์ หล่อนอาศัยอยู่ที่โยโกฮามา คุณแน่ใจเหรอว่ามีแค่สามคน ฉันคงจะขายหมาตัวนี้ถ้ามันตัวสูงกว่านี้ ทุกอย่างถูกเผาจนเป็นเถ้า",
  ),
]

