  (
    Npi,
    Medium,
    [11910442],
    "के तपाईसँग राम्रो गर्न केहि छैन र?",
  ),
  (
    Npi,
    Medium,
    [11848369],
    "\"म अस्ट्रेलियाबाट हुँ। तिमी कहाँबाट हौ?\" \"म न्युजिल्याण्डबाट हुँ।\"",
  ),
  (
    Npi,
    Medium,
    [12054743],
    "म भर्खरै इङ्गल्याण्डबाट फर्केको छु।",
  ),
  (
    Npi,
    Medium,
    [12054452],
    "मलाई लाग्दैन कि यो धेरै राम्रो विचार हो।",
  ),
  (
    Npi,
    Long,
    [12170729, 11876272, 12175324, 12208747],
    "टमकी श्रीमतीको नाम मेरी हो। मैले पहिले नै टमलाई भनिसकेको छु म उसले त्यसो गरून् भन्ने चाहन्न। मैले यो पुस्तक भोलि पुस्तकालयमा फिर्ता गर्नुपर्छ। भाषा संचार को एक माध्यम हो।",
  ),
  (
    Npi,
    Long,
    [11790992, 11858177, 12152716, 12139129],
    "म नयाँ ल्यापटप किन्न चाहन्छु, तर मसँग पैसा छैन। तपाई यस्तो पत्र कसरी लेख्न सक्नु हुन्छ ? यदि यो खायौ भने टम रिसाउनेछ। तपाईले तुरुन्तै छोड्नु राम्रो हुन्छ।",
  ),
  (
    Npi,
    Long,
    [11958200, 11848675, 11790979, 11883461, 12164841, 12208628],
    "माउन्ट फुजी सुन्दर छ। जिरी दिनहुँ अध्ययन गर्छिन्। भित्र ठाउँ खाली थियो । मैले सोचे कि यो स्पष्ट छ। तपाईं कुन हाईस्कूलमा जादै हुनुहुन्छ? टम मेरीलाई घृणा गर्थ्यो।",
  ),
  (
    Npi,
    Long,
    [12204285, 11831760, 12392598, 11998678, 11938246, 11856586],
    "म गाडीमा चढ्न भन्दा हिड्न रुचाउँछु। म ट्याक्सी चालक हुँ। बिहान छाता बोकेर जादा राम्रो हुन्छ। घण्टी बज्ने बित्तिकै आउनुहोस्। भूतहरू साँच्चै हुन्छन्? तपाईको तलको छिमेकी को हो?",
  ),
  (
    Npi,
    Long,
    [12047525, 12194633, 11764246, 11811926],
    "तपाईले त्यो किन्नु भएको पसलको नाम के हो? कृपया दुईवटा ह्याम्बर्गर र एउटा कोक दिनुहोस्। म टम क्यानेडियन हो भनेर पक्का छु। राम र लक्ष्मण जुम्ल्याहा हुन्।",
  ),
  (
    Npi,
    Long,
    [11764192, 12049521, 12401186, 12170735],
    "म संग कुकुर छ। ऊ कालो छ र उसको नाम टिकी हो। मानिसहरूले मलाई चिच्याएको मलाई यो मन पर्दैन। यस्ता किताबहरु सबै मेरो लागि बेकार छन्। बच्चालाई झोलामा नराख्नुहोस्।",
  ),
  (
    Npi,
    Long,
    [12054611, 11785019, 12049627, 11885892, 12008792, 11943328],
    "मैले तिमीलाई फोन गर्न बिर्सिए। उनीहरु फुटबलर हुन् । उनको ७१ वर्षको उमेरमा निधन भयो। को कान्छो हो, टम वा मेरी? टमले धेरै राम्रो समय बिताएको थियो। मेरो जन्मदिन अर्को हप्ता हो।",
  ),
  (
    Npi,
    Long,
    [11958204, 11973447, 12170723, 11848533, 11924413],
    "मैले माउन्ट फुजी चढेँ। हामी नेट बिना पनि भलिबल खेल्न सक्छौं। म भेडो हुँ। तिमी भेडो हौ। हामी भेडा हौं। तिमी मलाई किन दुख दिन चाहान्छौ? म तिम्रो नयाँ रूममेट हुँ।",
  ),
  (
    Npi,
    Long,
    [11811875, 12235434, 11856444, 12070665, 11855654],
    "मेरो हजुरबुबालाई रामायण पढ्न मन पर्छ। टम र म प्राय सँगै काम गर्छौ। टम आफ्नो बुबा जस्तै डाक्टर हो। के यो साँच्चै आवश्यक छ? उनी मेरी भावी श्रीमती हुन् ।",
  ),
  (
    Npi,
    Long,
    [11876278, 11858284, 11845931, 11958183, 11929451, 11925035],
    "टम धेरै भोकाएको छ, हैन? हामी बस्नको लागि ठाउँ खोज्दैछौं। टमले काम गर्न टाई लगाउँछ। माउन्ट एभरेष्ट विश्वको सर्वोच्च शिखर हो । उहाँ समयनिष्ठ हुनुहुन्छ। म उसलाई अस्पताल लैजादै छु ।",
  ),
  (
    Npi,
    Long,
    [12187602, 11919554, 11929445, 11958015, 11791017, 12065766],
    "म यसमा संलग्न हुन चाहन्न। हामी के को बारेमा कुरा गर्ने? उहाँ अविवाहित हुनुहुन्छ । के म यो केक खान सक्छु? हामीसँग साँच्चै राम्रो कार छ। यो वाक्य अपनाउनुभएकोमा धन्यवाद।",
  ),
  (
    Npi,
    Long,
    [11984030, 11861769, 12169014, 11861806, 11938401],
    "टमले आफ्नो दाहिने हातमा सानो फ्ल्यासलाइट समातिरहेको थियो। के उनीहरूलाई थाहा छ म कति वर्षको छु? के त्यो मान्छे ठीक छ? म तिम्रो कार हेर्छु। यो जम्पर धेरै महँगो छैन। यो धेरै सस्तो छ।",
  ),
  (
    Npi,
    Long,
    [11791013, 12182526, 12149961, 11922233, 11876249],
    "विज्ञान को सरल परिभाषा के हो? म स्पेनिज भाषा सिक्दै छु। टमको बुबा धनी हुनुहुन्छ। हामीले साँच्चै धेरै रमाइलो गर्यौं। सिंगल कोठाहरू पूरै बुक भइसकेका थिए।",
  ),
  (
    Npi,
    Long,
    [12182529, 11876369, 11831745, 11911095, 11840282],
    "उनी खाना पकाउन मन पराउँछिन्। चीजहरू त्यति राम्ररी बाहिर आएनन्। तपाईं समस्या को एक हिस्सा हुनुहुन्छ। तपाईहरु मध्ये कति जना हरेक दिन कफी पिउनुहुन्छ? यो सकिएकोमा म खुसी छु।",
  ),
  (
    Npi,
    Long,
    [12170655, 11765862, 12163806, 11984034],
    "\"आज मेरो जन्मदिन हो।\" \"मेरो जन्मदिन पनि आज नै हो।\" तिमीले किन विदेशीलाई मात्र रोकेको ? मलाई खेलकुद मन पर्दैन। हामीलाई रेस्टुरेन्टमा डिनरको लागि निम्तो दिनुहोस्।",
  ),
  (
    Npi,
    Long,
    [11766376, 11855650, 11911114, 11883810, 11788619],
    "राष्ट्रपति राजधानीबाट भागेका छन् । तिमी धेरै दुःखी देखिन्छौ। टम एक धेरै आकर्षक मानिस हो। म जतिसक्दो चाँडो यसलाई सक्छु। मलाई यसलाई दोहोर्याउन दिनुहोस्।",
  ),
  (
    Npi,
    Long,
    [12049644, 12159292, 11924997, 11814050],
    "यो टमको उत्कृष्ट कविताहरू मध्ये एक हो। अफ्रिकामा एक महिनाभन्दा बढी समयदेखि पानी परेको छैन। टमले मेरीलाई सावधानीपूर्वक गाडी चलाउन आग्रह गरे। आफ्नो औषधि लिन नबिर्सनुहोस्।",
  ),
  (
    Npi,
    Long,
    [12154541, 12063587, 11763402, 11878783, 12065566, 12084524],
    "यो नाम सुन्नुभएको छ? गत बिहीबारदेखि पानी परिरहेको छ। टम एक पशु चिकित्सक हो। टमले धेरै महँगो क्यामेरा किने। मलाई यो गितार मनपर्छ। मान्छेको बारेमा नराम्रो नबोल्नु नै राम्रो हो।",
  ),
  (
    Npi,
    Long,
    [11985674, 12193323, 11855656, 11876257, 11845679],
    "यो मसँग भएको एकमात्र टाई हो। मैले एउटा स्वादिष्ट मेक्सिकन रेस्टुरेन्ट फेला पारे। हामीले कहिल्यै अलविदा भनेनौं। त्यसो गर्नु अनैतिक हुने थियो। यी सबै उत्सवहरू उहाको जन्मदिनको सम्मानमा थिए।",
  ),
  (
    Npi,
    Long,
    [12344233, 11790934, 11924708, 12010598, 11756431],
    "मलाई थाहा छ तिमी के भन्दै छौ। के तपाईंलाई थाहा छ टम कहाँ गएको हुन सक्छ? मसँग जम्मा दुई घण्टा छ। मैले बिस्तारै आँखा खोलेँ। लामखुट्टेको टोकाइले चिलाउने गर्छ।",
  ),
  (
    Npi,
    Long,
    [11826238, 11939968, 11988900, 11805464, 11848295, 7298219],
    "टमले आफू एक्लो महसुस गरेको बताए। जे भए पनि त्यहाँ पसल किन ? तिमीलाई धेरै निद्रा लागेको छ, हैन? के तिनीहरू सबै यस्तै हुन्? यसले केही क्षण मात्र लिनेछ। कृपया बिस्तारि बोल्नु होस् ।",
  ),
  (
    Npi,
    Long,
    [11766017, 12148357, 12130413, 11906889, 11861932, 11877181],
    "तिम्रो उमेर कति भयो , टम? म सोध्न सक्छु यो के हो? टमले मेरीको तस्बिर जलायो। टमको रुथसँग इन्गेजमेन्ट भएको छ। \"तिम्रो राष्ट्रियता कुन हो?\" \"अंग्रेजी।\" टमले अब पर्खनु पर्दैन।",
  ),
  (
    Npi,
    Long,
    [12170738, 11861867, 12304998, 11788622, 11919556, 11858208],
    "परामर्श नलिए पनि हुन्छ हैन? के मेरो साथी बेलायती थियो? टमले लगाएको स्वेटर निलो थिएन। तिमी स्कुल जान्छौ, हैन ? मेरी अहिले खुसी छिन्, हैन र? तपाईंले टमलाई किन सोध्नुभएको छैन?",
  ),
  (
    Npi,
    Long,
    [11943285, 12196716, 11985778, 11823334, 12043145],
    "मैले पनि त्यही निर्णय गरें । गल्ती हुनु सामान्य हो। टम पहिलो पटक तीन वर्ष पहिले बोस्टन आएका थिए। म टमसँग बिहे गर्न चाहन्न। मेरो हजुरबुवाले लामो जीवन बिताउनुभयो।",
  ),
  (
    Npi,
    Long,
    [11985751, 11790976, 11970301, 12149536, 12049593, 12051530],
    "मैले उसलाई पटक्कै बुझिन। बाहिर के भइरहेको छ हेरौं। कृपया फूलहरूमा पानी हाल्नुहोस्। के यो हालको तस्वीर हो? हामीले सफा पानी पिउनुपर्छ। मलाई जापान जान मन छ।",
  ),
  (
    Npi,
    Long,
    [12168952, 12279982, 11927366, 11861876, 11763939, 11973638],
    "सूचीमा मेरो नाम छैन। म तपाईप्रति धेरै आभारी छु। मैले केटीलाई खोलामा पौडी खेलेको देखेँ। बच्चालाई देखेर म धेरै खुसी भएँ। म दिव्य संसारको देवता बन्छु। हामीले थोरै पर्खनुपर्छ।",
  ),
  (
    Npi,
    Long,
    [11979280, 12150020, 11885575, 11890797, 12086703],
    "मलाई नयाँ कारहरू प्रयोग गर्न मनपर्छ। अब मलाई सम्पर्क नगर्नुहोस्। मलाई लाग्दैन कि टमलाई कसरी पढ्ने वा लेख्न भन्ने थाहा छ। म एक डाईक्वरी चाहन्छु। म यसलाई ठीक गर्न सक्दिन।",
  ),
  (
    Npi,
    Long,
    [11890958, 12068267, 12054607],
    "तपाईले कति दुध किन्नु भयो ? सञ्जयले भने - हे राजन ! पाण्डुका छोराहरूले गरेको सेनाको सैन्य रचना देखेर राजा दुर्योधन आफ्ना गुरुका नजीक गएर यसो भने। टमले मलाई एउटा चङ्गा किन्दिए।",
  ),
  (
    Npi,
    Long,
    [12219517, 12302182, 12054599, 11814102],
    "माफ गर्नुहोस्, मैले बिर्सिएँ। आज मलाई अंग्रेजी पढ्न मन लागेको छैन। त्यो सुतिरहेको बच्चालाई हेर। इन्टरनेट भन्दा पहिलेको जीवन कस्तो थियो भन्ने कुरा सम्झन म पर्याप्त उमेरको छु।",
  ),
  (
    Npi,
    Long,
    [12027634, 11911068, 12068255, 12065318],
    "\"तिमी टमसँग साथी हौ, हैन?\" \"ओह।\" \"टम कस्तो मान्छे हो?\" टमले धेरै अवार्ड जितिसकेका छन्। हामीले स्वस्थकर खाना मात्रै खानुपर्छ। तपाइँ यो के को लागी प्रयोग गर्नुहुन्छ?",
  ),
]

