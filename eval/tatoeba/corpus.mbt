    [11494347],
    "waxaan doonayaa inaan diyaariyo maclumaad aan u isticmaalikaro barmaamuj cusub.",
  ),
  (Som, Medium, [9810937], "Tom wuxuu la koray John iyo Mary."),
  (
    Som,
    Medium,
    [9811131],
    "Waxaan u maleynayay in Tom uusan ku raaxeysan doonin safarka aniga.",
  ),
  (Som, Medium, [11491725], "Waxay go'aansatay inay u guurto Belgium."),
  (Som, Medium, [9811133], "Goorma ayuu ku noqday Mareykanka?"),
  (
    Som,
    Medium,
    [9811147],
    "Waxay ku andacoodaan in xagaaga soo socda uu noqon doono kan ugu kulul qarniga.",
  ),
  (Som, Medium, [9811222], "Liza waxay lacagteeda oo dhan ku bixisaa dharka."),
  (
    Som,
    Medium,
    [8268166],
    "Aynu halkaa uga baxno sida ugu dhakhsaha badan ee aan awoodno.",
  ),
  (Som, Medium, [9811089], "Halkaas keligaa ma tagi kartid."),
  (Som, Medium, [9811270], "Si buuxda ayaan ugu raacsanahay tan."),
  (Som, Medium, [9811033], "Markab ayaa ku degay meel u dhow halkan shalay."),
  (
    Som,
    Medium,
    [4338014],
    "Burj Khalifa waa dhismaha hadda adduunka ugu dheer.",
  ),
  (Som, Medium, [9811205], "Tom wuxuu u maleynayay inaan guuleysan doonin."),
  (
    Som,
    Medium,
    [9810980],
    "Tom si dhib yar waligiis guriga uma joogo Sabtiyada.",
  ),
  (
    Som,
    Medium,
    [9811015],
    "Gabdhaha fasalkayga midkoodna kama qurux badna Linda.",
  ),
  (Som, Medium, [9811171], "Waan daallan nahay oon harraadsan nahay."),
  (Som, Medium, [9811190], "Sami maalin kasta wuu xirtaa jiinis."),
  (
    Som,
    Long,
    [9810960, 8268161, 12409521, 5020855, 12408580, 12408607],
    "Horey ayaan ula hadlay iyada. Waxaan ku nolyahay Belfast. Maroodigu ma weyn yahay? Ku soo dhawaada Tatoeba! Magaceedu ma Maryan baa? Xaggaad ku dhalatay?",
  ),
  (
    Som,
    Long,
    [12408605, 9811324, 12408560, 12408586, 12408583, 8268154, 12408602],
    "Isagu ma macalin baa? Waa inaad qaadataa jaakadeyda. Waxaan leeyahay buug. Kani Cismaan ma aha. Magaciisu waa maxay? Waa tani jawaabta su’aashada. Waxaan ahay macalin.",
  ),
  (
    Som,
    Long,
    [9084231, 12811895, 11200532, 12408619, 4858259, 12408591, 12408572],
    "Qoraxdu waa kulushahay. sababahayga aan haaysadhaa Kani waa kumbuyuutar. Waxuu ku dhashay Muqdisho. Ingiriis miyaad ku hadashaa? Maxaad ka shaqeysaa? Magaceedu waa Xaliimo.",
  ),
  (
    Som,
    Long,
    [9084228, 4858428, 5020856, 12408564, 9811121, 9811195, 12408614],
    "Kursi weyn baan doonayaa. Magacaygu waa Maxamed. Ku soo dhawoow Tatoeba! Magacaygu waa Cabdi. Kabaha barafka ayay xirtay. Ma dareentay gariir? Waxaan ku dhashay magaalo.",
  ),
  (
    Som,
    Long,
    [12408587, 12408641, 12801226, 9811177],
    "Tani Xaliimo ma aha. Nin baa libaax dilay. Waxaan jeclahay skibidi toilet Waxaa jira warar xan ah oo sheegaya in xagjiriintu ay maleegayaan shirqool ka dhan ah dowladda.",
  ),
  (
    Som,
    Long,
    [12408616, 12408563, 13738998, 4858219, 6458131, 4338021],
    "Ma magaalo baad ku dhalatay? Magacaygu waa Siciid. Mar walba sidan ayey ahayd. Noloshaydu waa xuntahay. Diidiinka ilko ma leh. Burj Khalifa waa sarta hadda adduunka ugu dheer.",
  ),
  (
    Som,
    Long,
    [12801206, 9811098, 13594053, 12408654, 12408625, 9083433],
    "Mukulaalkiisa waan necbahay Mararka qaar waxaad ubaahantahay shukulaato. Dhalada yaa jabiyay? Geel badan ma leedahay? Ma Soomaali baad tahay? Kani ma aqalkaagii baa?",
  ),
  (
    Som,
    Long,
    [12801211, 11497844, 12408629, 12408627, 12977436, 12408622],
    "Waxa aad rabtid samey Ingiriisiga ma ku hadashaa? Ma Itoobiiyaad ku nooshahay? Ma magaalaad ku nooshahay? Magacaygu waa maxay? Waxaan ka imid Turkiga.",
  ),
  (
    Som,
    Long,
    [9811049, 4858498, 12970483, 9811255, 8268139],
    "Liisku waa sida soo socota. Waan akhrin doonaa buugga. sina wile ala awen lon tenpo suli. Tom fardaha afkiisa ayuu salaaxay. Tom iyo Marie waxay go’aansadeen inay socdaan.",
  ),
]

