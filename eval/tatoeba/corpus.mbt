  (Ilo, Short, [4678162], "Siguradoak a maawatam dayta."),
  (Ilo, Short, [4657449], "Maymaysak a mangan."),
  (
    Ilo,
    Medium,
    [4692506],
    "Imbes nga isuna, ti kabsat na nga babai ti kimmuyog kadakuada.",
  ),
  (Ilo, Medium, [5494043], "Nalaing a basketbolista ni Tom."),
  (Ilo, Medium, [4650907], "Amangan no nakaserra itan ti pagtagilakuan."),
  (Ilo, Medium, [7026348], "\"Ay-ayatenka!\" \"Ay-ayatenka met!\""),
  (
    Ilo,
    Medium,
    [4742960],
    "No adda man mapasamak bayat ti kaawanko, agdawatka kenkuana iti tulong.",
  ),
  (Ilo, Medium, [4674427], "Mano nga oras a nagbasaka kadagiti leksionmo?"),
  (Ilo, Medium, [4692693], "Nabannogen ni Tom nga agpilpila."),
  (Ilo, Medium, [4690635], "Kasano kabayagen nga estudiante ni Tom ditoy?"),
  (
    Ilo,
    Medium,
    [4664461],
    "Masapul nga aklonem nga umuna ti babakmo sakbay a pakawanenka.",
  ),
  (
    Ilo,
    Medium,
    [4677319],
    "Apay a kayat ti maysa a tao ti agnaed iti kastoy a lugar?",
  ),
  (
    Ilo,
    Medium,
    [4649592],
    "Makiiyotka kadi kaniak para iti maysa a milion a doliar?",
  ),
  (Ilo, Medium, [4692705], "Ania ti ibagbagam? Diak maawatan!"),
  (Ilo, Medium, [4690613], "Adayo kadi ti otel manipud ditoy?"),
  (Ilo, Medium, [4683692], "Ibagam kaniak no kaano nga awagannak."),
  (Ilo, Medium, [4943503], "Addaan isuna iti bassit a nangisit nga aso."),
  (Ilo, Medium, [4791521], "No saan a napasamak kenka, maysaka a birhen."),
  (Ilo, Medium, [4653832], "Saanak koma a nagul-ulbod kenka."),
  (
    Ilo,
    Medium,
    [4681031],
    "Ket nakita da ti baro nga langit ken baro nga daga.",
  ),
  (Ilo, Medium, [4674417], "Uray ti katatangkenan ti pusona ket aglua met."),
  (Ilo, Medium, [4649944], "Managbabain daydiay a gayyemko."),
  (
    Ilo,
    Medium,
    [4743255],
    "Saanna nga aramiden dagiti linalanggong a bambanag a kakasta.",
  ),
  (Ilo, Medium, [4675383], "Ania ti adda kadagidiay a kahon?"),
  (Ilo, Medium, [4658833], "Inggatangannakami ti nanangmi iti uken."),
  (Ilo, Medium, [4655966], "Adda kadi ammom maipanggep iti daytoy a banag?"),
  (Ilo, Medium, [4629781], "Apay koma a nasken a makisaritaak ken ni Tom?"),
  (Ilo, Medium, [4698757], "Bay-am a kitaek dagiti ladawan."),
  (
    Ilo,
    Medium,
    [4662440],
    "Mangnamnamaak nga agbalinak a dentista iti masakbayan.",
  ),
  (Ilo, Medium, [4743254], "Nakabarbara, isu a pinaandarko ti bentilador."),
  (Ilo, Medium, [4655968], "Adda kadi nasaysayaat a panangilawlawagmo?"),
  (Ilo, Medium, [4680046], "Nakidangadangda para iti wayawaya."),
  (
    Ilo,
    Long,
    [4662432, 4650226, 4658201, 4657685, 4658957],
    "Naannnadda a kanayon. Agpada a kaduogan ken kabaruanan a siensia ti astronomia. Adda isuna iti pagbaludan. Nagparang isuna kalpasan ti 30 a minutos. Nagburis ni Tom iti kaadu ti kinnanna a salamagi ken nilingta a mani.",
  ),
  (
    Ilo,
    Long,
    [4791643, 4685986, 4680039, 4674438],
    "Nakaiskediul nga umay ni Tom iti Boston inton umay a lawas. Nagpatpatnag a kaduak dagiti gagayyemko. Akinbolpen iti daytoy? Dinamagna no manon ti tawenko.",
  ),
  (
    Ilo,
    Long,
    [4657614, 4653205, 4661171, 4654874, 4755757],
    "Kasano a makisalipak? Ammom kadi no sadino ti papanantayo? Panagkunam, agsublida ngata gapu kaniak? Ammomi no ania ti aramidenmi. Inimdengan ni Tom ni Mary a nangyebkas iti daniw nga inkabesana.",
  ),
  (
    Ilo,
    Long,
    [4649596, 4662992, 4655971, 4704230],
    "Dandani natiliwan ti tatangna a makiin-inniyot isuna iti nobiona. Mayat ti urok ti matmaturog a pusa. Panggepmo kadi ti gumatang iti kotse? Nagaruat ti terorista iti tsaleko a napno iti bomba sana napan pinabettak ti bagbagina iti kaaduan ti inosente a tattao.",
  ),
  (
    Ilo,
    Long,
    [4680616, 4681290, 4653852, 4635290, 4695461],
    "Awan a pulos panagayatna iti arte. Nasursurok ken ni Tom ti panagluto. Ti kurang kenkuana ket kinatured. Am-ammok ti tatangmo. Padpadasen pay laeng dagiti doktor nga alawen ni Tom.",
  ),
  (
    Ilo,
    Long,
    [4791469, 10463302, 4650268, 4699732],
    "Kayatko ti agdaliasat iti daytoy a kalgaw, ngem diak ammo no sadino ti papanan. No laeng koma saanak a naikasar. Tinawen a mapmapanak idiay. Binisitak ti Paris iti naminsan.",
  ),
  (
    Ilo,
    Long,
    [4650300, 4681240, 4650500, 4790464],
    "Kalpasan a nagiyotkami, nakaturogak a nakapungan ti ulok iti tianna. Dagasenkanto inton agalas sais. Agsublinto pay ngata? Nadaras ti isusungad ti Paskua.",
  ),
  (
    Ilo,
    Long,
    [6035519, 4632835, 4680329, 4653839],
    "Siwayawayaak nga agmalmalem inton Lunes. Ania ti aramidem no sika ti adda iti lugarko? Nakitak isuna a simrek iti siled. Mapanak idiay. Awan ti makalapped kaniak.",
  ),
  (
    Ilo,
    Long,
    [4680415, 4662422, 4661159, 4658221],
    "Addaak ditoy a kas turista. Saan a masursuro iti dua a lawas laeng ti maysa a ganggannaet a pagsasao. Lumlumneken ti init idiay laud. Diak kayaten ti uminum iti serbesa.",
  ),
  (
    Ilo,
    Long,
    [4692716, 4656101, 4670063, 4662194],
    "Malaksid ken ni Mary a nobiana, adda pay sabali a kaayan-ayat ni Tom: ni John a padana a lalaki. Tungpalek ti pammagbagam. Saankanto a mangabak. Inubbana ti anakna sana insalasala tapno sumardeng nga agsangit daytoy.",
  ),
  (
    Ilo,
    Long,
    [4657671, 4680534, 4643581],
    "Pinapatayna ti bagina iti edadna a tallopulo. Saanmo a pagang-angawan ti maipapan iti dayta. Dika agsigarilio. Makapabassit iti buto ti panagsigarilio.",
  ),
  (
    Ilo,
    Long,
    [4952401, 4817244, 4692712],
    "Agsardeng nga agsigarilio. Ania nga oras ti ilelennek diay init? Pinanggep ni Tom ti agbekkel idi maammuanna a makiiiyot ni Mary iti sigud a kaayan-ayat daytoy.",
  ),
  (
    Ilo,
    Long,
    [4650378, 4678141, 4742964, 4670534, 4649559],
    "Saan kasta kalakana ti agpatanor iti anak. Awan ti pagbabawyak. Agtrabahokayo latta kabayatan nga awanak. Diak koma nalappedan daytoy. Naadik ni Tom iti sex.",
  ),
  (
    Ilo,
    Long,
    [4645044, 4653258, 4681282, 4662573],
    "Karuprupa ni Nancy ti kabsatko a babai. Kinamat ti pusa ti marabutit. Malidayanak para iti amin a maseknan. Gimmatang ni nanangko iti dua a botelia a tubbog ti kahel.",
  ),
  (
    Ilo,
    Long,
    [4655260, 4649533, 4687712, 4704664, 4677044],
    "Pakilukat ti bagmo tapno makitak no ania ti impanmo iti unegna. Ammo nga isu ti pudno. Umay isuna iti daytoy a malem. Sika ken siak, aggayyemta. Sapatos kadi ni Tom dagitoy?",
  ),
  (
    Ilo,
    Long,
    [4658940, 4699641, 4681057, 6035529, 4653198],
    "Nakagatgatel ti kudil ti ulok. Dandanin makatawen a nakadalit ni Tom. Awagam ni inam ken ibagam nga maladawka. Alwadam ti Ides of March! Nasaysayaat ti biag idi panawenmi ngem iti agdama.",
  ),
  (
    Ilo,
    Long,
    [4690638, 4662415, 4643579, 4658980],
    "Asino ti dimo am-ammo ditoy? Inkalikagumda nga amin a kopia ti libro ket madadael. Ti buto ti maysa a lalaki ti mangkontrol kenkuana. Napait daytoy a serbesa.",
  ),
  (
    Ilo,
    Long,
    [4695793, 4670059, 4706962, 4661416, 4686087, 4688897],
    "Immayak, nakitak, pinarmekko. Naimbag nga aldawmo, Tom. Saan a naawatan ni Tom ti saludsod. Lunes ita nga aldaw. Masapulmo pay la kadi ti tulongko? Insurat ni Tom dayta a kanta tallo a tawenen ti napalabas.",
  ),
  (
    Ilo,
    Long,
    [4695401, 4650343, 4658976],
    "Nagkallaysakami didiay sirok dagiti kayo ti sakura. Saanko a botosan dagiti kandidato a kameng ti pamilia a dinastia. Saan a nagimas ni Mary idi damo a nagiyotda ken ni Tom.",
  ),
  (
    Ilo,
    Long,
    [4686113, 4661316, 4662574, 4645076],
    "Saan kadi nga imbagam a maysa nga arkitekto ni Tom? Abaken ni Tom ti uray asino. Nakakallugong isuna iti nangisit. Umno met la kadi ti oras iti relom?",
  ),
  (
    Ilo,
    Long,
    [4724230, 4667741, 4735574, 4706965],
    "Gagangay a saan a maikkat ti mansa ti dara. Inkidem ni Tom ti maysa a matana. Ni Tom ti nangaramid. Saan a naawatan a nalaing ni Tom no ania ti kayat nga ipaaramid ni Mary kenkuana.",
  ),
  (
    Ilo,
    Long,
    [4683438, 4661329, 5494048, 4739527, 4669301, 4654870],
    "Addaak idiay Boston idi Oktubre. Maysa a takrot ni Tom. Saanko pay a nabasa daytoy a libro. Nagtudo iti makalawas. Masapul a rummuartayo itan ditoy. Inlawlawag ni Tom ti amin ken ni Mary.",
  ),
  (
    Ilo,
    Long,
    [4677625, 4650004, 5494050, 4677052, 4699931],
    "Awan ti makaliklik iti ipapatay. Ti Trier ti kaduogan a siudad iti Alemania. Ikarkarigatanmi ti mangabak. Adda kadi ideam no ania daytoy? Nawarawara ti grupo dagiti terorista.",
  ),
  (
    Ilo,
    Long,
    [4675364, 4677109, 4650023, 4642946],
    "Ammom kadi a ni Tom ket gayyem ni Mary? Ni kadi Tom ti akin-aramid iti daytoy? Napaneknekan ni Tom nga agul-ulbod ni Mary. Aglutluto isuna iti naimas a makan para kenkuana laeng.",
  ),
  (
    Ilo,
    Long,
    [4643605, 4681211, 4655902],
    "Tapno maliklikan iti pannakadunor wenno saan a panagganas, siguraduen a nababasa ti uki sakbay ti panagiyot. Kukua ni Tom ti botosko. Saan a napasardeng ti tudo ti panangiwayatda kadagiti obrada.",
  ),
  (
    Ilo,
    Long,
    [4677508, 4669302, 4677623, 4667469],
    "Kayatko nga addaak koma idiay Boston. Nasken nga aggunaytayon. Makarkulom kadi no kasano kaladawto ti tren? Ti kangrunaan a panggepna iti biag ket ti agbalin a baknang.",
  ),
  (
    Ilo,
    Long,
    [4692694, 4751742, 4671758, 4695472, 4629919],
    "Gimmatangak iti pang-VIP a pases. Binayadak a nasayaat ni Tom. Diak a masinunuo no kasano a naaramidak ti kasdiay a biddut. Katorsekon no bigat. Naragsak a Baro a Tawen!",
  ),
  (
    Ilo,
    Long,
    [4647283, 4791641, 4666288, 4650949],
    "Idiay Singapore, maiparit ti agtupra. Agur-urnong ni Tom iti kuarta tapno makapan isuna idiay Australia. Maiparit ti agdillaw. Naragsakak unay no kadkaduaka.",
  ),
  (
    Ilo,
    Long,
    [4692781, 4724241, 4657683, 4655266],
    "Kaimasan a maaramid a pinapaitan ti kalding. Sabali a bus ti naluganak. Nagretiro isuna iti kompania kalpasan ti tallopulo a tawen a serbisiona. Saan a mapasamak dayta.",
  ),
  (
    Ilo,
    Long,
    [4643557, 4630027, 4653855, 4715074, 4653828, 4650898],
    "Pinadasko ti timmaray iti napardas. Ania ti maitulongko kenka? Kasano a makatulongkami? Nabayagen nga agmaymaysaak. Nakapimpintas ti langam. Dimo liplipatan no asinoka.",
  ),
]

///|
let rows_rus : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Rus, Short, [6298192], "Нам хочется веселиться."),
  (Rus, Short, [11767092], "Они прибудут одновременно."),
  (Rus, Short, [3454229], "Он всегда такой?"),
  (Rus, Short, [6774218], "Спасибо, что дали знать."),
  (Rus, Short, [11935247], "Вы бы всё равно не поверили."),
  (Rus, Short, [4029083], "Пока я курил, он ушел."),
  (Rus, Short, [5249485], "Какой хлеб ты ешь?"),
  (Rus, Short, [9489867], "Я с трудом сдерживал слёзы."),
  (Rus, Short, [10069135], "Что его сподвигло на это?"),
  (Rus, Short, [11732763], "Хочешь, я пошлю тебе денег?"),
  (Rus, Short, [12576610], "Я протянул руку к книге."),
  (Rus, Short, [13488321], "Меня всю трясло."),
  (
    Rus,
    Short,
    [5982389],
    "Том не может пересечь границу.",
  ),
  (Rus, Short, [4988678], "Если не знаешь, не спорь."),
  (
    Rus,
    Short,
    [13804186],
    "Ко мне можно просто по имени.",
  ),
  (Rus, Short, [3445113], "Она полюбила вампира."),
  (Rus, Short, [10239758], "Как это им удалось?"),
  (Rus, Short, [7340255], "Я не знал, что вы канадцы."),
  (Rus, Short, [13210349], "Кто забил?"),
  (Rus, Short, [3764183], "Я подсолю мясо."),
  (Rus, Short, [2575992], "Сейчас уже почти час."),
  (Rus, Short, [4206834], "Вы понимаете, о чем я говорю."),
  (Rus, Short, [10341435], "Вы действительно голодные?"),
  (
    Rus,
    Short,
    [13150707],
    "Ты выглядишь расслабленным.",
  ),
  (Rus, Short, [7419920], "Его намерения были ясны."),
  (Rus, Short, [4305546], "У вас есть сомнения?"),
  (Rus, Short, [12465808], "Это ещё Гиппократ говорил."),
  (Rus, Short, [8993015], "Они мне маловаты."),
  (Rus, Short, [5598265], "Том много не ест."),
  (
    Rus,
    Short,
    [4019385],
    "Том предвидел её возражения.",
  ),
  (
    Rus,
    Medium,
    [4792710],
    "Надеюсь, вы не слишком много пьёте.",
  ),
  (
    Rus,
    Medium,
    [3384473],
    "Всякий раз, как я слышу эту песню, я думаю о своём детстве.",
  ),
  (
    Rus,
    Medium,
    [2791536],
    "Поверхность Земли на 70 процентов состоит из воды.",
  ),
  (
    Rus,
    Medium,
    [5360037],
    "Раз ты такой умный, почему бы тебе самому этого не сделать?",
  ),
  (
    Rus,
    Medium,
    [13095406],
    "Не могу выразить, как я тебе благодарен.",
  ),
  (
    Rus,
    Medium,
    [11916067],
    "Если вы не хотите, мы найдём кого-нибудь другого.",
  ),
  (
    Rus,
    Medium,
    [10028331],
    "Ваша дружба никогда не была настоящей.",
  ),
  (
    Rus,
    Medium,
    [9482683],
    "Вы знаете, как дела у Тома и Мэри?",
  ),
  (
    Rus,
    Medium,
    [11487666],
    "Почему бы вам не черкнуть ей пару строк?",
  ),
  (
    Rus,
    Medium,
    [9000318],
    "Эта книга произвела на меня большое впечатление.",
  ),
  (
    Rus,
    Medium,
    [5272213],
    "Видел бы ты сейчас себя со стороны!",
  ),
  (
    Rus,
    Medium,
    [10250394],
    "Миссис Грин учила меня английскому.",
  ),
  (
    Rus,
    Medium,
    [10165924],
    "Я хочу только напомнить, что это не я придумал.",
  ),
  (
    Rus,
    Medium,
    [4383415],
    "Водители-мужчины в два раза чаще попадают в аварии, чем водители-женщины.",
  ),
  (
    Rus,
    Medium,
    [2620491],
    "Я всё ещё жду, что Том покажет мне, как это сделать.",
  ),
  (
    Rus,
    Medium,
    [11274282],
    "У нас тут есть небольшая речка-переплюйка, но в ней никто не купается.",
  ),
  (
    Rus,
    Medium,
    [4661066],
    "Пожалуйста, дай мне ответ телеграммой.",
  ),
  (
    Rus,
    Medium,
    [5260001],
    "Мне действительно было это нужно.",
  ),
  (
    Rus,
    Medium,
    [5203017],
    "Том даже не знал, что Мэри уехала.",
  ),
  (
    Rus,
    Medium,
    [2446746],
    "Я не уверена, что могу ему доверять.",
  ),
  (
    Rus,
    Medium,
    [2069750],
    "В Японии много красивых городов. Киото и Нара, например.",
  ),
  (
    Rus,
    Medium,
    [4633220],
    "Какое-то время они жили в Норвегии.",
  ),
  (
    Rus,
    Medium,
    [11323239],
    "Я в этот город больше ни ногой.",
  ),
  (
    Rus,
    Medium,
    [13527627],
    "Я не хочу говорить вам, как меня зовут.",
  ),
  (
    Rus,
    Medium,
    [2531562],
    "Мы учим английский уже три года.",
  ),
  (
    Rus,
    Medium,
    [2411097],
    "Том пытался залезть на высокое дерево.",
  ),
  (
    Rus,
    Medium,
    [2801097],
    "\"Она странно разговаривает\", - подумал я.",
  ),
  (
    Rus,
    Medium,
    [908397],
    "Лечение только ухудшило состояние моего мужа.",
  ),
  (
    Rus,
    Medium,
    [6594661],
    "Почему вы хотите, чтобы я ушёл?",
  ),
  (
    Rus,
    Medium,
    [13975430],
    "Мне надо задать ему кое-какие вопросы, но я не хочу его сейчас беспокоить.",
  ),
  (
    Rus,
    Long,
    [607377, 10171653, 10187742, 12434133],
    "\"Ты почему не идёшь?\" - \"Потому что я не хочу\". Можешь не идти с Томом, если не хочешь. Он поменялся со мной местами. Он не мог сидеть у прохода. У тебя есть какие-нибудь мысли насчёт того, что бы это могло быть?",
  ),
  (
    Rus,
    Long,
    [11383532, 6859652, 2497966, 13694997],
    "Я хочу, чтобы вы стали хорошими людьми. Мне этого очень не хватало там, за границей. Пожалуйста, не иди слишком быстро. Вы можете сегодня вечером прийти?",
  ),
  (
    Rus,
    Long,
    [3126617, 3163747, 2924179],
    "Он всегда создаёт людям проблемы. Том подавился и чуть не задохнулся. Если листья орешника падают лицевой стороной – к тёплой зиме, изнанкой – к холодной.",
  ),
  (
    Rus,
    Long,
    [6931702, 2563819, 6169170, 6485689],
    "Не говори потом, что я не предупреждал. Прошёл сильный дождь, дорога ещё мокрая. Тому не нужно мыть машину. Мэри уже её помыла. Где стойка информации?",
  ),
  (
    Rus,
    Long,
    [3661054, 8441931, 14010909, 12220102],
    "Я занимался в течение двух часов. Мой друг сказал мне, что купил часы. Я не это хотел сказать, но неважно. Доктор запрещает мне притрагиваться к алкоголю.",
  ),
  (
    Rus,
    Long,
    [11699022, 6624232, 14061846, 11092341],
    "Этого обстоятельства мы не учли. Мэри что-то нашептала Тому на ухо, и теперь он косо смотрит на меня. Мама испекла именинный пирог. Хлеб за брюхом не бегает.",
  ),
  (
    Rus,
    Long,
    [8530560, 7822470, 8552782, 5370116, 6805347],
    "Так я тебе всё и рассказал! Тебе на самого себя надо обижаться, а не на меня. Когда Том купил эту рубашку? Ты хочешь сказать, что я не могу поехать? Скажите мне, пожалуйста, откуда это у вас.",
  ),
  (
    Rus,
    Long,
    [9941020, 3555966, 3841533, 5225397, 4091250],
    "Он принял верное решение. В этом ресторане дают щедрые порции. Похоже, она не очень-то рада меня видеть. Том не знает, когда это случилось. Ты ведь ещё ни разу не был женат?",
  ),
  (
    Rus,
    Long,
    [9742137, 3307752, 4320989, 14028202],
    "Я посвятил это своему новорождённому сыну. Том не захотел меня видеть. Что ты хочешь сказать на самом деле? Завтра я собираюсь помочь маме в саду полчаса.",
  ),
  (
    Rus,
    Long,
    [1647091, 3536740, 4332809, 3684024, 12364789],
    "Если вы игнорируете прошлое, вы рискуете будущим. Я должен поехать в Бостон. Вот тут я с вами не могу согласиться. Осторожно! Машина едет. Том планирует постоянно жить в Японии.",
  ),
  (
    Rus,
    Long,
    [3266557, 8998512, 13241128, 3640772],
    "Я вызову тебе такси. Его местонахождение не установлено. Говорил он с ошибками, но почти без акцента. Том уходит, потому что у него в кошельке деньги господина.",
  ),
  (
    Rus,
    Long,
    [12784094, 12684110, 13972321, 6405275, 13803549],
    "Супермаркетам не нравится эта идея. Том надеется, что сдаст экзамен. Не могу вам передать, как сильно я по вам скучал. Ни Том, ни Мэри не удивились. А ты смешной, я съем тебя последним.",
  ),
  (
    Rus,
    Long,
    [3046102, 13558852, 7004378, 4810821],
    "Поначалу нас это очень радовало, но в последнее время - нет. Можно мне взять его у тебя напрокат? Кто тебе дал право судить? С этого моста можно рыбачить?",
  ),
  (
    Rus,
    Long,
    [10779592, 4206664, 6682724, 4957407],
    "Не верится, что Жан это сделал. Так или иначе, Том наконец добрался до Бостона. Я ожидал, что Том будет участвовать. От лекарства меня потянуло в сон.",
  ),
  (
    Rus,
    Long,
    [3477055, 3475707, 4742727, 7077462, 3944538],
    "Я хочу быть свободной. Я ненадолго отходил. Том сказал, что ему нужно ещё немного времени. Черепахи откладывают яйца в песок. Мой отец доселе никогда не был за границей.",
  ),
  (
    Rus,
    Long,
    [12926666, 10982224, 6562696, 13949889, 2632974],
    "Я сделал на завтрак бутерброд. Этот старик редко бывает трезв. Том сказал мне, что он болел. «Ненавижу тебя!» — «Взаимно». Я был бы действительно благодарен.",
  ),
  (
    Rus,
    Long,
    [10971593, 469092, 11179361],
    "Не ты ли с пеной у рта доказывал мне, что это не так? Как в понедельник, так и во вторник у меня не будет времени. Отчего на чипсинах возникают пузырьки?",
  ),
  (
    Rus,
    Long,
    [4248385, 4571202, 7245108],
    "Ты здесь со своими претензиями никому не сдался, иди качай права в другом месте, дружок. Масатлан — тихоокеанская жемчужина Мексики. Я не могу понять ни одного слова.",
  ),
  (
    Rus,
    Long,
    [6404872, 9069133, 11075004, 6310823, 4128666],
    "Том тоже пошёл на рыбалку. Правду говорить легче, чем врать. Их певицы лучше, чем ваши. Я не успел позавтракать. Том и Мэри — хорошие друзья, но они не встречаются. По крайней мере, я так думаю.",
  ),
  (
    Rus,
    Long,
    [5256846, 8235210, 7157516, 13909451, 4428949],
    "Я уже ничего не понимаю. Хорошо, что этого не случилось. Том живёт с матерью в Австралии. Я уже записался к врачу. Расслабляться в любом случае не стоит.",
  ),
  (
    Rus,
    Long,
    [5179557, 5625636, 8827195, 7460942, 933159],
    "Русские медленно запрягают, но быстро едут. Я решил заниматься каждый день. Я знаю, где нахожусь. Том не хотел никого оскорбить. Повали это мёртвое дерево, иначе оно упадёт на твой дом.",
  ),
  (
    Rus,
    Long,
    [9933521, 3142335, 9637029, 423041],
    "«Я прошёл первый тур!» — восторженно протараторил Том, подбегая к маме. Спасибо тебе за завтрак. Каждому из нас надо завтра снова сделать это. Она может задавать и отвечать на вопросы.",
  ),
  (
    Rus,
    Long,
    [12477233, 2606092, 13181664, 13626645],
    "Я к нему сегодня собирался. Просто поговорим о языке, который ты хочешь выучить. Почему ты хочешь его выучить? Мне всегда будет нужна её помощь. Никто ему в подмётки не годился.",
  ),
  (
    Rus,
    Long,
    [5692495, 7778251, 12298687, 10042101],
    "Неужели это действительно просто совпадение? Выньте всё из карманов и положите на стол. Тебе бы только к чему-нибудь придраться! В чём заключаются наши минусы?",
  ),
  (
    Rus,
    Long,
    [12083538, 5216813, 8767555, 11218060, 8929242],
    "Боюсь, Том не выздоровеет. Что Том делает по понедельникам? Тебе надо поменьше смотреть телевизор. В нашей команде нет девочек. В понедельник после обеда Том был дома.",
  ),
  (
    Rus,
    Long,
    [5878855, 7863007, 6466244, 650514, 11508124],
    "Пока что ничего страшного не случилось. Я не хочу идти с вами плавать. Где я тебе среди ночи понятых возьму? Велика борода, да в голове сквозняк. Он попросил нас сидеть тихо.",
  ),
  (
    Rus,
    Long,
    [12222131, 3483697, 5072086, 8687404, 10769966],
    "Человек есть то, что он делает. Мёртвые собаки не кусаются. Давным-давно жила-была милая девушка. Ты с ними ещё увидишься? Том не страдает от болезней, лишь от лекарственной зависимости.",
  ),
  (
    Rus,
    Long,
    [5954447, 7790572, 3078200, 2635092, 11468758, 6394934],
    "У меня сейчас нет настроения петь. Как мне добраться до порта? Я продрогла до костей. Том продолжал говорить. Прочти предложение ещё раз. Не удивляйся, если я вдруг начну говорить по-русски. Когда я тороплюсь или волнуюсь, я перехожу на свой родной язык.",
  ),
  (
    Rus,
    Long,
    [13947884, 5762479, 3953372, 5642430, 12298732],
    "Мы люди цивилизованные, расстались друзьями. Том знает, сколько Мэри лет. Ты ведь был занят, да? Школа стоит напротив моего дома. Сравните свой перевод с её переводом.",
  ),
  (
    Rus,
    Long,
    [7780927, 9843717, 6688680, 12425603],
    "Лифты в этом здании часто ломаются. Этот идиот подорвал мою чистую репутацию, даже не подозревая об этом. Это было полным фиаско. Казахи - народ гостеприимный.",
  ),
]

