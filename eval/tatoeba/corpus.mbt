    Medium,
    [4774664],
    "ನಿಜವಾಗಿಯೂ ನಾನು ನಿಮಗೆ ಕ್ಷಮೆ ಕೋರಬೇಕು.",
  ),
  (
    Kan,
    Medium,
    [4776786],
    "ಅವನು ಅವನ ಮಗಳಿಗೆ ಹೊಸ ಬಟ್ಟೆಯನ್ನು ಖರೀದಿಸಿದನು.",
  ),
  (
    Kan,
    Medium,
    [4783909],
    "ನಿಮಗೆ ಆಂಗ್ಲಭಾಷೆಯನ್ನು ಮಾತಾಡುವುದಕ್ಕೆ ಬರತ್ತಾ?",
  ),
  (
    Kan,
    Medium,
    [4784789],
    "ನೆನ್ನೆ ರಾತ್ರಿ ನಾನು ಒಂದು ಪುಸ್ತಕವನ್ನು ಓದಿದೆ.",
  ),
  (
    Kan,
    Medium,
    [4774604],
    "ಯಾವಾಗಲಾದರು ನೀವು ನನ್ನ ಕಾರನ್ನು ಬೇಕೆಂದರೆ, ಬರಿ ಕೇಳಿ.",
  ),
  (
    Kan,
    Medium,
    [4775518],
    "ನನಗೆ ಟಾಮ್ ಫ್ರೆಂಚ್ ಮಾತಾಡುತ್ತಾನೆ ಅಂತ ಗೊತ್ತೇ ಇರಲಿಲ್ಲ.",
  ),
  (
    Kan,
    Medium,
    [4775411],
    "ಸರಾಯಿ ನೆಲಮಾಳಿಗೆಗೆ ಹೋಗಿ ಎರಡು ಬಾಟಲಿ ವೈನು ತೆಗೆದುಕೊಂಡು ಬನ್ನಿ.",
  ),
  (
    Kan,
    Medium,
    [4783980],
    "ನಾನು ಮತ್ತು ನನ್ನ ತಂದೆ ಮೊದಲ ಬಾರಿಗೆ ಸಂಗ್ರಾಲಯಕ್ಕೆ ಹೋದ್ವಿ.",
  ),
  (
    Kan,
    Medium,
    [4774666],
    "ಅದಕ್ಕೇನೇ ಅವನು ಅವನ ಕೆಲಸ ಕಳೆದುಕೊಂಡ.",
  ),
  (
    Kan,
    Medium,
    [4783929],
    "ಟಾಮಿಗೆ ಯಾರು ಕೊಲೆಗಾರ ಅಂತ ಗೊತ್ತಿತ್ತು.",
  ),
  (
    Kan,
    Medium,
    [4784806],
    "ಅಂದಿನಿಂದ ಬಹಳಷ್ಟು ಘಟನೆಗಳು ನಡೆದಿವೆ.",
  ),
  (
    Kan,
    Medium,
    [4775437],
    "ನಮಗೆ ಅದೃಷ್ಟ ಸಿಕ್ಕಿತು ಅಂತ ಅನಿಸುತ್ತೆ.",
  ),
  (
    Kan,
    Medium,
    [4774665],
    "ನಾವು ಪ್ರಯತ್ನಿಸದೇ ಬೇಡ ಅಂತ ಸೂಚಿಸುತ್ತೇನೆ.",
  ),
  (
    Kan,
    Medium,
    [4774750],
    "ನಾನು ಇವತ್ತು ಬೆಳಿಗ್ಗೆ ಬೇಗ ಏಳಬೇಕಾಗಿತ್ತು.",
  ),
  (
    Kan,
    Medium,
    [4774741],
    "ನೀವೆಲ್ಲ ಬಂದಿದ್ದು ನನಗೆ ತುಂಬಾ ಸಂತೋಷ.",
  ),
  (
    Kan,
    Medium,
    [4774191],
    "ನಿನ್ನ ಭಾಷೆ ಕಲಿಯುವುದೇ ನನ್ನ ಗುರಿ.",
  ),
  (
    Kan,
    Medium,
    [4783917],
    "ಅವನಿಗೆ ಹುಷಾರು ಇರಲಿಲ್ಲ ಅಂತ ಅವನು ಮನಗೆ ವಾಪಸ್ಸು ಬರವುದಕ್ಕೆ ನಿರ್ದರಿಸಿದ.",
  ),
  (
    Kan,
    Medium,
    [4775394],
    "ಟಾಮ್ ಬಗ್ಗೆ ಏನೆಲ್ಲಾ ಗೊತ್ತೋ ನಮಗೆ ಹೇಳಿ.",
  ),
  (
    Kan,
    Medium,
    [4784815],
    "ಯಾರೂ ನೋಡುತ್ತಿರಲಿಲ್ಲವೆಂದು ನಾನು ಖಚಿತಪಡಿಸಿಕೊಂಡೆ.",
  ),
  (
    Kan,
    Medium,
    [4776808],
    "ಅವನು ನನ್ನ ಅಭಿಪ್ರಾಯವನ್ನು ಸಮ್ಮತಿಸುತ್ತಾನೆ.",
  ),
  (
    Kan,
    Medium,
    [12479826],
    "ಈ ಕೋಣೆಗೆ ಹೆಚ್ಚು ಸೂರ್ಯನ ಬೆಳಕು ಬೀಳುವುದಿಲ್ಲ.",
  ),
  (
    Kan,
    Medium,
    [4776803],
    "ಪ್ರತಿದಿನ ನಾನು ಸುಧಾರಿಸುತ್ತಿದ್ದೇನೆ.",
  ),
  (
    Kan,
    Medium,
    [4774754],
    "ನೀನು ಇದನ್ನು ಮಾಡಕ್ಕೆ ಆಗುವುದಿಲ್ಲವೆಂದು ನಂಬಿದ್ದೀಯಾ ಅಲ್ವ?",
  ),
  (
    Kan,
    Medium,
    [4774189],
    "ನಿಮ್ಮ ಪುಸ್ತಕವನ್ನು ಒಂಬತ್ತನೆಯ ಪುಟಕ್ಕೆ ತೆರೆಯಿರಿ.",
  ),
  (
    Kan,
    Medium,
    [4775475],
    "ನಾವು ಅದರ ಕುರಿತು ಕೆಲಸ ಮಾಡುತ್ತಾ ಇದ್ದೇವೆ.",
  ),
  (
    Kan,
    Long,
    [4784799, 12482771, 4775526, 8902990, 13226188, 4774670],
    "ಬೇರೆ ರೀತಿಯಲ್ಲಿ ಯೋಚನೆ ಮಾಡೋಣ. ಅಲ್ಲಿಗೆ ಹೋಗಬೇಡ. ಇಲ್ಲೇ ಇರು. ನೀವು ಯಾವ ತಂಡಕ್ಕೆ ಆಟ ಆಡುತ್ತೀರಾ? ನಿಮ್ಮ ಮನೇಲಿ ಹೆಂಗಿದ್ದಾರೆ ನೀವು ಏನು ಮಾಡುತ್ತಿದ್ದೀರಿ? ಜೋಡಿ ಇಬ್ಬರು ಫೋಟೋಗೆ ನಿಲ್ಲಿದರು.",
  ),
  (
    Kan,
    Long,
    [11791429, 4783915, 13245814, 4774736, 4776848],
    "ನನ್ನ ಕಾಲಿನ ಮೇಲೆ ಜೇಡ ಹತ್ತಿತ್ತು. ಕ್ಷಮಿಸಿ ನಿಮ್ಮ ಕಛೇರಿಗೆ ಬರುವದಕ್ಕೆ ಆಗಲಿಲ್ಲ. ನಾವು ಎಲ್ಲಿಗೆ ಹೋಗಬೇಕು ಅಂತ ಗೊತ್ತಿಲ್ಲ. ಅಪಘಾತದ ಕಾರಣವೇ ಗೊತ್ತಿಲ್ಲ. ಟಾಮ್ ಬೇರೆಯಾರನ್ನೂ ಕೊಲ್ಲಲ್ಲ.",
  ),
  (
    Kan,
    Long,
    [12482949, 13224101, 12484394, 8909649, 4774669],
    "ಅವರು ನಮಗೆ ಸುಳ್ಳು ಹೇಳುತ್ತಾರೆ. ಅವಳಿಗೆ ಕನ್ನಡ ಗೊತ್ತು. ನಾಳೆ ನೀನು ಏನು ಮಾಡ್ತಾ ಇದ್ದೀಯ? ಅಯ್ಯೋ !! ಈಗ ತಾನೇ ನಾನು ದೆವ್ವದ ರೂಪ ನೋಡಿದೆ !! ಅವಳು ಅವಳ ಕೈಯಲ್ಲಿ ಏನೋ ಇಟ್ಟುಕೊಂಡಿದ್ದಾಳೆ.",
  ),
  (
    Kan,
    Long,
    [4776867, 4774632, 13224122, 4783939, 5387074],
    "ನಾನು ಎಂದಿಗೂ ಅದನ್ನೇ ನಂಬಿದ್ದೇನೆ. ನಾವು ಮುಂಚೆ ಎಂದಿಗೂ ಭೇಟಿಯಾಗಿಲ್ಲವೆಂದು ಖಚಿತವಾಗಿ ಹೇಳುತ್ತೀರಾ? ನನಗೆ ಮಸಾಲೆ ದೋಸೆ ಬೇಕು. ನನ್ನನ್ನು ಎಳೆಮಗು ತರಹ ಪರಿಗಣಿಸುತ್ತಾಳೆ. ನಾನು ದಡಕ್ಕೆ ಹೋಗಲು ಇಷ್ಟಪಡುತ್ತಿದೆ.",
  ),
  (
    Kan,
    Long,
    [8901622, 8909666, 13247005, 12482926, 4784818],
    "ನಾನು ನನ್ನ ಅಣ್ಣ ಇಬ್ರೂ ಒಳ್ಳೆ ಟೆನಿಸ್ ಆಟಗಾರರು ಈ ಚಕ್ರ ಓಡೋವಾಗ ಅಲ್ಲಾಡುತ್ತೆ ನೀವು ಕನ್ನಡ ಓದಬಹುದುವಾ? ಅವಳಿಗೆ ಬಾತುಕೋಳಿಗಳು ಇಷ್ಟ. ಟಾಮ್ ನಿಮಗೆ ಗಿಟಾರ್ ಭಾರಿಸುವುದಕ್ಕೆ ಹೇಳಿಕೊಟ್ಟನೆಂದು ನನಗೆ ಮರೆತುಹೋಯಿತು.",
  ),
  (
    Kan,
    Long,
    [8909646, 4774611, 12479834, 4784811],
    "ನಿನ್ನ ಮಗನನ್ನು ನೋಡಲು ನನಗೆ ತುಂಬಾ ಇಷ್ಟ ಚಲನ ಚಿತ್ರ ತಾರೆಯಿಂದ ಅವರು ರಾಜನೀತಿಜ್ಞರಾಗಿದರು. ಅವನು ನಾಳೆ ಬೇರೆ ನಗರಕ್ಕೆ ಹೋಗುತ್ತಾನೆ. ಅದಕ್ಕೆ ಅರ್ಥ ಇದೆ ಎಂದು ನಿಮಗೆ ಅನಿಸುತ್ತಾ?",
  ),
  (
    Kan,
    Long,
    [13224466, 4774653, 13236918, 12480077, 4784785],
    "ಇನ್ನೂ ತುಂಬಾ ಕೆಲಸ ಇದೆ. ನಾವು ಒಳಗಡೆ ಹೋಗಬಹುದಾ? ಇವತ್ತು ನನ್ನ ಹಳೇ ಪುಸ್ತಕ ಒಂದು ಸಿಕ್ತು. ಅವನು ಜೇನುತುಪ್ಪದ ಸಿಹಿ ರುಚಿಯನ್ನು ಆನಂದಿಸುತ್ತಾನೆ. ನಾನು ಸ್ವಲ್ಪ ದುಡ್ಡನ್ನು ತೆಗೆದುಕೊಂಡು ಬರಬೇಕಾಗಿತ್ತು.",
  ),
  (
    Kan,
    Long,
    [4783920, 4774667, 8902995, 4776845, 12479825, 4776827],
    "ಅವನು ಠಾಣೆಗೆ ಐದು ಗಂಟೆಗೆ ತಲುಪಿದ. ಸಾಟೋ ಅವರು ಆಯಾಸದಿಂದ ಕುಸಿದು ಬಿದ್ದರು. ಕುಡಿಯೋಕ್ಕೆ ಏನಾದ್ರು ಬೇಕಾ ? ಟಾಮ್ ಮೇರಿ ಮೇಲೆ ಪ್ರೀತಿ ಇದ್ಯಾ? ನಿನ್ನೆ ನಾನು ಬೇಗ ಎದ್ದೆ. ನೀನು ನನ್ನನು ನಿರಾಶೆ ಮಾಡುತ್ತೀಯ.",
  ),
  (
    Kan,
    Long,
    [4775449, 4784794, 4774759, 4784820],
    "ಎರಡು ವರೆಗೆ (೨.೩೦ ಗೆ) ನಿನ್ನನ್ನು ನೋಡುತ್ತೇನೆ. ಮೇರಿ ಸೌಂದರ್ಯವಾಗಿದ್ದಾಳೆ. ಒಂದು ವೇಳೆ ಟಾಮ್ ನಿನ್ನ ಬಗ್ಗೆ ಹೇಳಲಿಲ್ಲವೆಂದರೆ ತಪ್ಪಿಸಿಕೊಳ್ಳಬಹುದಾಗಿತ್ತು. ನಾನು ಮನೆಗೆ ಹೊರಡುತ್ತಾ ಇರಬೇಕು.",
  ),
  (
    Kan,
    Long,
    [4776456, 4776862, 4783961, 4783932, 4784823, 4775384],
    "ನಾನು ಒಂಟಿಯಾಗಿ ಪಯಣ ಮಾಡಿದೆ. ಟಾಮ್ ಮೇರಿಗೆ ಮನೆಗೆ ಹೋಗುವುದಕ್ಕೆ ಹೇಳಿದನು. ನೀವು ಪತ್ರಿಕೆಯನ್ನು ಓದಿ ಮುಗಿಸಿದ್ದೀರಾ? ನೀವು ಟಾಮಿಗೆ ಹೇಳಲೇಬೇಕು. ಬಹಳ ತರಕಾರಿಗಳು ತಿನ್ನು. ಆ ಕಥೆ ಇನ್ನಷ್ಟು ಹೆಚ್ಚು ಅದ್ಭುತವಾಯಿತು.",
  ),
  (
    Kan,
    Long,
    [4774678, 4783970, 4775511, 4774190, 4774187],
    "ನಮ್ಮ ಅತಿಥಿಗಳನ್ನು ಸ್ವಾಗತಿಸೋಣ. ಒಪ್ಪ೦ದವನ್ನು ನೋಡುವುದಕ್ಕೆ ನಾನು ಇಷ್ಟಪಡುತ್ತೇನೆ. ನಿಮ್ಮನ್ನು ಸಹಾಯ ಮಾಡುವುದಕ್ಕೆ ಆಶಿಸುತ್ತೇನೆ. ನೀನು ಅವನನ್ನು ಪ್ರೀತಿಸುತ್ತಿದ್ದೀಯ. ನಿಮ್ಮ ನಿರ್ಗಮನದ ಬಗ್ಗೆ ಮೊದಲೇ ನನಗೆ ತಿಳಿಸಿರಿ.",
  ),
  (
    Kan,
    Long,
    [4774645, 8903002, 12484466, 4774760, 4776869],
    "ಜಾಸ್ತಿ ಹೊತ್ತು ಅವನಿಗೆ ಅವನ ಕೋಪ ತಡೆಯುವುದಕ್ಕೆ ಆಗಲಿಲ್ಲ. ನಿಮಗೆ ಏನು ಅನ್ನಿಸುತ್ತೆ ನಾನು ಇಲ್ಲಿ ತನಕ ನೋಡುತ್ತಿದ್ದೆ. ಬಹುಷಃ ಟಾಮ್ ನಿನಗೆ ಎಲ್ಲದರ ಬಗ್ಗೆ ಹೇಳಲ್ಲ. ಪ್ರತಿವರ್ಷ ಅವನು ವಿದೇಶಕ್ಕೆ ಹೋಗುತ್ತಾನೆ.",
  ),
  (
    Kan,
    Long,
    [4776833, 4774772, 4774749, 13224119, 4774770],
    "ನಿನ್ನನ್ನು ಕೆಲಸದಿಂದ ತೆಗೆದಿರುವುದಕ್ಕೆ ನಾನೇ ಕರಣ ಮತ್ತು ನಂದೇ ತಪ್ಪು. ಅದು ಪರಿಹಾರ ಇಲ್ಲವೇ ಇಲ್ಲ. ಅವರು ಏನಕ್ಕೂ ಉಪಯೋಗವಿಲ್ಲ. ಇಲ್ಲಿ ತುಂಬಾ ಮಳೆಯಾಗಿದೆ. ತಪ್ಪು ಆಗುವುದಕ್ಕೆ ಹೇಗೆ ಸಾಧ್ಯ?",
  ),
  (
    Kan,
    Long,
    [12486794, 4784814, 4784821, 13223978, 4774595],
    "ನೀನು ಮೊಸರು ಇಷ್ಟಪಡ್ತಿಯಾ? ನಾನು ತಪ್ಪು ಮಾಡಿದೆ ಎಂದು ಹೇಳಬೇಕು. ಪ್ರವಚನ ನಡೆಯುತ್ತಿರುವಾಗ ನನಗೆ ತುಂಬಾ ಬೇಸರವಾಗಿತ್ತು. ನೀನು ಏನು ಮಾಡ್ತಿದ್ದೀಯ? ಯಾವಾಗ ನಿನಗೆ ದುಡ್ಡು ಬೇಕಾದರೆ ಮಾತ್ರ ನೀನು ನನ್ನ ಜೊತೆ ಮಾತನಾಡುತ್ತೇಯ.",
  ),
  (
    Kan,
    Long,
    [4774192, 4776840, 4776852, 12482868],
    "ನಿಮಗೆ ಒಂದೇ ಬಾರಿ ಎರಡು ಜಾಗದಲ್ಲಿ ಇರುವುದಕ್ಕೆ ಆಗಲ್ಲ. ಆಹಾರಕ್ಕೆ ತುಂಬಾ ಎಣ್ಣೆ ಇತ್ತು ಅಂತ ಅನಿಸಿತು. ಟಾಮ್ ಸಾಮಾನ್ಯವಾಗಿ ಯಾವಾಗ ಜಿಮ್ಮಿಗೆ ಹೋಗುತ್ತಾನೆ? ಹೂಗಳು ಅರಳುತ್ತಿದ್ದವು.",
  ),
  (
    Kan,
    Long,
    [4783948, 4774193, 4776868, 4774684, 4776838],
    "ನಿಮಗೆ ಅದನ್ನು ಹಂಗೇ ಬಿಡಬೇಕಾ? ಅಪಾಯ ಇರುವುದಕ್ಕೆ ಬಹಳ ಸಾಧ್ಯತೆ ಇದೆ. ಟಮಿನ ಉಪನಾಮ ಏನು ಅಂತ ನಿಮಗೆ ಗೊತ್ತ? ಏನೋ ಆಕರ್ಷಕವಾಗಿದ್ದರೆ ನಾನು ನಿನಗೆ ತಿಳಿಸುತ್ತೇನೆ. ಟಾಮ್ ಬಹುಮಟ್ಟಿಗೆ ಮರೆತುಬಿಟ್ಟಿದ್ದನು.",
  ),
  (
    Kan,
    Long,
    [4783974, 12484456, 4784808, 5387094, 4784803],
    "ನನಗೆ ಏನಾಯಿತು ಅಂತ ನನಗೇನೆ ಗೊತ್ತಿಲ್ಲ. ಹಳ್ಳಿ ಶಾಂತಿಯುತವಾಗಿದೆ. ಟಾಮ್ ಸಹಾಯ ನೀಡುತ್ತಾನೆಂದು ನನಗೆ ಭರವಸೆ ಕೊಟ್ಟನು ಆದರೆ ಕೊಡಲಿಲ್ಲ. ಕೆಲವೊಂದು ಅಗ್ನಿಶಾಮಕರು ಗಾಯ ಪಟ್ಟರು. ಈ ಸಲ ನಾವು ಸರಿಯಾಗಿ ಮಾಡೋಣ.",
  ),
  (
    Kan,
    Long,
    [4774186, 4776797, 8909670],
    "ಅವಳು ನಾಚಿಕೆಪಡುತ್ತಾಳೆ ಅಂತ ಕಾಣಿಸುತ್ತೆ ಆದರೆ ನಿಜವಾಗಲು ಅವಳಿಗೆ ಜಾಸ್ತಿ ಸಂಕಲ್ಪ ಶಕ್ತಿ ಇದೆ. ಅವರು ಅವರ ನಿಶ್ಚಿತಾರ್ಥದವನ್ನು ಪ್ರಕಟಿಸಿದ್ದಾರೆ. ಅವನತ್ರ ಯಾವಾಗಲೂ ಜೇಬಲ್ಲಿ ಕತ್ತಿಇರುತ್ತೆ",
  ),
  (
    Kan,
    Long,
    [4776866, 4776842, 4783910, 4775427],
    "ನಿಮ್ಮ ಕುಟುಂಬಕ್ಕೆ ನನ್ನ ಪರವಾಗಿ ಶುಭಾಕಾಂಕ್ಷೆಗಳನ್ನು ನೀಡಿ. ನಾವು ಹುಡುಕಾಟವನ್ನು ರದ್ಧುಗೊಳಿಸಬೇಕು. ಕೆಲವೊಂದು ಪ್ರಾಣಿಗಳು ಬೆಂಕಿಗೆ ಹೆದರುತ್ತವೆ. ನಾವು ಬಿರುಗಾಳಿಯಿಂದ ಸಿಕ್ಕಿಹಾಕಿಕೊಳ್ಳಿದ್ದೆವಿ.",
  ),
  (
    Kan,
    Long,
    [4783914, 13224410, 4784822, 13246993],
    "ಇದು ನಿಮಗೆ ಕಷ್ಟವಿದೆ ಎಂದು ನನಗೆ ತಿಳಿದು ಬರುತ್ತದೆ. ನಾನು ಎಷ್ಟು ದಿನಗಳಿಂದ ಬಿಸಿಬೇಳೆಬಾತ್ ಮಾಡಿಲ್ಲ. ನಾನು ನಿನ್ನ ಮೇಲೆ ನಂಬಿಕೆ ಇಟ್ಟಿದ್ದೇನೆ. ಹತ್ತು ನಿಮಿಷ ಮುಂಚೆ ಯಾಗಿ ಆಯಿತು.",
  ),
  (
    Kan,
    Long,
    [13247049, 4776816, 4776781, 4775458],
    "ಕೊರಿಯನ್ ಭಾಷೆ ಕಲಿಯುವುದು ಕಷ್ಟ, ಆದರೆ ಹಂಗುಲ್ ಅನ್ನು ಬೇಗನೆ ಕಲಿಯಬಹುದು. ನಿಮಗೆ ತೊಂದರೆ ಇಲ್ಲವೆಂದರೆ ನಿಮ್ಮ ಕಾರನ್ನು ಜರಗಿಸುತ್ತೀರಾ? ಇದು ಟಾಮಿನ ಕನ್ನಡಕ, ನನ್ನದಿಲ್ಲ. ನೀವು ಯಾಕೆ ನನಗೆ ಧನ್ಯವಾದ ಹೇಳುತ್ತೀರಾ?",
  ),
  (
    Kan,
    Long,
    [4776782, 12487578, 4774652, 4776861, 4776847],
    "ನೀವು ಯಾವಾಗಲಾದರೂ ಕಚ್ಚಾ ಮೀನು ತಿಂದಿದ್ದೀರಾ? ನೀವು ಕಾಫಿ ತಗೊಂಡು ಬಂದ್ರಾ? ಟಾಮ್ ಮೂರು ಗಂಟೆಯ ಮುಂಚೇನೇ ಹೋದ. ಟಾಮ್ ನಿನ್ನನ್ನು ಬಯಸಿದನು. ನನ್ನ ತಂದೆ ಹಾಗು ನನ್ನ ಅಣ್ಣ ಈ ಕಾರ್ಖಾನೆಯಲ್ಲಿ ಕೆಲಸ ಮಾಡುತ್ತಾರೆ.",
  ),
  (
    Kan,
    Long,
    [4776872, 13247002, 12487579, 4774616, 4774634],
    "ಬೆಂಕಿಯನ್ನು ನಂದಿಸುವುದಕ್ಕೆ ಮರೆಯಬೇಡಿ. ಭಾರತವು ಒಂದು ಶಾಂತಿವನ. ನೀನು ಕಾಫಿ ಖರೀದಿಸಿದ್ದೀಯಾ? ಎಲ್ಲಿ ಡಾಲರ್ಗಳನ್ನು ಪೌಂಡ್ಸ್ಗೆ ಬದಲಾಯಿಸಬಹುದು? ನಾವು ಸತ್ಯವನ್ನು ಎಲ್ಲಿ ಕಂಡುಹಿಡಿಯಬಹುದು?",
  ),
  (
    Kan,
    Long,
    [12481414, 13240010, 4784782, 13224113, 4774675],
    "ಮೊದಲು ಇಲ್ಲಿಗೆ ಬಂದಿದ್ದೆ. ನಿದ್ದೆ ಚೆನ್ನಾಗಿ ಮಾಡಿ. ನಮ್ಮಲ್ಲಿ ಒಬ್ಬರು ಹೋಗಲೇ ಬೇಕಾಗುತ್ತದೆ. ಇವತ್ತು ಕೆಲಸ ತುಂಬಾ ಇದೆ. ನನ್ನ ಅಭಿಪ್ರಾಯದಲ್ಲಿ ಪೂರ್ವ ದಿಕ್ಕಿನ ಹಾಡುಗಳು ಜಾಸ್ತಿ ಸದ್ದು ಮಾಡುತ್ತೆ.",
  ),
  (
    Kan,
    Long,
    [11791422, 2909783, 12486791, 4784812, 4776823],
    "ಸಾಮಿ ನನ್ನ ಜೊತೆ ಮಾತಾಡಲೇ ಇಲ್ಲ. ಒಂದು ಕಾಫಿ ಕುಡಿಯುವುದಕ್ಕೆ ಹೊರಗೆ ಹೋಗುತ್ತೇನೆ ನೀವು ಮೊಸರು ಇಷ್ಟಪಡುತ್ತೀರಾ? ಟಾಮ್ ತುಂಬಾನೇ ಅಸಡ್ಡೆ. ಅವರು ಜನಸಮೊಹದ ನಡುವೆ ಅವನನ್ನು ಕಂಡಿದರು.",
  ),
  (
    Kan,
    Long,
    [4783951, 8909658, 12479939, 4776855, 13221646],
    "ಅದೇ ಪ್ರಶ್ನೆ ನನ್ನನ್ನೇ ಕೇಳಿದೆ. ಈ ಊರಿನಲ್ಲಿ ಕೊಳಚೆ ನೀರಿನ ಶುದ್ದೀಕರಣ ನಡೆಯುತ್ತೆ . ಕಡಿಮೆ ಸಮಯದಲ್ಲಿ ಇಂಗ್ಲಿಷ್ ಕಲಿಯುವುದು ಅಸಾಧ್ಯ. ಮೂರ್ಖತನಕ್ಕೆ ಯಾವ ಕ್ಷಮೆಯು ಇಲ್ಲ. ಏನು ಬೇಕಾದರೂ ಕಾಲ್ ಮಾಡು, ನಾನು ಹೆಲ್ಪ್ ಮಾಡ್ತೀನಿ.",
  ),
  (
    Kan,
    Long,
    [4783940, 5387071, 11791428, 4784801, 4774671],
    "ನೆನ್ನೆ ರಾತ್ರಿ ಹೇಗೆ ನಡೆಯಿತು? ಆ ಗಾಯ ಹೇಗೆ ಸಿಕ್ಕಿತು? ನಾನು ಅವನನ್ನು ಸಮಾಧಾನಪಡಿಸುವುದು ಅವನಿಗೆ ಇಷ್ಟವಿರಲಿಲ್ಲ. ನಾನು ಪ್ಯಾರಿಸಿಗೆ ಎಂದಿಗೂ ಹೋಗಿಲ್ಲ. ಈ ಕೊಠಡಿ ಹಂದಿಮನೆ ತರಹ ಇದೆ.",
  ),
  (
    Kan,
    Long,
    [13223985, 4776870, 4783956, 4775442, 4788530],
    "ನಾನು ಒಬ್ಬನೇ ಹೋಗ್ತೀನಿ. ಅವಳು ಹದಿವಯಸ್ಸಿನಲ್ಲಿ ಮದುವೆಯಾಗಿದಳು. ಅವಳನ್ನು ನ್ಯೂ ಜಿಲಂಡಿಗೆ ಸ್ಥಳಾಂತರಿಸುತ್ತಾರೆ. ಟಾಮ್ ಹೆಚ್ಚು ಮಾಂಸ ತಿನ್ನುವುದಿಲ್ಲ. ಅಪಘಾತದ ಕಾರಣದಿಂದ ಸಂಚಾರ ಸ್ತಂಭನ ಇತ್ತು.",
  ),
  (
    Kan,
    Long,
    [4775544, 13247001, 12479837, 4776541],
    "ಅವನ ತಂದೆಯ ಮರಣಾನಂತರ ಅವನು ಸಂಸ್ಥೆಯ ಅಧಿಕಾರ ವಹಿಸಿಕೊಂಡಿದನು. ನಾವು ಎಲ್ಲಿಗೆ ಹೋಗಬೇಕು ಅಂತಾ ಗೊತ್ತಿಲ್ಲ. ನನ್ನ ಸಹೋದರನ ಕೋಣೆ ನನ್ನ ಕೋಣೆಗಿಂತ ಚಿಕ್ಕದಾಗಿದೆ. ಅವನ ಪಯಣ ಅವನನ್ನು ಆಫೀಸಿನಿಂದ ದೂರ ಇಡತ್ತೆ.",
  ),
  (
    Kan,
    Long,
    [4776794, 4775547, 4774188, 12484447, 4776851, 4783936],
    "ಟಾಮ್ ಈಗ ನಿಮಗೆ ತಯಾರಾಗಿದ್ದಾನೆ. ನಾನು ಈಗ ತಾನೇ ವಾಪಸ್ಸು ಬಂದೆ. ಅವಳ ಧ್ವನಿ ಉತ್ತಮವಾಗಿದೆ. ವಿಚಾರಣೆ ಅನ್ಯಾಯವಾಗಿತ್ತು. ನಾನು ಏನನ್ನು ಮಾಡಬೇಕೆಂದು ಸರಿಯಾಗಿ ನೀವು ಹೇಳಬೇಕು. ಇದನ್ನು ಎಲ್ಲಿ ಸಿಕ್ಕಿತ್ತೋ ಅಲ್ಲೇ ಇಡು.",
  ),
]

