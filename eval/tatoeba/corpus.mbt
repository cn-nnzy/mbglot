let rows_bel : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Bel, Short, [6599679], "Паедзеш на поездзе?"),
  (Bel, Short, [2813747], "Я распранаюся."),
  (Bel, Short, [5294875], "Крэйда белая."),
  (
    Bel,
    Short,
    [8046546],
    "Сёння мяне ніхто не наведваў.",
  ),
  (Bel, Short, [8357090], "Я таксама яго дужа кахаю…"),
  (Bel, Short, [5910162], "Дзе зараз твае дзеці?"),
  (Bel, Short, [5907185], "Што ў яе ёсць?"),
  (Bel, Short, [11750964], "Алжыр уваходзіць у АПЕК."),
  (Bel, Short, [8042649], "Я думаю пра сваіх дзяцей."),
  (Bel, Short, [8095380], "Чаму ты пайшла так рана?"),
  (Bel, Short, [8004894], "Чаму ты злуешся?"),
  (Bel, Short, [8046573], "Я паспрабую вас абараніць."),
  (
    Bel,
    Short,
    [478814],
    "Ніводзін браўзер не бяспечны.",
  ),
  (Bel, Short, [7310912], "Самі вывучаў іслам."),
  (Bel, Short, [7975516], "Я часам гуляю ў тэніс."),
  (Bel, Short, [8004543], "Я зусім не стаміўся."),
  (Bel, Short, [8347768], "Не, ты мне не трэба."),
  (Bel, Short, [8004997], "Ты ўсё яшчэ маладая."),
  (Bel, Short, [8350282], "Вось пабачыш…"),
  (Bel, Short, [5934289], "Вы святкавалі Масленіцу?"),
  (
    Bel,
    Short,
    [573332],
    "Здымаем сурокі па фатаграфіі.",
  ),
  (Bel, Short, [7325474], "Я маю ружовы аўтамабіль."),
  (
    Bel,
    Short,
    [7975520],
    "Пра што ты хацела пагаварыць?",
  ),
  (Bel, Short, [11551190], "Засмучанасць."),
  (Bel, Short, [13174446], "Ты знаеш яе?"),
  (Bel, Short, [5966087], "Я нарэзала памідор."),
  (Bel, Short, [12049963], "Сур'ёзна, ты такі брыдкі."),
  (
    Bel,
    Short,
    [1295703],
    "Мы не можам існаваць без вады.",
  ),
  (Bel, Short, [385424], "Жалеза — карысны метал."),
  (Bel, Short, [5318492], "Ён сядзіць у цягніку."),
  (
    Bel,
    Medium,
    [4249718],
    "Лііза была апранутая па-святочнаму.",
  ),
  (
    Bel,
    Medium,
    [5191075],
    "Том размаўляе па-англійску з паметным французскім акцэнтам.",
  ),
  (
    Bel,
    Medium,
    [8348085],
    "А твар у Яроцкага чырвоны, гарачы.",
  ),
  (
    Bel,
    Medium,
    [7860380],
    "Урач параіў Тому кінуць паліць.",
  ),
  (
    Bel,
    Medium,
    [8347872],
    "Я ўчора ў яе рэвальвер знайшоў…",
  ),
  (
    Bel,
    Medium,
    [13866225],
    "Тому варта паведаміць Мэры, што ён не мае намеру гэта рабіць.",
  ),
  (
    Bel,
    Medium,
    [391646],
    "У маі ўсе птушкі адкладваюць яйкі.",
  ),
  (
    Bel,
    Medium,
    [8357262],
    "І быццам чакае яго, быццам кліча, просіць спагады.",
  ),
  (
    Bel,
    Medium,
    [7310957],
    "Будызм прыйшоў у Японію ў 538 годзе.",
  ),
  (
    Bel,
    Medium,
    [397219],
    "Звычайна я іду дахаты ў чатыры.",
  ),
  (
    Bel,
    Medium,
    [1343246],
    "Разуменне сучаснасці немагчыма без добрага разумення мінуўшчыны.",
  ),
  (
    Bel,
    Medium,
    [8350460],
    "Зелянюк роўна глядзіць на яго і ўсміхаецца загадкаваю сваёю ўсмешкаю.",
  ),
  (
    Bel,
    Medium,
    [419871],
    "Не ведаю, ці буду мець на гэта час.",
  ),
  (
    Bel,
    Medium,
    [1108611],
    "Тысячы разоў можа кахаць чалавек, але толькі адзін раз ён кахае.",
  ),
  (
    Bel,
    Medium,
    [640721],
    "У параўнаньні з братам ён не такі разумны.",
  ),
  (
    Bel,
    Medium,
    [3993727],
    "Калі згубіш ручнік, што я выткала, то ніколі мяне зноў не ўбачыш.",
  ),
  (
    Bel,
    Medium,
    [2003846],
    "Ці можаш прысвяціць мне некалькі хвілінак твайго вольнага часу?",
  ),
  (
    Bel,
    Medium,
    [1170200],
    "Гэты гадзіннік зроблены ў Швейцарыі.",
  ),
  (
    Bel,
    Medium,
    [9981316],
    "«Даруй мне» — «Што я павінна дараваць?»",
  ),
  (
    Bel,
    Medium,
    [7850867],
    "Ці ёсць тут хто-небудзь, хто можа дапамагчы мне?",
  ),
  (
    Bel,
    Medium,
    [389756],
    "Амазонка — другая па даўжыні рака ў свеце пасля Ніла.",
  ),
  (
    Bel,
    Medium,
    [416309],
    "Пашуковая сістэма «Яндекс» стала падтрымліваць і татарскую мову.",
  ),
  (
    Bel,
    Medium,
    [8350405],
    "Ужо трудна было разабраць, што гаворыць кожны асобна.",
  ),
  (
    Bel,
    Medium,
    [580008],
    "Я ўпершыню размаўляю з замежнікам.",
  ),
  (
    Bel,
    Medium,
    [478762],
    "Юмі Ісіяма — настарэйшы член каманды Лёка.",
  ),
  (
    Bel,
    Medium,
    [2724344],
    "Маё жыцце было б зусім пустым без цябе.",
  ),
  (
    Bel,
    Medium,
    [8095434],
    "Хірофумі ўсталяваў шкловалакністую ізаляцыю ў столі.",
  ),
  (
    Bel,
    Medium,
    [525838],
    "Цябе не варта чытаць кнігу ў такім цёмным пакоі.",
  ),
  (
    Bel,
    Medium,
    [4323729],
    "Я ведаю правілы напамяць, але гуляю не вельмі добра.",
  ),
  (
    Bel,
    Medium,
    [7839555],
    "Рэйн цячэ паміж Францыяй і Германіяй.",
  ),
  (
    Bel,
    Long,
    [1523139, 579987, 6197524],
    "Дзяўчына з прагноза надвор’я сказала, што як максімум у нас сёння вечарам будзе слабы дождж. Яна працягнула працаваць. Я была радая, калі я прачнулася і зразумела, што ўсё гэта было проста дурным сном.",
  ),
  (
    Bel,
    Long,
    [3480522, 6599449, 421730, 8095408],
    "Эспэранта, іда, інтэрлінгва, клінганская мова, ложбан, на'ві й валяпюк — сканструяваныя мовы. Нікому гэтага не кажыце. Мой адказ правільны? Рыга — сталіца Латвіі.",
  ),
  (
    Bel,
    Long,
    [389958, 11552017, 8347640, 3505177, 13256716, 8357202],
    "У космасе няма паветра. Хутка зноў будзе Раство. Яна выйшла на кухню. Нам тут рабіць няма чаго. Вы сказалі сваім сябрам? Я прыехаў па тваёй тэлеграме.",
  ),
  (
    Bel,
    Long,
    [5147797, 397401, 391689, 5270892, 2708655],
    "Марская вада салёная. Ніхто не даведаецца. Я нешта для цябе маю. А можна заплаціць дарожнымі чэкамі? Што датычыцца палітыкі, ён усё яшчэ не вылез з пялёнак.",
  ),
  (
    Bel,
    Long,
    [13905063, 2016428, 409036, 8348093],
    "Частка таго, што ты сказаў, гучыць як глупства. Яго нечаканая хвароба ўтрымала нас ад падарожжа. Я паклаў яго у шуфлядку. Твар досыць прыемны, але хітры: вочы так і ўпіваюцца, быццам хочуць наскрозь працяць…",
  ),
  (
    Bel,
    Long,
    [8359179, 11548813, 11555337, 8090211],
    "Але прайшоў час, і Марылька заспакоілася. Сабаку збіў грузавік. Том забыўся набыць падарунак Мэры на дзень народзінаў. Чытач усё роўна аддасць перавагу Караткевічу.",
  ),
  (
    Bel,
    Long,
    [405966, 11533702, 5869394, 13180941, 9981280],
    "У суботу мы пайшлі ў кіно, а потым у рэстаран. Мы пайшлі спаць галодныя. Я нарэшце зразумела, што я цябе не кахаю. Пашпарт, калі ласка. Ёсць вялікая верагоднасць, што ён пераможа.",
  ),
  (
    Bel,
    Long,
    [479007, 8350532, 3623349, 917947],
    "Губка Боб і Патрык — сябры. Любачка мая, гэта ж як свет стаіць, гэткага не чуваць было, чэснае слова. Гэта можа здацца дзіўным, але гэта праўда. Але гэта дзіўна пахне.",
  ),
  (
    Bel,
    Long,
    [4020864, 5897939, 402222, 6667206],
    "Ці думаеш ты, што чалавецтва калісьці каланізуе месяц? Дзяўчынка пайшла ў лес па грыбы. Гэты эканаміст інстынктыўна прадчуваў бягучы спад. Я не надта стамілася.",
  ),
  (
    Bel,
    Long,
    [8004201, 5907327, 11549082, 2805460, 6199442],
    "Вы не маглі б мне дапамагчы? Пачуй голас свайго сэрца! Пакладзі гэта ў сваю кішэню. У кошыку было даволі шмат гнілых яблыкаў. Вы не маглі б распісацца вось тут?",
  ),
  (
    Bel,
    Long,
    [12529863, 8580303, 2941633, 13855994, 8350489],
    "Людзі робяць гэта кожны тыдзень. Я не думала, што іх будзе так шмат. Мы пачалі да світання. Я штосьці прапусціў? Я тады пачула тую магутную волю калектыву, аб якой я калісь табе гаварыла.",
  ),
  (
    Bel,
    Long,
    [5910152, 409051, 12998949, 5869517, 8032537],
    "Гэта не вельмі добрая праца, але з ёй можна плаціць па рахунках. Не ўдавай, што не ведаеш. Большасць пасажыраў былі канадцамі. Перадаш мне адвёртку? Я паехаў у бальніцу наведаць жонку.",
  ),
  (
    Bel,
    Long,
    [13057469, 2463391, 7857039, 8004203, 7773374],
    "Вы абяцалі зрабіць гэта ўчора. Спам на Татоэбе: адгэтуль і ў каментарыях! Я хачу, каб ён вам спадабаўся. Вы размаўляеце па-ангельску? Вам трэба было ўстаць раней.",
  ),
  (
    Bel,
    Long,
    [3314095, 385791, 574525, 4322981, 3266543],
    "Праходьце, калі ласка, і не перагароджвайце пуць. Гэты здымак зрабіў ён. Калі б не ты, я б стаў вялікім акторам. Інь — цёмнае, а Ян — светлае. Шанхайская зберагае супрацьпастаўленне па звонкасці—глухасці, што ў большасці іншых кітайскіх моў знікла.",
  ),
  (
    Bel,
    Long,
    [5931214, 7278016, 1171411, 7705640, 12037951],
    "Гэта сапраўднае золата. Самі любіць клубніцы. Усе дзеці смяяліся з Джэка. Ці можна мне карту аўтобусных маршрутаў? Ці ёсць нейкае іншае выйсце, акрамя выдалення?",
  ),
  (
    Bel,
    Long,
    [8090061, 8348171, 1708223, 4008460],
    "Матэрыялы пра папулярызацыю іх працы, несумненна, з'яўляюцца ўнікальнымі. Звані, звані, Сідар! Кажуць, што няма нічога больш каштоўнага за час. Яны абодзве добрыя шахматысткі.",
  ),
  (
    Bel,
    Long,
    [2054284, 7972665, 409338, 12838696, 1960836, 401138],
    "Гэта гісторыя адной коткі. Я збірала ў садзе клубніцы. Жыццё надта кароткае, каб вывучыць немецкую. Яна размаўляе з намі. Ён вагаўся перад адказам. Мы шпацыравалі па берагах Тэмзы.",
  ),
  (
    Bel,
    Long,
    [3480544, 8089981, 7959466, 4524910, 5926103, 13905120],
    "Вы кітаец ці японец? Андрусь быў студэнтам духоўнай семінарыі. Адгэтуль вы адна з нас. Расія — вельмі вялікая краіна. Паспрабуй сканцэнтравацца! Раскажы Тому, што адбылося.",
  ),
  (
    Bel,
    Long,
    [7281460, 8090238, 1962012],
    "Паглядзі на гэта з яго пункту гледжання. Нам варта яшчэ мець на ўвазе іншыя населеныя пункты. Ніводная дзяржава не павінна ўмешвацца ва ўнутраныя справы іншай дзяржавы.",
  ),
  (
    Bel,
    Long,
    [5934294, 8095457, 8359074, 8089964],
    "Хочаш з ёй пазнаёміцца? Адзіны спосаб мець сябра — быць сябрам. А думкі не збіваюцца, думкі йдуць так роўна і зладна, як у цвярозага. А яны, як дубы, усе роўныя.",
  ),
  (
    Bel,
    Long,
    [8103893, 585257, 8348011, 421703],
    "Як я выпусціла яго з рук? Мяне раптам пабудзілі на золку. Аўгінька, увайшоўшы ў хату, адразу села на лаўку і насупілася. Ніколі не думаў, што і сам так памылюся.",
  ),
  (
    Bel,
    Long,
    [755932, 2614810, 917973, 7851092, 9981282],
    "Не магу з табой пагадзіцца. Мы слухаем музыку, а ты? Я хачу прыняць удзел у гэтай канферэнцыі. Я так рад, што зрабіў гэта. Калі патрэбна, я не маю пярэчанняў заплаціць дадатковы збор.",
  ),
  (
    Bel,
    Long,
    [8359187, 395097, 383711, 592603, 1181305],
    "Усю ноч ён тады прадумаў. «Яна чытае кнігу?» — «Так». За камаром не ганяйся з тапаром. Полымя свечкі калышацца на мяккім ветрыку. Я не магу спыніцца чхаць.",
  ),
  (
    Bel,
    Long,
    [579984, 4023821, 6099694, 8042704, 7707852],
    "Паглядзі на таго хлопчыка, што плавае. Шчаслівай Вальпургіевай ночы! Лайла мне толькі што патэлефанавала. Мне падабаецца блакітны колер. Том у апошні час шмат хварэў.",
  ),
  (
    Bel,
    Long,
    [2221843, 6599480, 637188],
    "68,4% апытаных беларусаў адказалі, што не абралі б версію кнігі на беларускай мове ні пры якіх умовах. Музыка — гэта маё жыццё. Мой брат жыве ў Токіа.",
  ),
  (
    Bel,
    Long,
    [11534023, 4147820, 11666605, 13135805, 8004192, 1708158],
    "Можа быць іншы спосаб гэта зрабіць. Я стамілася да смерці. Том выгодна прыладзіўся на канапе. Я нарадзілася ў Кіёта. Дарэчы, дзе ты жывеш? Раскажы мне што-небудзь аб сваёй сям'і.",
  ),
  (
    Bel,
    Long,
    [8044913, 6606962, 9987625, 2976349, 1343104],
    "Мяне ўражвае ваша праца. Давай возьмем яе да хаты. Том не быў арыштаваны. Той, хто не ведае замежных моў, нічога не ведае пра ўласную. Музычныя ноты на маёй мове—гэта до, рэ, мі, фа, соль, ля і сі.",
  ),
  (
    Bel,
    Long,
    [7959426, 4295823, 4020813, 521707, 425958, 6100518],
    "Я нічога не разумею. Ілона працуе сурдаперакладчыцай. Восенню месяц прыгожы. Любіш ружу — цярпі і калючкі. Ён скончыў Такійскі Універсітэт. Чырвонашыйка — адна з найвядомейшых пявучых птушак, якія жывуць у Англіі.",
  ),
  (
    Bel,
    Long,
    [11750730, 580068, 1307127, 419894],
    "Яна выехала з Алжыру. Яму падабаецца не толькі бейсбол, але і футбол. Дваццаць першае стагоддзе пачынаецца ў 2001 годзе. Калі ласка, скапіюйце гэтую старонку.",
  ),
  (
    Bel,
    Long,
    [1438644, 4724578, 8004567, 1708252],
    "Я думаў, што Том спіць. Ты памеціла падабенства ў вымаўленні паміж польскай і партугальскай мовамі? Што б Вы зрабілі на маім месцы? Ты б чаму аддаў перавагу: пайсці ў кіно ці застацца дома?",
  ),
]

///|
let rows_bul : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Bul, Short, [3250616], "Ти си голямо момче."),
  (
    Bul,
    Short,
    [2323802],
    "Седи си един човек в кухнята.",
  ),
  (Bul, Short, [779627], "Не мърдайте."),
  (Bul, Short, [7666421], "Не си длъжен да обясняваш."),
  (
    Bul,
    Short,
    [3556291],
    "Искаш ли да чуеш нещо смешно?",
  ),
  (Bul, Short, [821567], "Дай ми нещо за ядене."),
  (Bul, Short, [4542024], "Аз бях осъдена."),
  (Bul, Short, [3927126], "Вече опитах по този начин."),
  (Bul, Short, [3256849], "Тя сгреши."),
  (Bul, Short, [2464236], "Мисля, че Том спи."),
  (Bul, Short, [3548151], "Време е да си ходя."),
  (
    Bul,
    Short,
    [2612768],
    "Можеш ли да броиш на френски?",
  ),
  (Bul, Short, [3264314], "Колко тежи тази бала?"),
  (Bul, Short, [528240], "Очевидно е, че ти излъга."),
  (Bul, Short, [3329077], "Тук сте в опасност."),
  (Bul, Short, [4713921], "Коя е любимата Ви птица?"),
  (Bul, Short, [2817429], "Ако ти трябва помощ, питай."),
  (Bul, Short, [771215], "Ще те черпя."),
  (
    Bul,
    Short,
    [2374253],
    "Том попадна в капана на Мери.",
  ),
  (Bul, Short, [3329183], "Закъсня с три дена."),
  (Bul, Short, [762603], "Ходим в едио и също училище."),
  (Bul, Short, [4550084], "Обади ми се, като свършиш!"),
  (Bul, Short, [830008], "Няма грешка."),
  (Bul, Short, [3927100], "Кой ти купи това?"),
  (Bul, Short, [3700160], "Спри да бъдеш така наивен."),
  (Bul, Short, [4864014], "Той ме нае."),
  (Bul, Short, [3700132], "Не си ли уплашен, Том?"),
  (Bul, Short, [767861], "Детето нарисува цветя."),
  (Bul, Short, [3933994], "Имаш ли монета?"),
  (Bul, Short, [3563989], "Косата му е дълга."),
  (
    Bul,
    Medium,
    [2605934],
    "Съобщението е написано на френски.",
  ),
  (
    Bul,
    Medium,
    [777813],
    "Той създаде училището преди пет години.",
  ),
  (
    Bul,
    Medium,
    [3802900],
    "Каква е минималната заплата в Мароко?",
  ),
  (
    Bul,
    Medium,
    [3785528],
    "И този път ми се размина на косъм.",
  ),
  (
    Bul,
    Medium,
    [12917231],
    "Аз отговорих само на един въпрос.",
  ),
  (
    Bul,
    Medium,
    [4549255],
    "Не знам как се произнася името Ви.",
  ),
  (
    Bul,
    Medium,
    [2860504],
    "Тя се качи на автобус за Хараюки.",
  ),
  (
    Bul,
    Medium,
    [2823529],
    "Френският е един от езиците, които винаги съм искал да науча.",
  ),
  (
    Bul,
    Medium,
    [4643176],
    "Не мога да повярвам, че никой не е умрял.",
  ),
  (
    Bul,
    Medium,
    [3256758],
    "Студено ми е. Имате ли нещо против да пусна отоплението?",
  ),
  (
    Bul,
    Medium,
    [3699688],
    "Как говорят мандарин шанхайците?",
  ),
  (
    Bul,
    Medium,
    [3700098],
    "Не очаквах да те видя на подобно място.",
  ),
  (
    Bul,
    Medium,
    [3785662],
    "Скочи колкото се може по-високо.",
  ),
  (
    Bul,
    Medium,
    [3243158],
    "Това е снимка на по-малката ми сестра.",
  ),
  (
    Bul,
    Medium,
    [821685],
    "Аз не можах да намеря неговата къща.",
  ),
  (
    Bul,
    Medium,
    [4800211],
    "Имам проблем. Трябва ми вашата помощ.",
  ),
  (
    Bul,
    Medium,
    [2791191],
    "Мисля, че си пила твърде много.",
  ),
  (
    Bul,
    Medium,
    [777769],
    "Той даде на всеки от тях по един молив.",
  ),
  (
    Bul,
    Medium,
    [2787814],
    "Помислих си, че може да се окаже сложно.",
  ),
  (
    Bul,
    Medium,
    [2799921],
    "Тя прекара много дни, плетейки пуловер за него.",
  ),
  (
    Bul,
    Medium,
    [2464071],
    "Мисля, че трябва да съобщим на родителите на Том.",
  ),
  (
    Bul,
    Medium,
    [2346318],
    "Сигурна ли си, че не искаш малко от това?",
  ),
  (
    Bul,
    Medium,
    [771522],
    "Нейното хоби е да събира пощенски марки.",
  ),
  (
    Bul,
    Medium,
    [3858563],
    "Том започна да си закопчава ризата.",
  ),
  (
    Bul,
    Medium,
    [765556],
    "Дори когато беше много заета, тя пак идваше да ме изпрати.",
  ),
  (
    Bul,
    Medium,
    [1601619],
    "Ще си правим парти в костюми от осемнайсти век.",
  ),
  (
    Bul,
    Medium,
    [2347203],
    "Сигурен ли си, че не искаш да дойдеш с мене?",
  ),
  (
    Bul,
    Medium,
    [3946140],
    "Можеш ли да изчакаш до 2.30 този следобед.",
  ),
  (
    Bul,
    Medium,
    [762530],
    "Предпочитам да пътувам със самолет.",
  ),
  (
    Bul,
    Medium,
    [3937290],
    "Споменавал ли съм ти някога какво направихме с Том в Бостън?",
  ),
  (
    Bul,
    Long,
    [3699637, 3328987, 782747, 830676, 3256619, 1489870],
    "Прав ти път, крива ти пътечка. Изобщо не съм толкова зает. Гледаш ли телевизия? Напоследък не съм виждал Том. Той е метросексуален. Не е голяма изненада, нали?",
  ),
  (
    Bul,
    Long,
    [4645723, 3751720, 830074, 3471766, 4480101, 2787360],
    "Той е работник във ферма. Това беше наистина мило. Той запали една клечка. Можете да ме цитирате. Мислех, че сте уморена. Тук, в Бразилия, е 5:00 сутринта.",
  ),
  (
    Bul,
    Long,
    [4864077, 3229464, 3556216, 3229420],
    "Брат ми беше назначен на работа в една голяма компания. Полетът ви е отменен. Разбира се, че те помня, ние бяхме първи приятели в началното училище! Не приемайте нищо за дадено.",
  ),
  (
    Bul,
    Long,
    [3699937, 5419079, 2338031, 2733190, 3710936],
    "Компанията скоро ще фалира. Том съжалява, че е обидил Мери. Искам да се видя с Том. Говори гласно, за да могат всички да те чуят. Този проблем е по-лесен от това.",
  ),
  (
    Bul,
    Long,
    [4531495, 4800154, 3329190, 2787651, 2346135, 2378425],
    "Няма да ти се сърдя за това. Мечтата ми е да стана учител. Ще послушам съвета ви. Мисля, че не трябва да го правим. Ти психично болен ли си? Изглежда имам лека настинка.",
  ),
  (
    Bul,
    Long,
    [4458931, 10005409, 4642108, 4646372, 3035130],
    "Вана или душ предпочиташ? Чаят струва две евро. Не мога да разбера какво се опитва да каже. Ще говоря с Том, когато се върне вкъщи. Какво те води насам?",
  ),
  (
    Bul,
    Long,
    [3212639, 3538811, 3926962, 3033010, 8468254, 376020],
    "Никога преди не съм срещал Том. Аз ще бъда щастлива завинаги! В кутията има кукла. Вие виждали ли сте Том? Кучето бе блъснато от кола. Обичаш ли китайска кухня?",
  ),
  (
    Bul,
    Long,
    [4455486, 3699946, 3700236, 13603475, 2312626],
    "Музеят на изкуствата някъде тук ли се намира? Не искам Том да ме види гола. Не е нужно да казвам нищо на Том. Излъгах. Моля ви, простете ми. Те си бъбриха на кафе повече от два часа.",
  ),
  (
    Bul,
    Long,
    [5418752, 816785, 11616771, 799427, 4737648],
    "Подозираме отравяне. Този ръчен часовник е произведен в Япония. Как успя да убедиш Том да ти помогне? Тя успя да реши задачата за десет минути. Том често се скита навън цяла нощ.",
  ),
  (
    Bul,
    Long,
    [808546, 2320997, 3264651, 776783],
    "Как смееш да казваш това? Много мои приятели предпочетоха да учат немски вместо испански. Тази трябва да я обясниш, защото не я разбрах. Може ли да отхапя малко?",
  ),
  (
    Bul,
    Long,
    [3252626, 2817580, 3946238, 821852, 4109227],
    "Той е популярен въпреки всичките си недостатъци. Не съм искала да нараня ничии чувства. Каза ли на Том, че съм тук? Джейн сама написа писмото. В това изречение има пет думи.",
  ),
  (
    Bul,
    Long,
    [762182, 2788812, 3329222, 3264804, 2613298, 771554],
    "От вас няма повече полза. Какво има в куфара ти? Том също не е гладен. Том разбира каквото вие не разбирате. Това е част от работата ми. Той живее някъде наоколо.",
  ),
  (
    Bul,
    Long,
    [4604199, 4465642],
    "Не искам да се нараниш сериозно само заради удоволствието да се разхождаш с развързани обувки. Мой е изборът да живея в провинцията и вече не мога без чистия въздух, зеленината, тишината и човешкия ритъм на живот.",
  ),
  (
    Bul,
    Long,
    [375064, 3790525, 2817454, 3328290, 2312643],
    "Искам да имам близък човек, с когото да си говоря. В сравнение с баща си, той е повърхностен. Мисля, че си въобразяваш. Том знае, че съм вкъщи. Той имаше тъмнокестенява коса.",
  ),
  (
    Bul,
    Long,
    [1461456, 3751583, 2845444, 2787845, 4510131],
    "Ще трябва да му се извиниш когато го видиш. Том най-накрая отиде. Какъв ти е номерът на телефона? Може да успея да намеря време да ви помогна. Контролирай емоциите си.",
  ),
  (
    Bul,
    Long,
    [3702642, 878548, 2798013, 2849499, 764325, 2612886],
    "Не забравяй да ми звъннеш. В десет вечерта аз вече спя. Тази риза е стандартен размер. Надявам се, че не те отегчавам. Тя лекичко бутна вратата. Том говори с учителите си на френски.",
  ),
  (
    Bul,
    Long,
    [2849569, 2845463, 3035213, 2370992],
    "Не съм ти казал всичко. Кой номер обувки носите? Когато бях студент в университета, никога не спях в нощта преди изпита. Престани да ме наричаш \"Том\".",
  ),
  (
    Bul,
    Long,
    [821512, 4549134, 2224982, 3926950, 2605543],
    "Познавате ли г-н Браун? Вече не се хващам на бас. Как разбираш, че пациентът не симулира болестта си ? Бих искал да купя тази кукла. Том много добре знае какво става в офиса.",
  ),
  (
    Bul,
    Long,
    [765446, 822722, 4598511, 776791, 3932090, 821464],
    "Аз познавам тези момичета. Историята му беше забавна на всички. Мария бърше сестра си. Всички пееха, освен мен. Не разбирам кучешки език. Не се присмивай на хората.",
  ),
  (
    Bul,
    Long,
    [2311782, 2823787, 2789532, 2605977],
    "Миналата нощ ми ограбиха къщата още докато бях будна. Доста ме бива в приготвянето на спагети. Какви са вашите изводи? Иска ми се да можех да говоря на френски.",
  ),
  (
    Bul,
    Long,
    [2787620, 3785540, 3703852, 2326115, 2194665],
    "Това повече няма да ви трябва. Като малка много обичах да ме гъделичкат по петичките. Тя ме помисли за доктор. За малко да ме блъсне кола. Тъкмо получихме сведения от Канзас касаещи брат ти.",
  ),
  (
    Bul,
    Long,
    [3329227, 3244594, 2347233, 762541, 1601593],
    "Том не се среща с никого. Направих си чекова сметка. Сигурен ли си, че наистина искаш да го направиш? Той използва талантите си добре. Изправени сме пред много проблеми.",
  ),
  (
    Bul,
    Long,
    [4645712, 2827842, 834230, 5140379, 821587],
    "Не съм отговорил на нито едно писмо. Опитах се да се свържа с Том. Той не живее в моя квартал. Това може да се окаже малко натоварващо. Пет галона нормален, ако обичате.",
  ),
  (
    Bul,
    Long,
    [4452450, 4534400, 828788, 4610650],
    "Скоро мина контрола. Може ли да приключваме? В някои отношения то приличало на футбола, който се играе в наши дни. Кралю порталю, отвори порти, че ще замине кралят за войската. Лъжичка, паничка, тиганче, капанче!",
  ),
  (
    Bul,
    Long,
    [760670, 2378128, 4558284],
    "Макар това да значеше, че ще се изложи на опасност, той се реши да отиде там. Том ходи подире ми навсякъде напоследък. Интернет връзката ту спира, ту тръгва.",
  ),
  (
    Bul,
    Long,
    [763660, 4452556, 2800019, 4534616, 762407, 821571],
    "Моля те, запази тази тайна. До кой терминал мога да стигна с метрото? Тя реши да вземе синя рокля. Всъщност сега затваря! Никой няма да разбере. Башо бил най-великият поет.",
  ),
  (
    Bul,
    Long,
    [372836, 834299, 3858562, 1490886, 1601600],
    "Тя влезе със сълзи на очи. Таро, можеш ли да ми помогнеш? Том си закопча ризата. Тя не може да бъде на повече от двадесет. Ние слизаме на следващата гара.",
  ),
  (
    Bul,
    Long,
    [2788900, 878541, 2370881, 761021, 3703850, 9008545],
    "Може ли да ви целуна? Ами... моята къща не е достатъчно голяма. Том идва тук всеки божи ден. Той седна начело на масата. Защо ли още слушам това? Мога ли да дойда сега да те видя?",
  ),
  (
    Bul,
    Long,
    [2843957, 811527, 3450118, 2787650, 4645743],
    "Виждал съм Том да прави някои доста забележителни неща. Той е добър по математика. Защото ти е време да пораснеш. Няма да повярваш, ако ти кажа. Ти ли си новият асистент?",
  ),
  (
    Bul,
    Long,
    [2805607, 2346246, 3556207],
    "Той закачи палтото си на куката. Сигурен ли си, че не искаш нещо за ядене? Най-добрият ми приятел работи за една неправителствена организация в Афганистан.",
  ),
]

