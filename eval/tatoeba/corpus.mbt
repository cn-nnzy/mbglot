  (Jav, Short, [10670720], "Kobalèni manèh."),
  (
    Jav,
    Short,
    [11434224],
    "ꦩꦤꦸꦁꦱꦲꦶꦏꦸꦲꦺꦴꦫꦧꦶꦱꦲꦸꦫꦶꦥ꧀ꦠꦤ꧀ꦥꦲꦮ꧉",
  ),
  (Jav, Short, [3986781], "Dhèwèké ora duwé kulawarga."),
  (Jav, Short, [13712703], "Tom turuné nang kono."),
  (Jav, Short, [13667902], "Coroné nang lawang!"),
  (Jav, Short, [13798786], "Banyuku nang endi?"),
  (Jav, Short, [10007667], "Kowé ngombé apa?"),
  (
    Jav,
    Short,
    [13258787],
    "ꦲꦏꦸꦲꦺꦭꦶꦁꦥꦁꦒꦺꦴꦤ꧀ꦲꦶꦏꦶ꧉",
  ),
  (Jav, Medium, [10721466], "Aku tuku payung iki telung minggu kapungkur."),
  (Jav, Medium, [3978477], "Rama kula wonten pundi, inggih?"),
  (Jav, Medium, [9995850], "Aku ora kenal karo tangga-tanggaku."),
  (
    Jav,
    Medium,
    [12742896],
    "ꦲꦏꦸꦤꦼꦩꦸꦕꦼꦩꦺꦁꦤꦁꦢꦭꦤ꧀ ꦧꦚ꧀ꦗꦸꦂꦢꦏ꧀ꦒꦮꦤꦁꦲꦺꦴꦩꦃ꧉",
  ),
  (
    Jav,
    Medium,
    [3978492],
    "Aku ora isa teka nèng restoran karo kowé mengko bengi.",
  ),
  (Jav, Medium, [8891821], "Kowé bisa ndelok dhèwèké kabèh ora?"),
  (
    Jav,
    Medium,
    [11202226],
    "ꦏꦸꦭꦢꦺꦫꦺꦁꦱꦒꦼꦢ꧀ꦔꦺꦴꦩꦺꦴꦁꦧꦱꦅꦤ꧀ꦝꦺꦴꦤꦺꦱꦾꦭꦚ꧀ꦕꦂ꧉",
  ),
  (Jav, Medium, [3984085], "Tak pikir Tom kuwi nèng omah turu."),
  (Jav, Medium, [9971366], "Awak dhéwé lunga énggal mariné udan."),
  (
    Jav,
    Medium,
    [3978479],
    "Kayané awakdhéwé bakal tekan Boston sakdurungé surup.",
  ),
  (Jav, Medium, [3978458], "Kowé nduwe apa menèh nèng sakmu?"),
  (
    Jav,
    Medium,
    [3988855],
    "Ora ana perkara penting liyané sing arep tak omongké.",
  ),
  (Jav, Medium, [10502817], "pasagi mbata lan wajikan iku pasagi miring."),
  (Jav, Medium, [10722261], "Aku ora seneng lungguh nang jaba."),
  (
    Jav,
    Medium,
    [9666130],
    "ꦏꦼꦢꦸꦠꦲꦤ꧀ꦭꦤ꧀ꦢꦮꦺꦴꦤ꧀ꦠꦼꦤ꧀ꦲꦶꦁꦥꦸꦤ꧀ꦢꦶꦔ꧀ꦒꦶꦃ?",
  ),
  (Jav, Medium, [10644346], "Papan anggegananipun tebih napa boten?"),
  (
    Jav,
    Medium,
    [3984108],
    "Apa bener yèn wong modèrn kuwi kalong wayah turuné?",
  ),
  (Jav, Medium, [10711390], "Saben bocah duwé kamaré dhéwé-dhéwé."),
  (Jav, Medium, [11060992], "Mari ngéné kowé arep lunga menyang ngendi?"),
  (Jav, Medium, [13381779], "Aku nyambut gawé dadi kasir ana ing supermarket."),
  (Jav, Medium, [11162412], "Bocah wadon iku rambuté ireng lan matané biru."),
  (Jav, Medium, [12028095], "Sepur iki ora mandheg ing kéné."),
  (
    Jav,
    Medium,
    [3941256],
    "Mangga sepatu dicopot lan didèlèhaké ana ing rak sepatu.",
  ),
  (Jav, Medium, [12473979], "Saben negara duwé gendérané dhéwé-dhéwé."),
  (
    Jav,
    Medium,
    [11084779],
    "Isih ana akèh banget sing awak dhéwé kudu nyinaoni.",
  ),
  (
    Jav,
    Medium,
    [11008273],
    "ꦱꦼꦥꦸꦂꦫꦺꦲꦮꦏ꧀ꦝꦺꦮꦺꦧꦏꦭ꧀ꦠꦸꦠꦸꦏ꧀ꦲꦏꦠꦗꦩ꧀ꦥꦶꦫ‌?",
  ),
  (
    Jav,
    Medium,
    [8864762],
    "ꦝꦺꦮꦺꦏꦺꦔꦺꦴꦩꦺꦴꦁꦤꦁꦲꦏꦸꦪꦺꦤ꧀ꦲꦉꦥ꧀ꦭꦸꦔꦩꦼꦚꦁꦥꦫꦶꦱ꧀ꦮꦸꦭꦤ꧀ꦄꦒꦸꦱ꧀ꦠꦸꦱ꧀꧈",
  ),
  (
    Jav,
    Medium,
    [3988917],
    "Tom ngandhani Mary yèn dhèwèké ora seneng ngrembug perkarané karo dhèwèké.",
  ),
  (
    Jav,
    Medium,
    [8873561],
    "ꦠꦺꦴꦩ꧀ꦲꦺꦴꦫꦮꦼꦫꦸꦃꦪꦺꦤ꧀ꦩꦺꦫꦶꦲꦶꦏꦸꦮꦺꦴꦁꦏꦤꦝ꧉",
  ),
  (
    Jav,
    Medium,
    [3988874],
    "Pametuné malah sawaliké saka sing dikarepaké awakdhéwé.",
  ),
  (
    Jav,
    Long,
    [3986826, 12895605, 13631215, 10798975],
    "Tak pikir ta, sing paling nggumunaké yaiku jebulé Tom kuwi bisa cecaturan mèh karo sapa waé. Aku ora gelem dadi guru. Aku ora butuh dhuwitmu. ꦗꦫꦺꦠꦺꦴꦩ꧀ꦲꦏꦸꦧꦸꦠꦸꦃꦥꦫꦧ꧀ꦧꦤ꧀꧈",
  ),
  (
    Jav,
    Long,
    [10041470, 11071689, 13976199, 9666081, 3988867, 4554550],
    "Dhèwèké kètokané lara. ꦲꦏꦸꦲꦺꦴꦫꦒꦼꦊꦩ꧀ꦭꦸꦔꦔ꧀ꦭꦔꦶꦢꦶꦤꦲꦶꦏꦶ꧉ ꦲꦏꦸꦲꦺꦴꦫꦱꦼꦤꦼꦁꦧꦱꦅꦁꦒꦿꦶꦱ꧀꧈ Nangis iku ora apa-apa. Mampir ngetèh dhisik, mbokan? Kowé kuwi mesthi telat.",
  ),
  (
    Jav,
    Long,
    [12117831, 9934131, 3938553, 12742880],
    "Turua nang paturonku. Persis kaya sing dakpikiraké. Yèn sira muni, \"Aku tresna marang sira,\" mangka aku uga bakal muni ngono marang sliramu. Aku péngin sinau iki.",
  ),
  (
    Jav,
    Long,
    [9665265, 8864706, 13710464, 12164302, 13012305, 10256311, 10979877],
    "ꦄꦗꦭꦭꦶꦔꦶꦫꦶꦩꦏꦺꦭꦪꦁꦏꦸꦮꦶ꧉ ꦲꦏꦸꦠꦸꦏꦸꦧꦸꦏꦸꦒꦮꦺꦠꦺꦴꦩ꧀꧈ ꦲꦏꦸꦱꦶꦱꦤ꧀ꦢꦸꦮꦺꦲꦱꦸꦲꦶꦉꦁ꧉ Masjid iku dibukak manèh. ꦱꦶꦗꦶ꧈ ꦭꦺꦴꦫꦺꦴ꧈ ꦠꦼꦭꦸ꧈ ꦥꦥꦠ꧀ ꦭꦶꦩ꧉ ꦠꦺꦴꦩ꧀ꦲꦺꦴꦫꦱꦪꦁꦏꦫꦺꦴꦲꦏꦸ꧉ Biyèn aku wedi karo asu.",
  ),
  (
    Jav,
    Long,
    [8864924, 13660209, 12099307, 11434230, 12398947, 3695240],
    "ꦝꦺꦮꦺꦏꦺꦲꦺꦴꦫꦱꦼꦤꦼꦁꦱꦸꦯꦶ꧉ ꦠꦺꦴꦩ꧀ꦱꦼꦤꦼꦁꦲꦚ꧀ꦗꦺꦴꦒꦺꦢ꧀꧈ ꦒꦼꦤꦺꦪꦝꦺꦮꦺꦏ꧀ꦏꦺꦲꦉꦥ꧀ꦏꦽꦗꦤꦁꦏꦺꦤꦺ? ꦗꦂꦫꦺꦠꦺꦴꦩ꧀ꦝꦺꦮꦺꦏ꧀ꦏꦺꦏꦚ꧀ꦕꦭꦮꦱ꧀ꦩꦸ꧉ Anaké lagi sinau nyetir. Kepriyé kowé nyebutné iki?",
  ),
  (
    Jav,
    Long,
    [13662208, 11086363, 11023692, 3937493, 11084806, 9971369],
    "Aku kerep mangan gedhang. Sepuré tekan ing London. Riga iku kutha krajané Lètlan. Manuk-manuké duwé werna abang. Oh, kowé wong Itali! ꦄꦮꦏ꧀ꦝꦺꦮꦺꦭꦸꦔꦌꦔ꧀ꦒꦭ꧀ꦩꦫꦶꦤꦺꦈꦢꦤ꧀꧈",
  ),
  (
    Jav,
    Long,
    [3938592, 10969642, 10976189, 3937473, 10273322],
    "Kowé wis adus apa durung? Taiwan iku dudu Praja Thai. ꦲꦺꦴꦩꦃꦲꦺꦠꦺꦴꦩ꧀ꦲꦤꦲꦶꦁꦔꦼꦤ꧀ꦢꦶ‌? Iwaké dhongé aja diguwak, isa dienggo pakan kucing. ꦠꦺꦴꦩ꧀ꦧꦏꦭ꧀ꦤꦼꦫꦁꦔꦏꦺꦱꦏꦧꦺꦃꦲꦺ꧉",
  ),
  (
    Jav,
    Long,
    [13217298, 10729455, 3978345, 8864681, 9665533, 4560194],
    "Kowé lagi sinau basa apa? ꦲꦏꦸꦱꦶꦤꦲꦸꦧꦱꦆꦁꦒꦿꦶꦱ꧀ꦮꦶꦱ꧀ꦠꦼꦭꦸꦁꦠꦲꦸꦤ꧀꧈ Kula kedah tangi mruput. ꦱꦥꦱꦶꦁꦔꦁꦏꦠ꧀ꦠꦶꦭ꧀ꦥꦸꦤ꧀ꦩꦸ? ꦱꦲꦶꦏꦶꦲꦏꦸꦠꦼꦩꦼꦤꦤ꧀ꦏꦸꦢꦸꦧꦸꦝꦭ꧀꧈ ꦲꦏꦸꦩꦼꦤ꧀ꦣꦶꦁꦩ꧀ꦭꦏꦸꦠꦶꦤꦶꦩ꧀ꦧꦁꦔꦼꦤ꧀ꦠꦺꦤꦶꦧꦶꦱ꧀ꦱꦧꦚ꧀ꦗꦸꦫꦺ",
  ),
  (
    Jav,
    Long,
    [12132462, 9648862, 12413759, 13736900, 12950269, 10256294],
    "ꦝꦺꦮꦺꦏ꧀ꦏꦺꦲꦺꦴꦫꦒꦼꦊꦩ꧀ꦔꦼꦤ꧀ꦠꦺꦤ꧀ꦤꦶ꧉ Tom ora seneng nèng Boston. Tom dakjarna ngomong. Dhèwèké kabèh kaya ngono. ꦲꦏꦸꦮꦼꦫꦸꦃꦲꦏꦸꦧꦏꦭ꧀ꦩ꧀ꦭꦼꦧꦸꦤꦫꦏ꧉ Tom ora seneng karo aku.",
  ),
  (
    Jav,
    Long,
    [12309388, 11156693, 10719258, 10721405, 10707430, 3988946],
    "ꦲꦶꦏꦶꦥꦁꦒꦺꦴꦤ꧀ꦱꦶꦁꦲꦥꦶꦏ꧀ꦧꦔꦼꦠ꧀꧈ Aku bakal nyritakake ng bapakku ꦪꦤ꧀ꦤꦶꦚꦼꦠꦂꦠꦼꦂꦥꦿꦲꦺꦴꦠꦺꦴꦤꦺ꧉ ꦩꦼꦤ꧀ꦝꦶꦁꦔꦤ꧀ꦲꦮꦏ꧀ꦩꦸꦠꦸꦫꦸꦧꦲꦺ꧉ ꦉꦉꦩ꧀ꦧꦸꦒ꧀ꦒꦤ꧀ꦤꦺꦩꦫꦶꦗꦩ꧀ꦱꦔ꧉ Yusuf mlakuné nyèmpèr.",
  ),
  (
    Jav,
    Long,
    [8864961, 13668313, 4971706, 11543208, 13712719],
    "ꦭꦺ꧈ ꦄꦪꦺꦴꦩꦺꦭꦸꦧꦥꦏ꧀ꦩꦼꦚꦁꦱꦮꦃ! Kowé gelem ora, manggon ning Ostrali? Sadurungé aku durung tau mlebu kelas iki. Wis dakwanti-wanti aja nganti kaya ngono. Dhèké dakjarna menang.",
  ),
  (
    Jav,
    Long,
    [8864737, 3938572, 10502815, 13616865],
    "Kelas iki duwé telung puluh lima murid. Anggona jus limun katimbang cokak. pasagi dawa lan wajikan iku pasagi miring. ꦲꦤꦮꦺꦴꦁꦲꦤ꧀ꦢꦼꦭꦺꦴꦏ꧀ꦏꦶꦲꦮꦏ꧀ꦝꦺꦮꦺꦱꦏꦕꦼꦤ꧀ꦝꦺꦭꦏꦸꦮꦶ꧉",
  ),
  (
    Jav,
    Long,
    [12132498, 12423984, 9848275, 3984081, 13649937],
    "Sésuk bakal luwih adhem manèh. Bojoné Tom asalé saka Ruslan. Awakmu anak sing kepira? Tom bisa basa Perancis amèh padha apiké kaya aku. ꦒꦗꦃꦲꦶꦏꦸꦏꦺꦮꦤ꧀ꦱꦶꦁꦥꦶꦤ꧀ꦠꦼꦂꦧꦔꦼꦠ꧀꧈",
  ),
  (
    Jav,
    Long,
    [8873690, 8872645, 10007617, 10271588],
    "ꦱꦶꦗꦶ꧈ ꦭꦺꦴꦫꦺꦴ꧈ ꦠꦼꦭꦸ꧈ ꦥꦥꦠ꧀ ꦭꦶꦩ꧈ ꦲꦼꦤꦼꦩ꧀ ꦥꦶꦠꦸ꧈ ꦮꦺꦴꦭꦸ꧈ ꦱꦔ꧈ ꦱꦥꦸꦭꦸꦃ꧉ Toni bisa mlayu banter. Jané aku waé durung tau ketemu karo Tom. ꦥꦭꦶꦁꦠꦺꦴꦩ꧀ꦮꦼꦫꦸꦃꦩꦺꦫꦶꦚꦩ꧀ꦧꦸꦠ꧀ꦒꦮꦺꦤꦶꦁꦔꦼꦤ꧀ꦢꦶ꧉",
  ),
  (
    Jav,
    Long,
    [4477006, 9848341, 10690576, 3984082, 9934309],
    "Ora enthuk ngomong sing ra elok. Kowe bakal mati yen mung meneng wae ning kene ꦲꦶꦏꦸꦠꦶꦭ꧀ꦥꦸꦤ꧀ꦤꦺꦠꦺꦴꦩ꧀ꦠ? Aku krungu ceritané kowé karo Tom. Aku ora tau mangan panganan Cina.",
  ),
  (
    Jav,
    Long,
    [11084696, 13381782, 10719244, 12398949, 12028872, 9983112],
    "ꦧꦱꦮꦭꦤ꧀ꦢꦲꦶꦏꦸꦲꦺꦴꦫꦲꦔꦺꦭ꧀ꦢꦶꦱꦶꦤꦲꦺꦴꦤꦶ꧉ ꦲꦏꦸꦚꦩ꧀ꦧꦸꦠ꧀ꦒꦮꦺꦢꦢꦶꦏꦱꦶꦂꦲꦤꦲꦶꦁꦱꦸꦥꦼꦂꦩꦂꦏꦼꦠ꧀꧈ ꦝꦺꦮꦺꦏꦺꦏꦧꦺꦃꦭꦒꦶꦔꦿꦸꦒꦺꦴꦏꦏꦺꦫꦝꦶꦪꦺꦴ꧉ ꦲꦤꦏ꧀ꦏꦺꦭꦒꦶꦱꦶꦤꦲꦸꦚꦼꦠꦶꦂ꧉ Kula mahasiswa Biologi. Kowé kudu ngati-ati yèn milih kanca.",
  ),
  (
    Jav,
    Long,
    [12028875, 12828458, 10729450, 4476943, 3988950, 8872601],
    "ꦏꦸꦭꦩꦲꦱꦶꦱ꧀ꦮꦧꦶꦪꦺꦴꦭꦺꦴꦒꦶ꧉ ꦲꦏꦸꦲꦺꦴꦫꦒꦼꦊꦩ꧀ꦢꦢꦶꦧꦺꦴꦗꦺꦴꦩꦸ꧉ Aku sinahu basa Inggris wis telung tahun. Jarene kowe arep lunga? Kapan olèhé kadadèn? Wong-wong ora ngomong iku manèh.",
  ),
  (
    Jav,
    Long,
    [11086253, 12134408, 3949939, 3978362],
    "ꦠꦏꦺꦴꦤ꧀ꦤꦤꦧꦲꦺꦩꦫꦁꦱꦶꦁꦭꦶꦪꦤꦺ꧉ ꦲꦏꦸꦭꦭꦶꦠꦏꦺꦴꦤ꧀ꦗꦼꦤꦼꦁꦔꦺꦱꦥ꧉ Wis setaun kapungkur kawit dhèwèké teka mréné. Wonten woh-wohan kaliyan ulam-ulaman wonten ing peken punika.",
  ),
  (
    Jav,
    Long,
    [8864784, 12797673, 3942818, 4575438, 10273313],
    "Aku seneng karo kutha iki. Aku lair nem èwu taun kapungkur. Cobi Panjenengan ambekan saking grana. Aku sujana marang patiné dhéké. ꦧꦭ꧀ꦲꦶꦏꦸꦲꦁꦒ꧀ꦭꦶꦤ꧀ꦝꦶꦁꦚꦼꦧꦿꦁꦢꦭꦤ꧀꧈",
  ),
  (
    Jav,
    Long,
    [11008256, 11008258, 10976213, 4549784, 10963146],
    "Ora ana sing luwih apik saka ulahraga. ꦲꦺꦴꦫꦲꦤꦱꦶꦁꦭꦸꦮꦶꦃꦲꦥꦶꦏ꧀ꦱꦏꦲꦸꦭꦃꦫꦒ꧉ ꦄꦪꦺꦴꦔꦼꦤ꧀ꦠꦺꦤꦶꦲꦶꦁꦗꦧꦧꦲꦺ꧉ Tom mungkasi sesorahé sarana tembang kang éndah. ꦧꦱꦲꦺꦴꦁꦒꦫꦶꦲꦶꦏꦸꦧꦱꦤꦺꦲꦔꦺꦭ꧀꧈",
  ),
  (
    Jav,
    Long,
    [3986803, 10675145, 3942779, 10716671, 10719257],
    "Dhèwèké ora bisa diandelaké merga dhèwèké kerep goroh. Apa manèh sing kodelok? Ati-ati aja nganti kowé nglarani awakmu dhéwé. ꦲꦶꦏꦶꦢꦸꦢꦸꦱꦶꦁꦏꦥꦶꦁꦥꦶꦱꦤ꧀꧈ Yanni nyetarter prahotoné.",
  ),
  (
    Jav,
    Long,
    [4476946, 8872591, 3938712, 12046050],
    "Aku ora reti apa-apa. Aku kudu ngerjakna PR-ku, ora malah lunga metu. Kowé sajaké durung ngerti rasané dipatil lélé. Bocah-bocahé ora gelem dolan karo Tom.",
  ),
  (
    Jav,
    Long,
    [9676870, 10125798, 12895591, 10644342, 8872583],
    "Apa kowé weruh sapa sing nyolong lèptopé Tom? Aku bocah paling dhuwur ana ing kelasku. Kula gadhah buku énggal. ꦲꦮꦏ꧀ꦝꦺꦮꦺꦲꦺꦴꦫꦢꦸꦮꦺꦝꦸꦮꦶꦠ꧀꧈ Tomas lair ing Sao Paulo ing Brasil.",
  ),
  (
    Jav,
    Long,
    [11133081, 11084756, 10078744, 11434223, 9988138],
    "Aku ora seneng pèlem iki. ꦥꦚ꧀ꦗꦼꦤꦼꦁꦔꦤ꧀ꦏꦼꦢꦃꦏꦺꦤ꧀ꦢꦼꦭ꧀ꦔꦼꦱꦼꦱ꧀ꦫꦺꦴꦏꦺꦴꦏ꧀꧈ ꦝꦺꦮꦺꦏ꧀ꦏꦺꦏꦺꦠꦺꦴꦏ꧀ꦏꦤ꧀ꦤꦺꦭꦫ꧉ Manungsa iku ora bisa urip tanpa hawa. ꦏꦺꦴꦮꦺꦪꦲꦉꦥ꧀ꦩꦺꦭꦸꦱꦶꦱꦤ꧀ꦲꦺꦴꦫ?",
  ),
  (
    Jav,
    Long,
    [13678489, 10707418, 4476970, 12488265, 12559386, 13649936],
    "Sugeng warsa énggal, Tatoéba! Takona Mèri dhéwéké até lapa. Tom remen kaliyan puniki. Biyèn iki panggoné aman. Kowé dolan tènis karo sapa? Gajah iku kèwan sing pinter banget.",
  ),
  (
    Jav,
    Long,
    [8864926, 3978317, 3949926, 3949922],
    "Aku ora tau seneng lelungan numpak sepur. Dhèwèké isa basa Perancis, lan jebulé dhèwèké isa basa Inggris barang. Rasané kaya lagi mangan ès krim. Pak guru mbukak kerdusé banjur ngetokaké bal.",
  ),
  (
    Jav,
    Long,
    [8864899, 10721470, 11084744, 10976244, 13828547],
    "Sapa sing gelem manggon ing papan kaya ngéné? ꦏꦸꦭꦠꦸꦩ꧀ꦧꦱ꧀ꦥꦪꦸꦁꦥꦸꦤꦶꦏꦠꦶꦒꦁꦩꦶꦁꦒꦸꦏꦥꦼꦁꦏꦼꦂ꧉ Nang endi guntingku? Aku blas ora gelem mrono. Aku weruh yen mejane luwih stabil tinimbang kursine.",
  ),
  (
    Jav,
    Long,
    [9975480, 3978453, 12395461, 13668304, 12132451],
    "Jam pinten panjenengan tindak dhateng peken? Kowé sarujuk apa ora marang panemuné? Buku iku kabèh wis dakwaca. ꦠꦺꦴꦩ꧀ꦭꦭꦶꦢꦸꦫꦸꦁꦩꦏꦤꦶꦲꦱꦸꦤꦺꦩꦲꦸꦧꦼꦔꦶ꧉ Dhuwité kosingitaké nang endi?",
  ),
  (
    Jav,
    Long,
    [10798853, 10256301, 9993237, 8872622, 12099352, 12028906],
    "ꦏꦼꦠꦼꦥꦏ꧀ꦏꦤ꧀ꦠꦺꦴꦩ꧀ꦪꦱꦱꦼꦥꦸꦂꦏꦫꦺꦴꦲꦏꦸ꧉ Tom ora sayang karo aku. Biyèn aku bocahé isinan. Asu iki mangané kakèhan. ꦤꦁꦏꦺꦤꦺꦩꦺꦃꦲꦺꦴꦫꦠꦲꦸꦲꦸꦢꦤ꧀꧈ ꦤꦔꦶꦁꦲꦏꦸꦥꦲꦩ꧀ꦱꦶꦁꦢꦶꦲꦸꦕꦥ꧀ꦥꦏꦺ꧉",
  ),
  (
    Jav,
    Long,
    [10721479, 12559399, 9998307, 11084760, 10676767, 10857054],
    "Sapa sing bisa mbadhèk angkané, menang. Bapakku uga dhokter. Jakarta iku kutha prajané Indhonésia. ꦏꦺꦴꦮꦺꦏꦸꦢꦸꦩꦤ꧀ꦝꦼꦒ꧀ꦔꦸꦢꦸꦢ꧀꧈ ꦗꦩ꧀ꦥꦶꦫꦏꦺꦴꦮꦺꦏꦸꦢꦸꦢꦏ꧀ꦠꦔꦺꦤꦶ? ꦲꦮꦏ꧀ꦝꦺꦮꦺꦏꦼꦱꦱꦂꦤꦶꦁꦢꦭꦤ꧀ꦩꦿꦺꦤꦺ꧉",
  ),
]

