    Medium,
    [4070603],
    "नैइमेग़न नीदरलैंड में सबसे पुराना शहर है।",
  ),
  (
    Hin,
    Long,
    [482442, 3213687, 4064569, 11371228, 8687956, 10198505, 3792517],
    "मुझे विश्वास नहीं होता! मैंने दरवाज़े पर टिकट दिखाया। तुम वहाँ नहीं जाना चाहती। मैं तो बस बोल रहा हूं! टॉम किसके लिए रुका है? ओ जा भाई, अपना काम कर। कई किसान अपने खेत गवां बैठे।",
  ),
  (
    Hin,
    Long,
    [506525, 3620861, 3623203, 2069549, 12418402],
    "एक दिन के लिए इतना काफ़ी है। मुझे पुर्तुगाली, अंग्रेज़ी और रूसी आती हैं। कई हिंदू संस्कृत को देवताओं की भाषा समझते हैं। वे विपत्ती में जी रहे हैं। मैं अंग्रेज़ी बोल सकता हूँ।",
  ),
  (
    Hin,
    Long,
    [2056648, 3620690, 505416, 486298, 10049632],
    "मैं आपकी करुणा के लिए अत्यंत आभारी हूँ. वह एक मशहूर व्यापारी है। भीड़ में एक औरत ने मेरी जेब काट ली। न उसको फ़्रानसीसी बोलनी आती है न मुझे। अल्जेरिया केवल तेल पर निर्भर है।",
  ),
  (
    Hin,
    Long,
    [3789110, 3617479, 482462, 881959, 487486],
    "मैं युरोप में रहती हूँ। जो हमारा है वह हमारा है। उसने हमारे लिए बहुत ही शानदार भोजन तैयार किया। हमारे लिये तो अच्छी शाम थी. ईमानदारी सर्वोत्तम नीति है।",
  ),
  (
    Hin,
    Long,
    [9415129, 516644, 2075234, 3667873, 488685, 514104],
    "टॉम एक बहुत चतुर लड़का है। मैं अपनी नई गाड़ी से बहुत खुश हूँ। आपको कल जवाब मिल जाएगा। अंदर मत आओ! मैं नंगा हूँ। यह लिफ़्ट छटी मंज़िल तक ही जाती है। उसके नसीब में उससे फिरसे मिलना नहीं लिखा हुआ था।",
  ),
  (
    Hin,
    Long,
    [3497876, 2072104, 516702, 3625219, 450390],
    "मेरे पिता चीन जा रहे हैं। मैं लगभग हर रोज़ खत लिखता हूं। उसने उसे अकेले न जाने की चेतावनी दी। नृत्य हर एक संस्कृति का एक सुंदर भाग होता है। मैं दोपहर बारह बजे खाना खाता हूँ।",
  ),
  (
    Hin,
    Long,
    [475964, 3670861, 1658895, 3620552],
    "उसे बहुत अकेलापन महसूस हुआ। वे टॉम को पीटने लगे। मेनेजर बाहर निकल चुके थे, इसलिए मैंने उनके सेक्रेटरी के हाथों संदेस थमा दिया. अगर तुम ने मेरी अंग्रेज़ी सीखने में मदद की तो में तुम्हारी जापानी सीखने में मदद करूँगी।",
  ),
  (
    Hin,
    Long,
    [9839014, 482420, 561260, 2077990, 498554],
    "उन्होंने कहा कि वह बहुत थकान महसूस कर रहे थे। उस बड़े डब्बे को कोई भी नहीं हिला सकता। हम सब एक-साथ खड़े हो गए। यह खाना कुछ ज़्यादा ही नमकीन है। उन दिनों में सफ़र करना बहुत मुश्किल हुआ करता था।",
  ),
  (
    Hin,
    Long,
    [10646991, 13689222, 3645579, 12405872, 3617162],
    "उन्होंने रास्ते और पुल बनाए थे। मैं इसलाम की पढ़ाई करता हूँ। गे विवाह यहाँ वैध है। मैं आपको लज्जित नहीं, सुसज्जित कर रहा हूँ। मुझे टॉम को बताने दीजिए।",
  ),
  (
    Hin,
    Long,
    [2070162, 444378, 4023484, 3617346, 2072534, 10270835],
    "टॉम मेरे दादा लगते हैं। कनाडा जापान से बड़ा है। ज़रूर कोई विषाणु होगा. हमें टॉम के मदद की ज़रूरत है। टॉम ने तीस डौलर्स में स्वेटर खरीदा। आपका पैकेज आने पर सूचित कर दिया जाएगा।",
  ),
  (
    Hin,
    Long,
    [8686268, 12410729, 3639005, 13687918, 459427],
    "सुनना नहीं है तो कान बंद करो। रोमनों की जीत के साथ लड़ाई समाप्त हुई। आप बिलकुल भी डरे हुए नहीं लगते हो। मुझे घर जा कर कपड़े बदलने हैं। मुझे उसकी झलक दिखाई दी।",
  ),
  (
    Hin,
    Long,
    [491821, 2654377, 13988938, 3216311],
    "इन सवालों का जवाब देना आसान है। उनके खर्च घटाने के प्रयास ज़्यादा सफल नहीं हुए। तुम्हारे कम्प्यूटर का पासवर्ड क्या है? ऐसे नेता मुझे गुस्सा दिलाते हैं।",
  ),
  (
    Hin,
    Long,
    [3670889, 506530, 2034874, 505430, 3842137],
    "मैं अपने बच्चों को टीवी नहीं देखने देता। मैं ग़रीब हूँ, पर मेरे भाई बहुत अमीर हैं। उसमें कोई शक नहीं है। उसने प्रतियोगिता फिरसे जीत ली। ओसाका जापान का दूसरा सबसे बड़ा शहर है।",
  ),
  (
    Hin,
    Long,
    [483875, 4051797, 588580, 13688802, 482439],
    "हवा में एक अफ़वाह है कि उस कारोबार का दिवालिया होने वाला है। हमें एक दूसरा मौका दिया गया है। केट अभी तक आई नहीं है? टॉम को एक क़लम मिल गई। मैंने इस साल गर्मी की छुट्टियों में बहुत तैरा।",
  ),
  (
    Hin,
    Long,
    [10047989, 4023506, 13688062, 590014, 450359],
    "सामी का लैला पर बलात्कार करने का इरादा था। बस टॉम की बात सुनिए। उनका दफ़्तर कहाँ है? उस कवि ने बहुत सारी कविताएं लिखीं थीं। डॉक्टर ने उसे सिगरेट न पीने की सलह दी।",
  ),
  (
    Hin,
    Long,
    [4083663, 3623161, 10047505, 3789121, 3792549, 6471002],
    "उनकी मुझ पर नज़र है। मुझे कैनेडियन होने पर गर्व है। पिछले साल मैंने एक नयी गाड़ी ख़रीदी। नेटफ़्लिक्स अब युरोप में उपलब्ध है। यह झंडा कभी देखा है? वैसे करने की कोशिश कीजिये।",
  ),
  (
    Hin,
    Long,
    [2655623, 455242, 459418, 4065139, 10046119],
    "एक क्रियान्वित विचार तीन अधूरे विचारों से कहीं बेहतर है। उसने टूटे हुए टुकड़ों को वापस जोड़ा। वह नतीजे के लिए बेचैन है। आपने हमें जाने क्यों दिया? वे हमें काग़ज़ बेचते हैं।",
  ),
  (
    Hin,
    Long,
    [10055938, 482422, 13294790, 509335, 516801, 10965657],
    "हम अभी खाना नहीं चाहते। मुझे उसकी लिखी हुई एक चिट्ठी मिली। तुझे स्कूल में रहना चाहिए था। उसकी मेरी बहन के साथ सगाई हो चुकी है। उसने कहा कि वह खुश थी। सामी को जेल से भागे हुए दो महीने हो गए है।",
  ),
  (
    Hin,
    Long,
    [3617383, 8689670, 487412, 486384, 510247],
    "क्या मैं टॉम से बात कर सकती हूँ? मैं सामी को फ़ोन लगा रही हूँ। मोटी मुर्गियाँ कम अंडे देतीं हैं। जॉन न्यूयॉर्क में रहता है। मैं जल्दी उठा था, क्योंकि मुझे पहली ट्रेन पकड़नी थी।",
  ),
  (
    Hin,
    Long,
    [13419112, 3623992, 8864221, 4083690, 13874292, 6544277],
    "मैं सेब छील रही हूँ। मैं यह किताब मेरे साथ ले जा रहा हूँ। मुझे पता है कि अगला सवाल क्या होगा। आप चाहें तो मैं आ सकती हूँ। मुझे पता ही था कि आप आएँगे। मैं तुझे बुला रही हूँ।",
  ),
  (
    Hin,
    Long,
    [510254, 3707668, 3650054, 10054888],
    "मुझे चिंता की वजह से कल रात नींद नहीं आई। मैं तो वह भी नहीं कर सकती। हमारी वेबसाइट शेड्यूल किये गये रखरखाव के लिये ऑफलाइन है। मैं उन्हें एक संदेश भेजूंगी।",
  ),
  (
    Hin,
    Long,
    [4088282, 518705, 611431, 2078171],
    "लगभग चार हज़ार सैनिक मारे गये। धूम्रपान आपको हानि पहुँचाएगा। मेरा बेटा घड़ी देखकर समय बता सकता है। मुझे लगता है के शिन्तारो अंग्रेज़ी अच्छी तरह बोल लेता है।",
  ),
  (
    Hin,
    Long,
    [13688159, 2038879, 2073210, 480198, 516815],
    "हम उसे ढूँढ निकालेंगे। मैंने तुम्हें देखा नहीं। हेलेन के शब्दों से मुझमें अचानक नई जान आ गई। यह वाईन चखकर देखो तुम्हें अच्छी लगती है कि नहीं। मुझे गिलास खाली मिला।",
  ),
  (
    Hin,
    Long,
    [455311, 9433229, 10047857, 3623184],
    "तुम चलने के लिए तैयार कब होगे? नब्बे होने के बावजूद टॉम के नानाजी एक सक्रिय जीवन बिताते हैं। सामी लैला के कुत्ते को जानता था। सिख साम्राज्य १७९९ में रणजीत सिंह ने स्थापित किया था।",
  ),
  (
    Hin,
    Long,
    [10966543, 4067358, 8686207, 12418446, 3617862],
    "टॉम मैरी के साथ कभी नहीं बैठता। टॉम के वाक्य बहुत लंबे होते हैं। उसे एक खूबसूरत राजकुमारी से प्यार हो गया। कोला की तीन बोतलें खरीद लाओ। मुझे बताइए यह किसने किया।",
  ),
  (
    Hin,
    Long,
    [2079453, 6829731, 3842846, 3620640],
    "इस क्लब में पचास सदस्य हैं। आप हमेशा ज़्यादा सवाल पूछते हैं। बहुत ज़्यादा खा लिया तो मोटे हो जाओगे। विकासशील देशों में जनसंख्या वृद्धी बहुत तीव्र होती है।",
  ),
  (
    Hin,
    Long,
    [4121273, 10051980, 515442, 3623957, 12405897],
    "बाकी की कहानी तो तुम जानते ही हो। वह तस्वीर मुझे दिखाओ। मेरे लिए तैरना आसान है। \"ये किसकी दवाइयां हैं?\" \"फ़ाहिमा की हैं।\" केवल जीतना ही महत्त्वपूर्ण नहीं है।",
  ),
  (
    Hin,
    Long,
    [12403739, 3620610, 4112607, 10978471, 3702151],
    "मुझे पता था कि तुम समझोगे। संयुक्त राज्य की राजधानी लंदन है। अंग्रेज़ी में जवाब दीजिए। मैरी ने कहा कि उसने यह किताब तीन बार पढ़ी है। कोई आपको देख रहा है।",
  ),
  (
    Hin,
    Long,
    [8687386, 4101329, 459441, 465637, 13688189, 12405964],
    "सामी हर रोज़ प्रार्थना करता है। आप कल रात ९ बजे क्या कर रहें थे? वह गाना गाते हुए आया। वह खुशी से उछल पड़ी। कोई तो झूठ बोल रहा है। कार्यभार और वेतन आनुपातिक नहीं हैं।",
  ),
  (
    Hin,
    Long,
    [2072095, 3638779, 4745465, 6829726, 2039281],
    "शांत रहें और आराम करें। टॉम बहुत कलात्मक है। फ़्रान्स को फ़्रांसीसी में \"फ़्रांस\" कहते हैं। तूने मुशकिल हिस्सा तो कर लिया है। अपना कमरा हर रोज़ साफ़ करना चाहिये।",
  ),
]

