  (Hrv, Short, [670219], "Možeš li mi dodati sol?"),
  (Hrv, Short, [12232026], "Budite svoji!"),
  (Hrv, Short, [955791], "Kako nepristojno od tebe!"),
  (Hrv, Short, [13824349], "Nisam platio."),
  (Hrv, Short, [2281650], "Zar nisi gladan?"),
  (Hrv, Short, [1128248], "Došao sam ovdje da studiram."),
  (Hrv, Short, [13822478], "Zna li netko kako je Tom ušao?"),
  (Hrv, Short, [13781769], "Što jedeš?"),
  (Hrv, Short, [11172772], "Jučer je govorio o tebi."),
  (Hrv, Short, [5733502], "To miriše ukusno."),
  (Hrv, Short, [3458086], "Što si radio tamo?"),
  (Hrv, Short, [4543243], "Uhvati ga."),
