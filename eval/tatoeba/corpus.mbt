let rows_por : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Por, Short, [12822936], "Você me deixa muito feliz."),
  (Por, Short, [1361923], "De onde vocês se conhecem?"),
  (Por, Short, [7882950], "Eles moram perto do dique."),
  (Por, Short, [1179345], "Diga-me o que queres."),
  (Por, Short, [4388413], "Nós teremos uma festa."),
  (Por, Short, [5189862], "Tom é o único filho da Mary."),
  (Por, Short, [8170491], "Não existe vida sem morte."),
  (Por, Short, [6068596], "Eu ri de Tom."),
  (Por, Short, [5199187], "Está esfriando mais uma vez."),
  (Por, Short, [1199945], "Eu tentarei."),
  (Por, Short, [1376974], "Ele já nada é para nós."),
  (Por, Short, [2747330], "Minha vida acabou-se!"),
  (Por, Short, [8618517], "Devo me mudar no mês que vem."),
