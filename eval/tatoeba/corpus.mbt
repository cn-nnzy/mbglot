  ),
  (
    Urd,
    Long,
    [5690297, 12486724, 12032718, 12902386, 1432855],
    "اس حالت کے بارے میں آپ کا کیا خیال ہے؟ میں تھی جس نے شیشہ توڑا۔ اس ملک نے امریکا سے سفارتی تعلقات منقطع کی ہیں۔ تمہاری کونسی گاڑی ہے؟ اجلاس پچھلے ہفتے منعقد ہوا تھا۔",
  ),
  (
    Urd,
    Long,
    [9697711, 1450598, 1450827, 1497748],
    "سمی دالان میں لیلا سے ملا ایک بار تم نے کوئی گندی عادت اپنالی، پھر اس سے آرام سے جان نہیں چھٹے گی۔ تم ہمیشہ دیر سے کیوں آتے ہو؟ میرے نانا اور نانی دونوں فوت ہو چکے ہیں۔",
  ),
  (
    Urd,
    Long,
    [1448482, 1733367, 1917683, 12902360],
    "اس نے مجھے اپنی زندگی کی کہانی سنائی۔ غربت نے اسے چوری کرنے پر مجبور کیا۔ آسمان میں ایک بھی بادل نہیں تھا۔ ان لوگوں کا لحاظ کرو، جن کے ساتھ کام کرتے ہو!",
  ),
  (
    Urd,
    Long,
    [2493078, 13551733, 1465700, 10823882, 1452257],
    "وہ کبھی کبھار امید کھو دیتا ہے۔ کیا آپ چائے چاہتے ہیں؟ وہ ملنسار فطرت کا مالک ہے۔ ساتھ ساتھ مشق کرتے ہیں۔ وہ جتنا مرضی کھا لے، اس کا وزن بڑھتا ہی نہیں ہے۔",
