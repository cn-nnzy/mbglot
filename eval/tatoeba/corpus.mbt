  (Som, Medium, [9811214], "Tom raaligelin ayuu ka bixiyay arrintaas."),
  (Som, Medium, [9811150], "Way ka caqli badan tahay sida ay u egtahay."),
  (Som, Medium, [9811112], "Mennad ayaa caawiyay hooyadiis."),
  (
    Som,
    Medium,
    [9811263],
    "Waxaan halkaan joogi doonaa dhowr saacadood oo dheeri ah.",
  ),
  (Som, Medium, [8268129], "Gacani keligeed ma sacaabayn karayso."),
  (Som, Medium, [9811153], "Weligeen sidaas kumaanaan samayn."),
  (
    Som,
    Medium,
    [9811024],
    "Waxaan sameynayay waxyaabo sharciga ka hor imanaya.",
