    Skr,
    Medium,
    [11244632],
    "اوں آپݨے ماء پیؤ کوں خوش کر ݙتا۔",
  ),
  (
    Skr,
    Long,
    [11116571, 11114208, 11374756, 11116562, 11244638, 11115697],
    "میں ٹوم ہاں۔ تہاݙا کیا ناں ہے؟ ایں کیتے کوئی ثبوت ہے؟ اوں میݙے مُن٘ہ تے ہی کُوڑ مارے میں ٹوم ہاں۔ تیݙا کیا ناں ہے؟ ہݨ دھُپ نلکی ہوئی ہے۔ ٹوم کوں آپݨے اوزار بھاندن۔",
  ),
  (
    Skr,
    Long,
    [11244620, 11114017, 11115716, 11244591, 11244640, 11127611, 11116587],
    "روسی سوکھی زبان کائنی۔ ہر کوئی خوش کائناں ہائی۔ تساں کتھاں راہندے ہیوے؟ زناور ساݙے سنگتی ہن۔ ہُݨ تکھی ہوا گھُلدی پئی ہے۔ تو آپݨے نال کیا کریسیں؟ میکوں مٹر چنگے لڳدے ہن۔",
  ),
  (
    Skr,
    Long,
    [10912787, 11489861, 11115702, 11489858, 11116581, 11115713, 11113897],
    "آئی اُٻاسی، نندر دی ماسی ثابت تھیا جو میݙا ہک بھرا ہے۔ تساں کتھاں راہندے ہو؟ این٘دے کیتے کوئی ثبوت ہے؟ پھُلاں کوں پاݨی ݙیوو۔ تساں کتھاں پڑھدے ہو؟ او اصل وچ مذاق ہائی۔",
  ),
  (
    Skr,
    Long,
    [11115694, 11115704, 11374762, 11244644, 11114206, 11127605],
    "ٹوم کانفرنس وچ حاضر ہائی۔ تریمتاں دا عالمی ݙین٘ہ مبارک! میݙا خیال ہے ایہ ممکن ہے۔ اساں اُوندے مخالف کائنی۔ میکوں کھنڈ بھاندی ہے۔ اے ٹی ایم کائنی چلدی پئی۔",
  ),
  (
    Skr,
    Long,
    [11111389, 11374748, 11116589, 11111415, 11244627, 11113913],
    "ہک ٻال گُم تھی ڳیا ہے۔ میکوں ایہ یاد کائنی۔ تساں جواب کیوں کائنی ݙتا؟ ساکوں مدد دی لوڑ ہائی۔ ٹام پچھاوڑے کھیݙا پیا ہائی۔ ٹوم بیمار تھیوݨ دا بہانہ کیتا۔",
  ),
  (
    Skr,
    Long,
    [11111352, 11114014, 11244584, 11114022, 11162651, 11162652],
    "میں آپݨے پیؤ نال راہندا ہاں۔ میں ایندا عادی کائنی۔ تیݙے سِر وچ اڄݨ وی پیڑ ہے؟ میں جھٻدے واپس آساں۔ یونانی ہک سوکھی زبان کائنی۔ دنیا وچ کتی آزاد ملک ہن؟",
  ),
  (
    Skr,
    Long,
    [11113867, 11374746, 11244630, 11244600, 11274457, 11244641],
    "چھوہریاں وچ ٹوم مقبول ہے۔ میݙی سائکل کوں مرمت دی لوڑ ہے۔ ہک سیکنڈ، گولی نہ مار! تو جواب کیوں کائنی ݙتا؟ میکوں کھنڈ بھان٘دی ہے۔ ٹام کجھ آکھݨ ہی آلا ہائی۔",
  ),
  (
    Skr,
    Long,
    [11244621, 11111414, 11127608, 11244625, 11111491],
    "آنا ٻارھاں سال دی ہے۔ میݙا ٹٻر شَہر وچ وسدا ہے۔ ایندا ادھا حصہ تیݙا ہے۔ بھلا ایہ مچھی ہݨ وی زندہ ہے؟ آپ ڳئی تے آپے آئی قدر ونڄایُس رناں دا، ݙاڑھی پٹیُس بابے دی تے چونڈا مُنیس اماں دا",
  ),
]

