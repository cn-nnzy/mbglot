let rows_ita : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Ita, Short, [1520601], "A me fa proprio schifo."),
  (Ita, Short, [13482329], "Lei sa se Tom e Mary lavorano?"),
  (Ita, Short, [5439160], "Io ero cattivo."),
  (Ita, Short, [7867154], "Non ero preparato per questo."),
  (Ita, Short, [6613146], "Il mio amico non era macedone?"),
  (Ita, Short, [2743094], "Temo che non puoi."),
  (Ita, Short, [14003253], "Oggi c'è tanto da fare?"),
  (Ita, Short, [13346579], "Mi hai mai vista sul palco?"),
  (Ita, Short, [7527245], "Ammise che era sovrappeso."),
  (Ita, Short, [8858850], "Non poteva salvarla."),
  (Ita, Short, [1728982], "Io sono qui da due ore."),
  (Ita, Short, [6013775], "È la sola spiegazione logica."),
  (Ita, Short, [3605171], "Ora sto aspettando mio padre."),
  (Ita, Short, [7035035], "Philip è più gentile di voi."),
  (Ita, Short, [3240972], "E cosa c'entra con la notizia?"),
  (Ita, Short, [13956605], "Adesso capisco la tua rabbia."),
  (Ita, Short, [8485320], "È sempre d'accordo."),
  (Ita, Short, [13665097], "Vorresti un regalo?"),
  (Ita, Short, [13322517], "Avete un virus."),
  (Ita, Short, [4236646], "Tom faceva il pisolino."),
  (Ita, Short, [1850442], "Lei non era una gran pianista."),
  (Ita, Short, [8553239], "Hai una camera doppia?"),
  (Ita, Short, [6203866], "Sta piovendo pesantemente."),
  (Ita, Short, [3846330], "È sempre pieno di schifezze."),
  (Ita, Short, [11795910], "È scritta in esperanto."),
  (Ita, Short, [5330651], "Tom andò a fare trekking."),
  (Ita, Short, [13967110], "Lo prendo qui vicino."),
  (Ita, Short, [6700437], "È di seta."),
  (Ita, Short, [3652631], "So che mi stai odiando."),
  (Ita, Short, [2815994], "Mettete via i vostri vestiti."),
  (Ita, Medium, [11544522], "Tom non è un programmatore di computer?"),
  (
    Ita,
    Medium,
    [3282394],
    "Io vidi qualcosa di molto brillante volare nel cielo notturno.",
  ),
  (Ita, Medium, [6458978], "Non ho mai detto che sarebbe facile."),
  (
    Ita,
    Medium,
    [5505815],
    "Tom ha detto che vorrebbe tanto venire con noi a Boston in ottobre.",
  ),
  (Ita, Medium, [7623897], "Andiamo a costruire grattacieli in Libano."),
  (
    Ita,
    Medium,
    [3298377],
    "Se oggi fosse stata domenica, saremmo andati a pesca.",
  ),
  (Ita, Medium, [12517863], "Mary sta tornando al suo albergo."),
  (Ita, Medium, [968027], "La polizia non ha trovato indizi."),
  (Ita, Medium, [13305387], "I consigli degli altri mi confondono di più."),
  (Ita, Medium, [8576416], "Avete mai baciato un uomo più giovane?"),
  (Ita, Medium, [2769544], "Ho perso il conto delle resurrezioni."),
  (Ita, Medium, [5004431], "Voi avete un problema con loro?"),
  (Ita, Medium, [13997244], "Non smetterò mai di ripetertelo."),
  (Ita, Medium, [6867342], "Io vengo ancora pagata, giusto?"),
  (Ita, Medium, [4090692], "Gli feci molte domande sull'ecologia."),
  (Ita, Medium, [1237830], "Tom venne qua un'ora prima di Mary."),
  (Ita, Medium, [14008480], "I tuoi occhiali ti aiutano a vedere meglio ?"),
  (Ita, Medium, [8673220], "È impegnato con i suoi compiti."),
  (Ita, Medium, [13712991], "Finire è facile. Iniziare è difficile."),
  (
    Ita,
    Medium,
    [1890599],
    "I popoli del passato non coincidono con i popoli attuali.",
  ),
  (Ita, Medium, [7638751], "Va a costruire autostrade in Olanda?"),
  (Ita, Medium, [3797369], "Non riesco a togliergli gli occhi di dosso."),
  (Ita, Medium, [4415883], "Tu sei molto più bella di tua sorella."),
  (Ita, Medium, [2960682], "Tom doveva essere qui trenta minuti fa."),
  (
    Ita,
    Medium,
    [6906514],
    "Tom vuole trascorrere più tempo con la sua famiglia.",
  ),
  (Ita, Medium, [7606908], "Non va a fare amicizie in Nuova Zelanda."),
  (Ita, Medium, [2478991], "Lui non è che un uomo d'affari."),
  (Ita, Medium, [4420164], "È destinata a superare l'esame."),
  (
    Ita,
    Medium,
    [12031187],
    "L'antico anfiteatro è stato restaurato e ora è aperto al pubblico.",
  ),
  (Ita, Medium, [7496005], "Mia mamma mi ha insegnato a farla."),
  (
    Ita,
    Long,
    [7527651, 3606210, 5980446, 5672392],
    "Dove ha parcheggiato la sua automobile? Gli autobus effettuano delle corse ogni dieci minuti. Non ci sono compromessi con i razzisti. Come vincere la malinconia autunnale?",
  ),
  (
    Ita,
    Long,
    [6928511, 3927996, 2090722, 7566212],
    "Dove possiamo comprare delle infradito? Bill è venuto a trovarmi lo scorso autunno. Non preoccuparti. Non le farò del male. Mercoledì non facciamo religione?",
  ),
  (
    Ita,
    Long,
    [3879072, 8224534, 6758552, 2504550],
    "È vero che ha morso sua sorella? Non ha imparato la sua lezione. \"Di che nazionalità sono le tue cugine?\" \"Ceca.\" Dovete fare spazio per il televisore.",
  ),
  (
    Ita,
    Long,
    [2998363, 4565723, 7129365, 13328032, 3601750],
    "Penso sarebbero perfetti per voi! Guarda che me la lego al dito! Questa lettera non è indirizzata a voi. Ho famiglia in Australia. Lei mi ha scritto una lettera d'amore in esperanto.",
  ),
  (
    Ita,
    Long,
    [3414517, 4532232, 1131687, 7531550, 4725282],
    "Il signor Juan è morto di tubercolosi. Gli errori capitano davvero. Tom deve aver visto Mary quando è stato a Boston. Dove ha trovato le mie chiavi? Uno dei miei amici sta studiando all'estero.",
  ),
  (
    Ita,
    Long,
    [7216604, 6613183, 3566111, 6618078, 6753192],
    "Noi siamo una grande famiglia felice. Il mio amico non era belga? Lei ha mai parlato con Tom? Vogliono offrirci un caffè. \"Di che nazionalità erano le nostre amiche?\" \"Lettone.\"",
  ),
  (
    Ita,
    Long,
    [8014695, 4394427, 7600390, 4781648, 4179343],
    "Perché non me l'avete mostrata? Lei ha abusato della mia fiducia. Vai a cercare qualcosa in Lettonia. Lei è oberato di lavoro. Io lavoro venerdì e sabato.",
  ),
  (
    Ita,
    Long,
    [12846783, 11749524, 13339288, 12014859, 1871469, 13965471],
    "Mary ha detto di avere sete. \"Yanni è qua.\" \"Dove?\" Questo dispositivo è molto leggero. John ha due anni in più di me. Purtroppo non ci posso essere! La neve si sta già sciogliendo?",
  ),
  (
    Ita,
    Long,
    [997291, 6762619, 3111560],
    "Mi è partita una caccola dal naso. \"Dove andremo per lavoro?\" \"In Grecia.\" Si dovrebbe essere più attenti rispetto a come si parla con quelle persone.",
  ),
  (
    Ita,
    Long,
    [7641886, 2157599, 481848, 7693616, 2166422],
    "Non vado a costruire mattatoi in Olanda? Dovresti farlo al più presto. La tua lettera mi ha resa felice. Io penso che mia mamma lo sappia. Perché non si sono fatte vedere?",
  ),
  (
    Ita,
    Long,
    [10249819, 1645757],
    "Sono abbastanza soddisfatto di come stanno le cose. Quel tessuto rosso è un \"fukusa\"; è uno strumento fondamentale per pulire l'apparecchiatura da tè.",
  ),
  (
    Ita,
    Long,
    [7619971, 13019484, 4464506, 538981],
    "Non vado a costruire biblioteche in Cina? Tom ha ascoltato con pazienza fino alla fine. È un posto molto tranquillo? Gli ho promesso di tradurre tutta l'interfaccia.",
  ),
  (
    Ita,
    Long,
    [5346577, 13995520, 7642952, 11941628],
    "A me piace insegnare ai bambini piccoli. Scommetto che ti hanno detto qualcosa stamattina. Vado a costruire allevamenti in Marocco? La guerra ha devastato la città, lasciandola bruciare a ferro e fuoco.",
  ),
  (
    Ita,
    Long,
    [5643657, 3901567, 2942010, 5718367, 13471053],
    "Tom non voleva che Mary soffrisse. I fiori del vaso sono gialli. Non credo a una tale storia. Per favore, dillo a lei. Non c'è bisogno di chiedere. Tutto ciò che è nel frigorifero è a tua disposizione.",
  ),
  (
    Ita,
    Long,
    [3881193, 2429197, 12041919],
    "Il progresso della civiltà è molto rapido. Ho aspettato un'ora la mia amica. La nostra politica aziendale prevede una maggiorazione dei premi per i dipendenti più meritevoli.",
  ),
  (
    Ita,
    Long,
    [2814781, 6755308, 13579120, 1860911],
    "Quando finirai questa traduzione? \"Di che nazionalità erano i suoi pazienti?\" \"Polacca.\" Mary ha detto che ti amava? Hiromi va a scuola cinque giorni alla settimana.",
  ),
  (
    Ita,
    Long,
    [3115177, 7631173, 1151626, 1701543, 3014758],
    "Mi serviva solo questo. Non vado a costruire università in India. Quanto sopporteremo ancora? Questo computer portatile è leggero. Non voglio il vostro aiuto.",
  ),
  (
    Ita,
    Long,
    [12542195, 4501269, 2736277, 1858033, 2429069],
    "Dove posso embucare queste lettere? Tom è estremamente competitivo. Io sto solamente essendo educato. Che ci si può aspettare di più? Ti presterà il suo libro.",
  ),
  (
    Ita,
    Long,
    [9939952, 2196456, 3503473],
    "Dei limoni e dei pompelmi rosa erano accanto al barattolo arancione. Un consiglio di mamma avrebbe più peso di quello di un amico. Cosa salterà fuori di qui?",
  ),
  (
    Ita,
    Long,
    [6951768, 13483499, 3833150, 14025118],
    "Mi sono innamorato di una ragazza che ho incontrato a Boston lo scorso anno. Io amo veramente i libri francesi. Lei non aveva sonno. Sì, io sono una volpe.",
  ),
  (
    Ita,
    Long,
    [3430177, 11031706, 9039902],
    "Ha letto \"Struttura e potere - Oltre la semiotica\" di Akira Asada? Utilizzi quegli strumenti. Tom chiese a Mary se per caso fosse felice della sua nuova occupazione.",
  ),
  (
    Ita,
    Long,
    [6894037, 3437118, 2032121, 8356607, 3758852],
    "Tu devi leggere tutto. Hanno discusso il piano per ore. Io non me lo merito. Hanno ammesso che non erano perfetti. Certe volte si accaniscono senza motivo!",
  ),
  (
    Ita,
    Long,
    [6607654, 13014082, 5169640, 3542760],
    "Non si esclude il capitalismo? Mary chiese a Tom di prestarle trecento dollari. Io non ho mai avuto l'occasione di incontrarla. Qualcuno mi rapisca e mi porti al mare!",
  ),
  (
    Ita,
    Long,
    [13644272, 4617275, 2486243, 9888842],
    "La mangusta ha catturato un serpente. Sembra che lei non la voglia fare. Io non voglio quel genere di vita per i nostri figli. Ha detto che non era scoraggiato.",
  ),
  (
    Ita,
    Long,
    [4312796, 10584321, 7593556, 11715280, 3772525],
    "Tom era scosso dall'esperienza. Mi sono seduto accanto all'autista. Non vado a studiare in Brasile. Mi trovo a migliaia di chilometri da casa. La reazione immediata è questa.",
  ),
  (
    Ita,
    Long,
    [3780103, 11735847, 1603646, 9815474, 13799792, 3266025],
    "Anche lei ha un segreto da rivelare. Layla ha lasciato le superiori. Lo hai visto ultimamente? Sembrano essere preparati. Ma questo era un pazzo! Quando ce ne andiamo?",
  ),
  (
    Ita,
    Long,
    [6734572, 3930529, 2603432, 5581865, 4538662],
    "Ci siamo incontrati l'anno scorso. Io ho bisogno di vernice. Tom e Mary non vogliono quello. Tom ha portato un rinfresco. Stavo risparmiando per comprare una nuova bici.",
  ),
  (
    Ita,
    Long,
    [8731683, 6210578, 12761929, 11956179],
    "Me ne preoccupo davvero. Sto venendo per loro. Sono andato a vedere come procedevano i lavori e ho trovato i muratori che se ne stavano là a oziare. Ogni regione ha la sua variante di hamburger, rendendolo un piatto universale con un tocco locale.",
  ),
  (
    Ita,
    Long,
    [6762638, 13653619, 9649620],
    "\"Dove vanno per lavoro?\" \"In Irlanda.\" Molte culture credono che la reincarnazione sia un concetto reale e significativo. Ha fatto i suoi compiti da solo.",
  ),
  (
    Ita,
    Long,
    [13956076, 3358705, 602337, 14025241],
    "Dentro c'era l'aria condizionata troppo alta? È sicuro di volerlo fare? È assurdo provare a persuaderlo. María si è macchiata la maglietta mentre cucinava.",
  ),
]

///|
let rows_tur : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Tur, Short, [1486515], "O, kapıya doğru koştu."),
  (Tur, Short, [2596087], "Tom dinlemedi."),
  (Tur, Short, [4126321], "Bu biraz tuzlu."),
  (Tur, Short, [522665], "Eczane, Fresno Sokağı'nda."),
  (Tur, Short, [6792771], "Sami bir avukat talep etti."),
  (Tur, Short, [3552325], "Ne arzu edersiniz?"),
  (Tur, Short, [5583836], "Buraya imzanı atar mısın?"),
  (Tur, Short, [10646238], "Tom kabız olmuş."),
  (Tur, Short, [2470469], "Hiç kimse bir hiç değildir."),
  (Tur, Short, [7670572], "Belçika uyruklu değiller mi?"),
  (Tur, Short, [3267574], "Tom sorunu kolayca çözdü."),
  (Tur, Short, [2443603], "Onu hatırlamalıyım."),
  (Tur, Short, [3268946], "Bazı delegeler katılmadı."),
  (Tur, Short, [3933376], "Her gün bunu düşünüyorum."),
  (Tur, Short, [7084083], "Sınalgıya bakıyorum."),
  (Tur, Short, [8595658], "Ataput ipi tut."),
  (Tur, Short, [4041890], "Seninle orada tanışacağım."),
  (Tur, Short, [10474539], "Bu civarda eczane var mı?"),
  (Tur, Short, [6365385], "Hâlâ yiyor musun?"),
  (Tur, Short, [4996418], "Biz dalıyorduk."),
  (Tur, Short, [1505935], "Biz uzun süredir arkadaşız."),
  (Tur, Short, [3732110], "Size iyi eğlenceler."),
  (Tur, Short, [4364565], "Ben oldukça iyiydim, değil mi?"),
  (Tur, Short, [3037923], "Birisi burada ya da buradaydı."),
  (Tur, Short, [4609860], "Bir iş ortağım var."),
  (Tur, Short, [5303223], "Hiç fazla boş koltuk yoktu."),
  (Tur, Short, [4910917], "Üç biletim var."),
  (Tur, Short, [11628973], "Bütün panjurlar kapalıydı."),
  (Tur, Short, [2505236], "Kimseyi görmüyorum."),
  (Tur, Short, [6537701], "Tom bunu görmek istedi."),
  (Tur, Medium, [6984032], "Tom sık sık işle ilgili uzaktadır."),
  (Tur, Medium, [9984963], "O hiç benim erkek arkadaşım olmadı."),
  (Tur, Medium, [5259133], "Deniz yakını her zaman rüzgarlıdır."),
  (Tur, Medium, [1235803], "Jane erkek kardeşimle tenis oynuyor olabilir."),
  (Tur, Medium, [7690700], "\"Onun kız kardeşleri nereli?\" \"Avusturya.\""),
  (Tur, Medium, [4859848], "Sınava girmeden o okula alındı."),
  (
    Tur,
    Medium,
    [10291503],
    "Şifreyi üç kez üst üste hatalı girince kart bloke oldu.",
  ),
  (
    Tur,
    Medium,
    [6093859],
    "Tipik bir baykuş ve kukumav arasındaki fark nedir?",
  ),
  (
    Tur,
    Medium,
    [5681568],
    "Daha önce hiç kimse sadakatimi sorgulamamıştı.",
  ),
  (Tur, Medium, [5034845], "Kimse benim etrafımda olmak istemiyor."),
  (
    Tur,
    Medium,
    [9955863],
    "Öğretmen okuduğumuz bir kitabın özetini çıkarma ödevi verdi.",
  ),
  (Tur, Medium, [1015219], "Şair çalışmasında intihar etti."),
  (Tur, Medium, [4216692], "İçeride başka bir yol bulmalıyız."),
  (
    Tur,
    Medium,
    [499313],
    "İstasyondan eve yürüyerek gitmek sadece beş dakika alır.",
  ),
  (
    Tur,
    Medium,
    [5426071],
    "Ben sipariş ettiğim paketi almak için buradayım.",
  ),
  (Tur, Medium, [3449652], "Eşi bile onun neden öldüğünü bilmiyor."),
  (
    Tur,
    Medium,
    [4891107],
    "Bunu değiştirmek için herhangi birinin yapabileceği bir şey yok.",
  ),
  (Tur, Medium, [6975675], "Tom'un sana verdiği gömlek uydu mu?"),
  (Tur, Medium, [1759903], "Duşlu tek kişilik bir oda istiyorum, lütfen."),
  (Tur, Medium, [3019158], "Ne yazık ki, bunu partinize yapamayacağım."),
  (Tur, Medium, [3944354], "Ne zamana kadar burada yaşamayı planlıyorsun?"),
  (Tur, Medium, [1183143], "Tom, Mary'yi karışıklıktan kurtardı."),
  (Tur, Medium, [6482165], "Bostonlu olduğumu bilmiyor muydun?"),
  (Tur, Medium, [3942486], "Tom'un dinlenmek için zamana ihtiyacı var."),
  (Tur, Medium, [5956995], "Bir samurayla bir ninja arasındaki fark nedir?"),
  (
    Tur,
    Medium,
    [5826512],
    "Aklı başında biri nasıl bununla aynı fikirde olmaz?",
  ),
  (
    Tur,
    Medium,
    [1009413],
    "Onun söylediklerine güvenebileceğimi zannetmiyorum.",
  ),
  (Tur, Medium, [9192401], "Planlarımı değiştirmem gerekecek."),
  (Tur, Medium, [4119390], "Bu yiyecek hem besleyici hem de lezzetli."),
  (Tur, Medium, [1489554], "Sütü meyve suyuna tercih ederim."),
  (
    Tur,
    Long,
    [2124197, 1587941, 8471757],
    "Bir insan aya indi. Berlinde bir duvar yıkıldı. Bir dünya kendi bilimimizle ve hayal gücümüzle bağlandı. Meksika'da bir devrim patlak verdi. Plajda güzel deniz kabukları topladı.",
  ),
  (
    Tur,
    Long,
    [6387946, 3971020, 4069293, 4860070, 4208507],
    "Şimdi yemek yemenizi öneririm. Tom oyun oynamak istediğini söyledi. Judy yarın Japonya hakkında konuşacak. Mola vermeyi tavsiye ederim. Bu, Arapçada ne anlama geliyor?",
  ),
  (
    Tur,
    Long,
    [6461809, 3762545, 1082319, 3631754],
    "Tom, Mary'nin saat 2.30'da onunla buluşmasını istedi. Bugün özellikle sıcak. İstasyona yürümek ne kadar sürer? Kurtlar sürüyle gezer ama kartallar yalnız uçar.",
  ),
  (
    Tur,
    Long,
    [1517573, 4894931, 4932098, 4840715],
    "Zarlar farklı kültürlerde farklı şekillere sahiptir. Başım dertte iken amcam bana iyi bir tavsiye verdi. Odama bir sürahi koyun lütfen. O, arabayla yaklaşık kaç saat sürer?",
  ),
  (
    Tur,
    Long,
    [3755447, 4153622, 5405351, 6374663],
    "Birlikte yalnız kaldılar. Tom Mary'nin her söylediğine inanıyor. Tom Mary ile konuşamadı ve bunun hakkında yapabileceği bir şey yoktu. Tom'un sınavı geçeceğini biliyordum.",
  ),
  (
    Tur,
    Long,
    [5413606, 2122830, 3568654, 5990854],
    "Bu sıra benim için çok alçak. Tom yatması gerektiğini söyledi. Dikkat et, yoksa tam bir kaltak olup çıkacaksın, tıpkı annen gibi. Tom yalan makinesi testine girmeyi reddetti.",
  ),
  (
    Tur,
    Long,
    [6307133, 2965878, 2742448, 2714407, 4624346, 4739076],
    "Tom ve ben çok farklıyız. Tom Mary'den bebeği zorla aldı. Bu pek doğru görünmüyor. Sizi incitmek istemedim. Arabaların sayısı artmakta. O, gümüş ağaçları olan altın şehirler hakkında harika hikayeler duymuştu.",
  ),
  (
    Tur,
    Long,
    [3875597, 7692625, 1230931, 5638529, 5352496],
    "Hiç evini paspasladın mı? \"Komşuların nereliydi?\" \"İspanyol.\" Çocuğa büyükannesinin anısına Sophia adı verildi. Tom'un son müzik videosunu gördün mü? Odadaki herkes sessizdi.",
  ),
  (
    Tur,
    Long,
    [1459048, 3452867, 1966946, 3731777, 4249514],
    "Bitişikteki köpek her zaman havlıyor. Tom bir sigara yakıyor. Otuz dakikadan daha az bir sürede oraya varabilirsiniz. Sanırım bir şeye çarptık! Muhtemelen o bir dolardan daha az paraya mal oldu.",
  ),
  (
    Tur,
    Long,
    [4114390, 3274825, 5305560, 13590063, 4911735],
    "Tom o kadar tutucu değil. Aradığımı buldum fakat sorgulamaktan asla vazgeçmeyeceğim. Birbirimize dürüst olalım. Ev ödevlerini yapmayı unutmuşlardı. Birçok insan bu hikayenin düzmece olduğuna inanmak istemiyordu.",
  ),
  (
    Tur,
    Long,
    [14017101, 4989022, 3767339],
    "Mısır'a gitti ve oradan kızını geri getirdi. Bunun konuşmamız için en iyi zaman olduğunu sanmıyorum. Bu şimdiye kadar gördüğüm en kötü vesikalık fotoğraf.",
  ),
  (
    Tur,
    Long,
    [6022194, 1584980, 10093423, 3834472, 7776479],
    "Bir yarış daha izlemek istiyorum. Bu, Dünyadaki en iyi şeydir. Veri istifçiliği bir dijital hastalıktır. Arkadaşlarım benim için çok önemli. Ben zaten haftalardır burada çalışıyorum.",
  ),
  (
    Tur,
    Long,
    [4161270, 12071795, 1663517, 5498126, 13232354],
    "Almanca öğrenmeye sana kim yardım edebilir? Ona hediye almak için yeterli param yoktu. Aldığı çok pahalıydı. Biz onun gerçek olduğunu biliyoruz. Tom Marry'le evli değil, değil mi?",
  ),
  (
    Tur,
    Long,
    [4179165, 4360858, 8086756],
    "Şimdi farklı bir işim var. Barda yanımda oturan şafak sökene kadar beraber içtiğim adamlarla gerçekten iyi anlaştım. Kabiliye'de kimseyi tanımıyordum.",
  ),
  (
    Tur,
    Long,
    [7690257, 1131349, 1391749, 4519630],
    "\"Komşularının milliyeti ne?\" \"Avustralya.\" Ona karşı nazik ol, Bill. Lütfen o dönünceye kadar bekle. Her zaman senin gibi yemek yapmayı öğrenmek istedim.",
  ),
  (
    Tur,
    Long,
    [1745067, 1495256, 3925136, 4869199],
    "Annem bana parayı boşa harcamamamı öğretti. O, bazen ümidini kaybeder. Yağmur gibi görünüyor. Yanına bir şemsiye alsan iyi olur. Geldiğiniz için teşekkürler, çocuklar! Bir sonraki derste görüşürüz!",
  ),
  (
    Tur,
    Long,
    [6037187, 1021304, 5300623, 3543948, 5675810],
    "Kendime inanıyorum, gerçekten yaparım. Film sırasında konuştular. Tekne bir zincirle çapaya bağlıdır. Odalar zevkle dekore edildi. Onların gerçekten araları çok bozuk.",
  ),
  (
    Tur,
    Long,
    [3849628, 6483704, 4830006, 5308826, 2440078],
    "Şimdi daha önce olduğumuzdan daha yoksuluz. Tom kesinlikle Mary'nin bunu yapmasına izin vermeyecek. John bir veterinerdir. Sen lisede bir zorbaydın. Aynı yatakta uyuduk.",
  ),
  (
    Tur,
    Long,
    [3301970, 6045493, 5306495, 4759670],
    "Anne babanla hemen temasa geçmen iyi olur. Leyla bir arkadaşına bir mektup yazdı. Son olarak, o Amerika Birleşik Devletleri'ne gitti. Ben tehlikeye uyandım.",
  ),
  (
    Tur,
    Long,
    [8359545, 7687131, 5018675, 1666428, 4438346],
    "Feng Şui'de \"Ki\" bir tür yaşam enerjisidir. \"Hocaları nereli?\" \"Amerikan.\" Müziğimin herkes için olmadığını biliyorum. Oğlunu okula gönderemedi. Manav müşterilerine karşı çok nazik.",
  ),
  (
    Tur,
    Long,
    [3443175, 6763191, 1463848, 4255212],
    "Yalnızca on tane kitabım var. Sami'nin cesedinde hiçbir görünür dış travma işareti yoktu. O, işi dün bitirmiş olmalı. Tom'a ne söylediğimi düşünüyordun?",
  ),
  (
    Tur,
    Long,
    [3956032, 5371621, 3524716, 4579482, 7689302],
    "Tom'un bir otobüsün önüne atladığı doğru mu? Onlar bu hafta sonu çalışıyorlar. Kırmızı eti çok severim. O her zaman moda kıyafetler giyer. \"Onun arkadaşları hangi milletten?\" \"Çek.\"",
  ),
  (
    Tur,
    Long,
    [7762236, 6079117, 6851326, 4256868, 1212047],
    "Hava durumu mevsimlere göre değişir. Bunun olacağını bilmiyor muydun? Hiç ciddi bir hastalık geçirdin mi? Hayat bir bilmecedir ve cevabı aşktır. Onun niçin o kadar kızgın olduğu hakkında bir fikrim yok.",
  ),
  (
    Tur,
    Long,
    [4034479, 5367873, 6122400, 6062095],
    "Onu görmek zorundasın. Tatoeba nasıl para kazanıyor? Dün geceki piyango çekilişinde kazanan rakamlar sırayla 7, 18, 3, 41 ve 6 idi. O, anne ve babalar için zorluktur.",
  ),
  (
    Tur,
    Long,
    [5361827, 14007033, 7924680, 5841035, 4786322],
    "Mary'nin bir yeme bozukluğu var. Onun mesajını telefonuma aldım. Tom'dan çok daha kısasın. Fadıl, köpeği öldürecek kadar zalim biriydi. Onların işi kitapları ciltlemek.",
  ),
  (
    Tur,
    Long,
    [5678347, 6364831, 6630573, 5094653],
    "Matematik benim en az sevdiğim konu. Tom, Mary'nin kazanmasına asla izin vermeyeceğini söyledi. Selam Sami. İşler nasıl? Dünyada mutluluğu artırmanın tek yolu onu bölüşmektir.",
  ),
  (
    Tur,
    Long,
    [10332606, 4254649, 2602364, 4099050],
    "Yerimde olsaydın sen ne yapacaktın? Bize ne söylemeye çalışıyorsun? Eğer üç işçi dört günde iki kanal kazarsa altı işçi dört kanalı kaç günde kazar? Tehlikenin farkında olduğuna kesin gözüyle baktım.",
  ),
  (
    Tur,
    Long,
    [5530099, 4956571, 4879441, 3085417, 4081669],
    "Bu bir randevu değil. Kullanmak zorundaysak güç kullanabiliriz. Her şey değişmiş gibi görünüyordu. Sanırım paranı geri istemelisin. Ya Tom ya da Mary markete gidecek, fakat ikisi değil.",
  ),
  (
    Tur,
    Long,
    [5821359, 2718176, 9795656],
    "Jamal ve Sarah Kahire'ye geldiler. Benim bardağımdan içiyorsunuz. Çocukluğunu hakkıyla yaşamamış insanların içinde tamiri zor bir tatminsizlik duygusu hep olur.",
  ),
  (
    Tur,
    Long,
    [1219404, 6775382, 3568906, 4173934],
    "Bütün arkadaşlarım doğum günü partime geldiler. Sami neler olduğunu avukatına anlattı. En sevdiğiniz hangisi? Sadece Tom'un söylediği her şeye inanmadığımı söyleyelim.",
  ),
]

///|
let rows_pol : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Pol, Short, [734222], "Znam ją trochę."),
  (Pol, Short, [933361], "On pewnie przegra."),
  (Pol, Short, [366302], "To gruba ryba."),
  (Pol, Short, [8547529], "Będziemy ten las wycinać."),
  (Pol, Short, [697470], "Wejście tylko dla personelu."),
  (Pol, Short, [12470452], "Bądź szybki."),
  (Pol, Short, [5665083], "Jesteś oddany."),
  (Pol, Short, [13335485], "Idź się bawić na dwór."),
  (Pol, Short, [8760718], "Lubię tańczyć."),
  (Pol, Short, [3445898], "Chyba żartujesz."),
  (Pol, Short, [3009624], "Praca trwa."),
  (Pol, Short, [5704243], "Było za dużo."),
  (Pol, Short, [12285682], "Spojrzeli do środka."),
  (Pol, Short, [8608278], "Ale jestem zmęczony!"),
  (Pol, Short, [403732], "Piszę do matki raz na miesiąc."),
  (Pol, Short, [2726995], "Masz moje klucze."),
  (Pol, Short, [948038], "Myślę, że zaraz lunie."),
  (Pol, Short, [751760], "On czuje się coraz lepiej."),
  (Pol, Short, [1564692], "Pójdźcie drugą ulicą."),
  (Pol, Short, [2301504], "Tom chciał odwiedzić Amerykę."),
  (Pol, Short, [579865], "Czy już do niej dzwoniłeś?"),
  (Pol, Short, [3616559], "Nikogo nie zastrzeliłem."),
  (Pol, Short, [12453753], "Zmarła w łóżku."),
  (Pol, Short, [366805], "Keiko zawzięcie się uczy."),
  (Pol, Short, [12453763], "Skończył nam się chleb."),
  (Pol, Short, [2244745], "Boga nikt nigdy nie widział."),
  (Pol, Short, [8745340], "Dlaczego chcesz to zrobić?"),
  (Pol, Short, [11263241], "Szczęście jest zdrowiem duszy."),
  (Pol, Short, [3607089], "Bardzo mi się podoba Hokkaidô."),
  (Pol, Short, [13560892], "Żona jest straszna."),
  (Pol, Medium, [6406124], "One obie już to wcześniej czytały."),
  (
    Pol,
    Medium,
    [2849692],
    "Samolubni ludzie myślą tylko o własnych uczuciach.",
  ),
  (Pol, Medium, [988644], "Łatwiej jest wystartować niż wylądować."),
  (
    Pol,
    Medium,
    [5489641],
    "Spróbuję, ale nie wiem na pewno, czy będę mógł iść jutro do kina, czy nie.",
  ),
  (
    Pol,
    Medium,
    [350021],
    "Czasem kłamiemy, żeby nie zranić czyichś uczuć.",
  ),
  (
    Pol,
    Medium,
    [9686914],
    "Tom mógłby zatrzymać się w naszym domu, jeśli by chciał.",
  ),
  (
    Pol,
    Medium,
    [525805],
    "Wiele cząsteczek związków aromatycznych ma nazwy zwyczajowe.",
  ),
  (Pol, Medium, [10599109], "To jeden z największych stadionów świata."),
  (
    Pol,
    Medium,
    [749211],
    "Za chwilę dalszy ciąg muzyki, proszę nas słuchać.",
  ),
  (Pol, Medium, [2725515], "Zmieniłam fryzurę, ale jemu nie spodobała się."),
  (Pol, Medium, [3435347], "Właśnie przeprowadziłem się do Bostonu."),
  (Pol, Medium, [521185], "Moja babcia wieczorem chodzi na spacer."),
  (Pol, Medium, [3004400], "To biurko jest zaprojektowane dla dzieci."),
  (Pol, Medium, [7183420], "Jest jeszcze coś, co chcę ci pokazać."),
  (
    Pol,
    Medium,
    [912652],
    "Rozmawialiśmy do późnej nocy przy herbacie i ciastkach.",
  ),
  (Pol, Medium, [4100248], "Tom był cały ranek w swoim biurze."),
  (Pol, Medium, [2197099], "Wstanę jutro rano i odrobię lekcje."),
  (
    Pol,
    Medium,
    [12471289],
    "Wracając do domu, natrafiłem na martwą kunę, leżącą na środku chodnika.",
  ),
  (Pol, Medium, [600391], "\"Za dużo mówisz.\" - powiedział."),
  (
    Pol,
    Medium,
    [3749356],
    "Wydaje mi się, że twierdzenia Toma też niekoniecznie mijają się z prawdą.",
  ),
  (
    Pol,
    Medium,
    [2975274],
    "W Japonii nie ma takiego zwyczaju, aby dawać napiwek za dobrą obsługę.",
  ),
  (Pol, Medium, [1856788], "Proszę, abyś przeczytał poniższy tekst."),
  (
    Pol,
    Medium,
    [3744927],
    "Czy mógłbyś do niego zadzwonić jutro rano i powiadomić go o tym?",
  ),
  (Pol, Medium, [734325], "Ten kapitan został marynarzem w wieku 19 lat."),
  (
    Pol,
    Medium,
    [5488008],
    "Czy możesz przedstawić mnie komuś, kto mówi po francusku?",
  ),
  (
    Pol,
    Medium,
    [2154237],
    "Tom i jego przyjaciele grali w ostatni weekend w koszykówkę.",
  ),
  (Pol, Medium, [9679428], "My mężczyźni przywykliśmy czekać na kobiety."),
  (Pol, Medium, [13655413], "Tom i ja nie odzywamy się już do siebie."),
  (
    Pol,
    Medium,
    [2407682],
    "Niczego w życiu nie należy się bać, należy to tylko zrozumieć.",
  ),
  (Pol, Medium, [5221449], "Sukces zależy głównie od wysiłku."),
  (
    Pol,
    Long,
    [3872014, 6553701, 531816, 13036730],
    "W tym roku Boże Narodzenie wypada w sobotę. Mylisz się. Nie jestem pesymistą, ale sceptykiem. Wyczuł niebezpieczeństwo i uciekł. Nie ma na świecie cudu, który mógłby się równać z twoim pocałunkiem, moja droga.",
  ),
  (
    Pol,
    Long,
    [1014380, 713548, 2900715, 6602353],
    "Z łatwością opanował angielski. Wystarczyło tylko powiedzieć mu prawdę. Często opowiada się żarty o innych narodach. Gdybyś wziął mapę, to byśmy nie zabłądzili.",
  ),
  (
    Pol,
    Long,
    [11699574, 3634047, 8707106, 5221500, 822163, 900881],
    "Kobiety są równie mądre jak mężczyźni. Tom wcale nie jest nieśmiały. Chciałbym ją zobaczyć! Tom liczy, że Mary mu pomoże. Cicho bądź i posłuchaj. Ogólnie rzecz biorąc, Japończycy są słabi w językach obcych.",
  ),
  (
    Pol,
    Long,
    [3522597, 12995585, 12213471, 13583224],
    "Ona może rozwiązać ten problem, ja zresztą też. Po wyznaczeniu następcy zmarł. Czy chcesz, żebym była szczera? Nie wolno nam jeszcze spocząć na laurach.",
  ),
  (
    Pol,
    Long,
    [8166711, 8429442, 3065546, 792195, 13690229],
    "Spojrzała na zegarki. Znów jestem w więzieniu. Ilu z was planuje być tu znów jutro? Był tak spragniony, że wypiłby studnię. Chcą, żebym się poddał, ale ja nie jestem gotów dać za wygraną.",
  ),
  (
    Pol,
    Long,
    [898716, 12954426, 5909082, 3703924, 8743579],
    "Trzeba wybrać jeden z tych planów. On próbował uciec przez okno. Nigdy nie wiadomo, co szykuje nam przyszłość. Moi rodzice już nie żyją. Czy jest pan emeryturze?",
  ),
  (
    Pol,
    Long,
    [4788981, 10559645, 3743765, 8166788],
    "Większość ludzi nie ma tutaj prądu ani bieżącej wody. Ona próbuje naprawić swój samochód. Niektóre dzieła mają liczne nazwy. Obecnie wszyscy oglądają telewizję mimowolnie.",
  ),
  (
    Pol,
    Long,
    [5608473, 10572612, 2830012, 6935666],
    "Od lat przyglądam się czasopismom wychodzącym w Polsce i przyznam, że ich poziom nie jest zbyt wysoki. Chciałbym to zobaczyć. Chcemy pełnych zdań. Ona walczyła o prawa kobiet.",
  ),
  (
    Pol,
    Long,
    [596504, 7911123, 2607618, 875913, 3298921],
    "Czy twój wuj pozwala ci prowadzić swój samochód. Tom jest wyjęty spod prawa. Jego postępowanie mi się nie podoba. Słyszysz jak on szybko mówi? Nie miałem pojęcia, że nie masz prawa jazdy.",
  ),
  (
    Pol,
    Long,
    [10550125, 4828171, 368387, 720178],
    "To jest trudniejsze niż myślisz. Tom nie chciał sprzedawać żadnego ze swoich obrazów. Osobiście nie zgadzam się na ten plan. Nauczyciel zadał mi trudne pytanie.",
  ),
  (
    Pol,
    Long,
    [13785878, 5147981, 11261073, 837206, 4547013],
    "Niech mi pan nie wysyła więcej niż jedną. Co spodziewasz się tu znaleźć? On żeni się w sobotę. Oni nie mają ze sobą nic wspólnego. Tom chce nam zadać kilka pytań.",
  ),
  (
    Pol,
    Long,
    [858485, 13430316, 7977908, 4120272, 8652360, 10574132],
    "Zadzwoniła do mnie z Tokio. On znowu zrobił ten sam błąd. Zapytam czy Tom chce kolejnego drinka. To nie jest takie trudne. Jesteśmy bardzo zajęci. Czy kazałem ci długo czekać?",
  ),
  (
    Pol,
    Long,
    [1060663, 12040456, 846279, 2894981],
    "Muszę napisać list. Masz papier? Wiem, że Tom wie, że tak planuję zrobić. Dopiero wczoraj John powiedział mi o swoich planach wyjazdu do Europy. Mam niewiarygodne bóle.",
  ),
  (
    Pol,
    Long,
    [461020, 1592277, 8115784, 830381, 591092],
    "Jego luksusowy tryb życia nie odpowiada jego zarobkom. Zadzwońcie po lekarza! Pozwól mi cię przytulić. Wstyd mi za to, co zrobiłem. Pływanie jest dobre dla zdrowia.",
  ),
  (
    Pol,
    Long,
    [10559690, 2015676, 4917347, 11111800, 3741482, 4090951],
    "Jesteś bardzo religijny, co nie? Cesarz jest władcą cesarstwa. Tom nie musi tam iść, chyba że chce. Jem melona miodowego. Kiedy on gra w tenisa? Jakie jest twoje ulubione rodzime wino?",
  ),
  (
    Pol,
    Long,
    [2601673, 3863114, 525208, 8571611],
    "Ziąb trzymał przez trzy tygodnie. Tom przyjechał pół godziny przed czasem. Zamierzam odrobić pracę domową, gdy wrócę do domu popołudniu. To my jesteśmy temu winni.",
  ),
  (
    Pol,
    Long,
    [8617755, 4130062, 10849504, 730576, 13564804],
    "Podaj mi, proszę, jedno z tych czasopism. Tom położył jajka na talerzu. Tom i Mary nie chcą dołączyć do naszego klubu. Taki plan nie może się udać. Chciałbym zapomnieć o ostatniej nocy, którą spędziłem z tobą, ale nie mogę.",
  ),
  (
    Pol,
    Long,
    [8524039, 593075, 10236828, 3855093, 362001],
    "Gdzie są szpaki w zimie? Jaskółki latają po niebie. Tom pomógł Mary posprzątać w domu. Gdyby dziś była niedziela, poszlibyśmy na ryby. Nie wchodź na tę drabinę, jest niebezpieczna.",
  ),
  (
    Pol,
    Long,
    [13690145, 12040401, 13296157, 13074618, 3160001],
    "Kto cię do tego namówił? Sami traci pieniądze. Tomaszowi udało się znaleźć nową pracę w Bostonie. Te banany są niedojrzałe. Przepraszam, ale muszę już iść do domu.",
  ),
  (
    Pol,
    Long,
    [8989714, 11678631, 8948662, 8739276, 13223713],
    "Sami nie jest moim ojcem. Minęła tylko godzina, zanim cała woda wyparowała. Jesteś zadowolony z wyniku? Czy jestem tu bezpieczny? Kupię tylko głośniki i zaraz wracam.",
  ),
  (
    Pol,
    Long,
    [751844, 13561873, 545034, 734209],
    "Nigdy jeszcze nie jadłem chińskiego jedzenia. Musimy zmienić plan. Albo ty jesteś w błędzie, albo twój przyjaciel. Ten niepopularny polityk wiele razy w trakcie swojego przemówienia budził śmiech tłumu.",
  ),
  (
    Pol,
    Long,
    [7803142, 1735687, 999165, 13000333, 880306],
    "Niedobrze że nie zapytałeś o jej imię. Masz coś do pisania? Porozmawiałem z Aki o ubraniach. Nie przeszkadzaj mnie. Lubię czytać przy świetle słonecznym.",
  ),
  (
    Pol,
    Long,
    [13593206, 11581855, 718952, 12406528, 827803],
    "W pobliżu nie ma nikogo. Tamten stół jest brudny. Odsunąłem stół, by nie przeszkadzał. Dlaczego mnie nie posłuchałaś? Dzięki temu lekarstwu od razu poczułem się lepiej.",
  ),
  (
    Pol,
    Long,
    [898817, 1772607, 4735326, 3361920, 1622989],
    "Tankowiec to statek przewożący ropę naftową. Nikt nawet nie widział niczego podobnego. Tom pływa każdego dnia. Wolę mocną kawę od słabej kawy. Jaka jest głębokość tego jeziora?",
  ),
  (
    Pol,
    Long,
    [4148349, 3961065, 3502759, 442912],
    "Nie mogłem uwierzyć, że to Tom. Tom oparł się o ścianę. Tom i ja spotkaliśmy się na lotnisku. Nie mam nic przeciwko temu, by ten chłopak czytał książki.",
  ),
  (
    Pol,
    Long,
    [11606324, 3871951, 3869239, 8493462, 2727002],
    "Martwię się o jego bezpieczeństwo. Ona ma świetlaną przyszłość przed sobą. Nauczyłem się myśleć tak, jak Tom. Chcesz iść ze mną na zakupy? Pójdę przekazać Tomowi dobre wieści.",
  ),
  (
    Pol,
    Long,
    [3938245, 8498654, 2733989, 838975, 4151831],
    "Nawet gdybym wiedział, nie powiedziałbym ci. Jak uczysz się francuskiego? Za naszym domem jest park. Jest dla niej bardzo miły. To mnie bardzo zezłościło.",
  ),
  (
    Pol,
    Long,
    [532165, 1592152, 3051485, 4403895, 547171],
    "Grudzień to ostatni miesiąc roku. Nie czytaj w tym pokoju. Jesteś bardzo dobrym nauczycielem. Nigdy tego nie zrobimy w tym tempie. Księżyc wzniósł się ponad chmury.",
  ),
  (
    Pol,
    Long,
    [4438811, 9636290, 3789666, 2903352, 761295],
    "Proszę, proszę, co my tu mamy? Martwisz się o Toma? Tom i Mary byli w sobie nawzajem zakochani. Nie mogę znaleźć moich butów. Jak długa jest ta historia?",
  ),
  (
    Pol,
    Long,
    [1728736, 10472307],
    "Wszystko mi jedno, czy wyjdziesz, czy zostaniesz. Czuł się przekonany, że Jonasz był znowu Jonaszem, którego znał tydzień temu, a nie Jonaszem z czasu pomiędzy.",
  ),
]

///|
let rows_swh : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Swh, Short, [10848348], "Ungeipenda."),
  (Swh, Short, [10872284], "Ilionekana rahisi sana."),
  (Swh, Short, [10845877], "Lazima nishughulikie kitu."),
  (Swh, Short, [10848304], "Hilo lina aibisha sana."),
  (Swh, Short, [13900044], "Utakula nini siku ya Krismasi?"),
  (Swh, Short, [10845372], "Siwezi kufikiria chochote."),
  (Swh, Short, [3173926], "Wao ni wabaya."),
  (Swh, Short, [10886866], "Alimuita jaji 'Mtukufu'."),
  (Swh, Short, [10850121], "Nipigie simu baadaye?"),
  (Swh, Short, [10893733], "Tulitaka tu ujue tunajali."),
  (Swh, Short, [10887122], "Oh! Hii inapendeza sana!"),
  (Swh, Short, [2576633], "Habari za nyumbani?"),
  (Swh, Short, [10845366], "Hawawezi kuniona."),
  (Swh, Short, [1121742], "Utaweza kurudia ulichosema?"),
  (Swh, Short, [10831318], "Siku njema."),
  (Swh, Short, [10872052], "Ulipanga viti katika safu."),
  (Swh, Short, [10818142], "Tumpa mbwa jina la Tim."),
  (Swh, Short, [10858180], "Ningependa unipe nafasi."),
  (Swh, Short, [3653645], "Ni nyumba ya Anita."),
  (Swh, Short, [369341], "Hutusahau!"),
  (Swh, Short, [10878189], "Kuna mahali kwa kila mtu."),
  (Swh, Short, [10889098], "Sitafanya hivyo."),
  (Swh, Short, [10894011], "Alisahau kuosha mikono yake."),
  (Swh, Short, [10845021], "Uni fuate tu."),
  (Swh, Short, [8998965], "Ninaongea Kijerumani kidogo."),
  (Swh, Short, [8986368], "Unaongea Kireno?"),
  (Swh, Short, [10827341], "Mbona mlikuwa mnachukua watu?"),
  (Swh, Short, [3172875], "Gari yao si jizuri."),
  (Swh, Short, [10898434], "Yeye ni mwongo tu."),
  (Swh, Short, [10874606], "Tunasaidiana."),
  (
    Swh,
    Medium,
    [10813541],
    "Mchinjaji aliyeniuzia nyama hii ni rafiki kila wakati.",
  ),
  (Swh, Medium, [10893837], "Je, unaweza kubainisha ni nini hataeda na sisi?"),
  (Swh, Medium, [10872317], "Anapenda kuzungumza kuhusu watoto wake."),
  (Swh, Medium, [3173094], "Mtawala alikuwa na wana wasita."),
  (
    Swh,
    Medium,
    [10877567],
    "Wanafunzi wanahitajika kufanya huduma ya jamii kwa saa moja kila wiki",
  ),
  (Swh, Medium, [10843108], "Ni magari mangapi gereji hii inaweza kuchukua?"),
  (Swh, Medium, [10877799], "Mawimbi yaliharibu ngome ya mchanga."),
  (Swh, Medium, [10818956], "Thieta yote iligeuka mtu alipolia \"Moto!\"."),
  (
    Swh,
    Medium,
    [10818438],
    "Msichana alisikiza muziki, mvulana alikuwa anasoma kitabu.",
  ),
  (
    Swh,
    Medium,
    [10813969],
    "Hakuna nchi inapaswa kuingilia mambo ya ndani ya nchi nyingine.",
  ),
  (Swh, Medium, [10869003], "Linda alimtambua Dani kama mtu aliyembaka."),
  (
    Swh,
    Medium,
    [879901],
    "\"Rafiki zangu watajifunza Kinyamwezi. Na wako je?\" \"La, wao hawatajifunza.\"",
  ),
  (Swh, Medium, [10835827], "Uhalifu wake unastahili adhabu ya kifo."),
  (Swh, Medium, [10833822], "Vikosi vya Uingereza viliamriwa kuchukua silaha."),
  (
    Swh,
    Medium,
    [10831248],
    "Mke akasimama kutoka kwa kiti chake. Kisha akatazama mlango.",
  ),
  (Swh, Medium, [10853329], "Mnyonya damu ananyonya damu yangu."),
  (Swh, Medium, [9063874], "Tuko moja kwa moja kwenye Facebook!"),
  (Swh, Medium, [3932851], "Kuna miji mingi mikubwa katika Brazil."),
  (
    Swh,
    Medium,
    [10872180],
    "Mtaa uliopo nyuma ya nyumba yangu ni mdogo sana kwa upatikanaji malori.",
  ),
  (
    Swh,
    Medium,
    [10852978],
    "Safari njema! Uwe na bahati njema katika safari yako.",
  ),
  (Swh, Medium, [10892298], "Kile unachopendekeza ni ujinga tu."),
  (
    Swh,
    Medium,
    [10881019],
    "Kifungo cha gerezani hakiweza kuweka pepo la ng'ombe kama huyo.",
  ),
  (Swh, Medium, [10826702], "Mapato ya kijumla ya mwaka uliopita yalikuwa aje?"),
  (Swh, Medium, [10821476], "Yeye huzima taa ili wasiharibu umeme."),
  (
    Swh,
    Medium,
    [10886219],
    "Meli zingine za kusafiri zinatupa takataka zao baharini moja kwa moja.",
  ),
  (Swh, Medium, [10884379], "Wanaishi kwa kutegemea maziwa sana."),
  (Swh, Medium, [10834041], "Muswada huu ulitumwa kwa Seneti kwa idhini yake."),
  (Swh, Medium, [10813755], "Tabasamu la Kim lilikuwa tamu sana."),
  (Swh, Medium, [10826723], "Kuna magurudumu ndani ya magurudumu."),
  (
    Swh,
    Medium,
    [10896043],
    "\"Nimefurahi umefanya hivyo,\" Malkia alisema kwa sauti yenye utulivu.",
  ),
  (
    Swh,
    Long,
    [10877475, 10813936],
    "Kama ilivyo sasa, nakataa kuhusika na aina yoyote ya sarakasi. Ni ya kitoto sana na inasikitisha kabisa. Siku njema iliyoje. Hii ndio maana ya hali ya hewa nzuri unayopata baada ya dhoruba.",
  ),
  (
    Swh,
    Long,
    [10886310, 10814321, 10811397],
    "Maria ana miaka mitano sasa. Maisha yake yote tangu kuzaliwa hadi leo yako Facebook. Je, unaweza kuniazima senti kumi? Meli hiyo itaanza safari ya Hong Kong kesho saa 9 mchana.",
  ),
  (
    Swh,
    Long,
    [10863817, 10831312, 10834935],
    "Kama ungalikuja leo, ningekupa francs elfu. Upasuaji ulikuwa wa hatari kwa muda kidogo lakini daktari anadhania kuwa atapona. Baridi na kavu, na jua nzuri, ni hali nzuri ya hewa ya baridi!",
  ),
  (
    Swh,
    Long,
    [10845210, 10858907, 10821031],
    "Alikuwa na hamu moja tu: kufinyika na kuishi kati ya taa na vivuli. Hunasababu ya sababu ya kuwa na wasiwasi. Aligawanya dola milioni moja kati ya wanawe watano.",
  ),
  (
    Swh,
    Long,
    [10818635, 10886382],
    "Ulimwengu unahitaji kubadilisha fikira na tabia yake, haswa katika mataifa yaliyoendelea. Nilitumia kitambaa hicho cha manjano ulichonipa kutengeneza mapazia ya chumba changu cha kulala.",
  ),
  (
    Swh,
    Long,
    [10868646, 10814243, 10833126],
    "Dani aliwaamuru walinda usalama kufunga milango yote ya kutoka ya jengo hilo. Basi langu kutoka uwanjani wa ndege linaondoka saa kumi na mbili. Nchini Marekani, bidhaa nyingi bado zinasafirishwa kwa reli.",
  ),
  (
    Swh,
    Long,
    [10826827, 10864089, 10853138],
    "Yeye ni shabiki wa Stephen King. Unanijua zaidi kuliko unavyofahamu. Ndevu zake zilikuwa nyeusi kama shimo, na ndefu kiasi kwamba ilifikia kutoka kidevu chake hadi miguu yake.",
  ),
  (
    Swh,
    Long,
    [10839900, 10855760, 10824975],
    "Kamwe usichezee uvumilivu wa mtu, kwa sababu mapema au baadaye atachoka. Ndugu yangu yuko Boston anasomea waalimu. Alikuwa na hamu ya kuwalisha ndege.",
  ),
  (
    Swh,
    Long,
    [10842369, 10869424, 10821501, 10863970],
    "Bado tunapaswa kugeuza nyasi na kukata kuni. Mahojiano yalirekodiwa kwenye video na kuenezwa kwenye mtandao. Aligongelea msumari kwenye bodi. Kuta za Roma zina milango kumi na miwili.",
  ),
  (
    Swh,
    Long,
    [10872588, 10864175, 10896356],
    "Unaweza kufanya chochote unachotaka kufanya. Wasiwasi wetu kuu ni usalama wa waliotekwa nyara. \"Halafu jukumu la kuunga kusaidia familia litanijia, kama kawaida hapo awali\" mwanamke huyo alisema.",
  ),
  (
    Swh,
    Long,
    [10869432, 10855256, 6927224],
    "Kikosi cha ulinzi kilikagua gari kwa milipuko. Romeo alimpenda sana Juliet kuliko vile alivyofikiria, na hakuweza kuvumilia kumpoteza. Nilisikia kwamba uliolewa.",
  ),
  (
    Swh,
    Long,
    [13899962, 10881329, 10889640, 3385264, 10807206],
    "Kifaransa ni kigumu sana. Akili yangu inasema ndiyo, lakini dhamira yangu inasema la. Ninaogopa hiyo ndio ukweli. Rafiki yangu hapendi sukari. Tafadhali rudisha seti moja kwetu na saini yako.",
  ),
  (
    Swh,
    Long,
    [10804719, 10858303, 10838122],
    "Tunastahili kupiga kura katika umri wa miaka ishirini. Chupi haimaanishi kuwa ifichwe, ila inafaa kuonekana. Ninashukuru kwa kusimama juu ya vilele vya mlima.",
  ),
  (
    Swh,
    Long,
    [10891476, 10863574, 10850925],
    "Sipendi uvuvi, lakini baba yangu anapenda. Kupoteza pasipoti yako katika nchi ya kigeni ni mbaya kuliko kupoteza mzigo wako au mkoba wako kuibwa. Unaweza kujua umri wako kwa kiasi cha maumivu unayosikia unapokutana na wazo jipya.",
  ),
  (
    Swh,
    Long,
    [10898569, 9063927, 10881278],
    "Alipokuwa katika safari yake, katika nyumba ya wageni, Bwana alikutana naye, na angeweza kumuua. Je! Unazungumza Kiromania vizuri? Je, unaenda wapi wikendi hii?",
  ),
  (
    Swh,
    Long,
    [10824715, 10809074, 10815725, 10837781],
    "Sauti yake bado ipo masikioni mwangu. Fred, kuwa na tabia nzuri, sina mzaha. Katika ukumbi, Kathy alibadilisha viti na mamake. Rafiki yangu alinialika kwa chajio.",
  ),
  (
    Swh,
    Long,
    [10824570, 10804648, 10837409],
    "Kuna uhusiano mkubwa wa kimapenzi kati yao. Hakika yeye ni mchanga na mrembo, lakini ana afya dhaifu. Unapaswa kusoma aina ya vitabu ambavyo vina aina ya habari ambayo itakuwa muhimu kwako baadaye maishani.",
  ),
  (
    Swh,
    Long,
    [10898127, 10820830, 10880412],
    "Ninaamu kusikiliza kile utakachosema. Kusudi lake lilikuwa nini kuwasha moto kwenye nyumba? Nguruwe walivaa mapambo kama sehemu ya utafiti wa kisayansi.",
  ),
  (
    Swh,
    Long,
    [10814327, 10825182, 10835295, 10880526, 10866002],
    "Maneno 'mrembo' na 'mbaya' ni maneno ya kawaida. Bakia ulipo hadi nikupe ishara. Madereva wanawake ni hatari. Sehemu ya Lisa wangu inakaa nami. Ninakushukuru mapema kwa msaada wako.",
  ),
  (
    Swh,
    Long,
    [10838249, 10842672, 2489839, 10858369],
    "Serikali haipaswi kuondoa haki za raia, inapaswa kuzilinda! Hukuzaliwa shetani; unajifunza kuwa shetani. Usinywe maji yaliyo bilaurini! Hii ndiyo kompyuta niliyokueleza kuhusu.",
  ),
  (
    Swh,
    Long,
    [10894352, 10866403, 8999016, 1121736, 10826764],
    "Aliniambia alikuwa ametulia. Treni hukimbiia kupitia hili shimo zikitumia maili arobaini kwa saa. Nina umri wa miaka arobaini. Mnajuana kutoka wapi? Unahitaji kupata ruhusu kubandika matangazo, na isitoshe, unaharibu sura ya mtaa!",
  ),
  (
    Swh,
    Long,
    [10845797, 10889115, 10807261],
    "Kwa upande wangu mwenyewe ningefurahi ikiwa Bald Eagle hangekuwa amechaguliwa Mwakilishi wa nchi yetu. Naogopa kujaribu kufanya hivyo. Salamu ni msingi wa tabia nzuri.",
  ),
  (
    Swh,
    Long,
    [10868757, 10869009, 10893630],
    "Dani alibarikiwa na mabinti wawili warembo. Polisi waliwahoji watu wengi ambao wanafanya kazi karibu na eneo la uhalifu. Wawindaji hawawezi kuwepo bila mawindo.",
  ),
  (
    Swh,
    Long,
    [10892061, 10848554, 10863879, 10812059],
    "Nilikuwa na mashaka. Kusema kweli huna wakati. Anna aliingia kwenye mahusiano makini na Paula baada ya kuhitimu chuo. Katika kazi yangu yote kama wakala wa kusafiri, sikuwahi kutembelea Afrika.",
  ),
  (
    Swh,
    Long,
    [10889389, 10872989, 3173258, 10858756, 10866018],
    "Sina nia hata kidogo. Siwezi kustahimili ukweli. Mungu aliumba dunia. Tutakuwepo kwa dakika chache. Mfalme wa Mashariki alikuwa na bustani nzuri, na katika bustani hiyo palikuwa na mti uliozaa tufaha ya dhahabu.",
  ),
  (
    Swh,
    Long,
    [10896324, 9063898, 10811427],
    "Ilichukua kama saa moja kutayarisha chakula cha jioni, lakini nilichukua wakati mwingi kujipanga kwa kazi hio. Nina umri wa miaka 33. Masharti yalitiwa saini kati ya Japan, Germany, Uingereza na Marekani.",
  ),
  (
    Swh,
    Long,
    [10804701, 10891976],
    "Ungetusaidia kama ungetuhifadhia hoteli ifuatayo wakati wa kongamano letu. Kuna wanaume wawili na mwanamke mmoja wamesimama karibu na mti katika picha hiyo.",
  ),
  (
    Swh,
    Long,
    [10818678, 10856064, 1121730, 10884598],
    "Ana sifa ya kunyooka kama mshale. Hawezi kamwe kujihusisha na ufisadi. Jambo la kuogofya limefanyika. Nimepoteza funguo zangu. Sikuvalia suti kwa sherehe yangu ya kuhitimu.",
  ),
  (
    Swh,
    Long,
    [10842194, 10875361, 10896142, 10887154, 10869534],
    "Kila mtu alikuwa akifanya hivyo. Ningependa kuona kinachotokea. Usinifanye nicheke. Itaganda hivyo. Masahati yanahitajika mlangoni mwa duka hili. Vipi kuhusu ice cream na mchuzi wa chokoleti?",
  ),
  (
    Swh,
    Long,
    [10894492, 10880612, 10838023, 10855228],
    "\"Sitapoteza wakati wako,\" alisema, akijiinua juu ya sofa. Nani anamlea mtoto huyu, Mathayo, wewe au mimi? Caleb ameifahamu vizuri. Utajiri wa mtu huyu ni mkubwa, lakini wazimu wake ni mkubwaz zaidi.",
  ),
]

///|
let rows_sun : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Sun, Short, [13444935], "Nya, hayu urang lakukeun wé."),
  (Sun, Short, [5161396], "Wilujeng Natal!"),
  (Sun, Short, [13457122], "Tom ngorok tarik pisan."),
  (Sun, Short, [13441342], "Aing teu yakin deui ku nanaon"),
  (Sun, Short, [13450600], "Kumaha lamun reureuh heula?"),
  (Sun, Short, [13442315], "sabaraha loba jelema nu matéh?"),
  (Sun, Short, [13444576], "Aing di portugal."),
  (
    Sun,
    Short,
    [13012310],
    "ᮠᮤᮏᮤ, ᮓᮥᮃ, ᮒᮤᮜᮥ, ᮇᮕᮒ᮪, ᮜᮤᮙ.",
  ),
  (Sun, Short, [13441268], "Bere hakan manukna!"),
  (Sun, Short, [13442239], "Aing sieun ka cucunguk"),
  (Sun, Short, [13441392], "Ulah diuk di sofa éta"),
  (Sun, Short, [13445682], "Aing lain panyaah anjing."),
  (Sun, Short, [13442173], "Ngudud di kasur téh bahya"),
  (Sun, Short, [13449125], "Aing dakan nilai alus."),
  (Sun, Short, [13442970], "Kembang apuyna katingali!"),
  (Sun, Short, [13445662], "Siya boga idé alus teu?"),
  (Sun, Short, [7838346], "Manehna moal percaya ka urang."),
  (Sun, Short, [13451877], "Ziri teu sapedahan deui."),
  (
    Sun,
    Short,
    [13706694],
    "ᮄᮑ ᮊᮥᮓᮥᮔ ᮒᮩ ᮊᮝᮤᮔ᮪ ᮏᮩᮀ ᮄᮑ.",
  ),
  (Sun, Short, [13444530], "Manéh leuwi pinter ku éta"),
  (Sun, Short, [13441349], "Maranéhna keur hakan apel"),
  (Sun, Short, [5161398], "Gero pulisi!"),
  (
    Sun,
    Short,
    [13706696],
    "ᮞᮥᮔᮒ᮪ ᮕᮤᮊᮩᮔ᮪ ᮘᮥᮓᮊ᮪ ᮒᮩ ᮆᮒᮤᮞ᮪.",
  ),
  (Sun, Short, [13445613], "Sami tetep ngomongkeun Layla."),
  (Sun, Short, [12869136], "Manéh teu nyaho."),
  (Sun, Short, [13442139], "Tah, aya salju!"),
  (Sun, Short, [13444551], "Pompa ieu bogana si Tom."),
  (Sun, Short, [13441365], "Manéh téh ancik di australia?"),
  (Sun, Short, [13463258], "Aing latihan piano unggal poé."),
  (Sun, Short, [13442284], "Inya ngomong basa cina"),
  (Sun, Medium, [13468722], "Ziri ngirim Rima balik ka imah jeung sasupir."),
  (Sun, Medium, [13445110], "Wenang teu aing menta hiji inuman?"),
  (Sun, Medium, [13450617], "Tom jeung Mary nyaho teu siya teu resep ka inya?"),
  (
    Sun,
    Medium,
    [13441397],
    "Aing reuwas nalika ngadéngé lamun tétéhna kabogoh aing tétéla bogoh ka aing",
  ),
  (Sun, Medium, [13450582], "Unggal désa, najan leutik, boga pésta taunan."),
  (Sun, Medium, [13445627], "Dimana aing bisa ngecék bagasiing?"),
  (
    Sun,
    Medium,
    [13445649],
    "Aing nanggung waler ka inya pakeun kaleungitan éta.",
  ),
  (Sun, Medium, [13442297], "aing geus ngalakukeun nu kudu dilakukeun ku aing"),
  (Sun, Medium, [13442971], "Tom narima surat ti meri poe ieu."),
  (Sun, Medium, [13457823], "Jalma sareya maké acuk siga badut."),
  (
    Sun,
    Medium,
    [13451863],
    "Kritikna mecenghul goréng pisan, iwal Dumplingna.",
  ),
  (Sun, Medium, [13451889], "Soca Yanni witan ngaulinkeunana."),
  (
    Sun,
    Medium,
    [13445224],
    "Aing ménta hampura pakeun naon nu kajadian seméméhna.",
  ),
  (Sun, Medium, [13450559], "Tom heuleut lamun mary bakal lakukeun itu."),
  (
    Sun,
    Medium,
    [13442279],
    "kolotna Yanni ancik di Aljazair salaku ekspatriat.",
  ),
  (Sun, Medium, [13450536], "Inya teu boga cekap pangalaman."),
  (Sun, Medium, [13444367], "Inya nolak pikeun ngala acisna."),
  (Sun, Medium, [13441383], "Aya leuwi loba awewe tibatan lalaki di dunya"),
  (Sun, Medium, [13441393], "Manéhna teu kungsi angkat ka sakola"),
  (Sun, Medium, [7838344], "Ulah nepi Tom nempo foto-foto ieu."),
  (Sun, Medium, [13444893], "Tom deung Aing teu ancik bareng deui."),
  (
    Sun,
    Medium,
    [13457813],
    "Malaur ngan lumpat sakedik, tapi tuur aing geus ngageter.",
  ),
  (
    Sun,
    Medium,
    [13441456],
    "Kamari aing kapanggih ku batur manéh nu aing geus 10 taun teu kadeuleu",
  ),
  (Sun, Medium, [13446573], "Kami puguh pisan perlukeun bantuan manéh."),
  (
    Sun,
    Medium,
    [13441359],
    "Ambisina nyaéta pikeun meunangkeun kawasaan politik",
  ),
  (Sun, Medium, [13444578], "Aing bakal lakukeun naon nu dihayang."),
  (
    Sun,
    Medium,
    [13450623],
    "Pamarentahan nyéksa rahayat pakeun nyieun inya ngucapkeunana.",
  ),
  (
    Sun,
    Medium,
    [13445707],
    "Ziri beunang nyinglarkeun cekelan manusa serigala.",
  ),
  (
    Sun,
    Medium,
    [13445626],
    "Tom netelakeun ka mary yén lumba-lumba téh satoa lindeuk.",
  ),
  (Sun, Medium, [13442895], "Tom sigana teu karasa kabita ku biantara meri."),
  (
    Sun,
    Long,
    [13444947, 4649477],
    "Aing teu ngarti naha basa jieunan diperyogikeun nalika geus aya cekap loba basa di bumi ieu. Hiji, dua, tilu, opat, lima, genep, tujuh, dalapan, salapan, sapuluh.",
  ),
  (
    Sun,
    Long,
    [13444541, 13442221, 13445137],
    "Anaking bakalan resep hakan perménna. Tom teu bakal eureun ngalakukeun éta Neuleuna bisa ngomong basa Prancis fasih kalawan fasih, inya meureun majar di prancis.",
  ),
  (
    Sun,
    Long,
    [7838345, 13442135, 13442948],
    "Jelema ti Mesir ngomong basa Arab. Tom ngomong yén inya kudu nurunkeun beurat awak Sabaraha heubeul Tom sareng Mary bobogohan saméméh maranéhna kawin?",
  ),
  (
    Sun,
    Long,
    [13444573, 7842536, 13442309],
    "Tom ngomong inya ngamaksud pikeun menang. Harita basa usum halodo panjang calik paduduaan dina samak salambar. lamun manéh rék lakukeun nanaon ka aing, aing bakal nangkep siya",
  ),
  (
    Sun,
    Long,
    [13442946, 13455257, 13453971, 13442286],
    "Meri meureun mikir naon nu inya lakukeun teh ide alus. Aing mawa ieu pakeun inya. Ieu geus sataun leuwi ti aing ningali Tom. Sami hayang ngundeur aplikasi éta",
  ),
  (
    Sun,
    Long,
    [13457804, 13444574, 13441410, 7838339, 13441315],
    "Abdi hayang nyium anjeun. Sami datang ka imah sabtu. Inya ngirimkeun aing buku Elmu tuntut dunia siar, korsi butut tumila liar. Manehna ngababarkeun orok nu cageur",
  ),
  (
    Sun,
    Long,
    [13671218, 13441440, 13445486, 13443340, 13444943],
    "ᮃᮄᮀ ᮌᮩᮞ᮪ ᮙᮎ ᮆᮒ ᮘᮥᮊᮥ ᮊᮘᮦᮠᮔᮔ. Urang ngahariwangkeun manéh Tom ngantepkeun anakna lakukeun nanaon nu didaék. Maranéhna dakan nanaon nu meunang dicokot Aing keur teu daék ngomong.",
  ),
  (
    Sun,
    Long,
    [13443326, 13457781, 13457774, 13451854],
    "Uwaing teu boga leungeun. Hal penting bisa diajarkeun di Toki Pona. Jalma ditu téh guru basa jepang, aing rasa. Yanni teu daék boga masalah saréng jelma itu.",
  ),
  (
    Sun,
    Long,
    [13902926, 13444513, 13442232, 13450546],
    "Naon maksud anjeun ngomong kitu? Manéh ngawaskeun murid. Ngaliwatan latihan yoga, awak murid jadi leuwih lemes. Manéh saré deui di kantor peuting ieu?",
  ),
  (
    Sun,
    Long,
    [13445119, 13457782, 13450608, 13445701],
    "Inya nanya kumaha carana masak lauk. Urang geus di imah ayeuna. Siya leuwi alus lakukeun ayeuna salawas siya boga kasempetan. Tom ngomong inya teu bakal dibuli pakeun ngalakukeun itu.",
  ),
  (
    Sun,
    Long,
    [13442319, 13444539, 13441351, 13445609, 13450550],
    "Leungeun manéh geus beresih ncan? Sami mangkat ti bandara. Wilujeng taun enggal Bisa teu manéh ngadéngé sora lambak. Aing nyaho siya nyaho dimana Tom jeung Mary.",
  ),
  (
    Sun,
    Long,
    [13444394, 13457803, 13468746, 13444575],
    "Kumaha lamun perpustakaan boga sagalana? Nanaon nu naék kudu turun. Siya mangkat ka warung dék meuli naon? Tom teu kungsi ceurik, teu peduli sabaraha ruksak inya dibabuk.",
  ),
  (
    Sun,
    Long,
    [13445200, 13445172, 13455242, 13442305, 13443055],
    "Kamana waé maranéh duaan? Aing nyaho Tom puguh ngomong kitu Hésé neangan pagawéan ayeuna mah. Urang milih pikeun teu kawin Lamun waé Bapana teu aya didieu, inya pati geus jadi miskin ayeuna.",
  ),
  (
    Sun,
    Long,
    [13441405, 13443111, 13444583, 7838347, 13455256],
    "Wilujeng sumping di Wikipédia Masa gede engke, aing hayang jadi raja. Tom teu kudu beuli buku éta. Tom geus jiga dulur kuring. Aing keur boga ateul-ateul.",
  ),
  (
    Sun,
    Long,
    [13441275, 13457778, 13451738, 13444520, 13442283],
    "urang hakan peuting di restoran korea Geura leuwi gancang. Manéh teu kungsi nyaho iraha inspirasi bakal datang. Badaina matak hésé balik ka kémah. Sababraha mindeng beusna datang?",
  ),
  (
    Sun,
    Long,
    [13474973, 13445673, 13441323, 13442954, 13446580],
    "Masa itu datang ka anaking, masalahna teu eureun eureun. Aing rasa Tom jeung Mary geus angkat. Manéhna teu boga anak Tom geus kacilakaan. pasian ieu, aing teu ngarti euy.",
  ),
  (
    Sun,
    Long,
    [13444540, 13469003, 13451887, 13443348],
    "Aing teu ngomong jawaban manéh sok salah. Inya ngagero ngaran aing. Kaluarga lokal geus nawarkeun ka manéh tempat pakeun ancik. Maranéhna nyaho maranéhna ngomong kaleuwihan.",
  ),
  (
    Sun,
    Long,
    [13441356, 13444871, 13442290, 13441380],
    "Manéh katingali sepa pisan Inya nandonkeun nyawana pakeun nyalametkeun budak nu kateuleum. pas aing dugi ka stasiun, karétana geus mangkat Manéhna hayang kapangging jeung manéh",
  ),
  (
    Sun,
    Long,
    [13442281, 13457764, 13441321, 13443071, 13444538],
    "Aing teu datang datang ka pesta éta Ziri teu ningali Rima. Nya. Henteu. Manawi. Teuing Hampura aing teu nelepon manéh peuting ieu. Sami poho ngisi absen.",
  ),
  (
    Sun,
    Long,
    [13445487, 13449122, 13444594, 13445597, 13444593],
    "Naon di harepkeun néangan didieu? Manéh datang pakeun nolong? Aing rasa kaos ieu bisa dipiceun we. Barudak biasana percaya ka kolotna. Tom teh juru tulis imaginatif pisan.",
  ),
  (
    Sun,
    Long,
    [13446575, 13474966, 13441305, 13443020, 13468771],
    "Abdi saangga dening pamadegan manéh. Sami sareng Layla boga kahirupan atita sasarengan. Coba aing neuleu daptar éta Tom magawe saheubeul hirupna. Tom ngan bisa nyimpen saeutik acis.",
  ),
  (
    Sun,
    Long,
    [13444545, 13441448, 13442155, 13441352],
    "Aing kuduna nyoba ngalakukeun éta. Inya maboga hiji anjing jeung genep ucing Aing hakan sangu unggal poé Nalika aing muteur sekrupna, caina ngocor kaluar",
  ),
  (
    Sun,
    Long,
    [13442249, 13442197, 13442313, 13441374, 13442780],
    "Aing rék hakan sangu goreng Meri ngomong yén inya hayang dikuburkeun didieu Kaulinan ieu matak kagum Aya alusna manéh ngadengekeun aing Inya ngomongna kitu, nya kitu.",
  ),
  (
    Sun,
    Long,
    [13442434, 13450541, 13441306, 13442307, 13442220],
    "Ziri geus manggih ajeun ayarna. Tom téh gitaris heavy métal. Maranehna teu neuleu nanaonan Hujan, jadi aing teu lakukeun Aing teu kungsi jieun kalepatan nu sarua deui",
  ),
  (
    Sun,
    Long,
    [13444510, 13442839, 13445494, 13445756],
    "Éta mereun kajadian nalika Tom aya di Australia. Urang ngahadap kapaehan Tom milu marching band. Tom nyétir salawas peuting nalika Mary saré disabeulahna.",
  ),
  (
    Sun,
    Long,
    [13443025, 13441337, 13442282, 13442871],
    "Aing teu resep ka ngaran manéh. Manéhna teuneungkeun dirina jeung mimiti ngomong deui Tom geus kawin nalika inya balik teu loba urang kanada ngalakukeun éta",
  ),
  (
    Sun,
    Long,
    [13442241, 13451886, 13442160, 13457800],
    "Jauhkeun ubar-ubaran ti jangkauan barudak Inya teu nempo manéhna deui kampanyena meunang jeung inya téh kapilih dina pamilihan Hiji kahormatan bisa gumawé bareng saréng anjeun.",
  ),
  (
    Sun,
    Long,
    [13452771, 13444357, 13455243, 13441309, 13444437],
    "Inya ambeuna teu hadé. Teu kungsi ngabawa pribadi nanaonan di tempat gawé téh. Maranéhna teu bakal nulungan inya. Hayu nungguan di luar Kalimah ieu boga jumlah suku kecap haiku.",
  ),
  (
    Sun,
    Long,
    [13449109, 13446582, 13453974],
    "Aing ajarkeun manéh gitar. Tarjamahkeun kalimah ieu dening alus. Mulah mo dipangaruhan ku tarjamahan basa lian. Nu boga taneuhna ngomong inya rék naékkeun harga séwa.",
  ),
  (
    Sun,
    Long,
    [13457125, 13442157, 13442152],
    "Tom ampir tilu puluh taun ayeuna. leuwi alus telat tibatan teu henteu pisan Aing ngarasa kurang percaya diri malahan kungsi mikir pikeun eureun sakola wé",
  ),
]

///|
let rows_ron : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Ron, Short, [8605276], "Și Tom și Mary sunt nebuni."),
  (Ron, Short, [6581973], "Aceasta îți aparține?"),
  (Ron, Short, [12349301], "Sora mea nu are mașină."),
  (Ron, Short, [1279043], "Nu-mi bara drumul."),
  (Ron, Short, [11876671], "Ei sunt prieteni?"),
  (Ron, Short, [6580616], "Știu că Tom este încăpățânat."),
  (Ron, Short, [1144722], "Capitala Turciei este Ankara."),
  (Ron, Short, [13045242], "Se plimbă pe străzi."),
  (Ron, Short, [13626587], "Îi trebuie mai multă sare."),
  (Ron, Short, [12884805], "Acesta este dicționarul meu."),
  (Ron, Short, [12299358], "Nu crede că este vina lui."),
  (Ron, Short, [4948782], "Fii cinstit cu mine."),
  (Ron, Short, [8180971], "Ce binecuvântare!"),
  (Ron, Short, [10787792], "Nu uita să te speli pe dinți."),
  (Ron, Short, [9308998], "Ești bătrân."),
  (Ron, Short, [1555849], "Ne grăbim."),
  (Ron, Short, [12199331], "Toate războaiele sunt rele."),
  (Ron, Short, [9961479], "Începe să plouă."),
  (Ron, Short, [8871977], "Tom spera să afle adevărul."),
  (Ron, Short, [1119702], "Vorbiți ebraica?"),
  (Ron, Short, [5082342], "Tom încă este tinerel."),
  (Ron, Short, [5165897], "Ai dat calificative testelor?"),
  (Ron, Short, [5221709], "Lui Tom nu-i place la școală."),
  (Ron, Short, [11087957], "Tom n-a studiat niciodată."),
  (Ron, Short, [1561500], "O săptămână are șapte zile."),
  (Ron, Short, [12332947], "Sigur că Tom a spus adevărul."),
  (Ron, Short, [7058653], "Poți să îmi dai asta?"),
  (Ron, Short, [11978180], "Apleacă-te."),
  (Ron, Short, [8581037], "Mă opresc imediat."),
  (Ron, Short, [12199376], "Las-o pe Jean în pace!"),
  (
    Ron,
    Medium,
    [13619292],
    "Frunzele moarte se opresc din mișcare pentru totdeauna.",
  ),
  (Ron, Medium, [13619678], "Într-un stup poate fi doar o singură regină."),
  (
    Ron,
    Medium,
    [6803852],
    "Tom a etalat o lipsă de respect pentru sentimentele Mariei.",
  ),
  (Ron, Medium, [4885782], "El știe cum să se comporte în public."),
  (Ron, Medium, [8578103], "Noi am continuat să muncim din greu."),
  (Ron, Medium, [6609888], "Tom tocmai mi-a împrumutat niște cărți."),
  (
    Ron,
    Medium,
    [13723535],
    "Vreau să mă plâng șefului pentru că lucrez prea mult.",
  ),
  (Ron, Medium, [12763226], "Layla a decis să se ducă să călătorească."),
  (
    Ron,
    Medium,
    [13596823],
    "Tom mai trebuie să plătească încă trei sute de dolari.",
  ),
  (
    Ron,
    Medium,
    [4920184],
    "Nu pot suporta nici pentru o clipă zgomotul acela.",
  ),
  (Ron, Medium, [10747614], "Tom nu a avut de ales decât să se predea."),
  (Ron, Medium, [9409028], "Vreau ca Tom să se mute la Boston."),
  (
    Ron,
    Medium,
    [1153881],
    "Când l-am întrebat dacă știa unde era ea, doar a ridicat din umeri.",
  ),
  (
    Ron,
    Medium,
    [5090389],
    "Trebuie să redactăm un proces-verbal de predare-primire pentru acest utilaj.",
  ),
  (Ron, Medium, [10792994], "Mi-e teamă să nu fiu concediat."),
  (
    Ron,
    Medium,
    [12364616],
    "Este necesar să-l oprești înainte de a avea timp să meargă mai departe.",
  ),
  (Ron, Medium, [5109663], "Guvernul Mexicului a refuzat să negocieze."),
  (Ron, Medium, [14066933], "Lipsește o literă din calea fișierului."),
  (Ron, Medium, [1192774], "Tom putea cu greu să suporte durerea."),
  (Ron, Medium, [8399651], "Pot să dau televizorul mai încet?"),
  (
    Ron,
    Medium,
    [1136955],
    "A făcut o demonstrație privind modul în care trebuie montat cortul.",
  ),
  (
    Ron,
    Medium,
    [5229195],
    "Sub nicio formă va putea Tom vreodată să jongleze.",
  ),
  (
    Ron,
    Medium,
    [4895909],
    "Această lege se poate aplica în toate circumstanțele.",
  ),
  (Ron, Medium, [4961179], "Hai să încercăm din nou, băieți!"),
  (Ron, Medium, [6732389], "Ce vrei să spui, că noi nu trebuie să o facem?"),
  (Ron, Medium, [10750431], "Nu cred că Tom știe că Mary este nefericită."),
  (
    Ron,
    Medium,
    [1059698],
    "Am învățat la școală că Shakespeare s-a născut în anul 1564.",
  ),
  (Ron, Medium, [13934461], "Avionul decolează la zece și un sfert."),
  (
    Ron,
    Medium,
    [6586178],
    "Chiar crezi că poți învăța să vorbești franceza fluent în trei luni?",
  ),
  (Ron, Medium, [12301542], "O femeie este cel mai dulce lucru din lume."),
  (
    Ron,
    Long,
    [13621299, 10788621, 11983039, 9020053, 5798711, 5041268],
    "Ne iau drept proști? Câinele i-a adus ziarul. Trenul ăsta are întârziere. Nu ești dispus să ajuți? Tom a zâmbit ca și cum s-ar scuza. El va părăsi Japonia în luna aprilie.",
  ),
  (
    Ron,
    Long,
    [8383456, 411868, 13719824, 4974901, 9622576],
    "Nu sunt un doctor, ci un profesor. Îmi duc hainele la curățat de două ori pe lună. Sunt multe păsări colorate în acest parc. Nici înainte, nici după. Tom îmi amintește foarte mult de tatăl meu.",
  ),
  (
    Ron,
    Long,
    [584793, 5324599, 4961111, 6724295],
    "Avem o bibliotecă minunată în incinta școlii. Am muncit mult săptămâna asta. Numele soției mele este Lidia Zarębowa. Zvonul este adevărat într-o oarecare măsură.",
  ),
  (
    Ron,
    Long,
    [10550675, 11469031, 14057970, 8962228, 13320179],
    "Tom a spus că nu dorea un sandviș. Nu știi absolut nimic? Mobilul meu trebuie să fie undeva. L-ai văzut? Pleacă și lasă-mă în pace! O perdea cu țesătură deasă era atârnată la fereastră, astfel încât nu se putea vedea în interior din exterior.",
  ),
  (
    Ron,
    Long,
    [12104069, 1279215, 14057388, 8834361],
    "Ești o adevărată zână. Teoria care-mi place este, că lucrurile trebuie privite de la distanță. Are o culoare oribilă. Iar mânecile sunt prea strâmte. Sunt din Paris, Franța.",
  ),
  (
    Ron,
    Long,
    [1136590, 13929605, 10733201, 12074117],
    "Prăbușindu-se pe jos, a izbucnit în lacrimi. Ea îl iubește pentru că el o ascultă mereu. Tom se simte bine acum, nu-i așa? Am să vin mâine la tine acasă.",
  ),
  (
    Ron,
    Long,
    [709905, 13427326, 13603848, 4827934, 13886936],
    "Termenul acestei facturi este azi. Bicicleta îți aparține, nu-i așa? Este o poveste adevărată. Ea este cea mai frumoasă fată. Prefer să gătesc pentru a face economii.",
  ),
  (
    Ron,
    Long,
    [12111729, 5164161, 12299989, 12889668, 11479850],
    "O să zbor cu avionul la Paris poimâine. Joey reprezintă familia. Bărbatul făcea sex cu o păpușă gonflabilă. Descrierea corespunde realității. Jos din pat cu tine!",
  ),
  (
    Ron,
    Long,
    [10734403, 5191380, 1137766, 12299418, 12932184],
    "Tom vorbește rar în franceză. Nu pot dormi din cauza zgomotului. E cunoscut de toți oamenii din oraș. Tom are cu siguranță peste 30 de ani. Ai, dragă, simplitatea unui copil.",
  ),
  (
    Ron,
    Long,
    [3004017, 12482622, 11583433, 8426301, 6709207],
    "Numele meu este Emily. Tom e aici și e gata să ajute. Ești sinceră sau mă minți? Încearcă să eviți anturajul nefast. Discursul primarului a fost primit cu mult entuziasm.",
  ),
  (
    Ron,
    Long,
    [5181910, 5369304, 7992859, 13626353],
    "Un centimetru este o unitate de măsură pentru lungime. Fără umilință, curajul este un joc periculos. N-am putut s-o fac niciodată. Nu îmi place cerul gri.",
  ),
  (
    Ron,
    Long,
    [4929952, 9813146, 8933237, 11563067, 1136256, 10787258],
    "Am nevoie de somnifere. Nu pot ajunge la ei. Am crezut că Tom va încerca să ne ajute. Acest tort este delicios. Nu există dragoste fără gelozie. Nu mai am telefon mobil.",
  ),
  (
    Ron,
    Long,
    [13931139, 13621470, 8399600, 12880338, 6724289],
    "Cu ce se ocupă fiul vostru? Ia-l! E un leac miraculos. Nu puteți fi mai liniștiți? E timpul să dai foc. Sunt de acord cu interpretarea ta, într-o mare măsură.",
  ),
  (
    Ron,
    Long,
    [11382369, 6586094, 12842154, 9939617],
    "Vom cumpăra o mașină nouă săptămâna viitoare. Nu contează dacă faci asta sau nu. O pătrime din echipă este nouă. De îndată ce Tom și Mary au rămas singuri, i-a spus vestea proastă.",
  ),
  (
    Ron,
    Long,
    [1138134, 10535254, 13525452],
    "Dacă vrei să pari vorbitor nativ, ascultă vorbitori nativi de câte ori este posibil. Amândoi am absolvit Harvard. Al nouălea și ultimul cerc al iadului este un lac înghețat unde, în Divina Comedie, trădătorii sunt pedepsiți.",
  ),
  (
    Ron,
    Long,
    [4988497, 13840197, 5321643, 1979980],
    "Ia-o mai ușor căci urmează un drum plin de gropi. Ei se uită la acest film pentru a mia oară. Tom a trecut de cei mai buni ani ai vieții lui. Care este motivul pentru care a venit aici?",
  ),
  (
    Ron,
    Long,
    [10815367, 12782324, 10333479, 4961164, 1138041],
    "Tom este mulțumit de ceea ce ai făcut. Am tradus documentul în franceză. Cine are puterea să facă asta? Este șase fără cinci. Incendiul a izbucnit după ce personalul a plecat acasă.",
  ),
  (
    Ron,
    Long,
    [4988676, 6061805, 6568374, 5120294, 5201934],
    "Dezertarea din armată era pedepsită cu moartea. Bărbatul era beat criță. Tom a explicat regulile lui Mary. Ei sunt în bucătărie. Cred că a venit vremea pentru mine să-mi iau o nouă adresă de email.",
  ),
  (
    Ron,
    Long,
    [12047708, 8607431, 6586034, 10450372, 11555971, 12337150],
    "Tom se va duce în Boston. Sper ca mama ta să se însănătoșească în curând. Nu fi așa de imatur. Ce ai făcut la școală azi? Da, vreau ca tu să o faci. Nivelul ăla e inundat.",
  ),
  (
    Ron,
    Long,
    [13606024, 2709524, 8931248],
    "Chebapul cu carne de miel este o alegere tradițională și suculentă pentru iubitorii de carne. Care este sărbătoarea ta preferată? Argumentul lui era bazat pe fapte.",
  ),
  (
    Ron,
    Long,
    [5244244, 7837972, 5232619, 4984109, 6640220],
    "Tom nu știe dacă Mary e fericită sau nu. Mi-am pierdut bagajele. A îndeplinit Tom criteriile pentru a trece această clasă? Nu are nevoie de nimic. În gastronomia moleculară, se folosesc aparate complet noi.",
  ),
  (
    Ron,
    Long,
    [13017458, 10733270, 4882057, 5004070, 8815090, 5316051],
    "Omul este un lup pentru om. Nu vreau să supăr pe nimeni. Nimeni nu e mulţumit. Cineva a furat la mașina lui Tom. Ai sprijinul nostru necondiționat. Doctorul i-a spus lui Tom că trebuie să poarte ghipsul trei săptămâni.",
  ),
  (
    Ron,
    Long,
    [3693502, 13727262, 2433871, 12005099],
    "Mergem la o mică plimbare? Noaptea trece și stelele, pe măsură ce se sting, ne invită la odihnă. Aș dori să telefonez în Japonia. Te iubesc din adâncul inimii mele.",
  ),
  (
    Ron,
    Long,
    [6815760, 13715259, 5189730, 12238073, 4933967],
    "Tom a strigat cu groază. Cât au costat noii cercei din argint? El aproape că nu avea o educație formală. Le împrumut de la biblioteca orașului. Ambele explicații pot fi corecte.",
  ),
  (
    Ron,
    Long,
    [3655932, 12450717, 4988751, 923830],
    "Îmi place să vorbesc limba velșă. Desigur, au fost concerte în oraș. Acele descoperiri corespund cu observațiile mele. Ea purta cu costum de baie roșu.",
  ),
  (
    Ron,
    Long,
    [1064315, 2536677, 11939589, 8412083, 6818228],
    "Mary este sora lui Tom. Unui metru cub îi corespund 1000 de litri. Care este numele zeului grec al soarelui? Am luat aproape un scor perfect. Petrecerea a fost un succes considerabil.",
  ),
  (
    Ron,
    Long,
    [10893119, 10784252, 13605985, 670634],
    "Avortul poate să-mi afecteze fertilitatea? Aceasta este o întrebare care se pune adesea. Vreau să rezerv o călătorie în Palestina. La hotelul Hilton, vă rog!",
  ),
  (
    Ron,
    Long,
    [6639045, 6576274, 13313864],
    "Schimbarea a fost remarcabilă. Nu vreau ca Tom să vină în Boston. Elevii folosesc dicționare explicative pentru a înțelege sensul cuvintelor dificile.",
  ),
  (
    Ron,
    Long,
    [1064272, 4895935, 7588965, 6589512, 5180198],
    "Tatăl ei a murit când ea avea trei ani. Acest tren oprește în toate stațiile. Tom a venit în Japonia din Australia. Tom a spus că Mary s-a întors. Tom a ținut un discurs scurt.",
  ),
  (
    Ron,
    Long,
    [12535263, 13731500, 1147523, 4943788],
    "Mi-ar plăcea foarte mult să aflu numele fiicei dvs. De ce nu mi-ai prezentat prietenii tăi? Nu vreau să aștept atât de mult timp. De unde ai știut că am fost eu?",
  ),
]

