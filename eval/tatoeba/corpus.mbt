let rows_hau : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Hau, Short, [10804552], "Ina bukatar kifi."),
  (Hau, Short, [10889284], "Yaya kafarka take warkewa?"),
  (Hau, Short, [10833285], "Kai! Daga ina ya zo?"),
  (Hau, Short, [10858948], "Kawai mene abin da kake yi?"),
  (Hau, Short, [10891402], "Isra'ila ta fi karfin doka."),
  (Hau, Short, [10880449], "Tambaya masomin ilimi."),
  (Hau, Short, [10895647], "Sun ce ba su yarda ba."),
  (Hau, Short, [10840153], "Yaya kuke son su apples?"),
  (Hau, Short, [10887063], "Kana da gida ne."),
  (Hau, Short, [10811680], "Talla ta TV tana zane sosai."),
  (Hau, Short, [10839760], "An haramta!"),
  (Hau, Short, [10889509], "Yaushe zaku ziyarce mu?"),
  (Hau, Short, [10831045], "Yesu christi Ka kare ni."),
  (Hau, Short, [10855616], "Na ga fim din ran Asabar."),
  (Hau, Short, [10864085], "Kin fita daga wasa na."),
  (Hau, Short, [10821125], "Ya buya bayan bishiyar."),
  (Hau, Short, [10850291], "Ina buƙatan ka kusa da Ni."),
  (Hau, Short, [10852804], "Shin zaka iya mun wancan?"),
  (Hau, Short, [10827443], "Ba kamar da bane, kun sani."),
  (Hau, Short, [10875436], "Dole mu mai da hankali."),
  (Hau, Short, [10859056], "Kuna buƙatar ƙarin aiki."),
  (Hau, Short, [10872919], "Kin gaji, masoyiyata?"),
  (Hau, Short, [10874940], "A kawo min wata giyar."),
  (Hau, Short, [10866751], "Ko da yaushe ina kaunar su."),
  (Hau, Short, [10848141], "Wasikar Henry tana damuna."),
  (Hau, Short, [10863539], "Kin tabbata ba ta da saurayi?"),
  (Hau, Short, [2910481], "Kasan abinda yakamata kayi?"),
  (Hau, Short, [10843034], "Yaran suna wasa a waje."),
  (Hau, Short, [10894107], "Ya zabi nasa."),
  (Hau, Short, [10850967], "Abokin ka yayi matukar sa'a."),
  (
    Hau,
    Medium,
    [10835430],
    "Akwai bukata da gaggawa ma hanyar mafi inganci na kula da wannan cutan.",
  ),
  (Hau, Medium, [10840100], "Yana da maguna guda biyu, ɗaya fari ɗaya baƙi."),
  (
    Hau,
    Medium,
    [10809433],
    "Ƙofofin sun kulle kuma ba za mu iya shiga ba ko ta yaya.",
  ),
  (
    Hau,
    Medium,
    [10811947],
    "Lallai Shelly ta kuma cikowa ka daga karshen haduwar mu.",
  ),
  (Hau, Medium, [10825180], "An gano mai karkashin Tekun Arewaci."),
  (
    Hau,
    Medium,
    [10892094],
    "Likitan ya faɗawa Mary ba za ta taɓa samun haihuwa ba.",
  ),
  (
    Hau,
    Medium,
    [10821496],
    "Ya bashi nasarar zuwa duka kwarewa da masana'antu.",
  ),
  (
    Hau,
    Medium,
    [10880408],
    "Mun ga mage mai ciki kusa da ƙofar shiga gidan caca.",
  ),
  (Hau, Medium, [10896261], "Dole ka magance matsalolin ka da kanka."),
  (
    Hau,
    Medium,
    [10892344],
    "Venice ya na ɗaya daga cikin garuruwan mafi soyayya a duniya.",
  ),
  (Hau, Medium, [10821083], "An ce ma shi ya kirkiro siminti."),
  (Hau, Medium, [10884777], "Na ji an ci amana kuma an wulakanta ni."),
  (Hau, Medium, [10848696], "Ba ni da wata matsala ta gaskata hakan."),
  (
    Hau,
    Medium,
    [10858983],
    "Babu wata hanyar da za a san tsawon lokacin da zai ɗauka.",
  ),
  (Hau, Medium, [10896259], "Zan yi ƙoƙari na rubuta rahoton yau."),
  (
    Hau,
    Medium,
    [10855613],
    "Abin takaici, babana ba zai ci gaba da zama cikin rukunin ba.",
  ),
  (Hau, Medium, [10844964], "Nayi tunani kace mini baka iya cin danyen kifi."),
  (
    Hau,
    Medium,
    [10804542],
    "Da fatan za a shiga lokacin da kuka kasance a cikin unguwa.",
  ),
  (Hau, Medium, [10872814], "Wannan sakon zai lalata kansa cikin dakika biyar."),
  (
    Hau,
    Medium,
    [10821281],
    "Ya ji labarai masu dadi game da biranen itatuwan zinariya da azurfa.",
  ),
  (Hau, Medium, [10813913], "Yaya tsawon lokaci zuwa Vienna da ƙafa?"),
  (
    Hau,
    Medium,
    [10875350],
    "Saƙonnin mail masu zuwa, na iya zuwa a jere ta suna, kwanan wata ko kuma inkiya.",
  ),
  (Hau, Medium, [10875214], "Ban san me ya sa suka tsani juna sosai haka ba."),
  (Hau, Medium, [10824796], "Ta ɗora laifin lalacewar kan John."),
  (
    Hau,
    Medium,
    [10820732],
    "Ƙasar Japan ta ƙera motoci fiye da kowane lokaci a wannan shekarar.",
  ),
  (Hau, Medium, [10824674], "Mutumin da za ta tattauna da shi Mista Allen ne."),
  (Hau, Medium, [10835050], "Sun kasance a cikin rumfar ko a cikin kogo."),
  (
    Hau,
    Medium,
    [10892158],
    "Yaya mutum mai irin wannan farin ciki da alfahari da rayuwa yaso kashe kansa?",
  ),
  (
    Hau,
    Medium,
    [10878029],
    "Nan-da-nan, a shahararren dandalin, za a kashe lantarki, kowa ya tafi.",
  ),
  (
    Hau,
    Medium,
    [10813710],
    "Da akwai wani mai suna Mista Kay ya na son ganin ka.",
  ),
  (
    Hau,
    Long,
    [10896362, 10827052],
    "A nan an yi gwagwarmaya da yawa daga cikin rikice-rikice masu gwagwarmaya yayin yakin basasa na Roses. Macizai -yakai wani matakin- kurma ne, amma har yanzu yana iya jin ƙaramin sautuka kuma yana da saurin jin ƙamshi.",
  ),
  (
    Hau,
    Long,
    [10886549, 10866457],
    "Ya kamata Ingila ta zauna a matsayin mamban Tarayyar Turai ko ta fita daga Tarayyar Turai? Gimbiyar ta ajiye kambunta na gimbiya, ta zama sarauniya, hakan ya sanya ta jin dadi sosai.",
  ),
  (
    Hau,
    Long,
    [10811290, 10863292, 10809506, 10813929],
    "Hana yaduwar cutuka cikin sauri ba ƙaramin aiki bane. Dukkan wadancan labari ne ma wawa. Shin Me Davis ya zo kasar Japan don koyar da Turanci? Ko ka ƙi ko ka so, muna cikin wannan tare. Abun da muke iya yi kawai shine aiki tare kamar an haɗa kugun mu.",
  ),
  (
    Hau,
    Long,
    [10833813, 10868689, 10868722],
    "Gwamnatin Burtaniya sun ɓata rai. Dan ya bayyana cewa haƙiƙa Linda ƴar wasan rawa ce. Sufeto Dan Anderson ya samu laifuka guda biyu da zai yi bincike.",
  ),
  (
    Hau,
    Long,
    [10824767, 10825119, 10896270, 10839934],
    "Ita ba kyakkyawa bace kamar ƴar uwarta. Soja na fuskantar hadari akai-akai. Bamuwa samun daama da yawa da yin hakan. Na riga na gaya muku cewa Marco maƙaryaci ne.",
  ),
  (
    Hau,
    Long,
    [10833269, 10892024, 10896580],
    "Duk wannan al'amarin yana wari zuwa saman sama. Yana da muhimmanci mu yi hakan daidai. Majalisar Dinkin Duniya ta amince da ranar mata ta duniya karo na farko a shekarar 1975.",
  ),
  (
    Hau,
    Long,
    [10837999, 10898356, 10878207],
    "Mama, a ina ne tsunmar takarda? Ba ka tunanin abin da mamaki cewa duk da laifinsa ne, kai ne za ka janye? Ina tunanin cewar har yanzu akwai buƙatar aiki.",
  ),
  (
    Hau,
    Long,
    [10825380, 10816523, 10825223, 10877467],
    "Ban san yadda ake dafa abinci ba. Na haɗu da shi jiya lokacin da ya faɗa mun labarin. Kalle ni da littafai ka a rufe. Da aka tayin sayar mishi da wani roka ma dala miliyan takwas, ya ƙi tayin saboda yayi sada da yawa.",
  ),
  (
    Hau,
    Long,
    [10816259, 10835268, 10850965],
    "Ba wani abu da na fahimta daga cikin maganarsu. Ya kashe kansa sakamakon tsalle daga tsauni. Billy da mahaifin shi basuwa hulda da juna har kusan shekaru ashirin.",
  ),
  (
    Hau,
    Long,
    [10831060, 10850796, 10858514],
    "An haifi Roger Miller a ranar 2, ga watan Junairun 1936 a yammacin birnin Fort Worth, da ke Texas. Za mu daidaita from kai nan gaba. Muna nan, a ofishin yawon bude ido, ka gani?",
  ),
  (
    Hau,
    Long,
    [10858570, 10855562, 10894317, 10809573],
    "Zan sha wannan maganin tarin idan maƙogwaro na ya bushe. Mun karɓi wasu alamun da ba mu sani ba. Ya gaya mani yana iya ganin fatalwowi. Danny bai da hankalin sanin abu mai kyawu.",
  ),
  (
    Hau,
    Long,
    [10811315, 10884729, 10811337, 10825152],
    "Gaya min wacce tafi a cikin kyamarorin. Ina son zuwa Boston tare da ku. Sunyi alamar lalacewar kayayyakin da kashi 40%. Mamata ba ta iya karatu ba tare da gilashin karatu ba.",
  ),
  (
    Hau,
    Long,
    [10894010, 10877958, 10809512, 10830585],
    "Ta manta bata wanke hannun ta ba. Ban san dalilin da ya sa yake faruwa ba. Dave bai sake komawa makaranta ba. Gaskiya zan faɗa maki, na ɓatar da bironki.",
  ),
  (
    Hau,
    Long,
    [10818320, 10855830, 10824928, 10824990, 10812057],
    "Akwai kyakkyawar dangantaka tsakanin samarwa da bukata. Ina kawai kasancewa ni. Sauran kaɗan mota ya buge ta. Tana alfaharin ita kyakkyawa ce. Wayewar Turawa ta samo asali ne a waɗannan ƙasashe.",
  ),
  (
    Hau,
    Long,
    [10866640, 10842554, 10850231, 10872708],
    "Ka gaya mata ta zauna. Tarihin tsoratarwa na ya dogara ne da hujjoji. Ina ta tambayar kai na wannan tambayar guda daya. Ina fatan zamu isa ga asalin wannan sirrin tare.",
  ),
  (
    Hau,
    Long,
    [10893633, 10872553, 10898294, 10863596],
    "Ina fatan wannan ya isa haka. Sojan yana da rauni a kafa kuma ya kasa tafiya. Tsohon saurayina na son ya lalata sabuwar alaƙa ta. Akwai banbancin al'adu masu dama tsakanin gabaci da yammacin Jamus.",
  ),
  (
    Hau,
    Long,
    [10852758, 10884256, 10820972, 10815938, 10894042, 10816293],
    "Masko ne babban birnin Rashs. Bana son zama manaja. Barkwancin sa yasa kowa dariya. Ka ganshi a tasha yau da safe? Ita da ma'aikatan ta sun shirya. Kar kayi kokarin neman wauta daga wurina.",
  ),
  (
    Hau,
    Long,
    [10872567, 10848446, 10840071, 10818850],
    "Wannan tsohon ɗan wasan kwaikwayon yara daga baya ya zama mai shan kwaya. Naɗe waɗancan jaridu. Harsashi nawa mashinga ke iya harbawa? Kada ku cika mu da surutu.",
  ),
  (
    Hau,
    Long,
    [10824826, 10843040, 10884012],
    "Ta ba da shawarar haɗa liyafa. Ya kamata mutanen Sydney su ji tsoron sharks, amma saboda wasu dalilai ba su da alama. Ranar da ta gabata jiya Talata; gobe bayan gobe Asabar.",
  ),
  (
    Hau,
    Long,
    [10804650, 10878253, 10850140, 10891826],
    "Idan kuka yi ihu daga saman dutse, zaku iya jin sautin muryarku. Kotun sun hana ɗaukaka ƙara. An umurce ni in kula. Wannan shine ɗayan manyan tituna na Rome.",
  ),
  (
    Hau,
    Long,
    [10809140, 10815864, 10853254, 10842552],
    "Ku danna ƙarrawar mana. Yeriman da Gimbiyar sun yi tafiyar su da yaɓawa daga taron jama'a. Lokacin da na fadi wando na ya yage a daidai gwiwar. Wadannan 'yan siyasa suna son gina gada da ba zata je ko ina ba.",
  ),
  (
    Hau,
    Long,
    [10853256, 10830635, 10893570, 10898138, 10815803],
    "Ban taba iya zama wuri daya ba. Zan ziyarci Mr. Brown gobe. Na kasa amincewa kina da buƙatar yin hakan. A'a, ban taɓa yi mata ƙarya ba. Kungiyar taimako ta mutum guda ba za ta gamsar ba.",
  ),
  (
    Hau,
    Long,
    [10858261, 10830848, 10892360],
    "Jamhuriya ƙasa ce da shugaban ƙasa ke jagoranta maimakon sarki. Dakunan wannan otal suna da kyau. Na yi tunani cewa kun ce har yanzu kuna son yin hakan.",
  ),
  (
    Hau,
    Long,
    [10866391, 10815988],
    "Duba abin da ya faru lokacin da na lankwasa wannan reshe da yawa. Kwallon ƙafa da aka buga a duk duniya a yau shine mafi kusancin kwallon kafa ta asali.",
  ),
  (
    Hau,
    Long,
    [10804512, 10875255, 10884378, 10891273],
    "Ina makarantarka take? Bari mu mai da hankali kan abubuwan da ake buƙatar yin yau. Galibi sun fi rayuwa da madara. Kai ba makanike ba ne, ko ba haka ba?",
  ),
  (
    Hau,
    Long,
    [10858374, 10807408, 10869275, 10889448],
    "Ba na bukatar ka gaya mani abin da zan yi. Da ya kokarta kadan, da ya yi nasara. Wasu jiragen ruwa suna da fasinjoji da yawa. Duk da abubuwan da suka faru, mun yi nasarar guduwa daga kogon.",
  ),
  (
    Hau,
    Long,
    [10818521, 10894349, 10833987, 10840238],
    "Dole ne mu sanya rayukanmu zuwa ga sabon yanayin. Tayi kamar hankalin ta ya kwanta. Lewis da Clark sun kiyaye bayanan sosai. Wannan fim gaskiya an nuna basira sosai.",
  ),
  (
    Hau,
    Long,
    [10869163, 10825156, 10886226, 10856012],
    "Da me ka ke amfani domin fatsa? Mahaifiyata ba ta da lafiya tun watan jiya. Zurfin Grand Canyon ya kai mile ɗaya sannan tsayin kusan mile ɗari ne. An nemi kasancewar likita a wani wuri.",
  ),
  (
    Hau,
    Long,
    [10869132, 10833775, 10818559, 10872752],
    "Shin babu wani abin da za mu iya yi don taimakawa? Ya fara kiwon naman shanu. Faɗa mini takamaiman lokacin da zasu iso. Duk lokacin da na hadiye shi, makogwaron sa yakan yi rauni.",
  ),
  (
    Hau,
    Long,
    [10811152, 10891532, 10896382],
    "Wadancan biranen suna da dokokin danjan kan hanya iri ɗaya. An aikata laifi mai kaduwa, kuma ina tunani na bada gabadayan bayanai akan shi. Idan har wannan damar ta zo, to kada ki yi jinkirin amfani da ita.",
  ),
]

///|
let rows_fuv : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Fuv, Short, [4639450], "Wala ko mi yidi."),
  (Fuv, Short, [4641855], "Patiru vurti ha les koruwal."),
  (Fuv, Short, [4674649], "Mido mari paturu didi."),
  (Fuv, Short, [4639442], "A medi yahugo Paris na?"),
  (Fuv, Short, [4674651], "Hatoi on woni be njonde?"),
  (Fuv, Short, [4674654], "Daka toi a wari?"),
  (Fuv, Short, [4642366], "Wala dalila kurdol."),
  (Fuv, Short, [4674640], "Mi yettima."),
  (Fuv, Short, [4639697], "Mi andi a jabata."),
  (Fuv, Short, [4639458], "O fauni bana ndebbo."),
  (Fuv, Short, [4674635], "Mi nani beldun fottugo be ma!"),
  (Fuv, Short, [4674647], "Mi andi ado sukli."),
  (Fuv, Short, [4674638], "Mi yidima."),
  (Fuv, Short, [4674648], "A wawi turanci na?"),
  (Fuv, Short, [4639698], "Mi andi a viyan wattako."),
  (Fuv, Short, [4639479], "Beddo hako shayi do useni."),
  (Fuv, Short, [4674645], "Ko a watta?"),
  (Fuv, Short, [4639449], "Mi yida ko dume."),
  (Fuv, Short, [4640123], "Tom hurtori masin."),
  (Fuv, Short, [4674634], "Assalamu Alaikum!"),
  (Fuv, Short, [4674637], "Noy innde ma?"),
  (Fuv, Short, [4674652], "Hatoi a woni be njonde?"),
  (Fuv, Short, [4674646], "Ko a wadata?"),
  (Fuv, Short, [4674655], "Daga toi a itti?"),
  (Fuv, Short, [4639536], "Na aibe am on ba."),
  (Fuv, Short, [4674657], "Ko a yidi?"),
  (Fuv, Short, [4674644], "Mi heftai."),
  (Fuv, Short, [4674636], "Noy a woni?"),
  (Fuv, Short, [4674650], "Mi mari paturu didi."),
]

///|
let rows_bos : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Bos, Short, [2734673], "On ima psa."),
  (Bos, Short, [2507715], "Pjevao je pjesmu."),
  (Bos, Short, [11183002], "Pažljivo slušaj."),
  (Bos, Short, [2503148], "Srećna sam."),
  (Bos, Short, [11185542], "Slažete li se?"),
  (Bos, Short, [11183736], "Uzela je taksi do bolnice."),
  (Bos, Short, [11183509], "Sutra ne moraš ići u školu."),
  (Bos, Short, [2342041], "Mi smo iz Rusije."),
  (Bos, Short, [11182658], "Dajem mu ga."),
  (Bos, Short, [11183217], "Razuman je u svojim pitanjima."),
  (Bos, Short, [11183323], "Imam nepravilan puls."),
  (Bos, Short, [11183265], "Šampanjac, molim."),
  (Bos, Short, [486989], "Ta torba je moja."),
  (Bos, Short, [3191490], "Bio sam učitelj."),
  (Bos, Short, [2503831], "On je aristokrat."),
  (Bos, Short, [11182582], "Možeš ponoviti?"),
  (Bos, Short, [11183662], "Tom mi nije to dao."),
  (Bos, Short, [11183167], "Ja sam u krivu, zar ne?"),
  (Bos, Short, [10198910], "Oprostite?"),
  (Bos, Short, [11185641], "Auto mi neće da upali."),
  (Bos, Short, [2983428], "Nikad nisam skočio."),
  (Bos, Short, [11185581], "Pauza traje dvadeset minuta."),
  (Bos, Short, [11183919], "Sada je na telefonu."),
  (Bos, Short, [11721215], "Boja je malo pretamna."),
  (Bos, Short, [11182701], "Sada je tri i petnaest!"),
  (Bos, Short, [475445], "Njegov je, zar ne?"),
  (Bos, Short, [11183599], "Rekla sam da ću te čekati."),
  (Bos, Short, [11183022], "Koliko dugo spava medvjed?"),
  (Bos, Short, [11183488], "Telefonirao me je u ponoć."),
  (Bos, Short, [12674122], "Šta su pet stubova islama?"),
  (Bos, Medium, [11158332], "Gdje ste kupili ovaj sok od ananasa?"),
  (Bos, Medium, [2923079], "Tirana je glavni grad Albanije."),
  (
    Bos,
    Medium,
    [11183327],
    "Što više razmišljam o tome, to sve manje razumijem.",
  ),
  (Bos, Medium, [11183092], "Predsjednik planira sutra dati izjavu."),
  (Bos, Medium, [11183112], "To je bolan i osjetljiv proces."),
  (Bos, Medium, [11183206], "Puno je toga za napraviti, želiš li pomoć?"),
  (Bos, Medium, [11183016], "Možete mi reći gdje se nalazi najbliža crkva?"),
  (Bos, Medium, [7816874], "Razgovarali smo o planovima za budućnost."),
  (Bos, Medium, [11183470], "Mnogi vojnici su bili ubijeni ovdje."),
  (Bos, Medium, [11183145], "Moja mlađa sestra obožava glazbu."),
  (Bos, Medium, [2332790], "Ona radi kao bolničarka u lokalnu bolnici."),
  (Bos, Medium, [2503805], "Ostat ću sa bebom ako želiš ići."),
  (Bos, Medium, [3679698], "Blagajnik, koji radi u samoposlugi je veoma brz."),
  (Bos, Medium, [11185473], "Tom misli da ne znam šta je rekao."),
  (Bos, Medium, [11183688], "Tvrtka se namjerava proširiti u Kinu."),
  (Bos, Medium, [11183468], "Je li došao autobusom, ili vozom?"),
  (Bos, Medium, [11183122], "Knjigu možemo uporediti s prijateljem."),
  (Bos, Medium, [11186068], "Nova kolegica je brzo riješila zadatak."),
  (
    Bos,
    Medium,
    [11185534],
    "Možemo ići na kavu, ali prvo moram ići na poštu",
  ),
  (
    Bos,
    Medium,
    [11183521],
    "Dobar dan! Ja sam Joe Carlton. Mogu li razgovarati s Michaelom?",
  ),
  (Bos, Medium, [7816889], "Ne možemo više da pratimo tvoj plan."),
  (Bos, Medium, [11158399], "U korpi je samo nekoliko jabuka."),
  (Bos, Medium, [11185578], "U koliko sati počinje vaš radni dan?"),
  (Bos, Medium, [11182728], "Sviđaju li vam se nogomet i košarka?"),
  (Bos, Medium, [11183559], "Smijem li posuditi tvoj rječnik?"),
  (Bos, Medium, [11183758], "Mislim da se Tom i Mary sviđaju jedno drugome."),
  (Bos, Medium, [11182626], "Sada idemo ravno u centar grada."),
  (
    Bos,
    Medium,
    [11721255],
    "Bio sam iznenađen kada se Tom pojavio na vrijeme.",
  ),
  (Bos, Medium, [7816878], "Moramo poštovati saobraćajna pravila."),
  (
    Bos,
    Medium,
    [2025523],
    "\"Ne mogu da odustajem\", ona je rekla, \"Ja sam se već zaljubila u njega\".",
  ),
  (
    Bos,
    Long,
    [11183019, 11182774, 11185479, 12116943, 11183153, 11183615],
    "Volim zabave iznenađenja. Nismo imali problema. Koliko mi je poznato, nema. Samo želim šalicu kave. Millie ima plave oči. On se ubrzo oporavio od šoka.",
  ),
  (
    Bos,
    Long,
    [6050681, 11183728, 2591511, 11183121, 11183617, 11186152],
    "Ovi tanjiri su ručno obojani. Čini se da Cathy voli glazbu. Stari prijatelj sam. Kako ste proveli odmor? Mora se mnogo učiti. Svi znamo da jezik učimo slušajući ga i govoreći.",
  ),
  (
    Bos,
    Long,
    [11183531, 11186190, 11183024, 11185589],
    "Bila je to poprilično mala kuća, čvrsta i dobro građena. Imate li ovo malo/veliko/srednje? Pozvao me je na zabavu. Drago mi je da to čujem da ljudi žele moj povratak.",
  ),
  (
    Bos,
    Long,
    [4698071, 11185443, 11183539],
    "Iznenada, podrum u kojem sam bio je počeo izgledati gotovo lijepo i toplo. Kada bi imao milijun jena, što bi učinio s njima? Ovo je najbolje knjiga koju sam ikada čitao.",
  ),
  (
    Bos,
    Long,
    [11182955, 11182876, 11183178, 9988220],
    "Zaustavili su se ispred banke. Gledali smo kako ti ljudi razgovaraju ispred hotela. Mnogi su ljudi poginuli od posljedica oluje. Postat ćemo učitelji.",
  ),
  (
    Bos,
    Long,
    [11183663, 11182982, 5220997],
    "Možete li mi reći gdje je zahod? Tjedan je podijeljen na sedam dana: ponedjeljak, utorak, srijeda, četvrtak, petak, subota i nedjelja. Hvala svima što ste došli. Vidimo se idući put.",
  ),
  (
    Bos,
    Long,
    [7816866, 12626980, 11183511],
    "U školi učimo da čitamo i pišemo. Podbadač kriminalne organizacije koja upravlja ilegalnim sajtovima za klađenje je bio uhapšen od strane policije. Svi ljudi moraju umrijeti.",
  ),
  (
    Bos,
    Long,
    [11183732, 11183884, 11183130, 13846349, 7785675],
    "Isključite molim vas Vaš motor. Da li neko govori engleski ovdje? Većina gitara ima šest žica. Povrće, meso i maslac sam kupio. Tom rijetko jede sa svojom porodicom.",
  ),
  (
    Bos,
    Long,
    [7816903, 11185613, 7785653, 11183568, 11183466],
    "Nekako ćemo proći kroz džunglu. Kako je dobro biti izvan grada u prirodi! Tom nije mogao da završi svoj ručak. Ispričaj nam priču o duhovima! Nemoguće je popraviti.",
  ),
  (
    Bos,
    Long,
    [2503175, 11183565, 2503827, 11183767, 11183700],
    "Šta je najduža njemačka riječ? Tom zarađuje mnogo novaca. Naći ćeš knjigu u knjižnici. Oni su inzistirali da ja moram platiti taj novac. Kratak je bio užitak.",
  ),
  (
    Bos,
    Long,
    [11183107, 11185438, 12037399, 11183750, 2507613],
    "To, iako sam dobro znao, zaboravio sam. Osjetila je kako joj srce brzo kuca. Vaš odgovor je tačan. Bila sam bolesna i morala sam ostati u kući. Konačno je ispunio moj zahtjev.",
  ),
  (
    Bos,
    Long,
    [11721232, 7785666, 11183039, 11185595, 7785645, 11183273],
    "Tom je sada jači nego njegov otac. Kako si uspio da ostvariš ovo? Vi ste nas to naučili. Kako se to piše na engleskom? Čuli smo da ona plače. Tom je već znao o tome.",
  ),
  (
    Bos,
    Long,
    [11183091, 11183494, 11183616, 12422289, 11721237],
    "Mačke se ne vole močiti vodom. Danas mi se ne da ništa. Bio je vrlo dobar prema njima. Ove godine sam odlučio ne ići na odmor. Tom nije bio dovoljno jak da podigne kutiju, pa je pitao Meri da mu pomogne.",
  ),
  (
    Bos,
    Long,
    [11185255, 11183199, 11183146, 11185513, 11183751],
    "Da sam ja ti, čekao bih. Ja nikada nisam rekao takvo što. Mogu li dobiti Vaš autogram? Oprostite, jeste li vi gospodin Brkić? Želim biti samostalniji.",
  ),
  (
    Bos,
    Long,
    [7788398, 11183713, 11186139, 11183138],
    "Tom mi je rekao da pokucam na vrata. Udovica je imala dvije kćeri. Svako mora umrijeti. Znam da si čekao jako dugo, ali možeš li pričekati samo još malo?",
  ),
  (
    Bos,
    Long,
    [11185665, 2731509, 10198929, 11183718, 2763055, 11183118],
    "Od sada ću češće dolaziti u Bosnu. Živjet ću u Kambodži. Onesvijestio sam se. Kada se obično ustaješ? Naoko živi u bijeloj kući. Kvalificiran si da budeš liječnik.",
  ),
  (
    Bos,
    Long,
    [11183050, 11185521, 11183652, 2503813, 11186168, 11183262],
    "Danas nemam domaću zadaću. Razumijem dosta, ali slabo govorim. Imam dovoljno novaca da kupim tu knjigu. To je tako smiješno. Sjela je pod stablo. Znamo se još iz djetinjstva.",
  ),
  (
    Bos,
    Long,
    [11182601, 11185527, 11182927, 11183912, 11185525, 11183284],
    "Doćiću po tebe pa ćemo razgovarati. Idem u grad na posao. Koja žena je uzela ključ? Sami joj je sve rekao. Šta želite popiti? - Ja bih pivo, hvala. U ponedjeljak sam najviše zauzet.",
  ),
  (
    Bos,
    Long,
    [11183624, 11183444, 11183725, 12213815, 11185540],
    "Sami i Lejla su komunicirali preko Fejsbuka Razgovarali smo o tebi. Vrijeme je da se krene. Koji je danas datum? Molim vas, gdje su sapuni i šamponi? – Tamo lijevo.",
  ),
  (
    Bos,
    Long,
    [7785684, 11183687, 1478658, 11182939, 11183694],
    "Francuski nije moj maternji jezik. Idemo igrati bejzbol sa svima. Da li znaš šta je rekao? Došavši u hotel, Mahir je uzeo ključ od sobe. Volio bih te jednom upoznati malo bolje.",
  ),
  (
    Bos,
    Long,
    [11183918, 11183692, 2332776, 11183043, 486721, 11185459],
    "Da li ste već doručkovali? Ugljikov dioksid sam po sebi nije otrovan. Lekar radi u bolnici. Nije to uradio namjerno. Kako se zoveš na bosanskom? Izgleda da vjeruje u ispravnost onoga što je rekao.",
  ),
  (
    Bos,
    Long,
    [11185484, 11183099, 3388971, 11183524, 7774286, 7816877],
    "Nebo je vedro skoro svakog dana. Dugujem svome ocu ono što sam. Imam tridest godina. Ne mogu sve ptice letjeti. Smatram ga neprijateljom. Moramo poštovati pravila saobraćaja.",
  ),
  (
    Bos,
    Long,
    [11183567, 11183913, 3185799, 11186157, 11183480, 11183252],
    "U slučaju požara, zovite 119. Tom je ranjen u borbi. Ima li ona novi kompjuter? Nemamo krov iznad naših glava. Jesi li donio kahvu? Obukao je naopako džemper.",
  ),
  (
    Bos,
    Long,
    [481595, 11183764, 11183908, 2604288, 7816909, 13837997],
    "Jesu li oni prijatelji? Emily će me iznenaditi. Izgleda da imamo sve. Ona je mlada studentkinja. Koliko znamo do sada, Tom je kriv. Svijet je veći od pet.",
  ),
  (
    Bos,
    Long,
    [3185702, 11183070, 11182585, 11185278, 11183010],
    "Želim kupiti knjigu. Biljka ima gorak okus. Pozdravi roditelje u moje ime! Sada je najbolje vrijeme gledati cvjetanje trešanja. Učinila sam sve da te usrećim.",
  ),
  (
    Bos,
    Long,
    [11183449, 11183049, 12674131, 11183152, 11185604],
    "Moja djeca vole životinje. Tatoeba: rečenice, rečenica i još rečenica. On mnogo voli fudbal. Nisi mu trebao pomoći pri poslu. Koliko dugo ostajemo u Berlinu?",
  ),
  (
    Bos,
    Long,
    [11182802, 11183523, 2502359, 7785660, 11183033, 11183056],
    "Nikad nije uzeo ništa. Nojevi ne mogu letjeti. Trier je najstariji grad u Njemačkoj. Rekao sam Tomu da si u Australiji. Izgubila je svoj put. Koliko ima do tvoje škole?",
  ),
  (
    Bos,
    Long,
    [11185567, 11185503, 11183007, 11185429, 11183608],
    "Belma živi u Rusiji. Šta preporučuje Mujo svom šefu? Sva živa bića imaju mozak, osim Toma. Čujem psa koji laje u šumi. Lejla nije bila spremna ići kući.",
  ),
  (
    Bos,
    Long,
    [11183922, 11183221, 11182985, 11183328, 11183291],
    "Čekam da razgovaram sa Tomom. Hoće li on stići na voz? Njezin mentalni razvoj bio je spor. Mislim, to je u redu. Hrvatska se zove \"Hrvatska\" na hrvatskom jeziku.",
  ),
  (
    Bos,
    Long,
    [11183677, 11183640, 11183933, 11182651, 11183183, 11183268],
    "Vrijeme je tako lijepo! Koliko jezika možeš govoriti dobro? Tom je htio da ti dam ovo. Skrenite u drugu ulicu. Reći ću Tomu da to učini. Zašto si odjednom znatiželjna?",
  ),
]

