  (
    Urd,
    Long,
    [10812145, 2608331, 1917680, 13387946, 4211227],
    "آغاز سے ہی آدھا تمام۔ اس نے ایک لمبی زندگی گزاری۔ اسے پتہ ہے کہ شیو کیسے کرتے ہے۔ سمیع پر تعرض اور جنسی زیادتی کے الزامات لگے۔ تم جدھر بھی جانا چاہو جا سکتی ہو۔",
