  (Ckb, Short, [10474226], "چۆن ماری دەناسیت؟"),
  (Ckb, Short, [10293279], "چاویلکەکەی خۆی دۆزییەوە."),
  (Ckb, Short, [10365881], "ھیچ مافێکی نییە ئەمە بکات."),
  (Ckb, Short, [10324729], "پێویستی بە قسەکردن نەدەکرد."),
  (Ckb, Short, [10538699], "تۆپەبەفرێکی تێ گرتم."),
  (Ckb, Short, [10368404], "ئەوە دروست نییە."),
  (Ckb, Short, [10366141], "لە کاتی نان خواردن قسە مەکە."),
  (
