  (Amh, Short, [4451308], "ቶም ሁልጊዜ ጧት ቡና ይጠጣል"),
  (Amh, Short, [12403685], "እንግሊዝኛ አላውቅም።"),
  (
    Amh,
    Short,
    [9145948],
    "እባክዎ፣ ያሜሪካን ኤምባሲ የት ነው?",
