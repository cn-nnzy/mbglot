    Short,
    [3142000],
    "මට උණුවතුර නාන්න ඕන්නෑ.",
  ),
  (
    Sin,
    Medium,
    [3142022],
    "ඔයා මොකක් හරි පිටරට භාෂාවක් ඉගෙනගන්නවා ද?",
  ),
  (
    Sin,
    Medium,
    [2968402],
    "ඔබ මොකක් හරි විදේශ භාෂාවක් හදාරනවා ද?",
  ),
  (
    Sin,
    Medium,
    [3744963],
    "බර්ජ් කලීෆා දැනට ලෝකයේ උසම ගොඩනැගිල්ලට නැග ඇත.",
  ),
  (
    Sin,
    Medium,
    [3142018],
    "ඔයා ඇහැරිනකොට මං මෙහෙන් ගිහින්.",
  ),
  (
    Sin,
    Medium,
    [6602193],
    "මම හිතනවා මට තව අයිස්ක්‍රීම් කෝන් එකක් ඕන කියල.",
  ),
  (
    Sin,
    Medium,
    [3142021],
    "ඔබ අවදිවන විට මා මෙහි තවත් නො සිටිනු ඇති.",
  ),
  (
    Sin,
    Medium,
    [2968395],
    "මං ලෑස්තියි. මා සූදානම්. මම සූදානමින් සිටිමි.",
  ),
  (
    Sin,
    Medium,
    [2986362],
    "ඔබ කුමන හෝ විදෙස් බසක් හදාරන්නෙහි ද?",
  ),
  (
    Sin,
    Medium,
    [3142020],
    "උඹ නැඟිටිනකොට මං මෙහෙන් ගිහින්.",
  ),
  (
    Sin,
    Long,
    [7320284, 3142002, 13215650, 2968388, 2968350, 3142017, 3142019],
    "හැම දෙයක්ම හරිම අමාරුයි මට උණුදිය නෑමට ඇවැසි නැති. ඔබ ඉංග්රිසි කථා කරනවාද? සුභ රාත‍්‍රියක් වේවා. මට පිහිනීමට පුළුවනි. ඔයා ඇහැරිනකොට මං මෙහේ නෑ. උඹ නැඟිටිනකොට මං මෙහේ නෑ.",
  ),
]

///|
let rows_ell : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Ell, Short, [2428043], "Θέλω λεπτομέρειες."),
  (Ell, Short, [5458056], "Είσαι απρόβλεπτη."),
  (
    Ell,
    Short,
    [5573086],
    "Πείτε της ότι είμαι άρρωστος.",
  ),
  (Ell, Short, [5451613], "Καταλάβανε;"),
  (Ell, Short, [5422600], "Χρειαζόμαστε εθελοντές."),
  (Ell, Short, [5481952], "Σας αγαπήσαμε."),
  (Ell, Short, [3043779], "Οι φίλοι μου θα έρθουν τώρα."),
  (Ell, Short, [8188209], "Έχεις πάει εκεί."),
  (
    Ell,
    Short,
    [5410055],
    "Μπορείς να βοηθήσεις τον Τομ;",
  ),
  (Ell, Short, [2733954], "Πίνουν λίγη μπίρα."),
  (Ell, Short, [9850782], "Γιατί τον σκότωσαν;"),
  (Ell, Short, [9932617], "Μου έσπασε μια τιράντα."),
  (
    Ell,
    Short,
    [9115007],
    "Είχα βάλει κιλά! Και τι έγινε;",
  ),
  (Ell, Short, [5603047], "Ο Τομ παντρεύτηκε Καναδή."),
  (Ell, Short, [5523359], "Δώστε μου εκείνο το κουτί."),
  (Ell, Short, [5518509], "Θέλω να δω τηλεόραση."),
  (Ell, Short, [2427587], "Πέρασα μιά λευκή νύχτα."),
  (Ell, Short, [8169637], "Τι κάνει ο Τομ;"),
  (Ell, Short, [5512404], "Δεν είμαστε μαθήτριες."),
  (Ell, Short, [5557462], "Δούλεψε σκληρά."),
  (
    Ell,
    Short,
    [3033849],
    "Είμαι από την ανατολική ακτή.",
  ),
  (Ell, Short, [5602623], "Υπέθεσα πως ήσαστε Καναδή."),
  (
    Ell,
    Short,
    [2398617],
    "Ας μοιραστούμε το λογαριασμό.",
  ),
  (Ell, Short, [8950023], "Έγραψα βιβλίο για την Κίνα."),
  (Ell, Short, [5488463], "Σας αρέσει ο καφές;"),
  (Ell, Short, [5723548], "Έλεγες...;"),
  (Ell, Short, [5613366], "Είστε δικός μου."),
  (Ell, Short, [5605459], "Σκόπευε να πάει για ψώνια."),
  (
    Ell,
    Short,
    [9177185],
    "Μόνος μου δεν θα το αποφάσιζα.",
  ),
  (
    Ell,
    Short,
    [5573660],
    "Πείτε τους ότι δε θέλω να πάω.",
  ),
  (
    Ell,
    Medium,
    [5639435],
    "Δε φαίνεται να 'ναι Καναδέζος ο Τομ.",
  ),
  (
    Ell,
    Medium,
    [12975228],
    "Δεν θα κουραστώ να το επαναλαμβάνω.",
  ),
  (
    Ell,
    Medium,
    [13137686],
    "Μακάρι να μπορούσα να πετάξω πέτρες στο σπίτι του δικτάτορα Μουσταφά Κεμάλ.",
  ),
  (
    Ell,
    Medium,
    [10678066],
    "Ο Θωμάς δεν θα άφηνε ποτέ την οικογενειά του.",
  ),
  (
    Ell,
    Medium,
    [5454504],
    "Ο Τομ δεν εμπιστεύεται τη Μαίρη.",
  ),
  (
    Ell,
    Medium,
    [5462794],
    "Το Τόκιο έχει τον μεγαλύτερο πληθυσμό από κάθε άλλη πόλη στην Ιαπωνία.",
  ),
  (
    Ell,
    Medium,
    [11363288],
    "Μου αρέσουν οι μακριές φούστες.",
  ),
  (
    Ell,
    Medium,
    [2463308],
    "Είμαι σίγουρος πως ο Μπομπ θα περάσει τις εξετάσεις.",
  ),
  (
    Ell,
    Medium,
    [7781588],
    "Πάνε πολλά χρόνια που πήγα στη Βοστόνη.",
  ),
  (
    Ell,
    Medium,
    [1969684],
    "Χρησιμοποιώ φυλλομετρητή \"Firefox\".",
  ),
  (
    Ell,
    Medium,
    [11546818],
    "Ο σίδηρος είναι ένα πολύ σημαντικό μέταλλο.",
  ),
  (
    Ell,
    Medium,
    [2466568],
    "Κάποιοι πιστεύουν στο Θεό αλλά κάποιοι άλλοι όχι.",
  ),
  (
    Ell,
    Medium,
    [4294490],
    "Ο Ατατούρκ γεννήθηκε το 1881, στη Θεσσαλονίκη.",
  ),
  (
    Ell,
    Medium,
    [1398542],
    "Εννιά στο τετράγωνο ίσον ογδονταένα.",
  ),
  (
    Ell,
    Medium,
    [2904181],
    "Η ομάδα μας αποτελείται από πέντε άτομα.",
  ),
  (
    Ell,
    Medium,
    [11175196],
    "Η πολυθρόνα είναι πάνω στο χαλί.",
  ),
  (
    Ell,
    Medium,
    [3513035],
    "Τα παπούτσια μου είναι πάρα πολύ μικρά.",
  ),
  (
    Ell,
    Medium,
    [5636465],
    "Μακάρι να μπορούσα να πάω στην Ιαπωνία.",
  ),
  (
    Ell,
    Medium,
    [4709205],
    "Δώσε μου σε παρακαλώ τις λεπτομέρειες του ατυχήματος.",
  ),
  (
    Ell,
    Medium,
    [7584739],
    "Πάνε τρία χρόνια από τότε που πέθανε ο πατέρας μου.",
  ),
  (
    Ell,
    Medium,
    [10679129],
    "Ο Θωμάς και η Μαρία παντρεύτηκαν πριν τον Ιωάννη και την Αλίκη.",
  ),
  (
    Ell,
    Medium,
    [5570442],
    "Πείτε του ότι δεν είστε έτοιμη.",
  ),
  (
    Ell,
    Medium,
    [5515035],
    "Ο Τομ ήξερε ποιον σχεδίαζε να παντρευτεί η Μαίρη.",
  ),
  (
    Ell,
    Medium,
    [5378413],
    "Είναι σε διακοπές μ' έναν φίλο.",
  ),
  (
    Ell,
    Medium,
    [3743331],
    "Μπορείς να μιλήσεις μια άλλη γλώσσα από τα αγγλικά;",
  ),
  (
    Ell,
    Medium,
    [7810831],
    "Αν ήταν να σβήσει ο ήλιος, όλα τα ζωντάνα πλάσματα θα πέθαιναν.",
  ),
  (
    Ell,
    Medium,
    [9519126],
    "Υπήρχε ένας κουβάς για να συλλέγει τις σταγόνες από το ταβάνι.",
  ),
  (
    Ell,
    Medium,
    [12722895],
    "Η χαρά των παιδιών είναι μαγευτική.",
  ),
  (
    Ell,
    Medium,
    [12057973],
    "Θα σου πω γιατί είμαι θυμωμένος.",
  ),
  (
    Ell,
    Medium,
    [5466060],
    "Το αυτοκίνητό μου είναι σε άσχημη κατάσταση.",
  ),
  (
    Ell,
    Long,
    [4945502, 13048421, 1663188],
    "Η Μαίρη γύρισε σπίτι σπό το σχολείο μες στα δάκρυα γιατί οι φίλοι της την πείραζαν. Το σώμα είναι θνητό, αλλά η ψυχή είναι αθάνατη. Οι άνθρωποι αρέσκονται να συνομιλούν.",
  ),
  (
    Ell,
    Long,
    [4346960, 13448880, 7854120, 5517591],
    "Βλέπω τη θάλασσα και το ποτάμι. Σε μια χώρα των καμπουριών, η όρθια κομψότητα θα αποτελέσει αξιοσημείωτη εξαίρεση. Δεν ξέρω τι εννοείς. Σας είδα στ' όνειρό μου.",
  ),
  (
    Ell,
    Long,
    [10165221, 8778369, 7705973, 3768361, 13727324],
    "Η Μαρία απάτησε τον Θωμά. Θέλω να της μάθω γαλλικά. Γιατί το κάνεις αυτό τώρα; Όλοι έχουμε τα μυστικά μας. Ήμουν ογδόντα χρονών όταν γεννήθηκε ο εγγονός μου.",
  ),
  (
    Ell,
    Long,
    [3588560, 7780371, 2466577, 5565330, 9938737],
    "Η Έιμι είναι στο μπάνιο τώρα. Είμαι σε δίαιτα εδώ και τρεις βδομάδες. Πίστευε στον εαυτό σου. Περιμέναμε μέχρι τις 2:30. Πρέπει να βρεις τη λύση μόνος σου.",
  ),
  (
    Ell,
    Long,
    [13304305, 5573849, 5431136, 5591618],
    "Ήταν τρομακτικό. Αυτή δεν είναι μια χώρα που έχει συνηθίσει τον πόλεμο. Τι θα τους λέγατε να κάνουν; Σας παρακαλώ, ακούστε μας. Θα ήθελες λίγο τσάι, Τομ;",
  ),
  (
    Ell,
    Long,
    [11233021, 5372642, 8349912, 5423441, 5609542, 5488499],
    "Ήρθε εδώ περπατώντας. Ήταν καλός άνθρωπος. Γράφεται σε εσπεράντο. Είστε σίγουρος ότι αυτό είπε ο Τομ; Δε μου αρέσουν τα σκυλιά. Αυτό είναι τ' αμάξι του Τομ.",
  ),
  (
    Ell,
    Long,
    [5405174, 12330559, 13712355],
    "Δε θέλω ν' ανησυχείς! Είναι πολύ βολικό να ζεις κοντά σε σταθμό. Η εκμάθηση του συγκολλητικού συστήματος της τουρκικής γλώσσας είναι μια συναρπαστική πρόκληση.",
  ),
  (
    Ell,
    Long,
    [5488527, 5525121, 5591571, 5524393, 5570434, 3251849],
    "Δε μ' αρέσει το κρασί. Της έκανε μασάζ στην πλάτη. Δεν μπορείτε να μας σκοτώσετε όλες. Πόσους ανθρώπους βλέπεις; Πείτε τους ότι θα θέλατε να φύγετε. Ο Ρωμύλος και ο Ρέμος ήταν αδέρφια.",
  ),
  (
    Ell,
    Long,
    [1663228, 9946647, 9946594],
    "Η τιμή του αυτοκινήτου είναι πολύ υψηλή. Η υπόθεση είναι πολύ βιαστική και δεν παίρνει αναβολή. Ο διευθυντής μεταχειρίστηκε πολύ άσχημα τη γραμματέα του, επειδή έκανε ένα μικρό λάθος.",
  ),
  (
    Ell,
    Long,
    [5581962, 4703668, 7971580, 14032678],
    "Θα πρέπει να περιμένουμε; Ο Τομ είναι φανερά έξυπνος. Τα αστεία του με σκοτώνουν πραγματικά. Το πρωί, τα αδέλφια Γιαν και Σοφία περπατούν δίπλα-δίπλα προς το σχολείο.",
  ),
  (
    Ell,
    Long,
    [9127078, 11475309, 9391699, 1315379],
    "Καθάρισε για λογαριασμό μας. Για περισσότερες πληροφορίες πάρτε αυτό το νούμερο. Ο Τζον έφυγε από την εταιρία και ξεκίνησε μια δικιά του. Το ρολόι μου πάει πέντε λεπτά μπροστά.",
  ),
  (
    Ell,
    Long,
    [13777861, 5418695, 13049992, 5475671],
    "Το διαμέρισμά μου είναι κοντά εδώ. Πρέπει να μ' αφήσεις να βοηθήσω. Η φύση είναι γενναιόδωρη φίλη. Αξίζει περισσότερη αγάπη από τους ανθρώπους. Είπα στον Τομ να μη χρησιμοποιήσει εκείνες.",
  ),
  (
    Ell,
    Long,
    [3003668, 10116152, 2753113],
    "Ο Μπιλ πηγαίνει για ψάρεμα κάθε δεύτερη μέρα. Εκείνη είναι η αίθουσα συνεδριάσεων, και αυτός είναι ο κοιτώνας. Δε μπορώ να φανταστώ την ζωή μου χωρίς εσένα.",
  ),
  (
    Ell,
    Long,
    [5357802, 7766317, 13464839, 5502720],
    "Μόνο αυτοί μπορούν να μας σώσουν. Μια αφελής αλεπού δεν υπάρχει. Αντίστοιχα, δεν υπάρχει αλάνθαστος άνθρωπος. Γιατί είναι ροζ η λίμνη; Θα ήθελα να το κρατήσω αυτό.",
  ),
  (
    Ell,
    Long,
    [10015640, 11889337, 13778917, 13283923],
    "Στις εννιά τα παιδιά θα πέσουν για ύπνο. Τι είδους ρούχα φοράνε οι διαιτητές; Η τουρκική γλώσσα αρχίζει να μου αποκαλύπτει τα μυστικά της. Μου αρέσει να διαβάζω βιβλία το βράδυ.",
  ),
  (
    Ell,
    Long,
    [4945505, 5565631, 11989151, 8239514, 1515749],
    "Έχεις μεγάλη οικογένεια? Πείτε του ότι είμαστε απασχολημένοι. Κάνει ακόμα κρύο το πρωί. Δεν ξέρω πια που είναι τα κλειδιά μου. Ο λογαριασμός μπορεί να πληρωθεί σήμερα.",
  ),
  (
    Ell,
    Long,
    [5607922, 5609833, 1383584, 9630710, 5521463],
    "Ο Τομ έφυγε για τη Βοστώνη. Αισθάνεσαι κουρασμένη; Ο πελάτης έχει πάντα δίκιο. Δεν έχουμε λεφτά για να ταξιδέψουμε με λεωφορείο. Ο Τομ πήγε τα παιδιά σχολείο.",
  ),
  (
    Ell,
    Long,
    [11660605, 5454454, 3228331, 3249364],
    "Το αφεντικό μου με σύστησε με γράμμα σε έναν από τους φίλους του. Ο Τομ νομίζει ότι η Μαίρη λέει ψέματα. Έχει κόκκινα λουλούδια. Αυτή έχει ζήσει όλη τη ζωή της σε αυτή τη πόλη.",
  ),
  (
    Ell,
    Long,
    [13682113, 1185942, 5523489, 10160690, 2918369],
    "Ούτε εγώ μπορώ να το βρω. Ο Τομ δε θέλει να μιλάει για την ιδιωτική του ζωή. Πώς είναι η σύζυγος; Αφού τύλιξαν το δώρο, του έβαλαν έναν φιόγκο. Στα δύο σου μπορούσες να μετράς μέχρι το δέκα.",
  ),
  (
    Ell,
    Long,
    [1383693, 1804889, 5454774, 9234150, 5514899],
    "Με χώρισε η κοπέλα μου. Ενεπλάκην σε ατύχημα. Ο Τομ θα συγχωρέσει τη Μαίρη. Η μπαταρία μου δεν παραμένει φορτισμένη για πολλή ώρα. Είστε πολύ εξυπνότερος από μένα.",
  ),
  (
    Ell,
    Long,
    [5595041, 2452297, 9177189, 5633398, 5603030, 5531515],
    "Αυτά τα δώρα είναι για σας. Γιατί δεν πηγαίνετε εκεί με τα πόδια; Φτάνει που σε θέλω εγώ. Θα 'στε ευτυχισμένοι. Παντρεύτηκα μια Καναδέζα. Χρειάζομαι μια κούπα ζάχαρη.",
  ),
  (
    Ell,
    Long,
    [1515755, 11653712, 5630123],
    "Το να μαθαίνεις ξένεις γλώσσες είναι βαρετό. Οι ημέρες της εβδομάδας είναι Δευτέρα, Τρίτη, Τετάρτη, Πέμπτη, Παρασκευή, Σάββατο και Κυριακή. Σου αρέσουν τα πορτοκάλια;",
  ),
  (
    Ell,
    Long,
    [1302817, 5410087, 5533527, 11193162, 1562514],
    "Κακό σκυλί ψόφο δεν έχει. Είστε σίγουρες ότι δε θέλετε να μιλήσω στον Τομ; Σήμερα είναι η επέτειος του γάμου μου. Ήμασταν στο σπίτι χθες. Αυτός είχε τρεις γιους που έγιναν δικηγόροι.",
  ),
  (
    Ell,
    Long,
    [5523448, 1611545, 5360536, 13360909],
    "Ο Τομ έχει δίδυμο αδερφό. Πως είναι η αδερφή σου; \"Νόμιζα ότι κοιμάσαι\". - \"Το ίδιο νόμιζα κι εγώ\". Ακόμα κι αν σταθείς στις μύτες των ποδιών σου, δεν μπορείς να δεις τίποτα.",
  ),
  (
    Ell,
    Long,
    [11348563, 11235505, 7864671, 1321435, 9444728],
    "Η περιπέτεια αρχίζει τώρα! Είδα πολλά όντας εκεί. Η Αλγερία βρίσκεται μέσα και κυριαρχεί στην καρδιά του Μαγκρέμπ. Πως πήγε το Σαββατοκύριακο; Έχω να μιλήσω με πολύ κόσμο.",
  ),
  (
    Ell,
    Long,
    [4938957, 9921658, 5527676, 5409949, 7762494],
    "Σε παρακαλώ μη με αγγίζεις. Η αστυνομία δεν πίστεψε την ιστορία του. Ο Τομ δεν μπορεί να δουλέψει αυτό τ' απόγευμα. Στον Τομ αρέσει να κοιμάται αργά. Νόμιζα ότι ο Τομ θα ερχόταν για ψάρεμα μαζί μας χθες.",
  ),
  (
    Ell,
    Long,
    [3127185, 2429656, 1521931, 9441026, 2161978],
    "Δεν μπορώ να πάω παρακάτω. Θα μπορούσα να έχω μία πίτσα παρακαλώ; Σας παρακαλώ πείτε του να περιμένει. Δεν δούλεψε το ξυπνητήρι; Ο Μάρκος δεν είναι τόσο ψηλός όσο ο Μάριος.",
  ),
  (
    Ell,
    Long,
    [1609618, 5517763, 5443768, 5409552, 4938986],
    "Απαντήσέ μου, σε παρακαλώ. Δεν μπορώ να δεχτώ το δώρο σας. Παρακολουθούσαν τηλεόραση. Ο Τομ άρπαξε την τσάντα του κι έφυγε. Αν είσαι λάθος, παραδέξου το. Αν είσαι σωστός, μη μιλάς.",
  ),
  (
    Ell,
    Long,
    [9757121, 2367461, 5615557, 2458881, 11234888, 8804976],
    "Βοηθήστε με να απλώσω τα ρούχα. Μείνε εδώ και περίμενέ τον. Ο Τομ θέλει να μείνει. Θα ήρθε, φαίνεται, ήδη. Ποια ομάδα ποδοσφαίρου είστε οπαδός; Έχετε επιπλέον χρήματα;",
  ),
  (
    Ell,
    Long,
    [11201463, 1287940, 9226341, 5565159, 9163090],
    "Θέλετε να αποθηκεύσετε το παιχνίδι πριν βγείτε; Γεια σου, πως είσαι; Δε χρειάζεται να εκνευρίζεστε. Δε μου αρέσουν τα ζώα. Ήταν απατηλό να προσποιείσαι πως δεν ήξερες για το ατύχημα.",
  ),
]

