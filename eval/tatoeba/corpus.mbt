    "Sikholwa ukuthi, njengoba kusho amaZulu, akukho ndlovu esindwa umboko wayo.",
  ),
  (Zul, Medium, [10946793], "Imithetho yethu iqinile kakhulu."),
  (
    Zul,
    Medium,
    [9208691],
    "Sinifisela uKhisimusi omuhle nonyaka omusha omuhle.",
  ),
  (Zul, Medium, [9208695], "Nina zingane ningabangi umsindo ongaka!"),
  (Zul, Medium, [9204337], "Ungazithola zonke izincwadi zikaNiki?"),
  (Zul, Medium, [9204366], "Bangaki abantu abafunda iphephandaba?"),
  (Zul, Medium, [3501564], "Ukugqugquzela abanye ngamasu amahle"),
  (Zul, Medium, [9210322], "Ngihlangane nomyeni wakho ezitolo."),
  (Zul, Medium, [9204328], "Lapha kulapho sibuka khona umabonakude."),
  (Zul, Medium, [9204371], "Kungabe idolo lakho libuhlungu?"),
  (Zul, Medium, [9204343], "Sawubona. Igama lami nginguJabu."),
  (Zul, Medium, [9210361], "Uhulumeni kufanele abheke izidingo zentsha."),
  (
    Zul,
    Medium,
    [9210329],
    "Uma imoto yakho yephuka ngokushesha, into yokuqala oyenzayo ukungenwa ingebhe.",
  ),
  (
    Zul,
    Medium,
    [9204591],
    "Bazokhokha malini ngalezi ziphuzo ezibandayo ezimbili?",
  ),
  (
    Zul,
    Medium,
    [9204545],
    "Ungazithola izimpawu zesonto lamaSulumani, isonto kanye nesinagogo?",
  ),
  (
    Zul,
    Medium,
    [9210382],
    "Izindiza azivamile ukuvunyelwa ukundiza endaweni engaphezu kwenkaba yedolobha.",
  ),
  (
    Zul,
    Medium,
    [4805150],
    "Burj Khalifa yibhilidi elide kwengca wonkhe emhlabeni.",
  ),
  (
    Zul,
    Medium,
    [9210374],
    "Umhlambi wamadube uqale ukubaleka ngesikhathi ubona kuza amabhubesi.",
  ),
  (
    Zul,
    Long,
    [9204382, 9208671, 3180923, 2887146, 10946826, 10946800],
    "Likuphi ikepisi likaJabu? Wena ukhulumisa okwesilima. Ngifuna ukuthenga incwadi. Ngifuna ukuhlala emaphandleni. Isisu sami sibuhlungu. Ngiyayithanda intombi yami.",
  ),
  (
    Zul,
    Long,
    [2887179, 9210316, 9210371, 2887158],
    "Ngingumfundi enyunivesini. Ngabe izingane zakho lezi? Uthe ebusheni bakhe, abantu abancane babesukumela abantu abadala ebhasini ukuze bahlale. Ngifuna ukuhlala enqabeni.",
  ),
  (
    Zul,
    Long,
    [2887389, 9204394, 9204765, 2887148],
    "Usebenzela isibhedlela. Iseduzane noxhaxha lwezitolo. Emuva kwesikhashana uqala ukufunda ngokucophelela okukhulu bese ubona okuqondwe umbhali. Ngifuna ukuhlala edolobheni.",
  ),
]

///|
let rows_swe : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Swe, Short, [5104690], "Hä av den!"),
  (Swe, Short, [922566], "Hon såg upp mot himlen."),
  (Swe, Short, [3834337], "Fågeln är i skyn."),
  (Swe, Short, [8668816], "Det är en utkik."),
  (Swe, Short, [9984952], "Jag steg upp sent i morse."),
  (Swe, Short, [2286000], "Tom väntar."),
  (Swe, Short, [869119], "Det här är lätt."),
  (Swe, Short, [12493001], "Jag gav Tom stryk."),
  (Swe, Short, [3004542], "Vad är växelkursen?"),
  (Swe, Short, [3790814], "Lär mig franska."),
  (Swe, Short, [11572438], "Jag är deprimerad."),
  (Swe, Short, [2271546], "Bilen täcktes i ett avgasmoln."),
  (Swe, Short, [1137692], "Min far lagade en trasig stol."),
  (Swe, Short, [2128768], "Det är nästan omöjligt."),
  (Swe, Short, [11089499], "Babyn heter Tom."),
  (Swe, Short, [2175067], "Det har slutat att regna."),
  (Swe, Short, [10664848], "Prästen välsignade oss."),
  (Swe, Short, [10197140], "Mary läser till barnmorska."),
  (Swe, Short, [3744402], "Det är ett stort företag."),
  (Swe, Short, [3745322], "Det här är deras hus."),
  (Swe, Short, [12337292], "Lita inte på någon!"),
  (Swe, Short, [2212610], "Han köpte plockgodis."),
  (Swe, Short, [10664891], "Det är en kam."),
  (Swe, Short, [3874227], "Tom kunde inte hjälpa oss."),
  (Swe, Short, [5926535], "Jag satt bredvid honom."),
  (Swe, Short, [2098280], "Jag vet hur det här funkar."),
  (Swe, Short, [1972808], "Han hade ett väldigt tålamod."),
  (Swe, Short, [3711764], "Vad hemskt."),
  (Swe, Short, [11916304], "Tom hatar att jogga."),
  (Swe, Short, [8600537], "Jag väntar barn."),
  (Swe, Medium, [10925505], "Han gör inte annat än klagar dagen i ända."),
  (Swe, Medium, [2147881], "Ser jag verkligen så sorgsen ut?"),
  (
    Swe,
    Medium,
    [3720754],
    "Vi var så illa tvungna att låta honom följa med.",
  ),
  (Swe, Medium, [4163711], "Genetiska sjukdomar är oftast obotliga."),
  (Swe, Medium, [10164561], "Han är den enda man jag någonsin älskat."),
  (Swe, Medium, [10161179], "Jag ber inte om ursäkt för någonting."),
  (Swe, Medium, [5524579], "Jag är inte hemma nästa söndag."),
  (
    Swe,
    Medium,
    [9445929],
    "Vi parkerade bilen i ett parkeringshus med gratis parkering.",
  ),
  (Swe, Medium, [2776088], "Katter finns i många olika storlekar."),
  (Swe, Medium, [5120837], "Ditt brev har nyss kommit fram."),
  (Swe, Medium, [3875463], "Du tycker om att diskutera arkitektur, eller hur?"),
  (Swe, Medium, [12347487], "Det är precis vad jag har behövt."),
  (Swe, Medium, [9117250], "Jag köpte fem meter tyg i affären."),
  (
    Swe,
    Medium,
    [4163260],
    "Fallskärmshopparen föll ner i havet och drunknade.",
  ),
  (Swe, Medium, [1988786], "Jag trodde inte att Tom faktiskt skulle prova det."),
  (Swe, Medium, [12100381], "Tom ville inte göra Mary besviken."),
  (Swe, Medium, [2266751], "Hon gråter alltid när han är full."),
  (
    Swe,
    Medium,
    [3873180],
    "Börja inte gråta nu. Jag börjar också när jag ser dig gråta.",
  ),
  (Swe, Medium, [3705519], "Jag hade en hamster vid namn Cookie."),
  (Swe, Medium, [3720783], "Alla bilar på gatan var lappade."),
  (Swe, Medium, [2043792], "Han visade mig massor av vackra bilder."),
  (
    Swe,
    Medium,
    [2114872],
    "Jag tror att det är osannolikt att Tom kommer till festen själv.",
  ),
  (Swe, Medium, [10661219], "Hon kommer att bli arg om hon inte vinner."),
  (Swe, Medium, [5883492], "Det är däremot inte så viktigt."),
  (Swe, Medium, [10660787], "Jag tror att det kommer att regna."),
  (Swe, Medium, [1138509], "Pojken som står vid dörren är min bror."),
  (Swe, Medium, [10110528], "Det finns inga skäl för att du ska skrika."),
  (Swe, Medium, [11068744], "Jag borde ha varit ärligare med Tom."),
  (Swe, Medium, [2171229], "De slog upp ett tält på en allmänning."),
  (Swe, Medium, [3837819], "Vill ni inte höra min syn på saken?"),
  (
    Swe,
    Long,
    [1988913, 12215876, 4451151, 2027043, 10956829, 3719060],
    "Det var riktigt roligt. Vi kanske aldrig ses igen. Vi ska hitta ett botemedel. Han blev ditsatt för mord. Det är en säker bank. Du har en timma på dig.",
  ),
  (
    Swe,
    Long,
    [2610120, 3830764, 5893449, 1988790, 5120820],
    "Självklart tycker jag om det. Se mig i ögonen. Annars betyder det ingenting. Jag kollar i källaren. Jag är faktiskt en väldigt bra förare. Jag orkar inte ta mig ner på stan.",
  ),
  (
    Swe,
    Long,
    [3923471, 4347252, 10003477, 929928, 9826677, 10104277],
    "Han sitter på en stol. Får jag äta den här tårtan? Det här är upprörande! Det värsta med sommaren är hettan. Tappa inte taget om repet. Ni må säga vad ni vill.",
  ),
  (
    Swe,
    Long,
    [3841238, 10077795, 2235394, 3834783],
    "Jag drack en kopp kaffe på ett café i Stockholm. Vi kan fly från allting, utom vårt samvete. Han lovade mig att vara mer försiktig i framtiden. ”Vad är det där?” ”Hur ska jag veta?”",
  ),
  (
    Swe,
    Long,
    [8399891, 6631448, 2025336, 9770337, 10597323],
    "Är du fortfarande uppe? Tom kan komma med dig om han vill. Jag känner mig inte sjuk. Jag tycker mycket om att se på fotboll på tv. Jag studerar franska och webbdesign.",
  ),
  (
    Swe,
    Long,
    [13881092, 5265554, 12244137, 3837679, 11909276],
    "Tyfonen slog till mot ön. De köpte ett hus på Parkgatan. Kroatiens huvudstad är Zagreb. Jag är tre timmar bort. Låt oss hitta en restaurang och äta något.",
  ),
  (
    Swe,
    Long,
    [2212862, 3889674, 4335622, 10712046, 4451098],
    "Deras konsert planeras bli en audivisuell upplevelse. Hon skriver alltid skrivstil. Jag målar ett påskägg. Giraffen satte sig ner. Vi tänker inte göra det.",
  ),
  (
    Swe,
    Long,
    [3835437, 7427772, 1647184, 5896020, 5783427, 3720748],
    "Jag vill äta kinesiska nudlar. Vi kör på Stockholms gator. Jag är inte alls trött. Jag anser att den är överflödig. Han är en riktig gentleman. De utbytte erfarenheter med varandra.",
  ),
  (
    Swe,
    Long,
    [12887344, 10152003, 10912759, 10693132, 2032104],
    "Python är ett programmeringsspråk. Vilken är den tyngre av de två? Naturgas är en viktig råvara. Jag älskar den här stolen. Jag önskar att jag hade en bil.",
  ),
  (
    Swe,
    Long,
    [1971382, 8955686, 3721171, 2088408, 2748925, 1435273],
    "Jag kan inte rädda dig. Achille föddes år 1908 i Paris. Kan vi höras av lite senare? Tom gjorde en bra putt. Du måste vara försiktig. Har du någonsin varit i utlandet?",
  ),
  (
    Swe,
    Long,
    [9419461, 3874178, 2193675, 2209893, 891888],
    "Ska vi promenera lite på stranden? Vi är vänner, eller hur? Har du kollat om vi har något bröd i frysen? Tom hade ingen anledning att vara arg. Jorden är ingen stjärna, utan en planet.",
  ),
  (
    Swe,
    Long,
    [8761430, 1964463, 1433496, 1969179, 2140291],
    "Jag är rädd för kackerlackor. Vad ska du göra på Halloween? De här blommorna är vackra, inte sant? Den här bilen går på alkohol. Han ville smickra mig.",
  ),
  (
    Swe,
    Long,
    [6592405, 1023188, 1998255, 4423923, 4391734],
    "Tom sa att han trodde Mary inte var trött. Jag förstår mig inte på musik. Jag kommer att berätta för dig. Det måste vara skrämmande. På den tiden kunde få människor resa utomlands.",
  ),
  (
    Swe,
    Long,
    [10950628, 10951899, 3721048, 6903727, 1968662],
    "Läs igenom instruktionerna noggrannt! Jag behöver en läkare. Till helgen ska jag försöka slå mig lös. Du får inte lämna mig! Under många år vände han på vartenda öre för att kunna spara pengar.",
  ),
  (
    Swe,
    Long,
    [4023061, 5133338, 2701177, 866393, 5912265, 12301144, 5264075],
    "Han är nästan tjugo år. Det var väldigt varmt. Jag ska till Paris i helgen. Han är inte en av oss. Han gillar att laga mat. Varför är gräset grönt? Jag tvättar mina äpplen.",
  ),
  (
    Swe,
    Long,
    [5926251, 2000113, 12065015, 5384829, 9812688],
    "Jag har inte särskilt mycket tid. Den här typen av smycken har inte mycket värde. Far tog plats vid bordets spets. Nähä, det är inte sant. Mitt hjärta slutade slå.",
  ),
  (
    Swe,
    Long,
    [1435124, 2668646, 4445082, 8789114, 11916090, 409711],
    "Han la handen på min axel. Någon stal mitt körkort. Tom är ute och går med hunden. Jag cyklar till jobbet. Saker och ting är under kontroll. Alla hästar är djur, men inte alla djur är hästar.",
  ),
  (
    Swe,
    Long,
    [3661591, 3721102, 6797747, 9819615, 7220907],
    "Din son är ihop med min dotter. Dörren till huset stod på glänt. Varför berättade du inte det för Tom? Det är din enda möjlighet. Varför går du så fort?",
  ),
  (
    Swe,
    Long,
    [4443745, 1216381, 11061725],
    "Det har inte alltid varit lätt. När en katt ligger och sover i ett rum finns det inte mycket mer för en inredare att göra där. Tom var väldigt stilig.",
  ),
  (
    Swe,
    Long,
    [6392153, 4319983, 2212637, 13884631, 3836917],
    "Jag menar det, från botten av mitt hjärta. Hur svårt skadad var Tom? Hur stort är deras arvode? Jag har inte slutat än. Vänlighet är det språk som de döva kan höra och de blinda kan se.",
  ),
  (
    Swe,
    Long,
    [3833492, 11061672, 10705866, 8924597, 8770173],
    "Ditt pass finns nu att hämta ut. Jag undrar om Tom fortfarande är singel. Hon är inte ansvarig för vad Tom har gjort. Varför gör ni så mot mig? Jag vill inte arbeta.",
  ),
  (
    Swe,
    Long,
    [2180566, 9696161, 3793867, 9943652, 10915731, 2046223],
    "Sista ansökningsdag är i övermorgon. Jag gillar verkligen inte Tom. Äntligen är vi två ensamma. Skicka fakturan hem till mig. Den här hinken läcker. Jag håller på att bli bättre.",
  ),
  (
    Swe,
    Long,
    [3011692, 8944975, 10507826, 10091308],
    "Min hund är mycket ren. Det är helt och hållet upp till er. Gatsoparbilen for nyss förbi på gatan. När jag gick på gymnasiet, vaknade jag klockan sex varje morgon.",
  ),
  (
    Swe,
    Long,
    [2096010, 10734572, 2654384, 9155800, 9768917],
    "Skulle du kunna lämna mig i fred? Är det för kallt för dig? Jag översätter programvaran. Markku fattade direkt att Liisa var finländare. Han är lång och elegant.",
  ),
  (
    Swe,
    Long,
    [1583136, 2455297, 1433461, 1666367, 4445968],
    "Jag har svarta ögon. Han greps för skattefusk. Det är ingen tvekan om vem som blir vald. Om du verkligen vill lyckas måste du tycka om att äta gift. Jag behöver en timme ledigt.",
  ),
  (
    Swe,
    Long,
    [2654797, 8969753, 4423385, 4357810, 7085052],
    "Jag skrev inte ett brev. Jag kommer inte att ta emot de presenterna. Tom och Mary åt upp hela tårtan själva. Får jag se något ID-kort? Allt är tack vare Tom.",
  ),
  (
    Swe,
    Long,
    [9817096, 893144, 9927614, 2108155, 3125136, 10957338],
    "De flesta engelsmän är konservativa. Jag är orolig för honom. Det är morgon här i min tidszon. Hans svar var idel invektiv. Nästa man till rakning! Ser ni de där bergen?",
  ),
  (
    Swe,
    Long,
    [892725, 10724599, 5887802, 10042779, 9115569],
    "Hon ville gifta sig omedelbart. Talar dina föräldrar franska? Bägge bröder lever än. Nu är det tid att säga godnatt. Välkommen, hur kan jag stå till tjänst?",
  ),
  (
    Swe,
    Long,
    [12426909, 11918475, 3889693, 4451039],
    "Jäst används för att göra bröd. Framtidsutsikterna är inte särskilt ljusa. Redan efter en liten stunds skrivande, börjar jag få ont i handen. Vi är ute efter samma sak.",
  ),
  (
    Swe,
    Long,
    [11164137, 5932176, 4407091, 9553902, 7085088],
    "Detta är bara ett exempel. Det låter som en omständlig process. Hon har läst alla Muminböcker. Min hobby är att läsa. Tom erkände inte Marias auktoritet.",
  ),
]

///|
let rows_lin : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Lin, Short, [10888976], "Ozalaka kaka mwana ya kimia."),
  (Lin, Short, [10827016], "Bonzenga na ye ekweyisi ye."),
  (Lin, Short, [10830646], "Tata akei koloba mbisi."),
  (Lin, Short, [10845531], "Nasepeli koyeba yo."),
  (Lin, Short, [10869287], "Na bozindo, ozali na elonga."),
  (Lin, Short, [10804453], "Mpuku moko akatisi na nzela."),
  (Lin, Short, [10835751], "Alekisi bomoyi naye nakolota."),
  (Lin, Short, [10842648], "Ezali mpo na mbongo te."),
  (Lin, Short, [10835385], "Pine izali na kati ya pine."),
  (Lin, Short, [10804362], "Grace atalaki ya esengo te."),
  (Lin, Short, [10833474], "Tolongaki lisano ya motopi."),
  (Lin, Short, [10845799], "Kobenga bapolisi te, ndeko !"),
  (Lin, Short, [10827151], "Nkake elamusaki ya na mpwasa."),
  (Lin, Short, [10863893], "Tinda bana bakende kolala!"),
  (Lin, Short, [10842799], "Eza likambo ya basi."),
  (Lin, Short, [10868739], "Tom azalaki kososola ngai."),
  (Lin, Short, [10833510], "Amikotisi na monoko ya ngando."),
  (Lin, Short, [10835575], "Eleko ya bokila efungwami."),
  (Lin, Short, [10837439], "Gin azali moninga na ngai te."),
  (Lin, Short, [10877877], "Tom akosala yango na ngonga."),
  (Lin, Short, [10863234], "Nakoki koyeba esika bosalaka?"),
  (Lin, Short, [10837695], "Olingi komela kopo ya soda ?"),
  (Lin, Short, [10844973], "Nayebi ete ozali kobanga te."),
  (Lin, Short, [10804350], "Anne alingi sokolá mingi."),
  (Lin, Short, [9531683], "Ekoki tɛ́ !"),
  (Lin, Short, [10844918], "Nakosepela koyemba mpo na yo."),
  (Lin, Short, [10804449], "Na bilembo, kotala, kende!"),
  (Lin, Short, [10826954], "Nakozela awa kino akozonga."),
  (Lin, Short, [10837930], "Atindamaki na bitumba."),
  (Lin, Short, [10848599], "Tokokisaka maloba nabiso."),
  (
    Lin,
    Medium,
    [10827656],
    "Moto ya bonyama ayibaki ngai mabanga na ngai ya talo mpe akimaki.",
  ),
  (
    Lin,
    Medium,
    [10858504],
    "Ezalaki pete pona kososola, nasosoli likambo nyonso.",
  ),
  (
    Lin,
    Medium,
    [10850314],
    "Nazalaki na motema munene nayango ezalaki pete pona basokisa ngai motema.",
  ),
  (
    Lin,
    Medium,
    [10835358],
    "Nazali M. Tanaka, mozalani nayo ya sika. Nasepeli koyeba yo.",
  ),
  (
    Lin,
    Medium,
    [10835353],
    "Nazali kaka mwana mobali oyo asalaka mabunga mingi.",
  ),
  (
    Lin,
    Medium,
    [10865979],
    "«Bobalani, na moninga na yo? » « te. » «Ah malamu? Nakanisaka ete ee. »",
  ),
  (Lin, Medium, [10845422], "Esengeli na Bobby alala na 7h 30."),
  (Lin, Medium, [10886651], "Landa ba mitu ya baanonce soki ozoluka mosala."),
  (
    Lin,
    Medium,
    [10848618],
    "Nabeti mondenge ete ozali komituna lolenge etambwisamaka.",
  ),
  (Lin, Medium, [10896537], "Nayebi ndenge mosusu te ya kosala."),
  (
    Lin,
    Medium,
    [10845794],
    "Obosanaka kotindela mama nayo libonza ya eyenga ya mbotama te.",
  ),
  (
    Lin,
    Medium,
    [10855149],
    "Nakanisi ete Emi ako tarder te. Nazali awa kozela ye.",
  ),
  (
    Lin,
    Medium,
    [10831542],
    "Bolingo oyo ezali na bosolo ya makasi esimbaka te.",
  ),
  (Lin, Medium, [10839720], "Muana muke kitoko mpeza. Mbote!"),
  (
    Lin,
    Medium,
    [10863444],
    "Bomeka te ko zipa mapata nyonso na makata ya maboko na bino.",
  ),
  (
    Lin,
    Medium,
    [10837260],
    "Tokoki kobenga nsolo oyo malasi te mpo ezali nsomo mabe.",
  ),
  (Lin, Medium, [10842726], "Soki nayebisi yo, esengelaki naboma yo."),
  (Lin, Medium, [10842685], "Mike mpe Tom bazali na kelasi moko."),
  (
    Lin,
    Medium,
    [10865997],
    "Na pukwa ya lelo, ngai nde Charlie, nazali pulusi.",
  ),
  (
    Lin,
    Medium,
    [10831466],
    "Okanisi ete okoki kosakana na ngai ? Yaka awa, natanda yo mbata.",
  ),
  (
    Lin,
    Medium,
    [10886815],
    "Ozali na elikya nyonso te ete olingi okoma kino lobi te?",
  ),
  (Lin, Medium, [10848488], "Diamba pona kobikisa endingisami na Mbula matari."),
  (Lin, Medium, [10850213], "Alambi nyama ya ngulu ya kokata mpona elambo."),
  (
    Lin,
    Medium,
    [10858517],
    "Kitty azali na mibu 12 kasi ayebi kaka kotanga te.",
  ),
  (
    Lin,
    Medium,
    [10835809],
    "Osengeli otosa molongo ya molulu mpe omikokisa na elembo etiyama.",
  ),
  (
    Lin,
    Medium,
    [10815617],
    "Moto moko na nkombo ya M. Brawun alekaki ko tala tango ozalaki te.",
  ),
  (
    Lin,
    Medium,
    [10853495],
    "Nazali na bwanya ya kopesa eyano na mitungisi ya bato.",
  ),
  (
    Lin,
    Medium,
    [10845758],
    "Bolimbisi na motungisi, bazali kobenga yo na telefone.",
  ),
  (Lin, Medium, [10827492], "Ndeko-muasi Green atunaki ngai mituna mibale."),
  (
    Lin,
    Medium,
    [10891917],
    "Amiral, masuwa mayebani te mazali kopusana na etemeli na biso.",
  ),
  (
    Lin,
    Long,
    [10831139, 10842676],
    "Moto ya liboso oyo akobandela koloba yango lisusu epayi ya mwasi na ngayi, nakoboma ye, boyoki? Mosisa ya fololo ezalaka na bolembu nyonso lokola mosapi ya mwna moke oyo abotami sika.",
  ),
  (
    Lin,
    Long,
    [10827353, 10886990],
    "Tozali kotangaka biso mibale bibiliya moyi mpe butu, kasi ozali kotanga mwindo esika nazali kotanga mpembe . Eloko moko te eleki ngonga ya sikoyo, soki oyoki wana nde ndelo oyo ekaboli lobi oyo eleka na lobi oyo ekoya.",
  ),
  (
    Lin,
    Long,
    [10898690, 10835514],
    "Mama wa ngai ya bolingo, nakozala na posa ya ba toli nayo pembi ya mbotama ya muana na ngai. Soki esengeli tobenga mboka na mboka na nkombo oyo toyokaka bato balobaka mingi, Angleterre elingaki ebengama “damn it”.",
  ),
  (
    Lin,
    Long,
    [10877522, 10859149, 10826926, 10863814],
    "Mongongo moye lokola nayebi yango malamu. Mitango mibale ya yambo ya elembo ya posita nayo bizali nini? Esengelaki andima etinda na ye. Soki oloni mbuma ya pomme lobi ekoki kokoma nzete.",
  ),
  (
    Lin,
    Long,
    [10837765, 10889610, 10877521],
    "Na njombo : « Eh malamu, bolingo nangai, ozo zala nini? » Thomas abwakaki bilamba na ye na kitunga ya bilamba ya salite. Na sengi bolimbisi pona oyo elekani awa.",
  ),
  (
    Lin,
    Long,
    [10886308, 10850345],
    "Kopesa bondeko na moto oyo alingi bolingo, ezali lokola kopesa lipa na moto oyo azali kokufa na posa ya mayi. Kosenga na bana kelassi baya kotanga na France na lokota ya Anglais ezali likanisa ya buzoba oyo naino nayoka te.",
  ),
  (
    Lin,
    Long,
    [10859033, 10842144, 10848012, 10847700],
    "Ayebaki ete ezaleli na ye ezalaki ya bozoba. Naboyi koyanola motuna ya buzoba. Tozalaka kopusana mokolo na mokolo. Moto azali awa, na kelasi, oyo ayoki koloba na ntina ya Norman Finkelstein ?",
  ),
  (
    Lin,
    Long,
    [10863227, 10834055, 10844981],
    "Nabotamaki awa te kasi nalekisaki bomwana na ngai nyonso awa. Soki botali na bokebi nyonso, bokomona ete linzanza ezali na biteni mibale. Nakanisi ete olobani ete okoki koliya mbisi ya mobeso te.",
  ),
  (
    Lin,
    Long,
    [10845440, 10804379, 10831221],
    "ba soda ebele basilaki kozoka ntangu ya bitumba. Julia azwi mokanda ya Noel ewuti epayi ya ndeko na ye ya mobali azalaka na mboka Italie. ba Allemands bayebi ndenge ya ko sala maseki te ? Ezo sepelisa ngai lisusu ata moke te !",
  ),
  (
    Lin,
    Long,
    [10842289, 10850459, 10835830],
    "Nasuka ya mbebu naye bilembo ya bleu ezali mpe ezali kotungisa minganga. Nabanzi ete oyebi eloko ya nsuka oyo nakoki kosala ezali kozokisa yo. Nazomituna esika nini natiye maillot de bain !",
  ),
  (
    Lin,
    Long,
    [10804428, 10898231, 10831238, 10831047],
    "Martha azali mobeti monene ya piano. Wana nde nyonso tokoki kosala sikawa. Etaleli ya miso ya bana popi ebangisaka ngai. Okozwa likambo soki likangu na yo ayoki bosolo.",
  ),
  (
    Lin,
    Long,
    [10886848, 10845520, 10831472, 10845848],
    "Tango tolalaka, moto ya nzoto ekitaka na ba degré moke. Nakotala, elokomoko te ekoki kosalema lelo. Tosengi na yo obeta yambo ya kokota na zongo. Ekozala malamu kokende koluka lisungi.",
  ),
  (
    Lin,
    Long,
    [10881147, 10898701, 10827704],
    "Lobi eleki nalandaki filime allemand moko na lolenge na yango ya liboso na pologalame ya Arte. Alongolaki lisukulu na ye na kasete. Sala mabungutulu ya satimetele misato mpe tiya yango likolo ya nkasa ya aliminium ya mpembe batiya manteka.",
  ),
  (
    Lin,
    Long,
    [10863546, 10872121],
    "Baboti ya Nora baza na ntuku nsambo ya mbongo ya banki. Lokola Marika azali wana te mpe azali na ntina te ya kokutana lisusu na yo, ekozala malamu obosana ye.",
  ),
  (
    Lin,
    Long,
    [10837474, 10837922, 10831491],
    "Kotika imbwa na yo na bozenga te soko olingi akangama na yo. Okomeka mbala mingi, eyano ekozala kaka motindo moko. Mwasi atelemaki na kiti. Mpe atalaki na ngambo ya ekuke.",
  ),
  (
    Lin,
    Long,
    [10886235, 10896475, 10872926],
    "Motema ya cyclone ekobeta ngele ya Floride. Uto tokotaki na babilo eye ya sika, esengeli na yingela na baengunduka misatu po na koya mosala na tongo. Momekano ezala mpasi mingi na tina ete moto moko te akokaki kosilisa yango.",
  ),
  (
    Lin,
    Long,
    [10855191, 10886862, 10804410],
    "Libota ba ndimaki na boboto nyonso koyanola mituna ya molukiluki. Osengeli ko meka pizza Chicago ya poso monene. Mbula moko eleki Tata pe Mama Davis babyangemaki na butu ya eyenga ya mbotama ya Yesu na lotele.",
  ),
  (
    Lin,
    Long,
    [10848656, 10833489, 10872092, 10896169],
    "Azali kokomela makango na ye mwa nsango. Nayoki makelele ya mabe koyaka na garage. Ntango azalaka na likanisi, akendeke na yango esika mosusu te. Bosengeli kobimisa banyama baye na ndako ya bibwele.",
  ),
  (
    Lin,
    Long,
    [10833389, 10880785],
    "Limpinga ezali na ebateli moko ya liboso, ebeteli moko ya nsima mpe monene ya limpinga. Soki ba tambolisi nga na likolo ya mobali, bako simba nga na lotomo te.",
  ),
  (
    Lin,
    Long,
    [10845646, 10872799, 10893877],
    "Ebikeli ekeseni na oyo ekoya na maye tozalaki kozila. Ekozala motuya mpo na biso soki totiki maye mazali mpe tobandeli nyonso biso moko. Babalanaki mpe babotaki bana mingi.",
  ),
  (
    Lin,
    Long,
    [10858545, 10898624, 10837860],
    "Ezalaki lolango kotambola na nse ya pole ya sanza. Bana mapasa bakabolaki bango na mbotama mpe bakolisamaki na mabota ekeseni. Tata azalaka koloba ete ya motuya koleka ezali ete nazala nabomoyi.",
  ),
  (
    Lin,
    Long,
    [10814397, 10889243, 10815610],
    "Anetolamaki na molongo ya colonel eleki mibu mibale. Kunzi Karnavon azalaki motangi ya mambi ma Ejipito ya kala. Nakolinga nasala mombongo ya libanda ekolo na mikolo mikoya.",
  ),
  (
    Lin,
    Long,
    [10875381, 10833345, 10833635],
    "Naino na silingwi te kokota na bolingo ya solosolo. Zunale ya lelo elobi ete moyangeli ya yambo atikaki makanisi ya kokende kotala Etats-Unis. Zela mwinda ya langi ya mayi ya pondu epela liboso ya kokatisa.",
  ),
  (
    Lin,
    Long,
    [10853015, 10827765],
    "Nasepeli kotika ba lido polele mpo ekotisa mwinda ya sanza. Mokambi ya mabi ma boluki atindaki departement na ye esala batesti nyonso ya produit ya sika bazali kobimisa.",
  ),
  (
    Lin,
    Long,
    [10827255, 10886821, 10842360],
    "Basalelaka ba pointiye mpo na modeli, mpe batrait oyo elandami mpo na bosolo. Nazali na elikya ete okomona ete bato bazali ya kolemba epai na ngai ? Esengeli osenga bolimbisi epayi ya tata na yo mpona kozonga sima ya ngonga ya bileyi ya mpokwa.",
  ),
  (
    Lin,
    Long,
    [10831105, 10837273, 10833484],
    "Pimbwa lokolo ya ekelamu pona ko boma yango. Nsango ya liwa ya mwana na ye ya mobali ekataki ye motema. Akeyi na lombango kozanga kosenge mbongo ya sanze.",
  ),
  (
    Lin,
    Long,
    [10833392, 10869198, 10835919, 10833490],
    "Moko te asengeli kobunga mobeko. Okoki kopesa ngai mungwa, soki olingi ? Mituna mibulunginisaki motatoli. koleka 90 pour cent ya bapaya bayebaka bisika bawuta o nzela etando ya boluki.",
  ),
  (
    Lin,
    Long,
    [10804344, 10826924],
    "Biloko nyoso na bokokani bisika mosusu, eyano ezali malamu koleka ndenge na likyaki. Ba voisins bazali Pomona ete exila ya boyambi mikanda ezali polele te.",
  ),
  (
    Lin,
    Long,
    [10850279, 10835899, 10863883],
    "Makomi lya toki eye mokomi ye mei atangaki na mongongo makasi esepelisaki mingi penza. Ezali na boyokani moko ya motuya kati na bikolo oyo mibale. Po na ngai, koyemba na kobina ezali na tina makasi.",
  ),
  (
    Lin,
    Long,
    [10886864, 10815643, 10834068],
    "Bozali kotuna mituna mingi, hein. Awa abungi nzela na ye, aponi kaka nzela bongo bongo. Nazalaki na mbula libwá ntangu na tunaki mama na ngai soki Père Noël azalaki ya solo.",
  ),
]

