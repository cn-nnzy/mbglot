  ),
  (
    Yor,
    Medium,
    [3352025],
    "Ẹ̀gbẹ́ táa máa fi sùn lálẹ́, kò yẹ ká fi gbọgbẹ́ lọ́ọ̀sán.",
  ),
  (
    Yor,
    Medium,
    [11984202],
    "Lọ́jọ́ jímọ̀ la lọ sí mọ́ṣálásí.",
  ),
  (
    Yor,
    Medium,
    [3352030],
    "Ẹni tó bá ńjẹ nínú ọlà ẹnìkan nií pèé ní anímáṣaun.",
  ),
  (
    Yor,
    Medium,
    [11984199],
    "Mo lọ sí mọ́ṣálásí lọ́jọ́ jímọ̀.",
  ),
  (Yor, Medium, [4266589], "Burj Khalifa je agbar tó ga ju ni gbògbó ayè."),
  (
    Yor,
    Long,
    [3143483, 11984218, 11984710, 11984215, 11984181, 11984165, 3633484],
    "Ẹṣin yìí jẹ́ funfun. Mo ń kọ́ èdè Yorùbá. Ṣé mo ní láti lọ síbẹ̀? Mo wá síléèwé wọkọ̀ kẹ̀kẹ́. N kò lọ síléèwé lánà. Ó jẹ́ ọmọ ilẹ̀ Potogí. Mi ò fẹ́ lọ sí ilé-ẹ́kọ́.",
  ),
  (
    Yor,
    Long,
    [11984222, 3143485, 11984198, 11984182, 11984456, 3713991, 3143486],
