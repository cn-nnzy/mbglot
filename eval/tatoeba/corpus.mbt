  (
    Urd,
    Long,
    [10812584, 12902431, 12032548, 12449540, 1450556],
    "کیا تو بہار کے لیے تیار ہے؟ اسٹریلیا میں کیا کیا دیکھا؟ کیا میں نے اس کا صحیح ترجمہ کیا؟ آپ لوگ جرمنی کب منتقل ہو رہے ہیں؟ مجھے ایک کشتی چاہئیے جو مجھے یہاں سے دور لے جائے۔",
