let rows_plt : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Plt, Short, [6672761], "Alako ny ririnina."),
  (Plt, Short, [1674452], "Mandrosoa tompoko ô!"),
  (Plt, Short, [9527939], "Mila fehezanteny feno izahay."),
  (Plt, Short, [13204659], "Tsy manana Papa isika!"),
  (Plt, Short, [4050839], "Iza ny anaranao?"),
  (Plt, Short, [1674409], "Fahasalamana?"),
  (Plt, Short, [1674441], "Nalahelo anao aho."),
  (Plt, Short, [3698029], "Tsara mandry!"),
  (Plt, Short, [7816569], "Mety hahafaty izany."),
  (Plt, Short, [3982552], "Moa tia ny reninao?"),
  (Plt, Short, [3418715], "ts izy ahoana e!"),
  (Plt, Short, [13293500], "marahaba antsika rehetra"),
  (Plt, Short, [9568218], "Tsy noana aho."),
  (Plt, Short, [1674443], "Inona ny vaovao?"),
  (Plt, Short, [1674429], "Ary ianao?"),
  (Plt, Short, [3667082], "Misy nosy ao anaty ranomasina."),
  (Plt, Short, [11444609], "Inona no hitanao mampihomehy?"),
  (Plt, Short, [7816568], "Afaka ataoko tsara ny asa!"),
  (Plt, Short, [1674437], "Tsy dia tena tsara loatra."),
  (Plt, Short, [7816562], "Tsy mampino!"),
  (Plt, Short, [11797037], "Firenena nosy i Madagasikara."),
  (Plt, Short, [3153479], "Tsy fotsy ny soavaly."),
  (Plt, Short, [1674392], "Manao ahoana e!"),
  (Plt, Short, [9568211], "Noana aho!"),
  (Plt, Short, [9770666], "Dony tampany handoa erany."),
  (Plt, Short, [12228940], "Maty izy valo taona lasa izay."),
  (Plt, Short, [1674439], "Ela tsy nihaonana!"),
  (Plt, Short, [1674435], "Tsy dia tsara."),
  (Plt, Short, [12690503], "Mpampianatra aho."),
  (Plt, Short, [7816561], "Azafady..."),
  (Plt, Medium, [1674459], "Mirary anao tontolo andro mahafinaritra!"),
  (
    Plt,
    Medium,
    [7918826],
    "Iray, roa, telo, efatra, dimy, enina, fito, valo, sivy, folo.",
  ),
  (
    Plt,
    Medium,
    [3884859],
    "Ny Burj Khalifa ankehitriny no tena trano avo indrindra amin'izao tontolo izay.",
  ),
  (Plt, Medium, [1674464], "Tsara mandry dia manaova nofy tsara."),
  (Plt, Medium, [2222544], "Manidina toy ny tsipika ny fotoana."),
  (Plt, Medium, [7816571], "Tsy izaho irery no nanoratra iny taratasy iny."),
  (Plt, Medium, [11444688], "Tsy azoko hikatona tsara ny varavarana."),
  (Plt, Medium, [7816570], "Aza matahotra ny hihaona amin'ny olona vaovao."),
  (Plt, Medium, [1674400], "Faly miarahaba anao, ra-namana!"),
  (Plt, Medium, [11444982], "Efa nisy nilaza taminao ve ny hatsaranao?"),
  (Plt, Medium, [5324424], "Ny sokatra dia tsy manana nify."),
  (Plt, Medium, [3843887], "Dibera dia vita amin'ny ronono."),
  (
    Plt,
    Long,
    [13293503, 5324425, 12228930, 3755168, 11866422, 1674505],
    "miarahaba ihany koa ireo Ny sokatra dia tsy misy nify. Hividy ilay boky ianao anio. Fa maninona ianao no kamo? Namaly ny fanontaniana izy. Iza moa kay no anaranao?",
  ),
]

