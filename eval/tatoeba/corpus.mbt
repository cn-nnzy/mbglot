  (Amh, Short, [3764070], "እኔም አስተማሪ ነኝ።"),
  (
    Amh,
    Short,
    [3085375],
    "በዚህ ሆቴል ውስጥ ባዶ ክፍል አለዎት?",
  ),
  (
    Amh,
    Medium,
    [2722289],
    "ባለፈው ሳምንት ከአሜሪካ አንዳንድ ማስታወሻ ላኩለት።",
  ),
  (
    Amh,
    Medium,
    [3982309],
    "በአሁኑ ወቅት ቡርጅ ከሊፋ የአለማችን ረጅሙ ሰማይ ጠቀስ ሕንጻ ነው።",
  ),
  (
    Amh,
    Medium,
    [4451457],
    "የእናት ቋንቋዬ ከእናቴ የተቀበልኩት በጣም ደጉ በረከት ነው።",
  ),
  (
    Amh,
    Medium,
    [13102671],
    "ሶፍትዌሩን ወደ የቅርብ ጊዜው ስሪት አዘምነዋለሁ።",
  ),
  (
    Amh,
    Long,
    [12403690, 13987194, 3206724, 3466632],
    "የትኛውን ቋንቋ መማር ይፈልጋሉ? የኤስፐራንቶ ቀን በዓለም ዙሪያ በየዓመቱ የሚከበረው የመጀመሪያው መጽሐፍ ስለ ኤስፐራንቶ ሐምሌ 26፣ 1887 የታተመበትን ዓመት ለማክበር ነው። ልጆች የሕይወታችን አበባዎች ናቸው። ወደ ትምህርት ቤት መሄድ አልፈልግም።",
  ),
  (
    Amh,
    Long,
    [3085606, 12403698, 4897529, 6804707, 3316506, 12403457, 12344096],
    "በሁለት ሰኣት ውስጥ፣ ወደ ቤት እንመጣለን። የትኛውን ቋንቋ መማር ትፈልጋለህ? ወደ አዲስ አበባ መቼ ነው የምትሄጂ? እንኳን ለአለም አቀፍ የሴቶች ቀን አደረሰን የምትሄደው በተሳሳተ አቅጣጫ ነው። ወላንዶን ማብረር አደገኛ ሊሆን ይችላል። ይህ ይዘት በእርስዎ አገር ውስጥ አይገኝም።",
  ),
  (
    Amh,
    Long,
    [12975503, 3316135, 12403475, 3143562, 3085371, 9145954, 12119908],
    "እህቶቼ ስለ ሳይንስ ማውራት ይወዳሉ። አነጋግሬ ለየት ያለ ሊሆን ይችላል። ፎክስ ቲቪን እየተመለከትኩ ነው። ልጁ ይህች ቆንጆ ልጃገረድን ይወዳል። ከቤቱ እስከ ባቡር ጣቢያ ድረስ ሄደ። ወደፊት ይህዱና ወደ ግራ ይዙሩ። ለንደን ውስጥ ለሁለት ሳምንታት ቆየን።",
  ),
  (
    Amh,
    Long,
    [3642774, 9145950, 13621473, 3783762, 12975489, 3085600, 3316301],
    "ወደ ትምሕርት ቤት እየሄድኩ ነው። ያሜሪካን ኤምባሲ በስተቀኝዎ ነው። የትግሬ ቋንቋ ለመማር ቀላል ነው። እኔም ወደ ትምህርት ቤት እየሄድኩ ነው። ሁሉም ሰው እንግሊዝኛ ይናገራል። እርስዎ ወደ አዲስ አበባ መቸ ይሄዳሉ? እንደማምነው ከሆነ ስህተት አለ።",
  ),
  (
    Amh,
    Long,
    [4451453, 12403675, 2722308, 12403452, 12405455, 12405456, 12403461],
    "ቦስቶን ውስጥ ለመጉብኘት ብዙ ቦታዎች አሉ። ሳድግ አስተማሪ መሆን እፈልጋለሁ። ቶም ብዙ ጊዜ ከውሻው ጋር ይናገራል። አዲስ የጊዜ ማሽን መግዛት እፈልጋለሁ። ሴቶቹ በቤት ውስጥ ይሠሩ ነበር። ሴቶቹ በቤት ውስጥ ይሰሩ ነበር። አንካራ የቱርክ ዋና ከተማ ነች።",
  ),
]

