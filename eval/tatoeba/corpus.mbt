let rows_spa : Array[(@mbglot.Lang, Length, Array[Int32], String)] = [
  (Spa, Short, [2624631], "Tom se quedará."),
  (Spa, Short, [13024729], "No ganaré."),
  (Spa, Short, [5967486], "Se lo doy."),
  (Spa, Short, [6701272], "Soy el campeón del equipo."),
  (Spa, Short, [2118794], "No puedes matarnos a todos."),
  (Spa, Short, [4444219], "¡La guerra continúa!"),
  (Spa, Short, [463257], "Este niño es de Columbia."),
  (Spa, Short, [1391587], "Este periódico es de ayer."),
  (Spa, Short, [5161205], "Para. No quiero hacerlo."),
  (Spa, Short, [10188681], "Me equivoqué de fecha."),
  (Spa, Short, [10008974], "Éramos una piña."),
  (Spa, Short, [2717838], "¿Cuántas cestas tiene él?"),
  (Spa, Short, [10306717], "Tú eres de Grecia."),
  (Spa, Short, [5017250], "Mi novio es muy piropeador."),
  (Spa, Short, [13721581], "Esto tiene su intríngulis."),
  (Spa, Short, [11932398], "Timotea es una rompecorazones."),
  (Spa, Short, [6810689], "No voy a repetirme."),
  (Spa, Short, [2675869], "Lo buscamos en el diccionario."),
  (Spa, Short, [11713087], "¿Durmieron ustedes mejor?"),
  (Spa, Short, [4637588], "Están filmando una película."),
  (Spa, Short, [7934554], "¿Dónde está vuestro hijo?"),
  (Spa, Short, [1038653], "No quité el ojo de su maleta."),
  (Spa, Short, [13005771], "Yo no poseo paraguas."),
  (Spa, Short, [4318012], "¿Qué le pasó a tu pie?"),
  (Spa, Short, [11875535], "Intenté escribir un poema."),
  (Spa, Short, [1446545], "La natación es saludable."),
  (Spa, Short, [482571], "Tráeme mis gafas."),
  (Spa, Short, [1431935], "Ese es un bello poema."),
  (Spa, Short, [2872850], "Ayer los vimos en el teatro."),
  (Spa, Short, [537851], "Él intentó levantarse."),
  (
    Spa,
    Medium,
    [2857691],
    "No se puede usar esta mesa porque le falta una pata.",
  ),
  (Spa, Medium, [6477327], "No me avergüenza decir que lloré."),
  (
    Spa,
    Medium,
    [2073510],
    "Asegúrese de que los genitales están ocultos con un efecto mosaico.",
  ),
  (
    Spa,
    Medium,
    [2183395],
    "Ellos llamaron a Mary para decirle que llegarían tarde.",
  ),
  (Spa, Medium, [344046], "Fuiste muy amable de prestarle el dinero a él."),
  (
    Spa,
    Medium,
    [13426224],
    "A estas alturas ya no hay arrepentimientos que valgan.",
  ),
  (
    Spa,
    Medium,
    [11582446],
    "Tengo dos hermanos mayores, pero los dos están estudiando en el extranjero.",
  ),
  (Spa, Medium, [1993030], "No juzgues a una persona por su apariencia."),
  (
    Spa,
    Medium,
    [10078903],
    "Quiero aprender a decir algunas palabras en alto sorabo.",
  ),
  (Spa, Medium, [5967459], "Sería bueno que lo recordarais."),
  (Spa, Medium, [1466864], "Tu sueño algún día se volverá realidad."),
  (Spa, Medium, [2130810], "En una recta existen infinitos puntos."),
  (Spa, Medium, [3390133], "No quiero que Tom oiga de esto."),
  (Spa, Medium, [10885979], "La fricción hace que una cerilla se encienda."),
  (Spa, Medium, [8289879], "No le dije a Tom que ya estaba casado"),
  (
    Spa,
    Medium,
    [11462902],
    "Si un amigo te abandona en una emergencia, esa persona no es tu amigo de verdad.",
  ),
  (Spa, Medium, [6296530], "Bueno es pan, y mejor, con algo que agregar."),
  (Spa, Medium, [8018415], "A Linda le gusta mucho el chocolate."),
  (Spa, Medium, [1638692], "Debes trabajar duro para triunfar."),
  (
    Spa,
    Medium,
    [13417704],
    "Una palabra de aliento es más efectivo qué la coerción.",
  ),
  (Spa, Medium, [4779002], "Tomás simplemente no quería verme."),
  (Spa, Medium, [1711415], "Él retiró el último dólar de sus ahorros."),
  (Spa, Medium, [9477937], "Si te pega un resfriado me van a echar una bronca."),
  (Spa, Medium, [1120226], "Dos ladrones entraron en una tienda."),
  (
    Spa,
    Medium,
    [1102640],
    "Me he hecho las gafas en la mejor óptica de la ciudad.",
  ),
  (Spa, Medium, [2173813], "Si ocurre de nuevo, queremos estar preparados."),
  (
    Spa,
    Medium,
    [1699065],
    "La clase se componía de 15 niños y muchas niñas.",
  ),
  (Spa, Medium, [13920079], "Necesito retirar dinero del cajero automático."),
  (
    Spa,
    Medium,
    [13655697],
    "El inesperado impacto del balón la dejó conmocionada durante unos minutos.",
  ),
  (Spa, Medium, [7666614], "No he recibido ninguna respuesta."),
  (
    Spa,
    Long,
    [10154400, 11849487],
    "La osa destrozó a cuatro lobos con sus enormes garras mientras defendía a su cría. Los diseños de personajes de Alex Toth para Hanna-Barbera siempre me han resultado fascinantes.",
  ),
  (
    Spa,
    Long,
    [1275954, 7908062, 13718046],
    "Mi abuela vivía con nosotras. Fabiola me explicó que la sal está corroyendo lentamente a la Gran Esfinge de Guiza desde dentro. ¿Esto está aquí para tirarlo?",
  ),
  (
    Spa,
    Long,
    [1713336, 1805500, 1193341, 732586, 652503],
    "No lo sujetes boca abajo. ¡Deja de ser tan idiota! Oí cómo ella lloraba en mitad de la noche. Esta montaña está cubierta de nieve todo el año. He oído hablar que el inglés es para el comercio, el francés para el amor, y el español para rezar a Dios.",
  ),
  (
    Spa,
    Long,
    [10332319, 3100847, 6795718, 1346203, 1439696],
    "Dejé mi tarea en la escuela. Todo es culpa de Tom. No me gusta su pelo. Eso es lo peor que podría suceder. Tom estaba profundamente dormido cuando Mary entró a la habitación.",
  ),
  (
    Spa,
    Long,
    [10077067, 1721166, 1672417],
    "¿\"Sólo\" sigue siendo una palabra en español? Su hermana no puede hablar con usted hoy. El instinto de supervivencia es propio de todos los seres vivos.",
  ),
  (
    Spa,
    Long,
    [3407210, 1276077, 7317803, 2454392, 1228271],
    "Boston está sobrevalorado. ¿De quién es esta cámara? ¿Ha sido de su agrado? No quiero ir a ningún lado esta noche. Mamá está en la cocina haciendo galletitas de crema.",
  ),
  (
    Spa,
    Long,
    [587332, 5084152, 1593504, 8624773],
    "En la Rusia soviética, ¡las frases te escriben a ti! Suelo echar el dinero suelto en el cajón del escritorio. Ella tiene una cara bonita. La alegría y la moderación son los mejores remedios.",
  ),
  (
    Spa,
    Long,
    [6568642, 1937818, 7908198, 11965800, 5015522],
    "Me hice dieciséis largos en la piscina. La verdad es que ella es lesbiana. Los chicos a veces son extraños. Estoy muy sucio para meterme. Tom se disfrazó de guardia de seguridad.",
  ),
  (
    Spa,
    Long,
    [1445006, 2258267, 6863560, 5007007],
    "Está más gordo de cuando lo vi por última vez. Se puso enfermo y lo acostaron en un banco. El tuyo es un buen plan. Sin honor, la victoria pierde sentido.",
  ),
  (
    Spa,
    Long,
    [6681536, 343647, 2893584, 12021183, 1203888],
    "Tienes que haberlos perdido. Nuestro equipo de béisbol es muy fuerte. No sabía que Tom era un drogadicto. Do quiera que voy, voy buscando el amor. Mis hijos hacen esfuerzos patéticamente sinceros de levantarse temprano.",
  ),
  (
    Spa,
    Long,
    [1218434, 1713640, 1604748, 1205805],
    "Cuando él se siente bien, sale a dar un paseo. Tom se ve estupendo. ¡Andate de acá antes de que venga el centinela! Todos estaban muy interesados en la historia de la llegada de los portugueses a Brasil.",
  ),
  (
    Spa,
    Long,
    [1776981, 8034096, 1706270, 13677637],
    "¡Qué maravillosas flores! Los de la gripe son procesos víricos que tienen que seguir su curso. ¿Qué son los ácaros? La voz suave y cómplice de Emma llama a Juan.",
  ),
  (
    Spa,
    Long,
    [3767615, 2538, 8234987, 10874563, 9151920],
    "No lo sé y no me interesa. Por alguna razón, me siento más vivo por la noche. ¿Qué diente le duele? No puedo decirte lo que hicimos al final. Tengo dos pies izquierdos.",
  ),
  (
    Spa,
    Long,
    [1582516, 2114454, 12300732, 10092904, 1031890],
    "Se dice que los ingleses son conservadores. No hagas nada que no quieras hacer. Ellos te buscaron por Warzen. El agua está demasiado fría. Ella se quedará en el hotel Royal el próximo martes.",
  ),
  (
    Spa,
    Long,
    [12045435, 6730009, 4248435, 808248],
    "Se va a embarcar para Iberbacen. ¿Te gusta alguien en este momento? El placer de enseñar no es menor que el de aprender. Él ha mostrado una aptitud para la matemática.",
  ),
  (
    Spa,
    Long,
    [11700291, 10940905, 5610319, 13049778],
    "Si encontráis mi cartera, llamadme, por favor. Nadie defiende mi país. Los ricos chicanean con sus relojes caros. La naturaleza es una amiga generosa. Merece más amor de los seres humanos.",
  ),
  (
    Spa,
    Long,
    [5098297, 13640238, 13991336, 1898698, 13888764],
    "¿Cuántos correos electrónicos escribe por día? Sería ridículo hacer eso. Nuestros bosques están más vivos. Eso no está en el archivo. Has subestimado a Tom.",
  ),
  (
    Spa,
    Long,
    [4988427, 642411, 10621075],
    "Cuando un tonto coge un camino el camino se acaba y el tonto sigue. El número de asesinatos está aumentando incluso en un país como Japón. ¿De dónde aprendiste esa palabra tan difícil?",
  ),
  (
    Spa,
    Long,
    [985010, 11811161, 10327664, 2127459],
    "Nuestro viaje a Sevilla costó cinco mil reales. ¿Puedo robarte un par de minutos de tiempo? Debería hacerlo, pero no quiero. Por favor, deja de fumar.",
  ),
  (
    Spa,
    Long,
    [1068509, 10158745, 1063191],
    "Algunos piensan que el presidente pasa demasiado tiempo viajando. Yanni vendía enciclopedias de casa en casa. Puede que parezca una locura, pero creo que todavía estoy enamorada de Mary.",
  ),
  (
    Spa,
    Long,
    [12051166, 2171048, 13215980, 7547328, 2417572],
    "Mi abuela es una verdadera cabileña. Estuve intentando bajar un poco de peso. Mañana vamos a la ciudad. Tom siempre habla del trabajo. Si aparece gangrena habrá que amputar.",
  ),
  (
    Spa,
    Long,
    [6583228, 740092, 12007615, 5570167],
    "Hice el examen sin haberlo preparado. Aquél que hable mal de ella se arrepentirá. ¿Cómo debe traducirse \"engaño\" al fiyiano? Me miraba con los ojos entrecerrados, como si estuviera decidiendo qué hacer conmigo.",
  ),
  (
    Spa,
    Long,
    [2924619, 1457850, 3252967, 2769205],
    "Yo no estaba ocupada. Me gusta la canción estival de las cigarras. Hay que advertir a los demás. En Singapur te dan una multa si tiras basura en la calle.",
  ),
  (
    Spa,
    Long,
    [4489125, 856291, 11796397, 1526193, 1235032],
    "Mañana va a hacer calor. He cambiado el diseño de mi web. ¿Hay algún problema? ¿Por qué no contestáis? Ese abrigo oscuro no va con su tez oscura. Llame a su amigo para que coma con nosotros.",
  ),
  (
    Spa,
    Long,
    [1388895, 6804935],
    "Algunos brillantes ensayos de Comrade Stalin le permitieron a los lingüistas soviéticos tomar la vanguardia en el mundo. Cuando voy a la oficina me pongo un traje.",
  ),
  (
    Spa,
    Long,
    [1923257, 10786430, 4466603, 11292739, 2100170],
    "¿Quién fue la que compró ayer esta falda? Tom asaltó un banco. Están corriendo descalzos. ¿Qué pensáis al respecto? Goza el momento, pues el momento es tu vida.",
  ),
  (
    Spa,
    Long,
    [2560863, 1010697, 5056736, 1509669],
    "La heroína de esta historia es una niña pequeña. Me sentí bastante aliviado, después de haber dicho lo que tenía que decir. Intentaré olvidarlo todo. Mary está frustrada con su vida.",
  ),
  (
    Spa,
    Long,
    [1068760, 10224210, 1795018, 354949],
    "Encontré otro trabajo. Desconfían de nosotras. El año que viene tendré 17 años. Él siempre tuvo mala relación con el profesor a causa de sus retrasos.",
  ),
  (
    Spa,
    Long,
    [505853, 12965743, 1208831, 7904905, 1897533],
    "¿Has perdido la cabeza? Tomará mucho tiempo para hacer eso. La causa del accidente nos es desconocida. ¿Con quién quieren bailar primero? Adonde quiera que vaya, nunca olvidaré su amabilidad.",
  ),
  (
    Spa,
    Long,
    [8284222, 10321764, 9713863, 3888945, 8687183],
    "Mi mayor temor es fallarle a mi familia. ¿Lo has intentado así? Tom ha tomado un lugar. El trabajo duro nunca ha herido a nadie. Seguro que no tienes de qué preocuparte.",
  ),
]

