///|
/// mbglot's prediction for `text`: the detected language, if any.
fn any_detection(text : String) -> @mbglot.Lang? {
  match @mbglot.detect(text) {
    Some(d) => Some(d.lang)
    None => None
  }
}

///|
/// mbglot's prediction for `text` when it is reliable, as a router that
/// sends uncertain messages to manual triage would use it.
fn reliable_detection(text : String) -> @mbglot.Lang? {
  match @mbglot.detect(text) {
    Some(d) if d.reliable => Some(d.lang)
    _ => None
  }
}

///|
/// Share of answered samples that were right.
fn answered_precision(report : @eval.Report) -> Double {
  let answered = report.total() - report.unidentified()
  if answered == 0 {
    0.0
  } else {
    report.correct().to_double() / answered.to_double()
  }
}

///|
/// The benchmark report in Markdown. `eval/results.md` holds its output;
/// CI checks that it is up to date.
fn benchmark() -> String {
  let buf = StringBuilder()
  let langs = @tatoeba.languages()
  buf.write_string(
    "# Benchmark\n\nmbglot on Tatoeba sentences in \{langs.length()} languages " +
    "(see eval/tatoeba). Generated by `moon run eval/run`; do not edit.\n\n" +
    "Accuracy counts every detection. Reliable precision is the share of " +
    "reliable detections that are right, and coverage the share of samples " +
    "with a reliable detection.\n\n",
  )
  buf.write_string(
    "| Length | Samples | Accuracy | Macro F1 | Reliable precision | Coverage |\n",
  )
  buf.write_string("|---|---:|---:|---:|---:|---:|\n")
  let lengths : Array[@tatoeba.Length?] = [
    Some(Short),
    Some(Medium),
    Some(Long),
    None,
  ]
  for length in lengths {
    let samples = @tatoeba.samples(length?)
    let all = @eval.evaluate(samples, any_detection)
    let reliable = @eval.evaluate(samples, reliable_detection)
    let name = match length {
      Some(l) => l.name()
      None => "all"
    }
    let coverage = 1.0 -
      reliable.unidentified().to_double() / reliable.total().to_double()
    buf.write_string(
      "| \{name} | \{all.total()} | \{@eval.percent(all.accuracy())} | " +
      "\{@eval.percent(all.macro_f1())} | " +
      "\{@eval.percent(answered_precision(reliable))} | " +
      "\{@eval.percent(coverage)} |\n",
    )
  }
  buf.write_string("\n## Every length, every detection\n\n")
  buf.write_string(
    @eval.evaluate(@tatoeba.samples(), any_detection).to_markdown(confusions=20),
  )
  buf.to_string()
}

///|
fn main {
  println(benchmark().trim_end())
}
