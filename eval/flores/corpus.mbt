  (
    Azj,
    269,
    "Həyatını itirənlər 25 yaşlı Nikolas Alden və 21 yaşlı sürücü Zakari Kyudbek idi.",
  ),
  (Azj, 282, "Bununla belə, sürücü başından ciddi yara aldı."),
  (
    Azj,
    330,
    "Quyruqlu ulduzlar güman ki, zülal yarada və həyatı dəstəkləyə bilən üzvi maddələrlə birlikdə suyun da Yerə çatdırılma mənbəyidir.",
  ),
  (
    Azj,
    457,
    "Fransız inqilabı digər ölkələrdən repressiyaya məruz qalan işçi sinfini də inqilaba başlamaq üçün ilhamlandırmışdı.",
  ),
  (
    Azj,
    477,
    "Şübhəsiz, ABŞ imperializminin əsas qazancını təşkil edəcək kifayət qədər böyük mənfəət Filippin xalqının uzun sürən istismarından əldə edilmişdi.",
