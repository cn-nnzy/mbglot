let rows_nya : Array[(@mbglot.Lang, Int32, String)] = [
  (
    Nya,
    88,
    "Ntchito yomwe inachitika kwambiri inali yongoganiza, koma pologalamu inalembedwa kuti izitsanzira zomwe awona mlengalenga wa Sagittarius.",
  ),
  (
    Nya,
    92,
    "Chiphunzitsochi chimati zinthu zamdima kwambiri kuzungulira mlalang'amba zili mozungulira ngati chi yelo, ndipo zimapangidwa nditizidutswa tating'onoting'ono tambiri.",
  ),
  (
    Nya,
    115,
    "Boma lalonjeza mamiliyoni ambiri amabotolo akatemera wa encephalitis, zomwe zithandize kuti mabungwe azaumoyo akonzekere chaka chamawa.",
  ),
  (
    Nya,
    116,
    "Ndondomeko ya katemera oti aperekedwe kumalo omwe ali ndimbiri yokonda kukhuzidwa, chaka chino yachedwa chifukwa chosowa ndalama komaso chifuwa chosayika pagulu lofunikira malingana ndimatenda ena.",
  ),
  (
    Nya,
    119,
    "Ntchito yake ndiyotamandika komanso yandondomeko, mwakuti dzina lake ndilimodzi mwa “mayina otchuka mnyumba zambiri”, ndipakati pa akatswiri ama stamp azamtengatenga ndi mtokoma. Ena amangopanga zokuti adzitolera ntchito yake basi.",
  ),
  (
    Nya,
    120,
    "Stamp yake yokwanitsa 1000 idali yapamwamba ya “Great Deeds by Swedish Kings” yopangidwa ndi David Klocker Ehrenstrahl muchaka cha 2000, zomwe zidalembedwa mu Guiness Book of World Records.",
  ),
  (
    Nya,
    138,
    "Chidikha ichi chidali chofunika pokonza mchenja ndi magombe , amene amagwira ngati malo okhala nyama zakutchire.",
  ),
  (
    Nya,
    139,
    "Zotsatira zake, mitundu iwiri ya nsomba yatha, moti ina mitundu iwiri ili yowopsezedwa, kuphatikizirapo nsomba zotetezedwa za humpback chub.",
  ),
  (
    Nya,
    198,
    "Malingana ndi apolisi, woyendetsa galimoto yomwe inagunda wojambula ndi zokayikitsa ngati ayimbidwe mulandu.",
  ),
  (
    Nya,
    240,
    "Anzake osewera naye Fernando Alonso anali patsogolo pa nthawi yambiri pampikisanowo koma zinatha bwino atayima pa malo osinthila zinthu chifukwa cha teyala lakutsogolo limene silinayikidwe bwino.",
  ),
  (
    Nya,
    256,
    "Cyanuric acid ndi melamine onse anapezeka mu mikodzo yanyama zomwe zidafa zitadya chakudya cha ziweto choyipitsidwa.",
  ),
  (
    Nya,
    269,
    "Anthu omwe adamwalira adali a Nicholas Alden, azaka 25 ndi a Zachary Cuddeback, azaka 21. A Cuddeback adali yemwe amayendetsa.",
  ),
  (Nya, 282, "Choncho, woyendetsa galimoto adavulala modetsa nkhawa ku mutu."),
  (
    Nya,
    330,
    "Ma Comet mwina idali njira yoperekera madzi ku dziko lapansi komaso ndi zinthu zina zomwe zimapanga ma protein komanso kuthandizira moyo.",
  ),
  (
    Nya,
    457,
    "Kusintha kwa zinthu ku France kunalimbikitsa anthu ogwira ntchito amaiko ena kuti nao asinthe zinthu.",
  ),
  (
    Nya,
    477,
    "Ndithudi, phindu lomwe limapezeka kwa nthawi yayitali popondeleza anthu achi Filipino linakhala phindu la ulamulilo wa U.S. ku maiko ena.",
  ),
  (
    Nya,
    530,
    "Zomera zomwe zimapezeka mosavuta zikanakhala zomanga thupi zomwe zimapezeka m'masamba ndi nyemba, koma zimenezi ndizovuta kwa anyani komanso ife anthu kugaya pokhapokha ngati zaphikidwa.",
  ),
  (
    Nya,
    558,
    "Ngakhale misewu ya ngolo inali ya matabwa, zinkathandiza akavalo kuti azikoka ngolo ndi changu kwambiri komaso kukoka ngolo zakatundu wambiri kusiyana misewu yomwe idali yoyipa kwambiri patsikulo.",
  ),
  (
    Nya,
    572,
    "Ma broadside a Dunlap omwe amadziwika kuti alipo ndi ma copy akalekale. Eni eni omwe analembedwa pamanja sapezekanso.",
  ),
  (
    Nya,
    573,
    "Akatswiri ambiri omwe amaona zakusanjana kwa miyala amakhulupilira kuti mtundu wina wama dinosaur sunafe ndipo ulipobe mpaka lero. Ndizo timazitcha mbalame.",
  ),
  (
    Nya,
    603,
    "Zosintha zokha m'ma selo okhala ndi majeremusi ndizomwe zimatha kupatsira ana, pomwe kusintha kwina kungayambitse kufa kwa selo kapena khansa.",
  ),
  (
    Nya,
    669,
    "Pamene chuma chimene chilipo chikugwiritsidwa bwino ntchito moyenera m'madipatimenti onse a bungwe, zaluso ndi luso zimatha kuchitika.",
  ),
  (
    Nya,
    685,
    "Kugawana za ulendo wakumunda ndi njiranso yopambana kuwonanso za ulendowo ndikugawana zophunzira ndi makalasi akutsogolo.",
  ),
  (
    Nya,
    698,
    "Madagasca kumbali ya nyama ndimbambane yili ngati kontinenti payokha.",
  ),
  (
    Nya,
    769,
    "Mzinda wa Apia udapezedwa mzaka zam'ma 1850 komanso lidakhala likulu la dziko Samoa kuchokera chaka cha 1959.",
  ),
  (
    Nya,
    790,
    "Amkhala pakati awoyendetsa maulendo nthawi zambiri amapereka maphukusi omwe amakhala ndizinthu zambiri monga chakudya cham'mawa, mayendedwe kuchokera kapena kupita ku bwalo la ndege ngakhaleso mphatikizano wa ndege ndi maphukusi amalo ogona.",
  ),
  (
    Nya,
    823,
    "Anthu amene akuyenda angathe kukomana ndi tizirombo ting'onoting'ono timene samatidziwa bwino ku zigawo zakwawo.",
  ),
  (
    Nya,
    835,
    "Mwina mungafune zakudya zing'onozing'ono zochepa ngakhale zamafuta, lawani zimenezi potengera mbali zimatchedwa Berliner, Pfannkuchen komanso Krapfen.",
  ),
  (
    Nya,
    853,
    "Kubelekera chikwama kumsana chifukwa cha ski: Zimenezi zimatchedwaso kuti backcountry ski, ski touring kapena ski yoyenda.",
  ),
  (
    Nya,
    902,
    "Malo opatsa chidwi amaonetsedwa pa mapiramidi komaso ma piramidi ena amakhala owala.",
  ),
  (
    Nya,
    906,
    "Malo a Ellsworth ndi chigawo chakumwera cha chisumbu chomwe chilim'malire ndi Nyanja ya Bellingshausen.",
  ),
  (
    Nya,
    919,
    "Ngakhale zilumba zina za mphepete mwanyanja ndi nyanja zikuluzikulu ndizazikulu kuti ma boti atha kuyendapo, ma boti wocherako ngakhalenso kayak amathanso kupangitsa kuti muyende mosangalala.",
  ),
  (
    Nya,
    921,
    "Zimenezi zikufanana ndi Norway, Sweden komanso New Zealand koma mwapaderadera (mwachitsanzo ku Netherlands chiwelengero chake ndi chimodzi mpaka makumi anayi).",
  ),
  (
    Nya,
    922,
    "Zombo za m'madzi zimene zimagwiritsidwa ntchito mu Ma Baltic Cruise ambiri zimakhala nthawi yayitali mu St. Petersburg, mudziko la Russia.",
  ),
  (
    Nya,
    927,
    "Sizoti ungachite nazo manyazi: palibe chosiyana ndi mantha amunthu ndiponso kudana ndi zinthu zina zimene anthu ambiri ali nazo.",
  ),
  (
    Nya,
    980,
    "Mopanda kukayika, ngati umadziwa zilankhulo za chi Romance, zizakhala zosavuta kuti muphunzire Chipwitikizi.",
  ),
  (
    Nya,
    986,
