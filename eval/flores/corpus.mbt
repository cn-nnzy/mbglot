  ),
  (
    Kaz,
    906,
    "Элсуэрт жері – түбектің оңтүстігіндегі, Беллинсгаузен теңізімен шекараласатын аймақ.",
  ),
  (
    Kaz,
    919,
    "Жағажайлық архипелагтар мен ең үлкен көлдер яхтамен саяхаттауға жеткілікті деңгейде үлкен болғанымен, шағын қайықтар немесе тіпті байдарка өзгеше сезім ұсынады.",
  ),
  (
    Kaz,
    921,
    "Бұған Норвегия, Швеция және Жаңа Зеландия сәйкес, бірақ басқа жерде айтарлықтай бірегей (мысалы, Нидерландыда бұл сан он төрттен бір).",
  ),
  (
    Kaz,
    922,
    "Балтық теңізіндегі круиздардың көпшілігі Ресейдің Санкт-Петербург қаласында ұзақ уақыт болады.",
  ),
  (
    Kaz,
    927,
    "Бұл ұялатын нәрсе емес: ол көп адамдарда бар жеке қорқыныштардан және басқа нәрселерді ұнатпаулардан өзгеше емес.",
  ),
  (
    Kaz,
    980,
    "Егер сіз романдық тілді білсеңіз, сізге португал тілін үйрену оңайырақ болатынын айтпай-ақ қойса да болады.",
  ),
  (
    Kaz,
    986,
    "Бұл ұғым онда өрік гүлдері таңдаулы гүл болып табылатын Қытайдан келді.",
  ),
  (
    Kaz,
    991,
    "Бірақ экватордан бар болғаны бірнеше градус солтүстікте орналасқан «жоғары тропиктерде» орналасқандықтан, жылуға (әрқашан) және қатты күнге (аспан анық кезде, сирегірек) шыдауыңыз керек болады.",
  ),
  (
    Kaz,
    992,
    "Сондай-ақ библиялық патриархтар Авраам, Исаак, Яков және олардың әйелдерінің дәстүрлі жерлеу жері Хебронға солтүстікке қарай бірнеше автобус барады.",
  ),
  (
    Kaz,
    1000,
