  (
    Azj,
    823,
    "Səyahətçilərin, öz bölgələrində görmədikləri heyvan parazitləri ilə üzləşəmə ehtimalı var.",
  ),
  (
    Azj,
    835,
    "Kiçik ölçülü lakin zəngin inqridiyentli xəmir xörəkləri dadmaq istəsəniz, pankekləri yoxlayın. Onlar regiondan asılı olaraq, Berliner, Pfannkuchen və ya Krapfen kimi adlanır.",
  ),
  (
    Azj,
    853,
    "Xizəklə bekpekinq aktivliyi həmçinin bek-kantri xizək idmanı (çox az insanın yaşadığı ucqar yerlərdə), xizək turu və ya xizək haykinqi (yürüyüşü) də adlanır.",
  ),
  (
    Azj,
    902,
    "Səhnələr ehramlarda göstərilir, digər ehramlar isə işıqlandırılır.",
  ),
  (
    Azj,
    906,
    "Elsuort Torpağı, Yarımadanın cənubunda Bellingshausen Dənizi ilə həmsərhəd bir bölgədir.",
  ),
  (
    Azj,
    919,
    "Sahil adaları və ən böyük göllər, istənilən gəmir üçün kifayət qədər böyük olsa da, daha kiçik qayıqlar, hətta kanoelər daha fərqli bir təcrübə olardı.",
  ),
  (
    Azj,
    921,
    "Bu məşğuliyyət Norveç, İsveç və Yeni Zelandiyadakı kimidir, amma digər bir tərəfdən həm də özünəməxsusdur (məs. Hollandiyada bu rəqəm 1-40 arasıdır).",
  ),
  (
    Azj,
    922,
    "Müxtəlif Baltikyanı dəniz səyahətlərinin bir çoxunun proqramında Rusiyanın şəhəri Sankt-Peterburqda qalma müddəti çoxdur.",
  ),
  (
    Azj,
    927,
    "Burda utanılası bir şey yoxdur; bu vəziyyətin, bir çox insanda olan şəxsi qorxu və digər şeylərdən xoşunun gəlməməsi kimi hallardan heç bir fərqi yoxdur.",
  ),
  (
    Azj,
    980,
    "Roman dillərini bilirsinizsə, portuqal dilini öyrənməyin sizin üçün çox asan olacağını demək artıqdır.",
  ),
  (
    Azj,
    986,
    "Bu anlayış, alça çiçəklərinin sevilən çiçək növləri olaraq qəbul edildiyi Çindən yayılmışdır.",
  ),
  (
    Azj,
    991,
    "Amma ekvator xəttinin sadəcə bir neçə dərəcə şimalında yerləşən \"yüksək tropik\" iqlimə malik bölgələrdə qonaqlasanız, həm istilərə (daima), həm də günəşin qızmar şüalarına (səma aydın olduqda, daha hadir hallarda) qarşı mübarizə aparmalı olacaqsınız.",
  ),
  (
    Azj,
    992,
    "İncilin müqəddəslərindən İbrahim, İsa, Yaqub və onların həyat yoldaşlarının dəfn olunduğu Hebron şəhərinə şimal istiqamətdə gedən bir neçə avtobus var.",
