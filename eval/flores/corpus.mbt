    Kan,
    477,
    "ಅದಾಗ್ಯೂ, ಫಿಲಿಪಿನೊ ಜನರ ದೀರ್ಘಾವಧಿಯ ಶೋಷಣೆಯಿಂದ ಬಂದಂತಹ ಅತ್ಯಧಿಕ ಲಾಭಗಳು ಅಮೇರಿಕಾದ ಸಾಮ್ರಾಜ್ಯಶಾಹಿವಾದಕ್ಕೆ ಮೂಲ ಲಾಭಗಳನ್ನು ತಂದುಕೊಟ್ಟವು.",
  ),
  (
    Kan,
    530,
    "ಸಸ್ಯ ಜನ್ಯ ಪ್ರೊಟೀನ್ ಬೇಕೆಂದರೆ ಹಸಿರೆಲೆಗಳು ಮತ್ತು ದ್ವಿದಳ ಧಾನ್ಯಗಳಿಂದ ಸುಲಭವಾಗಿ ಪಡೆಯಬಹುದು, ಆದರೆ ನಮ್ಮಂಥ ಸಸ್ತನಿಗಳಿಗೆ ಬೇಯಿಸದ ಹೊರತು ಇವುಗಳನ್ನು ಅರಗಿಸಿ ಕೊಳ್ಳುವುದು ಕಷ್ಟ ಸಾಧ್ಯ.",
  ),
  (
    Kan,
    558,
    "ವ್ಯಾಗನ್‍‌ಗಳು ಹೋಗುವ ಹಾದಿಯು ಕೇವಲ ಸಮಾನಾಂತರವಾದ ಮರದ ಹಲಗೆಗಳನ್ನು ಹೊಂದಿತ್ತಾದರೂ, ಕುದುರೆಗಳು ಎಳೆಯುವಂಥ ಗಾಡಿಗಳಿಗೂ ಹೋಗಲು ಅವಕಾಶ ಕೊಟ್ಟರು, ಏಕೆಂದರೆ ಅವು ಹೆಚ್ಚಿನ ವೇಗದಲ್ಲಿ ಸಾಗುತ್ತಿದ್ದವು ಮತ್ತು ಭಾರದ ಸಾಮಾನುಗಳನ್ನೂ ಒರಟಾದ ರಸ್ತೆಗಳಲ್ಲಿ ಸಾಗಿಸಬಲ್ಲವಾಗಿದ್ದವು.",
  ),
  (
    Kan,
    572,
    "ಇನ್ನೂ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ ಎಂದು ತಿಳಿದಿರುವ 25 ಡನ್‌ಲಾಪ್ ಬ್ರಾಡ್‌ಸೈಡ್‌ಗಳು ಡಾಕ್ಯುಮೆಂಟ್‌ನ ಉಳಿದಿರುವ ಅತ್ಯಂತ ಹಳೆಯ ಪ್ರತಿಗಳಾಗಿವೆ. ಪ್ರತಿಗಳ ಮೂಲ ಕೈಬರಹದ ನಕಲುಗಳು ಉಳಿದಿಲ್ಲ.",
  ),
  (
    Kan,
    573,
    "ಒಂದು ಗುಂಪಿನ ಡೈನೋಸಾರ್‍‌ಗಳು ಬದುಕುಳಿದು ಇಂದಿಗೂ ಜೀವಂತವಾಗಿವೆ ಎಂದು ಕೆಲವು ಪಾಲಿಯೊನ್ಟೋಲೊಜಿಸ್ಟರು ನಂಬಿಕೆ ಹೊಂದಿದ್ದಾರೆ. ಅವುಗಳನ್ನು ನಾವು ಪಕ್ಷಿಗಳು ಎನ್ನುತ್ತೇವೆ.",
  ),
  (
    Kan,
    603,
    "ಜರ್ಮ್-ಲೈನ್ ಕೋಶ್‍‍ಗಳಲ್ಲಿನ ರೂಪಾಂತರವನ್ನು ಮಾತ್ರ ಮಕ್ಕಳಿಗೆ ವರ್ಗಾಯಿಸಬಹುದು, ಬೇರೆಡೆಗಳ ರೂಪಾಂತರಗಳು ಕ್ಯಾನ್ಸರ್ ಅಥವಾ ಕೋಶಗಳ ಸಾವಿಗೆ ಕಾರಣವಾಗುತ್ತದೆ.",
  ),
  (
    Kan,
    669,
    "ಸಂಸ್ಥೆಯ ಕ್ರಿಯಾತ್ಮಕ ವಿಭಾಗಗಳಲ್ಲಿ ಲಭ್ಯವಿರುವ ಎಲ್ಲಾ ಸಂಪನ್ಮೂಲಗಳನ್ನು ಪರಿಣಾಮಕಾರಿಯಾಗಿ ಬಳಸಿದಾಗ, ಸೃಜನಶೀಲತೆ ಮತ್ತು ಜಾಣ್ಮೆ ತಾನಾಗಿಯೇ ಹೊರಹೊಮ್ಮುತ್ತದೆ.",
  ),
  (
    Kan,
    685,
    "ಪ್ರವಾಸವನ್ನು ಪ್ರತಿಫಲಿಸಲು ವರ್ಚುವಲ್‌ ಆಗಿ ಫೀಲ್ಡ್‌ ಟ್ರಿಪ್ ಹಂಚಿಕೊಳ್ಳುವುದು ಮತ್ತು ಭವಿಷ್ಯದ ಕ್ಲಾಸ್‌ಗಳೊಂದಿಗೆ ಅನುಭವಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದು ಕೂಡ ಉತ್ತಮ ವಿಧಾನವಾಗಿದೆ.",
  ),
  (
    Kan,
    698,
    "ವನ್ಯಜೀವಿಗಳ ವಿಷಯದಲ್ಲಿ ಹೇಳುವುದಾದರೆ. ಬಹಳ ಮಟ್ಟಿಗೆ, ಮಡ್ಗಾಸ್ಕರ್ ಅತಿ ದೊಡ್ಡ ಮತ್ತು ತನ್ನದೇ ಆದ ಖಂಡವಾಗಿದೆ.",
  ),
  (
    Kan,
    769,
    "ಆಪಿಯಾವನ್ನು 1850 ಸ್ಥಾಪಿಸಲಾಯಿತು ಮತ್ತು 1959ರಿಂದ ಅದು ಸಮೋವಾವಿನ ಅಧಿಕೃತ ರಾಜಧಾನಿಯಾಗಿದೆ",
  ),
  (
    Kan,
    790,
    "ಟ್ರಾವೆಲ್ ಏಜೆಂಟರು ಸಾಮಾನ್ಯವಾಗಿ ಉಪಾಹಾರ, ವಿಮಾನ ನಿಲ್ದಾಣಕ್ಕೆ ಹೋಗಲು/ಬರಲು ಸಾರಿಗೆ ವ್ಯವಸ್ಥೆ ಅಥವಾ ಸಂಯೋಜಿತ ವಿಮಾನ ಮತ್ತು ಹೋಟೆಲ್ ಪ್ಯಾಕೇಜ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರುವ ಪ್ಯಾಕೇಜ್‌ಗಳನ್ನು ನೀಡುತ್ತಾರೆ.",
  ),
  (
    Kan,
    823,
    "ಪ್ರಯಾಣಿಕರು ತಮ್ಮ ಮನೆಯ ಪ್ರದೇಶಗಳಲ್ಲಿ ಪರಿಚಯವಿಲ್ಲದ ಪ್ರಾಣಿಗಳ ಕೀಟಗಳನ್ನು ಕಾಣಬಹುದು.",
  ),
  (
    Kan,
    835,
    "ಚಿಕ್ಕ ಆದರೂ ಸೊಗಸಾದ ಪೇಸ್ಟ್ರಿಸ್ ಬೇಕೆಂದರೆ ಸ್ಥಳದ ವಿಶೇಷತೆ ಮೇಲೆ ಕರೆಯುವ ಬರ್ಲಿನರ್ , ಫನ್ ಖುನ್ ಅಥವಾ ಕ್ರಾಫೆನ್‍‌ಗಳನ್ನು ಪ್ರಯತ್ನಿಸಬಹುದು.",
  ),
  (
    Kan,
    853,
    "ಸ್ಕಿ ಇಂದ ಬ್ಯಾಕ್‌ಪ್ಯಾಕಿಂಗ್: ಈ ಚಟುವಟಿಕೆಯನ್ನು ಬ್ಯಾಕ್‌ಕಂಟ್ರಿ ಸ್ಕೀ, ಸ್ಕೀ ಟೂರಿಂಗ್ ಅಥವಾ ಸ್ಕೀ ಹೈಕಿಂಗ್ ಎಂದೂ ಕರೆಯಲಾಗಿದೆ.",
  ),
  (
    Kan,
    902,
    "ಪಿರಮಿಡ್‌ಗಳ ಮೇಲೆ ಸನ್ನಿವೇಶಗಳನ್ನು ಪ್ರದರ್ಶಿಸಲಾಗಿದೆ ಮತ್ತು ವಿಭಿನ್ನ ಪಿರಮಿಡ್‌ಗಳನ್ನು ಬೆಳಗುವಂತೆ ಮಾಡಾಲಾಗಿದೆ.",
  ),
  (
    Kan,
    906,
    "ಬೆಲ್ಲಿಂಗ್ಸ್‌ಹೌಸನ್ ಸಮುದ್ರದಿಂದಾವೃತ್ತವಾದ ಎಲ್ಸ್‌ವರ್ಥ್ ಲ್ಯಾಂಡ್ ಪೆನ್ನಿನ್ಸುಲಾದ ದಕ್ಷಿಣ ಪ್ರಾಂತ್ಯದಲ್ಲಿದೆ.",
  ),
  (
    Kan,
    919,
    "ಕರಾವಳಿ ದ್ವೀಪಸಮೂಹಗಳು ಮತ್ತು ಅತಿದೊಡ್ಡ ಸರೋವರಗಳು ಯಾವುದೇ ತರಹದ ನೌಕಾವಿಹಾರಕ್ಕೆ ಸಾಕಷ್ಟು ದೊಡ್ಡದಾಗಿದ್ದರೂ, ಸಣ್ಣ ದೋಣಿಗಳು ಅಥವಾ ಕಯಾಕ್ ಸಹ ವಿಭಿನ್ನ ಅನುಭವವನ್ನು ನೀಡಬಲ್ಲವು.",
  ),
  (
    Kan,
    921,
    "ನಾರ್ವೆ, ಸ್ವೀಡನ್ ಮತ್ತು ನ್ಯೂಜಿಲೆಂಡ್ ಇದಕ್ಕೆ ಸಂಬಂಧಿಸಿವೆ, ಆದರೆ ಇತರ ವಿಧಾನಗಳಲ್ಲಿ ಬಹಳ ವಿಶಿಷ್ಟವಾಗಿವೆ (ಉದಾಹರಣೆಗೆ, ನೆದರ್‌ಲ್ಯಾಂಡ್‌ನಲ್ಲಿ, ಈ ಸಂಖ್ಯೆ 40 ರಿಂದ 1).",
  ),
  (
    Kan,
    922,
    "ಬಹಳಷ್ಟು ವಿಶಿಷ್ಟ ಬಾಲ್ಟಿಕ್ ಕ್ರೂಸ್‍‌ಗಳು ರಷ್ಯಾದ ಸೇಂಟ್ ಪೀಟರ್ಸ್‌ಬರ್ಗ್‍‌ನಲ್ಲಿ ಹೆಚ್ಚಿನ ತಂಗುವಿಕೆಯನ್ನು ನೀಡುತ್ತವೆ.",
  ),
  (
    Kan,
    927,
    "ಇದೇನೂ ನಾಚಿಕೆಪಡಬೇಕಾದ ವಿಷಯವಲ್ಲ: ಇದು ಬೇರೆಯವರು ಹೊಂದಿರುವ ಭೀತಿಗಳು ಮತ್ತು ಬೇರೆ ಬೇರೆ ವಿಷಯಗಳ ಬಗ್ಗೆ ಇರುವ ಅರುಚಿಗಿಂತ ಬೇರೆಯಾಗಿರುವುದಿಲ್ಲ.",
  ),
  (
    Kan,
    980,
    "ಹೇಳುವ ಅಗತ್ಯವಿಲ್ಲ, ಒಂದೊಮ್ಮೆ ನಿಮಗೆ ಪ್ರಣಯದ ಭಾಷೆ ಗೊತ್ತಿದ್ದರೆ, ನಿಮಗೆ ಪೋರ್ಚುಗೀಸ್ ಕಲಿಯುವುದು ಬಹಳ ಸುಲಭವೆನಿಸುತ್ತದೆ.",
  ),
  (
    Kan,
    986,
    "ಈ ಪರಿಕಲ್ಪನೆಯು ಪ್ಲಮ್ ಹೂವುಗಳು ಜನಪ್ರಿಯವಾಗಿರುವ ಚೀನಾ ದಿಂದ ಬಂದಿದೆ.",
  ),
  (
    Kan,
    991,
    "ಭೂ ಮಧ್ಯರೇಖೆಯ ಕೆಲವೇ ಡಿಗ್ರಿಗಳಷ್ಟು ಉತ್ತರದಲ್ಲಿ ಹೆಚ್ಚಿನ ಉಷ್ಣವಲಯದಲ್ಲಿರಲು ನೀವು ಯಾವಾಗಲೂ ಉಷ್ಣ ಮತ್ತು ಪ್ರಖರವಾದ ಸೂರ್ಯ ಬೆಳಕು (ಅಪರೂಪಕ್ಕೆ ಆಗಸ ತಿಳಿಯಾದಾಗ) ಈ ಎರಡೂ ಪರಿಸ್ಥಿತಿಗಳನ್ನು ಎದುರಿಸಬೇಕಾಗುತ್ತದೆ.",
  ),
  (
    Kan,
    992,
    "ಉತ್ತರದ ಕಡೆಯ ಹೆಬ್ರಾನ್‍‌ನಿಗೆ ಹೋಗಲು ಕೆಲವು ಬಸ್ಸುಗಳಿವೆ, ಅದು ಬೈಬಲಿನ ದೇಶಭಕ್ತರಾದ ಅಬ್ರಾಹಂ, ಐಸಾಕ್, ಜೇಕಬ್ ಮತ್ತು ಅವರ ಪತ್ನಿಯರ ಸಾಂಪ್ರದಾಯಿಕ ಸಮಾಧಿಯ ಸ್ಥಳವಾಗಿದೆ.",
  ),
  (
    Kan,
    1000,
    "ಈ ಸಂಪ್ರದಾಯಕ್ಕೆ ಕ್ರಿಶ್ಚಿಯನ್ ದೇವತಾಶಾಸ್ತ್ರದ ವಿವರಣೆಗಳಿಂದ ಕೊಡಿದೆ, ಆದರೆ ಇದು ಕ್ರಿಶ್ಚಿಯನ್ ಪೂರ್ವ ವಸಂತ ಮತ್ತು ಫಲವತ್ತತೆ ಆಚರಣೆಯಾಗಿರಬಹುದು.",
  ),
]

///|
let rows_mal : Array[(@mbglot.Lang, Int32, String)] = [
  (
    Mal,
    88,
    "ചെയ്ത ജോലി തികച്ചും സൈദ്ധാന്തികമായിരുന്നു, പക്ഷേ ആ പ്രോഗ്രാം സജിറ്റേറിയസ് ഗാലക്സിയിൽ ചെയ്ത നിരീക്ഷണത്തിനനുസരിച്ച് ചെയ്യാനാണ് എഴുതിയിരുന്നത്.",
  ),
  (
    Mal,
    92,
    "ഈ സിദ്ധാന്തം പറയുന്നത് ഒരു താരാപഥത്തിന് ചുറ്റുമുള്ള ഭൂരിഭാഗം ഇരുണ്ട ദ്രവ്യവും, താരാപഥത്തിന് ചുറ്റും ഒരുതരം പ്രകാശവലയത്തിൽ സ്ഥിതി ചെയ്യുന്നുവെന്നും ഇത് ധാരാളം ചെറിയ കണങ്ങളാൽ നിർമ്മിതവുമാണെന്നാണ്.",
  ),
  (
    Mal,
    115,
    "അടുത്ത വർഷത്തേക്ക് ആരോഗ്യ ഏജൻസികളുടെ തയ്യാറെടുപ്പിന് സഹായിക്കുന്നതിന് എൻ‌സിഫലൈറ്റിസ് വാക്സിന്റെ ദശലക്ഷക്കണക്കിന് വയലുകൾ സർക്കാർ വാഗ്ദാനം ചെയ്തിട്ടുണ്ട്.",
  ),
  (
    Mal,
    116,
    "ചരിത്രപരമായി ഏറ്റവും കൂടുതൽ ബാധിക്കപ്പെടുന്ന പ്രദേശങ്ങളിൽ ഈ വർഷം വാക്‌സിനുകൾ എത്തിക്കുന്നതിനുള്ള പദ്ധതികൾ, ഫണ്ടിന്റെ അഭാവവും, മറ്റ് രോഗങ്ങളുമായി താരതമ്യപ്പെടുത്തുമ്പോളുള്ള മുൻഗണന കുറഞ്ഞതും മൂലം വൈകി.",
  ),
  (
    Mal,
    119,
    "\"അദ്ദേഹത്തിന്റെ സൃഷ്ടികൾ അംഗീകൃത നിലവാരത്തിലുള്ളതും സങ്കീർണ്ണത നിറഞ്ഞതുമാണ്. സ്റ്റാമ്പ് ശേഖരണം ഇഷ്ടപ്പെടുന്നവർക്കിടയിലുള്ള വളരെ കുറച്ച് \"\"പരിചിതന്മാരിൽ\"\" ഒരാളാണ് അദ്ദേഹം. അദ്ദേഹത്തിന്റെ സൃഷ്ടികൾ മാത്രം ശേഖരിക്കുന്നവരുമുണ്ട്.\"",
  ),
  (
    Mal,
    120,
    "\"ഗിന്നസ് ബുക്ക് ഓഫ് വേൾഡ് റെക്കോർഡ്സിൽ പട്ടികപ്പെടുത്തിയിട്ടുള്ള, ഡേവിഡ് ക്ലോക്കർ എഹ്‌റിന്സ്ട്രാലിന്റെ 2000-ത്തിലെ ഉജ്ജ്വലമായ \"\"ഗ്രേറ്റ് ഡീഡ്സ് ബൈ സ്വീഡിഷ് കിങ്‌സ്\"\" ആയിരുന്നു അദ്ദേഹത്തിന്റെ 1000-മത്തെ സ്റ്റാമ്പ്.\"",
  ),
  (
    Mal,
    138,
    "വന്യജീവി ആവാസ കേന്ദ്രങ്ങളായ മണൽത്തിട്ടകളും, കടൽത്തീരങ്ങളും നിർമ്മിക്കാൻ ഈ എക്കൽപ്പാളി ആവശ്യമാണ്.",
  ),
  (
    Mal,
    139,
    "തൽഫലമായി, രണ്ട് മത്സ്യ ഇനങ്ങൾക്ക് വംശനാശം സംഭവിക്കുകയും, ഹംപ്ബാക്ക് ചബ്ബ്‌ ഉൾപ്പടെ മറ്റ് രണ്ട് മത്സ്യ ഇനങ്ങൾ വംശനാശഭീഷണി നേരിടുകയും ചെയ്യുന്നു.",
  ),
  (
    Mal,
    198,
    "പോലീസ് പറയുന്നതനുസരിച്ച്, ഫോട്ടോഗ്രാഫറെ തട്ടിയ വാഹനത്തിന്റെ ഡ്രൈവർ ക്രിമിനൽ കേസ് നേരിടാൻ സാധ്യതയില്ല.",
  ),
  (
    Mal,
    240,
    "മത്സരത്തിൽ ഏറിയ ദൂരവും തന്റെ ടീം അംഗമായ ഫെർണാണ്ടോ ആലോൻസോ ആയിരുന്നു മുന്നിൽ, എന്നാൽ പിറ്റ് സ്റ്റോപ് കഴിഞ്ഞപ്പോൾ അതിന് മാറ്റംവന്നു, ഒരുപക്ഷേ തെറ്റായി ഘടിപ്പിച്ച വലത് ഭാഗത്തെ മുൻചക്രം ആകാം അതിന് കാരണം.",
  ),
  (
    Mal,
    256,
    "വളർത്തു മൃഗങ്ങൾക്കുള്ള പഴകിയ ഭക്ഷണം കഴിച്ച് മരിച്ച വളർത്തുമൃഗങ്ങളുടെ മൂത്ര സാമ്പിളുകളിൽ ക്യനൂറിക് ആസിഡ് മെലാമിൻ ഇവ രണ്ടും കണ്ടു.",
  ),
  (
    Mal,
    269,
    "അപകടമരണം നടന്നത് നിക്കോളാസ് ആൽഡനും, 25, സക്കാറി കഡ്ഡിബാക്ക്കിനുമാണ്, 21. കഡ്ഡിബാക്കായിരുന്നു ഡ്രൈവർ.",
  ),
  (
    Mal,
    282,
    "എന്നിരുന്നാലും, ഡ്രൈവര്‍ക്ക് തലയ്ക്ക് ഗുരുതര പരിക്കുകൾ നിലനില്‍ക്കുന്നു.",
  ),
  (
    Mal,
    330,
    "വാൽനക്ഷത്രങ്ങൾ ഭൂമിയിലേക്ക് ജലവും അതോടൊപ്പം ജീവനെ പിന്തുണയ്ക്കാൻ കഴിയുന്ന പ്രോട്ടീനുകളായി മാറാൻ കഴിയുന്ന ജൈവസ്തുക്കളും എത്തിച്ച ഒരു സ്രോതാസ്സായിരിക്കാം.",
  ),
  (
    Mal,
    457,
    "ഫ്രെഞ്ച് വിപ്ലവം മറ്റു രാജ്യങ്ങളിൽ അടിച്ചമർത്തപ്പെട്ടിരുന്ന പല തൊഴിലാളി വർഗ്ഗങ്ങളിലും അവരുടെ വിപ്ലവപ്രവർത്തനങ്ങൾ തുടങ്ങാൻ പ്രചോദനം നൽകിയിരുന്നു.",
  ),
  (
    Mal,
    477,
    "തീർച്ചയായും, ഫിലിപ്പിനോ ജനതയെ ദീർഘകാലം ചൂഷണം ചെയ്ത് നേടിയ മികച്ച ലാഭങ്ങളാണ് യുഎസ് സാമ്രാജ്യത്വത്തിന്റെ അടിസ്ഥാന നേട്ടം.",
  ),
  (
    Mal,
    530,
    "സസ്യ ഉറവിടങ്ങളിൽ ഇലകളിലും പയർവർഗ്ഗങ്ങളിലും ലഭ്യമാകുന്ന പ്രോട്ടീനുകൾ ഏറ്റവും എളുപ്പത്തിൽ ലഭ്യമാകുമെങ്കിലും അവ പാചകം ചെയ്ത് ഉപയോഗിച്ചില്ലെങ്കിൽ നമ്മെ പോലുള്ള പ്രൈമേറ്റുകളിൽ ദഹിക്കാൻ പ്രയാസമാണ്.",
  ),
  (
    Mal,
    558,
    "വാഗൺ‌വേസ് സമാന്തരമായി തടി കൊണ്ടുള്ള പലകകൾ ഉൾക്കൊള്ളുന്നുണ്ടെങ്കിലും, കൂടുതൽ വേഗത കൈവരിക്കാൻ കുതിരകളെ വലിക്കാൻ അവർ അനുവദിച്ചു കൂടാതെ, ദിവസത്തെ അൽപ്പം കൂടുതൽ പരുക്കൻ റോഡുകളിൽനേക്കാൾ അധികം വലിയ ലോഡുകൾ വലിക്കുക.",
  ),
  (
    Mal,
    572,
    "ഇപ്പോഴും നിലവിലുള്ളതായി അറിയപ്പെടുന്ന 25 ഡൺലാപ്പ് ബ്രോഡ്‌സൈഡുകൾ ഡോക്യുമെന്റിന്റെ അവശേഷിക്കുന്ന ഏറ്റവും പഴയ പകർപ്പുകളാണ്. ഒറിജിനൽ കൈയ്യെഴുത്ത് പകർപ്പ് ലഭ്യമല്ല.",
  ),
  (
    Mal,
    573,
    "ഫോസ്സിലുകളെക്കുറിച്ച് പഠിക്കുന്ന ധാരാളം ശാസ്ത്രജ്ഞന്മാരും ഇന്ന് വിശ്വസിക്കുന്നത് 1 വിഭാഗം ദിനോസറുകൾ അവശേഷിച്ചിട്ടുണ്ടെന്നും അവ ഇപ്പോഴും ജീവിച്ചിരിക്കുന്നുണ്ടെന്നുമാണ്. നമ്മൾ അവയെ പക്ഷികൾ എന്നു വിളിക്കും.",
  ),
  (
    Mal,
    603,
    "ജെം-ലൈൻ സെല്ലുകളിലെ മ്യൂട്ടേഷനുകൾ മാത്രമേ കുട്ടികളിലേക്ക് കൈമാറാൻ കഴിയൂ, അതേസമയം മറ്റെവിടെയുമുള്ള മ്യൂട്ടേഷനുകൾ കോശത്തിന്റെ നാശത്തിനോ കാൻസറിനോ കാരണമാകാം.",
  ),
  (
    Mal,
    669,
    "ഒരു സ്ഥാപനത്തിന്റെ പ്രവർത്തന വകുപ്പുകളിലുടനീളം ലഭ്യമായ എല്ലാ വിഭവങ്ങളും ഫലപ്രദമായി ഉപയോഗിക്കുമ്പോൾ സർഗാത്മകതയിലും ചാതുര്യത്തിലും മാറ്റമുണ്ടാകാം.",
  ),
  (
    Mal,
    685,
    "ഒരു ഫീൽഡ് ട്രിപ്പ് ഫലത്തിൽ പങ്കിടുന്നത് ഒരു യാത്രയെ പ്രതിഫലിപ്പിക്കുന്നതിനും ഭാവി ക്ലാസുകളുമായി അനുഭവങ്ങൾ പങ്കിടുന്നതിനുമുള്ള ഒരു മികച്ച മാർഗമാണ്.",
  ),
  (
    Mal,
    698,
    "മഡഗാസ്കർ ഏറ്റവും വലുതും വന്യജീവികളുടെ കാര്യത്തിൽ സ്വന്തമായി ഒരു ഭൂഖണ്ഡവുമാണ്.",
  ),
  (
    Mal,
    769,
    "1850 കളിൽ ആണ് ആപിയ കണ്ടെത്തിയത് 1959 മുതൽ സമോവയുടെ ഔദ്യോഗിക ആസ്ഥാനം ഇതായിരുന്നു.",
  ),
  (
    Mal,
    790,
    "ട്രാവൽ ഏജന്റുമാർ സാധാരണയായി പ്രഭാതഭക്ഷണം, എയർപോർട്ടിലേക്ക് / അവിടെ നിന്ന് പുറത്തേക്കുള്ള ഗതാഗത ക്രമീകരണം എന്നിവ വാഗ്ദാനം ചെയ്യുന്നു, ചിലപ്പോൾ ഫ്ലൈറ്റ്, ഹോട്ടൽ താമസം എന്നിവ ചേർന്നുള്ള പാക്കേജുകളും വാഗ്ദാനം ചെയ്യാറുണ്ട്.",
  ),
  (
    Mal,
    823,
    "അവരുടെ സ്വന്തം മേഖലകളിൽ പോലും അവർ പരിചിതർ അല്ലാത്തതിനാൽ, സഞ്ചാരികൾക്ക് കീട ജന്തുക്കളെ നേരിടേണ്ടിവന്നേക്കാം.",
  ),
  (
    Mal,
    835,
    "നിങ്ങൾക്ക് ചെറുതും രുചികരവുമായ പേസ്ട്രികൾ വേണമെന്നുണ്ടെങ്കിൽ, ബെർലിനർ, ഫാൻകുചെൻ അല്ലെങ്കിൽ ക്രാപ്‌ഫെൻ എന്ന് ഓരോ പ്രദേശത്ത് വിളിക്കുന്നത് പരീക്ഷിക്കുക.",
  ),
  (
    Mal,
    853,
    "സ്കീയിംങ് ചെയ്യുന്നയാളുടെ ബാക്ക്പാക്കിംഗ്: ഈ പ്രക്രിയയെ ബാക്ക്കൺട്രി സ്കീ, സ്കീ ടൂറിംഗ് അല്ലെങ്കിൽ സ്കീ ഹൈക്കിംങ് എന്നിങ്ങനെയും വിളിക്കുന്നു.",
  ),
  (
    Mal,
    902,
    "രംഗങ്ങൾ പിരമിഡുകളിൽ പ്രദർശിപ്പിക്കുകയും വിഭിന്നങ്ങളായ പിരമിഡുകൾ തെളിയുകയും ചെയ്യുന്നു.",
  ),
  (
    Mal,
    906,
    "ബെല്ലിംഗ്‌ഷോസൻ കടലിന്റെ അതിർത്തിയായ പെനിൻസുലയുടെ തെക്ക് ഭാഗമാണ് എൽസ്‌വർത്ത് ലാൻഡ്.",
  ),
  (
    Mal,
    919,
    "തീരദേശ ദ്വീപ സമൂഹവും ഏറ്റവും വലിയ തടാകങ്ങളും ഏതൊരു വള്ളത്തിനും മതിയായതാണെങ്കിലും, ചെറിയ ബോട്ടുകളോ ഒരു കയാക്കോ പോലും ഒരു വേറിട്ട അനുഭവം നൽകുന്നു.",
  ),
  (
    Mal,
    921,
    "ഇതിനൊപ്പം നോര്‍വേ, സ്വീഡന്‍, ന്യൂസിലാന്‍റ് എന്നിവരെത്തുന്നു, പക്ഷേ മറിച്ചാണെങ്കില്‍ വളരെ അതുല്യമാണ്‌ (ഉദാഹരണത്തിന്‌ നെതര്‍ലാന്‍റ്സില്‍ ഈ കണക്ക് 1 മുതല്‍ നാല്‍പത് വരെയാണ്‌.",
  ),
  (
    Mal,
    922,
    "മിക്കവാറും വ്യത്യസ്തമായ ബാള്‍ട്ടിക് ക്രൂസുകളെല്ലാം റഷ്യയിലെ സെന്‍റ്. പീറ്റേഴ്സ്ബര്‍ഗില്‍ ദീര്‍ഘനേരം തങ്ങാറുണ്ട്.",
  ),
  (
    Mal,
    927,
    "ഇതില്‍ നാണക്കേടുതോന്നാന്‍ ഒന്നുമില്ല: ഇത് വ്യക്തിഗതമായ ഭയങ്ങള്‍ പോലെയോ ഇഷ്ടമില്ലായ്മകള്‍ പോലെയോ ഓരോരുത്തരിലും വ്യത്യസ്തമായിരിക്കുന്നതാണ്‌.",
  ),
  (
    Mal,
    980,
    "പ്രതീക്ഷിച്ച പോലെ, നിങ്ങൾക്ക് ആദർശ പ്രേമത്തിൻ്റെ ഭാഷ അറിയുമെങ്കിൽ, പോർട്ടുഗീസ് ഭാഷ പഠിക്കുന്നത് നിങ്ങൾക്ക് എളുപ്പമായിരിക്കും.",
  ),
  (
    Mal,
    986,
    "ചൈനയിൽ നിന്നാണ് ഈ ആശയം വന്നത് ഇവിടെ പ്ലം പൂക്കൾ ഇഷ്ടപ്പെട്ട പുഷ്പമായിരുന്നു.",
  ),
  (
    Mal,
    991,
    "\"എന്നാൽ മധ്യരേഖയ്ക്ക് ഏതാനും ഡിഗ്രി വടക്ക് \"\"ഉയർന്ന ഉഷ്ണമേഖലാ പ്രദേശങ്ങളിൽ\"\" ആയിരിക്കുമ്പോൾ നിങ്ങൾ ചൂടും (എല്ലായ്പ്പോഴും) ശക്തമായ വെയിലും (ആകാശം തെളിഞ്ഞിരിക്കുമ്പോൾ, വളരെ അപൂർവമായി) നേരിടേണ്ടിവരും.\"",
  ),
  (
    Mal,
    992,
