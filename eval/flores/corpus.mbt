let rows_ron : Array[(@mbglot.Lang, Int32, String)] = [
  (
    Ron,
    88,
    "Munca depusă a fost în mare parte teoretică, dar programul a fost conceput pentru a stimula observarea galaxiei din Săgetător.",
  ),
  (
    Ron,
    92,
    "Această teorie spune că materia întunecată dintr-o galaxie este localizată în jurul galaxiei ca un fel de aură și este compusă dintr-o mulțime de particule mici.",
  ),
  (
    Ron,
    115,
    "Câteva milioane de fiole cu vaccinul contra encefalitei au fost, de asemenea, promise de către guvern, care vor ajuta agențiile de sănătate să se pregătească pentru anul următor.",
  ),
  (
    Ron,
    116,
    "Planurile de a livra vaccinurile în zonele istoric cele mai afectate au fost întârziate anul acesta datorită fondurilor insuficiente și a priorității reduse acordate în comparație cu alte boli.",
  ),
  (
    Ron,
    119,
    "„Opera sa este de o calitate și detalii atât de ușor de recunoscut, încât este unul dintre foarte puținele «nume importante» printre filateliști. Unii sunt specializați în colecționarea exclusivă a lucrărilor sale.”",
  ),
  (
    Ron,
    120,
    "„Al 1000-lea timbru al său a fost superbul timbru numit «Faptele mărețe ale regilor Suediei» de David Klöcker Ehrenstrahl, în 2000, inclus în Cartea Recordurilor Mondiale Guinness.”",
  ),
  (
    Ron,
    138,
    "Aceste sedimente au fost necesare pentru a crea bancuri de nisip și plaje, care au servit ca habitat pentru viețuitoare.",
  ),
  (
    Ron,
    139,
    "Ca urmare, două specii de pești au dispărut, iar altele două sunt în pericol, inclusiv cleanul cu cocoașă.",
  ),
  (
    Ron,
    198,
    "Conform poliției, conducătorul vehiculului care l-a lovit pe fotograf probabil nu va fi inculpat.",
  ),
  (
    Ron,
    240,
    "Coechipierul său Fernando Alonso a fost în frunte pentru cea mai mare parte a cursei, dar a încheiat-o imediat după oprirea la boxe, cel mai probabil pentru că roata din dreapta față a fost avariată.",
  ),
  (
    Ron,
    256,
    "Atât acid cianuric, cât și melamină au fost găsite în probe de urină de la animale de companie care au murit după ce au consumat hrană pentru animale contaminată.",
  ),
  (
    Ron,
    269,
    "Cei decedați sunt Nicholas Alden, de 25 de ani, și Zachary Cuddeback, de 21 de ani. Cuddeback a fost șofer.",
  ),
  (Ron, 282, "Cu toate acestea, șoferul a suferit răni grave la cap."),
  (
    Ron,
    330,
    "Cometele este posibil să fi fost sursa de alimentare cu apă a pământulului, alături de materie organică, care poate forma proteine și poate întreține viața.",
  ),
  (
    Ron,
    457,
    "Revoluția franceză, la rândul ei, a inspirat mulți alți muncitori oprimați din alte țări să pornească propriile revoluții.",
  ),
  (
    Ron,
    477,
    "Bineînțeles, profiturile enorme de pe urma exploatării îndelungate a poporului filipinez au constituit câștigul de bază al imperialismului american.",
  ),
  (
    Ron,
    530,
    "Cele mai ușor accesibile resurse vegetale erau proteinele din frunze și leguminoase, dar acestea sunt greu de digerat pentru primatele ca noi dacă nu sunt gătite.",
  ),
  (
    Ron,
    558,
    "Cu toate că aceste wagonways constau doar din scânduri de lemn dispuse în paralel, le-au permis cailor să atingă viteze mai mari și să tragă încărcături mai grele decât o puteau face pe drumurile puțin mai neregulate din acea vreme.",
  ),
  (
    Ron,
    572,
    "Cele 25 de postere Dunlap încă existente sunt cele mai vechi copii ale documentului care au supraviețuit. Manuscrisul original nu mai există.",
  ),
  (
    Ron,
    573,
    "Mulți paleontologi, astăzi, cred că un grup de dinozauri a supraviețuit și este în viață în ziua de azi. Noi îi numim păsări.",
  ),
  (
    Ron,
    603,
    "Doar mutațiile din celulele de tipul liniei germinale pot fi transmise copiilor, în timp ce mutațiile din orice altă parte pot cauza moarte celulară sau cancer.",
  ),
  (
    Ron,
    669,
    "Atunci când în departamentele funcționale ale unei organizați toate resursele disponibile sunt utilizate într-un mod eficient, creativitatea și ingeniozitatea se pot manifesta liber.",
  ),
  (
    Ron,
    685,
    "Partajarea virtuală a unei ieșiri pe teren este de asemenea un mod excelent de a reflecta asupra călătoriei și de a împărtăși experiența cu clasele viitoare.",
  ),
  (
    Ron,
    698,
    "Madagascar este de departe cea mai mare și un adevărat continent de sine stătător când vine vorba de animale sălbatice.",
