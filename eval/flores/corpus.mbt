let rows_tam : Array[(@mbglot.Lang, Int32, String)] = [
  (
    Tam,
    88,
    "கோட்பாட்டை அடிப்படையாகக் கொண்ட வேலைகள் மட்டுமே பெரும்பாலும் முடிக்கப்பட்டுள்ளன. ஆனால் இந்த திட்டம் தனுசு விண்மீனை கண்காணிக்க துண்டுதலாக எழுதப்பட்டது.",
  ),
  (
    Tam,
    92,
    "விண்மீன் மண்டலத்தை சுற்றியுள்ள மிகவும் இருட்டான விஷயம் விண்மீன் மண்டலத்தை சுற்றி ஒளிவட்ட வடிவல் அமைந்துள்ளது, மற்றும் அது பெருமளவு சிறுதுகள்களால் உருவாக்கப்பட்டது.",
  ),
  (
    Tam,
    115,
    "என்செபலிடிஸ் தடுப்பூசியின் பல மில்லியன் குப்பிகளுக்கு அரசாங்கம் உறுதியளித்துள்ளது, இது அடுத்த ஆண்டு சுகாதார அமைப்புகளை தயார்படுத்துவதற்கு உதவியாக இருக்கும்.",
  ),
  (
    Tam,
    116,
    "இந்த ஆண்டு வரலாற்று ரீதியாக அதிகம் பாதிப்புடைய பகுதிகளுக்கு நிதி சுமை மற்றும் பிற நோய்களுக்கான முன்னுரிமை காரணமாக தடுப்பூசிகள் வழங்குவதில் தாமதம் ஏற்பட்டுள்ளது.",
  ),
  (
    Tam,
    119,
    "\"இவரது பணி மிகவும் அங்கீகரிக்கப்பட்ட தரம் மற்றும் விவரம் கொண்டிருப்பதால், அவர் தபால்தலை சேகரிப்பவர்களிடையே மிகக் குறைந்த \"\"வீட்டுப் பெயர்களில்\"\" ஒருவராக(1) இருக்கிறார். சிலர் அவரது படைப்புகளை மட்டுமே சேகரிப்பதில் கவனம் செலுத்துகிறார்கள்.\"",
  ),
  (
    Tam,
    120,
    "\"அவரது 1000ஆவது தபால் தலை 2000த்தின், டேவிட் க்ளோக்கர் எரென்ஸ்ட்ராலில் மிகச் சிறந்த, \"\"கிரேட் டீட்ஸ் பை ஸ்வீடிஷ் கிங்ஸ்\"\" ஆகும் மற்றும் அது கின்னஸ் உலக சாதனைப் புத்தகத்திலும் பட்டியலிடப்பட்டது.\"",
  ),
  (
    Tam,
    138,
    "வனவிலங்குகளின் வாழ்விடமாக விளங்கும் மணல் பட்டைகள் மற்றும் கடற்கரைகளை உருவாக்க இந்த வண்டல் அவசியம்.",
  ),
  (
    Tam,
    139,
    "இதன் விளைவாக, இரண்டு(2) மீன் வகைகள் அழிந்துவிட்டன, மேலும் ஹம்ப்பேக் சப் உட்பட மற்ற இரண்டு (2) அழியும் நிலையில் உள்ளன.",
  ),
  (
    Tam,
    198,
    "காவல்துறையைப் பொறுத்தவரை, புகைப்படக் கலைஞரைத் தாக்கிய வாகனத்தின் ஓட்டுநர் குற்றவியல் நடவடிக்கைகளை எதிர்கொள்ள வாய்ப்பில்லை.",
  ),
  (
    Tam,
    240,
    "அவரது அணி வீரரான பெர்னாண்டோ ஆலோன்ஸோ, அந்தப் பந்தயத்தில் பெரும்பாலும் முன்னணியில் இருந்தார் , ஆனால் அவரது பிட்-நிறுத்ததிற்குப் பிறகு, அநேகமாக தவறாக இணைக்கப் பட்ட முன் சக்கரத்தால் அது முடிந்தது.",
  ),
  (
    Tam,
    256,
    "மாசடைந்த வளர்ப்புப் பிராணிகள் உணவினை உண்டதால் மரணமடைந்த வளர்ப்புப் பிராணிகளின் சிறுநீர் மாதிரியில் சயனூரிக் அமிலம் மற்றும் மெலமைன் ஆகிய இரண்டும் கண்டறியப்பட்டன.",
  ),
  (
    Tam,
    269,
    "மரணமடைந்தவர்கள் நிக்கோலஸ் ஆல்டென், 25 மற்றும் ஸகேரி கட்பேக், 21 ஆகியோர் ஆவர். கட்பேக்தான் வண்டியின் ஓட்டுனர்.",
  ),
  (
    Tam,
    282,
    "எனினும், அந்த வாகன ஓட்டுனர் தலையில் ஏற்பட்ட பலத்த காயங்களுடன் உயிர் தப்பினார்.",
  ),
  (
    Tam,
    330,
    "பூமிக்கு நீர் ஆதாரமாக வால்மீன்கள் இருந்து இருக்கலாம், அத்துடன் கரிமப் பொருட்களுடன் புரதங்களை உருவாக்கி வாழ்க்கையை ஆதரிக்கும்.",
  ),
  (
    Tam,
    457,
    "பிரெஞ்சுப் புரட்சி மற்ற நாடுகளிலும் ஒடுக்கப்பட்ட தொழிலாளர் வர்க்க மக்களிடையே புரட்சிகளைத் தொடங்க தூண்டியது.",
  ),
  (
    Tam,
    477,
    "நிச்சயமாக, U.S. ஏகாதிபத்தியத்தின் அடிப்படை ஆதாயங்கள் பிலிப்பைன் மக்களிடமிருந்து பலவாறு பெறப்பட்ட சுரண்டலின் பெரு இலாபமாக இருக்கலாம்.",
  ),
  (
    Tam,
    530,
    "மிகவும் எளிதில் பெறக்கூடிய தாவர வளங்களானது இலைகளிலும் பயறுவகைகளிலும் கிடைக்கும் புரதங்கள் தான். ஆனால், நம்மைப் போன்ற பாலூட்டிகளுக்கு சமைத்தாலன்றி அவை ஜீரணிக்ககடினமாக இருக்கும்.",
  ),
  (
    Tam,
    558,
    "வண்டிப் பாதைகள் வெறும் மரத்தாலான இணையான பலகைகளை மட்டுமே கொண்டிருந்தாலும், அவற்றை இழுக்கும் குதிரைகளை அதீத வேகத்துடன் இழுக்கவும், சற்றே கரடு முரடான சாலைகளை விட அதிக எடையை இழுப்பதையும் அனுமதித்தன.",
  ),
  (
    Tam,
    572,
    "தற்போதுள்ள 25 டன்லப்பின் அகலப் பக்கங்கள் தான் அந்த ஆவணத்தின் மிகப் பழைய எஞ்சி இருக்கும் பிரதிகள். அசல் கையெழுத்து பிரதி மிஞ்சவில்லை.",
  ),
  (
    Tam,
    573,
    "டைனோஸர்களின் ஒரு(1) குழு தப்பித்து இன்றளவும் வாழ்கிறது என பல தொல்லுயிரியல் அறிஞர்கள் இன்றும் நம்புகிறார்கள். நாம் அவற்றை பறவைகள் என்று அழைக்கிறோம்.",
  ),
  (
    Tam,
    603,
    "கிருமி-வரிசை செல்களில் உள்ள மாற்றங்கள் மட்டுமே குழந்தைகளுக்கு கடத்தப்படலாம், அதே நேரத்தில் பிற இடங்களில் நடைபெறும் மாற்றங்கள் உயிரணு-இறப்பு அல்லது புற்றுநோயை ஏற்படுத்தக்கூடும்.",
  ),
  (
    Tam,
    669,
    "இருக்கும் எல்லா வளங்களையும் ஒரு நிறுவனத்தின் எல்லா துறைகளும் சிறப்பாக பயன்படுத்தினால் படைப்பாற்றல் மற்றும் புத்திசாலித்தனம் அனைவருக்கும் பயன்படும்.",
  ),
  (
    Tam,
    685,
    "களத்திற்கு செல்லும் சிறு பிரயாணத்தை காட்சி முறையில் பகிர்ந்து கொள்வது பயணத்தை சிறந்த முறையில் பிரதிபலிக்கும் வழியாகும் மற்றும் வருங்கால வகுப்புக்களுடன் அனுபவத்தைப் பகிர்ந்து கொள்வதுமாகும்.",
  ),
  (
    Tam,
    698,
    "மடகாஸ்கர் மிகப்பெரியது, வனவிலங்குகளுக்கென்று வரும் நிலையில், இது ஒரு தனிக்கண்டமாக கருதப்படுகிறது.",
  ),
  (
    Tam,
    769,
    "அபியா 1850-ல் நிறுவப்பட்டு 1959 முதல் சமோவாவின் அதிகாரப்பூர்வ தலைநகரமாக உள்ளது.",
  ),
  (
    Tam,
    790,
    "பொதுவாக, பயண முகவர்கள் காலை உணவு, விமான நிலையத்திற்கு போகும் மற்றும் வரும் போக்குவரத்து ஏற்பாடுகள் அல்லது சில சமயங்களில் விமானம் மற்றும் ஹோட்டல் பேக்கேஜுகள் ஆகியவை இணைந்த பேக்கேஜுகளை அளிப்பர்.",
  ),
  (
    Tam,
    823,
    "பயணிகள் தங்கள் வீட்டுப் பகுதிகளில் தெரியாத விலங்குகளை அழிக்கும் பூச்சிகளைச் சந்திக்க நேரிடலாம்.",
  ),
  (
    Tam,
    835,
    "உங்களுக்கு கொஞ்சம் சிறிய ஆனால் செழுமையான பேஸ்ட்ரீகள் வேண்டுமெனில், பிராந்தியத்தைப் பொறுத்து பர்லீனர், ஃபான்கூக்கன் அல்லது கிராஃபென் என்றழைக்கப்படும் பேஸ்ட்ரீகளை முயற்சித்திடுங்கள்.",
  ),
  (
    Tam,
    853,
    "பனிச்சறுக்குப் பயணம்: இந்த செயல்பாடு பேக்கண்ட்ரி பனிச்சறுக்கு, பனிச்சறுக்கு சுற்றுலா அல்லது பனிச்சறுக்கு ஹைக்கிங் என்றும் அழைக்கப்படுகிறது.",
  ),
  (
    Tam,
    902,
    "காட்சிகள் பிரமிடுகளில் காட்சிப்படுத்தப்பட்டு வெவ்வேறு பிரமிடுகள் ஒளியேற்றப்படும்.",
  ),
  (
    Tam,
    906,
    "தீபகற்பத்தின் தெற்கு பகுதியில் அமைந்துள்ள எல்ஸ்ஒர்த் லேன்ட், பெலிங்ஷாஷென் கடலால் சூழப்பட்டுள்ளது.",
  ),
  (
    Tam,
    919,
    "கடலோர தீவுக்கூடங்கள், மிகப்பெரிய ஏரிகள் ஆகியவை எந்த படகுக்கும் ஏற்றதாக இருந்தாலும், சிறிய படகுகள் அல்லது ஒரு சிறு கயாக் கூட வித்தியாசமான அனுபவத்தை அளிக்கின்றன.",
  ),
  (
    Tam,
    921,
    "இது நார்வே, சுவிடன் மற்றும் நியுசிலாந்துடன் பொருந்துகிறது, ஆனால் மற்றபடி இது மிக தனித்துவமானது (எ.கா. நெதர்லாந்து நாட்டில் இந்த எண்ணிக்கை ஒன்று முதல் நாற்பது வரையாகும்).",
  ),
  (
    Tam,
    922,
    "மிகவும் தனித்துவமான பால்டிக் கடற்பயணங்களில் பெரும்பாலானவை ரஷ்யாவின், செயின்ட் பீட்டர்ஸ்பர்க்கில் ஒரு நீட்டிக்கப்பட்ட தங்குமிடத்தை அளிக்கும் அம்சத்தைக் கொண்டுள்ளது.",
  ),
  (
    Tam,
    927,
    "அது வெட்கப்பட வேண்டிய ஒன்று இல்லை: பல மனிதர்களுக்கு இருக்கும் தனிப்பட்ட பயங்கள் மற்றும் பிற விஷயங்களின் மீது விருப்பமின்மையும் இதுவும் ஒன்றே வேறுபாடு இல்லை.",
  ),
  (
    Tam,
    980,
    "உங்களுக்கு ரோமானிய மொழி தெரிந்தால், போர்ச்சிகிசியம் கற்றுக்கொள்வது சுலபமாக இருக்கும் என்பதை சொல்ல தேவையில்லை.",
  ),
  (
    Tam,
    986,
    "பூக்களின் தேர்வாக ப்ளம் பூக்கள் இருக்கும் என்ற கருத்து சைனாவிலிருந்து வந்தது.",
  ),
  (
    Tam,
    991,
    "\"எனவே பூமத்திய ரேகைக்கு சில டிகிரி வடக்கே \"\"உயர் வெப்பமண்டலத்தில்\"\" இருப்பதால் நீங்கள் வெப்பமாக (எப்போதுமே) மற்றும் வலுவான சூரியன் (வானம் தெளிவாக உள்ளபோது, மிகவும் அபூர்வமாக) இரண்டையும் கையாள வேண்டியிருக்கும்.\"",
  ),
  (
    Tam,
    992,
    "விவிலிய குருமார்கள் ஆபிரகாம், ஐசக், ஜேகப் மற்றும் அவரது மனைவிகளின் தொன்மையான கல்லறைக்கு, அங்கு சில பேருந்துகள் ஹெப்ரான் வடக்கிற்கு செல்கின்றன.",
  ),
  (
    Tam,
    1000,
    "இந்த பாரம்பரியத்துக்கு நிச்சயமாகக் கிறிஸ்தவ இறையியல் விளக்கங்கள் உள்ளன, ஆனால் இது கிறிஸ்தவத்துக்கு முன்பாக, வசந்தகால மற்றும் கருவுறுதல் சடங்காகவும் இருக்கலாம்.",
  ),
]

///|
let rows_guj : Array[(@mbglot.Lang, Int32, String)] = [
  (
    Guj,
    88,
    "જે કામ કરવામાં આવ્યું તે મોટા ભાગે સૈદ્ધાંતિક હતું. પરંતુ આ કાર્યક્રમ સગિટારિયસ ગેલેક્સીમાંથી બનેલા અવલોકનોની નકલ કરવા માટે લખવામાં આવ્યો હતો.",
  ),
  (
    Guj,
    92,
    "આ સિદ્ધાંત કહે છે કે આકાશગંગાની આસપાસનો મોટા ભાગનો કાળો પદાર્થ એક પ્રકારના હેલોમાં આકાશગંગાની આસપાસ સ્થિત હોય.અને તે ઘણા નાના કણોથી બનેલું છે.",
  ),
  (
    Guj,
    115,
    "સરકાર દ્વારા એનસીફીલાઇટીસ રસીની અમુક લાખ શીશીઓનો વાયદો કરવામાં આવ્યો હતો, જે આરોગ્ય સંસ્થાઓને આવનાર વર્ષ માટે તૈયાર રહેવામાં મદદરૂપ થશે.",
  ),
  (
    Guj,
    116,
    "ભંડોળની કમી અને અન્ય રોગોની સરખામણીમાં ઓછી પ્રાથમિકતાને કારણે, આ વર્ષે સૌથી વધુ અસરગ્રસ્ત થયેલા વિસ્તારોમાં રસીનું વિતરણ કરવાની યોજનામાં વિલંબ થયો.",
  ),
  (
    Guj,
    119,
    "\"તેમનું કામ એટલું માન્ય ગુણવત્તા અને વિગતનું છે કે તે ફિલેટેલિસ્ટ્સમાં \"\"ઘરમાં જાણીતું નામ\"\"માંનું એક છે. કેટલાક તેના એકલા હાથે કામ લેવામાં નિષ્ણાત છે.\"",
  ),
  (
    Guj,
    120,
    "\"તેમની 1,000મી ટિકિટ હતી, \"\"મહાન કાર્યો દ્વારા સ્વીડીશ રાજાઓ\"\" ડેવિડ કોલ્કર એહરેન્સટ્રોમે 2000માં લખ્યું હતું, જે ગિનિસ બુક ઓફ વર્લ્ડ રેકોર્ડ્સમાં સૂચિબદ્ધ હતું.\"",
  ),
  (
    Guj,
    138,
    "આ કાંપ રેતીના સ્તંભ અને કિનારાઓ બનાવવા માટે જરૂરી હતો, જે જંગલી જીવોના રહેઠાણ તરીકે કાર્ય કરતો હતો.",
  ),
  (
    Guj,
    139,
    "પરિણામે, બે માછલીઓની પ્રજાતિઓ લુપ્ત થઈ ગઈ છે અને બે અન્ય પ્રજાતિઓ જોખમી બની છે, જેમાં હમ્પબેક ચબનો પણ સમાવેશ થાય.",
  ),
  (
    Guj,
    198,
    "પોલીસના જણાવ્યા અનુસાર, ફોટોગ્રાફર સાથે અથડાયેલા વાહનના ડ્રાઇવરને ગુનાના આરોપનો સામનો કરવો પડે તેની સંભાવના નથી.",
  ),
  (
    Guj,
    240,
    "તેનો ટીમનો સાથી ફર્નાન્ડો અલોન્સો મોટા ભાગની સ્પર્ધામાં આગળ હતો, પરંતુ આગળનું જમણી બાજુનું વ્હીલ ખરાબ રીતે ફસાઈ જવાના કારણે ઘણું કરીને, તેના પીટ સ્ટોપ ની બરાબર પાછળ પૂર્ણ કર્યું હતું.",
  ),
  (
    Guj,
    256,
    "પાલતુ પ્રાણીઓ માટેના અશુદ્ધ આહારનો ઉપયોગ કર્યા બાદ જે મૃત્યુ પામ્યા હતા તે પાલતું પ્રાણીઓના પેશાબના નમૂનાઓમાંથી સાયનુરીક એસીડ અને મેલામાઇન મળી આવ્યા હતા.",
  ),
  (
    Guj,
    269,
    "અકસ્માતે મોત થયેલા લોકો નિકોલસ આલ્ડન, 25, અને ઝાચાર્ય કુડબેક, 21 હતા. કુડબેક વાહનચાલક હતો.",
  ),
  (
    Guj,
    282,
    "જો કે, ડ્રાઇવરને માથામાં ગંભીર ઈજાઓ પહોંચી હતી.",
  ),
  (
    Guj,
    330,
    "ધૂમકેતુઓ પૃથ્વી પર પાણી તથા પ્રોટીન્સ બનાવી શકે અને જીવન રચનાને આધાર આપી શકે એવા સેન્દ્રીય પદાર્થ લાવવાના સ્ત્રોત રહ્યા હશે.",
  ),
  (
    Guj,
    457,
    "ફેન્ચ ક્રાંતિ દ્વારા બીજા દેશોના કચડાયેલા કામદાર લોકોને તેમની પોતાની ક્રાંતિ શરૂ કરવાની પ્રેરણા પણ મળી.",
  ),
  (
    Guj,
    477,
    "અલબત, ફિલિપિનો લોકોના લાંબા શોષણમાંથી મેળવેલા અતિશય નફામાં અમેરિકન સામ્રાજ્યવાદનાં મૂળભૂત લાભોનું સ્થાપન થશે.",
  ),
  (
    Guj,
    530,
    "સૌથી વધુ સહેલાઈથી પ્રાપ્ય વનસ્પતિ સંશાધનો પાંદડાઓ અને શીંગોમાં સુલભ પ્રોટીન્સ હોઈ શકે છે પરંતુ જો તેમને રાંધવામાં આવે નહીં તો તે આપણા જેવા મનુષ્ય પ્રાણીઓ માટે પચાવવા મુશ્કેલ હોય છે.",
  ),
  (
    Guj,
    558,
