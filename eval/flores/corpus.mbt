let rows_ben : Array[(@mbglot.Lang, Int32, String)] = [
  (
    Ben,
    88,
    "সম্পন্ন কাজটির বেশিরভাগই ছিল তাত্ত্বিক, তবে কর্মসূচিটি সাগিটারিয়াস ছায়াপথের পর্যবেক্ষণগুলি অনুকরণ করার জন্য রচিত হয়েছিল।",
  ),
  (
    Ben,
    92,
    "এই তত্ত্ব মতে একটি ছায়াপথের চারপাশের ডার্ক ম্যাটার ছায়াপথের চারপাশে এক ধরণের বর্ণবলয় হয়ে অবস্থান করে এবং যা অসংখ্য ছোট ছোট কণা দিয়ে গঠিত।",
  ),
  (
    Ben,
    115,
    "সরকার লক্ষাধিক এনসেফ্যালাইটিস টিকাপূর্ণ শিশি প্রদানের প্রতিশ্রুতি দিয়েছে যা স্বাস্থ্য সচেতন সংস্থাগুলিকে আগামী বছরের জন্য প্রস্তুত হতে সাহায্য করবে।",
  ),
  (
    Ben,
    116,
    "তহবিলের অভাব ও অন্যান্য রোগের তুলনায় কম অগ্রাধিকারের কারণে ঐতিহাসিকভাবে এ বছর সবচেয়ে বেশি ক্ষতিগ্রস্থ অঞ্চলে ভ্যাকসিন সরবরাহের পরিকল্পনাতে দেরি হয়েছিল।",
  ),
  (
    Ben,
    119,
    "\"তাঁর কাজ এতটাই স্বীকৃত গুণমানের এবং বিশদে যে সে হচ্ছে \"\"ঘরে ঘরে নাম করা\"\" ডাকটিকিট সংগ্রহকারীদের মধ্যে একজন। কেউ কেউ শুধুমাত্র তাঁর কাজ সংগ্রহে বিশেষজ্ঞ ।\"",
  ),
  (
    Ben,
    120,
    "\"তার 1,000 তম স্ট্যাম্পটি ছিল 2000 সালে ডেভিড ক্ল্যাকার এহরেনস্ট্রহল রচিত \"\"গ্রেট ডিডস বাই সুইডিশ কিং\"\", যা গিনেস বুক অফ ওয়ার্ল্ড রেকর্ডসে তালিকাভুক্ত আছে।\"",
  ),
  (
    Ben,
    138,
    "বালুচর এবং সমুদ্রসৈকত তৈরি করার জন্য এই অধঃক্ষেপের প্রয়োজন ছিল, যা বন্যজীবনের বাসস্থান হিসাবে কাজ করে।",
  ),
  (
    Ben,
    139,
    "এর ফলে, দুই প্রজাতির মাছ লুপ্ত হয়ে গেছে এবং আরও দুটি প্রজাতি বিপন্ন। এরমধ্যে হাম্পব্যাক চাবও আছে।",
  ),
  (
    Ben,
    198,
    "পুলিশ জানায়, ফটোগ্রাফারকে আঘাত করা গাড়ির চালকের বিরুদ্ধে অপরাধমূলক অভিযোগ আনার সম্ভাবনা নেই।",
  ),
  (
    Ben,
    240,
    "তার দলের ফার্নান্ডো আলোন্সো প্রতিযোগীতায় সবার আগে ছিলেন, কিন্তু তার গর্তের সামনেই তিনি খেলা শেষ করেন, সম্ভবত একটি রাইট ফ্রন্ট হুইলের কারণে এমনটা হয়েছে।",
  ),
  (
    Ben,
    256,
    "বিষাক্ত খাবার খেয়ে মারা যাওয়া পোষা প্রাণীর মূত্রের নমুনা থেকে সাইনিউরিক অ্যাসিড এবং মেলামাইন উভয়ই পাওয়া গিয়েছিল।",
  ),
  (
    Ben,
    269,
    "যাদের প্রাণহানি হয়েছিল তারা হলেন, নিকোলাস অলডেন, 25 বছর, এবং জ্যাকারি চুডব্যাক, 21 বছর। চুডব্যাক ছিল ড্রাইভার।",
  ),
  (
    Ben,
    282,
    "তবে, গাড়ির চালকের মাথায় মারাত্মক চোট লেগেছে।",
  ),
  (
    Ben,
    330,
    "ধূমকেতু সম্ভবত পৃথিবীতে জল সরবরাহের উৎস হওয়ার পাশাপাশি জৈব পদার্থের উৎস হতে পারে যা প্রোটিন গঠন এবং জীবন চালাতে সাহায্য করতে পারে।",
  ),
  (
    Ben,
    457,
    "ফরাসী বিপ্লব অন্যান্য দেশের অনেক নিপীড়িত শ্রমজীবী মানুষকে তাদের নিজ নিজ বিপ্লব শুরু করতে উদ্বুদ্ধ করেছিল।",
  ),
  (
    Ben,
    477,
    "অবশ্যই, ফিলিপিনো জনগণের ওপর দীর্ঘদিন ধরে শোষণ থেকে প্রাপ্ত অতিরিক্ত লাভগুলি মার্কিন সাম্রাজ্যবাদের মূল ভিত্তি গঠন করবে।",
  ),
  (
    Ben,
    530,
    "সর্বাধিক সহজেই অভিগমনযোগ্য উদ্ভিদ সংস্থানগুলো হতে পাতা এবং কলাইতে অ্যাক্সেসযোগ্য প্রোটিন তবে এগুলো আমাদের মতো প্রাইমেটদের রান্না না করে হজম করা কঠিন।",
  ),
  (
    Ben,
    558,
    "যদিও মালগাড়ি চলার পথগুলো শুধুমাত্র কতগুলো সমান্তরাল কাঠের তক্তার সমষ্টি, সেগুলো দিনের একটু বেশি অসমতল পথগুলোর তুলনায় টানতে থাকা ঘোড়াগুলোকে বেশি গতি তুলতে এবং বেশি বোঝা টানতে সাহায্য করে।",
  ),
  (
    Ben,
    572,
    "এখনও বিদ্যমান হিসাবে পরিচিত ২৫ টি ডানল্যাপ ব্রডোসাইড হল দলিল প্রাচীনতম অনুলিপি। মূল হাতে লেখা অনুলিপিটি এখন আর নেই।",
  ),
  (
    Ben,
    573,
    "অনেক জীবাশ্মবিদ আজও বিশ্বাস করেন যে ডায়নোসরের একটি দল বেঁচে গিয়েছিলো এবং আজও বেঁচে রয়েছে। আমরা তাদের পাখি বলি।",
  ),
  (
    Ben,
    603,
    "কেবল জার্ম-লাইন কোষগুলিতে যে মিউটেশন ঘটে তাকেই শিশুর মধ্যে পরিচালিত করা যেতে পারে, অন্য কোথাও মিউটেশনগুলি কোষের মৃত্যু বা ক্যান্সারের কারণ হতে পারে।",
  ),
  (
    Ben,
    669,
    "যখন সমস্ত কার্যকরী উপলভ্য রসদগুলিকে কোনও সংস্থার বিভিন্ন বিভাগে ব্যবহার করা হয়, তখন সৃজনশীলতা এবং চতুরতা পরিবাহিত হতে পারে।",
  ),
  (
    Ben,
    685,
    "কার্যত কোনও ভ্রমণের বিবরণ শেয়ার করে নেওয়া ভবিষ্যতের ক্লাসগুলির সাথে অভিজ্ঞতা ভাগ করে নেওয়ার এক দুর্দান্ত উপায়।",
  ),
  (
    Ben,
    698,
    "বন্যজীবনের ক্ষেত্রে মাদাগাস্কার এখন পর্যন্ত সর্ববৃহৎ একটি মহাদেশ।",
  ),
  (
    Ben,
    769,
    "১৮৫০ সালে আপিয়া প্রতিষ্ঠিত হয়েছিল এবং ১৯৫৯ সাল থেকে এটি সামোয়ার সরকারি রাজধানী।",
  ),
  (
    Ben,
    790,
    "ট্রাভেল এজেন্টরা সাধারণত প্যাকেজ ব্রেকফাস্ট অন্তর্ভুক্ত অফার দিয়ে থাকে , বিমানবন্দর বা এমনকি মিলিত ফ্লাইট এবং হোটেল প্যাকেজ থেকে অথবা পরিবহন ব্যবস্থা থেকে ।",
  ),
  (
    Ben,
    823,
    "ভ্রমণকারীরা কীটনাশক পেতে পারে যেগুলি তারা সাধারণত নিজের এলাকাতে দেখেননি।",
  ),
  (
    Ben,
    835,
    "আপনি যদি ছোট কিন্তু ভালো মানের কিছু পেস্ট্রি চান, তবে অঞ্চলটির উপর নির্ভর করে বার্লিনার, ফাফানকুচেন বা ক্র্যাপফেন নামের কিছু ট্রাই করুন।",
  ),
  (
    Ben,
    853,
    "স্কি এর মাধ্যমে ব্যাকপ্যাকিং: এই বিষয়টিকে ব্যাককান্ট্রি স্কি, স্কি টুরিং বা স্কি হাইকিংও বলা হয়।",
  ),
  (
    Ben,
    902,
    "পিরামিডের উপরিতলে দৃশ্যগুলি ফুটে উঠলে পিরামিডগুলি উজ্জ্বল হয়ে ওঠে।",
  ),
  (
    Ben,
    906,
    "উপদ্বীপটির দক্ষিণে এলসওর্থ ল্যান্ড এলাকাটি বেল্লিংশাউসেন সমুদ্র দ্বারা আবদ্ধ।",
  ),
  (
    Ben,
    919,
    "উপকূলীয় দ্বীপপুঞ্জ এবং বৃহত্তম হ্রদগুলিতে যে কোনও ইয়াটের পক্ষে যথেষ্ট বড়। তবে ছোট নৌকা বা একটি কায়াকের অভিজ্ঞতাই অন্যরকম হবে।",
  ),
  (
    Ben,
    921,
    "এটি নরওয়ে, সুইডেন এবং নিউজিল্যান্ডের সাথে মিলেছে তবে অন্যদের থেকে বেশ আলাদা (উদাঃ নেদারল্যান্ডে সংখ্যাটি চল্লিশে একটি)।",
  ),
  (
    Ben,
    922,
    "বেশিরভাগ স্বতন্ত্র বাল্টিক ক্রুজগুলোর বৈশিষ্ট্য রাশিয়ার সেন্ট-পিটার্সবার্গে বর্ধিত থাকা।",
  ),
  (
    Ben,
    927,
    "লজ্জিত হওয়ার মতো কিছু নয় এটি: অন্য লোকের থেকে ব্যক্তিগত ভয় এবং অপছন্দের বিষয়গুলো আলাদা থাকা।",
  ),
  (
    Ben,
    980,
    "বলা বাহুল্য যে, আপনি রোমান ভাষা জানলে আপনার পক্ষে পর্তুগিজ শেখায় সহজ হবে।",
  ),
  (
    Ben,
    986,
    "এই ধারণাটি চীন থেকে এসেছিল যেখানে পাম পুষ্পগুলি ছিল পছন্দের ফুল।",
  ),
  (
    Ben,
    991,
    "\"কিন্তু নিরক্ষীয় অঞ্চল থেকে মাত্র কয়েক ডিগ্রি উত্তরে \"\"উচ্চ ক্রান্তীয়\"\" অঞ্চলে অবস্থিত হওয়ার জন্য আপনাকে তাপ (সবসময়) এবং প্রখর রোদ (যখন আকাশ স্বচ্ছ থাকে, যা খুব কমই হয়) দুই মোকাবেলা করতে হবে। \"",
  ),
  (
    Ben,
    992,
    "কিছু বাস হেবরনের উত্তর দিকে যাচ্ছে, এটি বাইবেলীয় পিতা আব্রাহাম, আইজ্যাক, জ্যাকব এবং তাদের স্ত্রীদের গোরস্থান।",
  ),
  (
    Ben,
    1000,
    "এই ঐতিহ্যের জন্য অবশ্যই খ্রিস্টান ধর্মতাত্ত্বিক ব্যাখ্যা রয়েছে, তবে এটি খ্রিস্টপূর্ব বসন্ত এবং উর্বরতার রীতিও হতে পারে।",
  ),
]

