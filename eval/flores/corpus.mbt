  ),
  (
    Amh,
    906,
    "ኤሪስወርዝ ላንድ በ ቤሊንግሿሰን ባህር የተከበበ በደቡብ ፔኑንስላ የሚገኝ ግዛት ነው።",
  ),
  (
    Amh,
    919,
    "የጠረፍ እጅብ ደሴቶች እና ትልልቆቹ ሃይቆች ለማንኛውም መርከብ በበቂ ሁኔታ ትልቅ ቢሆኑም ትንሽ ጀልባዎች ወይም ትንሽ ጀልባ እንኳ የተለየ ተሞክሮ ያቀርባሉ።",
  ),
  (
    Amh,
    921,
    "ይህ በኖርዌይ፣ ስዊድን፣ እና ኒው ዚላንድ ይዛመዳል፣ ነገር ግን አለበለዚያ በጣም ልዩ (ምሳ. በኔዘርላንድ ቁጥሩ አንድ ለ አርባ ነው)።",
  ),
  (
    Amh,
    922,
    "አብዛኞቹ ልዩ የቦልቲክ መርከቦች በሩሲያ ኤስቲ ፒተርስበርግ የተራዘመ ቆይታ ይኖራቸዋል።",
  ),
  (
    Amh,
    927,
    "እርሱ የሚያሳፍር ነገር አይደለም፤ በጣም ብዙ ሰዎች ካሏቸው ከሌሎች ነገሮች ግላዊ ፍርሃቶችና አለመውደዶች የተለየ አይደለም።",
  ),
  (
    Amh,
    980,
    "መናገር ባያስፈልግም የሮማንስ ቋንቋን ካወቁ ፖርቹጋልኛ ለመማር ይቀልዎታል።",
  ),
  (
    Amh,
    986,
    "ጽንሰ-ሃሳቡ የተቀረፀው ፕለም አበባዎች የምርጫ አበባ ከሆኑበት ከቻይና ነው።",
  ),
  (
    Amh,
    991,
    "ግን ከምድር ወገብ ትንሽ ዲግሪዎች በስተሰሜን “በከፍተኛ ሃሩሮች” ውስጥ ከተመደቡ ሙቀትን (ሁልጊዜ) እና ጠንካራ ፀሃይን (ሰማዩ ሲጠራ በጣም አልፎ አልፎ) ሊቋቋሙ ያስፈልግዎታል።",
  ),
  (
    Amh,
    992,
    "በተጨማሪም ወደ ሰሜን ወደ ኬብሮን የሚሄዱ ጥቂት አውቶቡሶች አሉ፣ ባህላዊ የቀብር ስፍራው የመጽሐፍ ቅዱስ አባቶች አብርሃምን፣ ይስሐቅ፣ ያዕቆብንና ሚስቶቻቸውን።",
  ),
  (
    Amh,
    1000,
    "በእርግጥ ለዚህ ባህል የክርስቲያን ኃይማኖታዊ መግለጫዎች አሉ፣ ነገር ግን የቅደመ-ክርስትና ፀደይ እና የውልደት የአምልኮ ስርዓትም ሊሆን ይችላል።",
  ),
]

